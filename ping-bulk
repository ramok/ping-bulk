    def _cmd_resolv(self, args=''):
        """Apply a static DNS override: :resolv <ip-pattern> <hostname-template>."""
        parts = args.split(None, 1)
        if len(parts) != 2:
            self.add_event("cmd", "resolv: usage: :resolv <ip> <hostname>")
        else:
            ip_pattern, hostname_tmpl = parts[0], parts[1].strip()
            try:
                rows = _expand_host_with_captures(ip_pattern)
            except ValueError as e:
                self.add_event("cmd", f"resolv: brace expansion error: {e}")
            else:
                for expanded_ip, captures in rows:
                    if not _is_ip(expanded_ip):
                        self.add_event("cmd",
                            f"resolv: '{expanded_ip}' is not a valid IP address — skipped")
                        continue
                    hostname = _apply_backref(hostname_tmpl, captures)
                    self._apply_hosts_entry(expanded_ip, hostname)

    def _cmd_resolv_port(self, args=''):
        """Apply a static port→service mapping: :resolv-port <port-pattern> <service-template>."""
        parts = args.split(None, 1)
        if len(parts) != 2:
            self.add_event("cmd", "resolv-port: usage: :resolv-port <port> <service>")
        else:
            port_pattern, service_tmpl = parts[0], parts[1].strip()
            try:
                rows = _expand_host_with_captures(port_pattern)
            except ValueError as e:
                self.add_event("cmd", f"resolv-port: brace expansion error: {e}")
            else:
                for expanded_port, captures in rows:
                    try:
                        port_num = int(expanded_port)
                    except ValueError:
                        self.add_event("cmd",
                            f"resolv-port: '{expanded_port}' is not a valid port number — skipped")
                        continue
                    service = _apply_backref(service_tmpl, captures)
                    # Store bidirectional mapping
                    self.port_map[port_num] = service
                    self.port_map[service] = port_num

    def _cmd_remote_ping(self, args=''):
        """Add a remote-ping monitor: :remote-ping [ssh-opts] <relay> <target>."""
        if not args:
            self.add_event("cmd",
                "remote-ping: usage: :remote-ping [ssh-opts] <relay> <target>")
        else:
            try:
                tokens = shlex.split(args)
            except ValueError as e:
                self.add_event("cmd", f"remote-ping: parse error: {e}")
            else:
                if len(tokens) < 2:
                    self.add_event("cmd",
                        "remote-ping: usage: :remote-ping [ssh-opts] <relay> <target>")
                else:
                    ping_host_pattern = tokens[-1]
                    ssh_args = tokens[:-1]
                    ssh_dest = ssh_args[-1]

                    # In kiosk mode, validate and prepend isolation flags
                    if self.kiosk_mode:
                        err = _kiosk_validate_ssh_args(ssh_args)
                        if err:
                            self.add_event("cmd", f"remote-ping: {err}")
                            return
                        ssh_args = _kiosk_ssh_flags() + ssh_args

                    # Preserve original SSH args before applying :resolv mappings
                    original_ssh_args = ssh_args.copy()

                    # Apply :resolv mapping to SSH destination
                    ssh_args[-1] = self._resolve_ssh_host(ssh_dest)

                    # Apply :resolv mapping to ProxyJump/jump hosts (-J and -o ProxyJump=)
                    i = 0
                    while i < len(ssh_args):
                        arg = ssh_args[i]

                        # Handle -J option (ProxyJump shorthand)
                        if arg == '-J' and i + 1 < len(ssh_args):
                            # Collect all tokens that belong to this -J argument.
                            # When user types "-J bastion1, bastion2", shlex.split() produces
                            # ['-J', 'bastion1,', 'bastion2'], so we need to collect tokens
                            # while the previous token ends with a comma.
                            jump_tokens = []
                            j = i + 1
                            while j < len(ssh_args):
                                jump_tokens.append(ssh_args[j])
                                # Stop if this token doesn't end with comma (it's the last one)
                                if not ssh_args[j].endswith(','):
                                    break
                                j += 1

                            # Join collected tokens with space, then split on comma
                            jump_hosts_str = ' '.join(jump_tokens)

                            # Handle comma-separated multi-hop: host1,host2,host3
                            if ',' in jump_hosts_str:
                                resolved_hops = []
                                for hop in jump_hosts_str.split(','):
                                    hop = hop.strip()  # Strip whitespace
                                    if hop:  # Skip empty strings from trailing commas
                                        resolved_hops.append(self._resolve_ssh_host(hop))
                                resolved_str = ','.join(resolved_hops)
                            else:
                                resolved_str = self._resolve_ssh_host(jump_hosts_str)

                            # Replace the collected tokens with the single resolved string
                            ssh_args[i + 1] = resolved_str
                            # Remove any extra tokens that were part of the jump host list
                            for _ in range(len(jump_tokens) - 1):
                                ssh_args.pop(i + 2)

                            i += 2
                            continue

                        # Handle -o ProxyJump=host (with or without space after -o)
                        if arg.startswith('-oProxyJump='):
                            # Format: -oProxyJump=host (no space)
                            jump_hosts = arg.split('=', 1)[1]
                            if ',' in jump_hosts:
                                resolved_hops = []
                                for hop in jump_hosts.split(','):
                                    resolved_hops.append(self._resolve_ssh_host(hop.strip()))
                                ssh_args[i] = '-oProxyJump=' + ','.join(resolved_hops)
                            else:
                                ssh_args[i] = '-oProxyJump=' + self._resolve_ssh_host(jump_hosts)
                        elif arg == '-o' and i + 1 < len(ssh_args):
                            # Format: -o ProxyJump=host (with space)
                            next_arg = ssh_args[i + 1]
                            if next_arg.startswith('ProxyJump='):
                                jump_hosts = next_arg.split('=', 1)[1]
                                if ',' in jump_hosts:
                                    resolved_hops = []
                                    for hop in jump_hosts.split(','):
                                        resolved_hops.append(self._resolve_ssh_host(hop.strip()))
                                    ssh_args[i + 1] = 'ProxyJump=' + ','.join(resolved_hops)
                                else:
                                    ssh_args[i + 1] = 'ProxyJump=' + self._resolve_ssh_host(jump_hosts)
                                i += 2
                                continue

                        i += 1
                    try:
                        expanded_hosts = _expand_host(ping_host_pattern)
                    except ValueError as e:
                        self.add_event("cmd", f"remote-ping: brace expansion error: {e}")
                    else:
                        for ping_host in expanded_hosts:
                            actual_ping_host = (self.hosts_map[ping_host][0]
                                                if ping_host in self.hosts_map
                                                else ping_host)
                            monitor = SshPingMonitor(ssh_args, actual_ping_host,
                                                     ping_host_label=ping_host,
                                                     original_ssh_args=original_ssh_args,
                                                     hosts_map=self.hosts_map)
                            self.monitors.append(monitor)
                            self._add_entry(monitor)
                            if self._monitoring_started:
                                thread = threading.Thread(
                                    target=monitor.ping, daemon=True
                                )
                                thread.start()
                                self.threads.append(thread)

    def _cmd_fold_all(self, args=''):
        """Fold (collapse) all sections."""
        self._fold_all(True)

    def _cmd_unfold_all(self, args=''):
        """Unfold (expand) all sections."""
        self._fold_all(False)

    def _cmd_help(self, args=''):
        """Open the help overlay (sets self.help_open = True).

        The overlay is drawn by _draw_help_overlay() and is never written to
        the event log or the log file.  Scroll position is reset to the top
        each time the overlay is opened.
        """
        self.help_open = True
        self.help_tab = 0
        self._tab_scroll = [0] * 6
        self._tab_h_scroll = [0] * 6
        self.help_search_active = False
        self._current_mode = 'help'

    def _cmd_help_tab(self, args=''):
        """Switch to a help tab: 'next', 'prev', or tab index 0-5."""
        a = args.strip()
        if a == 'next':
            old_tab = self.help_tab
            self.help_tab = (self.help_tab + 1) % 6
        elif a == 'prev':
            old_tab = self.help_tab
            self.help_tab = (self.help_tab - 1) % 6
        else:
            try:
                old_tab = self.help_tab
                self.help_tab = int(a) % 6
            except ValueError:
                return
        if self.help_tab != old_tab:
            self.help_search = ''
            self.help_search_matches = []
            self.help_search_match_idx = 0

    def _cmd_help_toggle_all(self, args=''):
        """Switch to or away from the Bindings tab."""
        self._cmd_help_tab('prev' if self.help_tab == 4 else '4')

    def _cmd_help_toggle_settings(self, args=''):
        """Switch to or away from the Settings tab."""
        self._cmd_help_tab('prev' if self.help_tab == 5 else '5')

    def _cmd_settings_cursor(self, args=''):
        """Move cursor up or down in the settings overlay."""
        if not (self.help_open and self.help_tab == 5):
            return
        direction = args.strip()
        n = len(SET_PARAMS)
        if direction == 'up':
            self.settings_cursor = (self.settings_cursor - 1) % n
        elif direction == 'down':
            self.settings_cursor = (self.settings_cursor + 1) % n
        # Scroll overlay so cursor line is visible
        cursor_line = self._settings_param_line(self.settings_cursor)
        if cursor_line is not None:
            # cursor_line is in the full lines list; scroll is relative to scrollable portion.
            adj_cursor = cursor_line - self._HELP_PINNED
            visible = max(5, getattr(self, '_help_visible_count', 20))
            if adj_cursor < self.help_scroll:
                self.help_scroll = adj_cursor
            elif adj_cursor >= self.help_scroll + visible:
                self.help_scroll = adj_cursor - visible + 1

    def _settings_param_line(self, param_idx):
        """Return the line index in the settings overlay for the given param index."""
        for line_idx, pidx in self._settings_line_map.items():
            if pidx == param_idx:
                return line_idx
        return None

    def _cmd_settings_apply(self, args=''):
        """Cycle the current setting value forward (Space/→) or backward (←) in settings overlay."""
        if not (self.help_open and self.help_tab == 5):
            return
        param = SET_PARAMS[self.settings_cursor]
        direction = -1 if args == 'prev' else 1
        nxt = param.next_value(self, direction)
        if nxt is not None:
            self._cmd_set(f'{param.name} {nxt}')
        else:
            # free-form: fall back to edit
            self._cmd_settings_edit()

    def _cmd_settings_edit(self, args=''):
        """Close settings overlay and open command line pre-filled with :set <name> <value>."""
        if not (self.help_open and self.help_tab == 5):
            return
        param = SET_PARAMS[self.settings_cursor]
        cur = param.get_current(self)
        self._cmd_close()
        prefill = f'set {param.name} {cur}'
        self._open_cmd_line(prefill=prefill)

    def _update_search_results(self):
        """Recompute self._search_results from self._search_query and _search_mode."""
        q = self._search_query.lower()
        if not q:
            self._search_results = []
            return
        if self._search_mode == 'hosts':
            dns_mode = DNS_MODES[self.dns_mode]
            results = []
            for i, entry in enumerate(self.entries):
                if isinstance(entry, Monitor):
                    name = entry.get_display_name(dns_mode).lower()
                    ip   = (entry.resolved_ip or '').lower()
                    host = (entry.resolved_hostname or '').lower()
                    if q in name or q in ip or q in host:
                        results.append(i)
            self._search_results = results
        else:
            event_list = self._get_filtered_events()
            self._search_results = [i for i, e in enumerate(event_list)
                                    if q in e.text.lower()]

    def _apply_search_result(self, raw_idx):
        """Jump to search result at raw_idx (wraps around)."""
        if not self._search_results:
            return
        idx = raw_idx % len(self._search_results)
        self._search_idx = idx
        if self._search_mode == 'hosts':
            self.highlighted_index = self._search_results[idx]
        else:
            # Scroll event log so matched entry is visible at bottom of window
            ev_idx = self._search_results[idx]
            event_list = self._get_filtered_events()
            total = len(event_list)
            self.log_offset = max(0, total - ev_idx - 1)

    def _cmd_search_open(self, args=''):
        """Open the / search prompt.  Mode: hosts if a host is selected, log otherwise."""
        mode = 'hosts' if self.highlighted_index is not None else 'log'
        # Save state so ESC can restore it
        self._search_pre_highlighted = self.highlighted_index
        self._search_pre_fold = {s: s.folded
                                 for s in self.entries if isinstance(s, SectionLabel)}
        self._search_auto_unfolded = set()
        self.prompt = {'type': 'search', 'mode': mode, 'chars': list(self._search_query)}

    def _get_ancestor_sections(self, entry_idx):
        """Return the list of SectionLabel objects that are ancestors of entry_idx."""
        stack = []
        for i, entry in enumerate(self.entries):
            if i >= entry_idx:
                break
            if isinstance(entry, SectionLabel):
                while stack and stack[-1].level >= entry.level:
                    stack.pop()
                stack.append(entry)
        return list(stack)

    def _search_live_update(self):
        """Called on every keystroke during host search: live-jump and auto-unfold.

        Re-folds any previously auto-unfolded sections first (so stale unfolds
        from a prior query are cleaned up), then unfolds sections that contain
        the current matches, then jumps highlighted_index to the first match.
        """
        if self._search_mode != 'hosts':
            return
        # Re-fold sections that were auto-unfolded by a previous query
        for section in self._search_auto_unfolded:
            if self._search_pre_fold.get(section, False):
                section.folded = True
        self._search_auto_unfolded.clear()

        if not self._search_results:
            self.highlighted_index = self._search_pre_highlighted
            return

        # Auto-unfold every section that contains a match
        for idx in self._search_results:
            for section in self._get_ancestor_sections(idx):
                if section.folded:
                    section.folded = False
                    self._search_auto_unfolded.add(section)

        # Live-jump to the first match
        self._apply_search_result(0)

    def _cmd_search_next(self, args=''):
        """Jump to next (or prev) search match.  :search-next prev → backward."""
        if not self._search_query:
            return
        if not self._search_results:
            self.add_event("cmd", f"search: no matches for '{self._search_query}'")
            return
        direction = args.strip()
        step = -1 if direction == 'prev' else 1
        self._apply_search_result(self._search_idx + step)

    def _update_filter_visible(self):
        """Recompute _filter_visible from _filter_query.

        Sets _filter_visible to the set of entry indices that should be rendered:
        matching Monitor entries plus all their ancestor SectionLabel entries.
        Clears both sets when no query is active.
        Auto-expands any folded sections that contain matching descendants.
        """
        if not self._filter_query:
            self._filter_visible = set()
            self._filter_visible_monitors = set()
            return

        q = self._filter_query
        # Bare strings (no glob metacharacters) auto-wrapped as *query*
        if not any(c in q for c in '*?[]'):
            pattern = f'*{q}*'
        else:
            pattern = q
        pattern = pattern.lower()

        dns_mode = DNS_MODES[self.dns_mode]
        entry_idx_map = {id(e): i for i, e in enumerate(self.entries)}
        matching_indices = set()

        for i, entry in enumerate(self.entries):
            if isinstance(entry, Monitor):
                name = entry.get_display_name(dns_mode).lower()
                ip   = (entry.resolved_ip or '').lower()
                host = (entry.resolved_hostname or '').lower()
                if (fnmatch.fnmatch(name, pattern) or
                        fnmatch.fnmatch(ip, pattern) or
                        fnmatch.fnmatch(host, pattern)):
                    matching_indices.add(i)

        self._filter_visible_monitors = set(matching_indices)

        # Walk upward from each match to include ancestor SectionLabel indices
        visible = set(matching_indices)
        for idx in matching_indices:
            for section in self._get_ancestor_sections(idx):
                si = entry_idx_map.get(id(section))
                if si is not None:
                    visible.add(si)
                    # Auto-expand folded sections that contain matching children
                    if section.folded:
                        section.folded = False

        self._filter_visible = visible

    def _cmd_filter_open(self, args=''):
        """Open the interactive filter prompt."""
        self.prompt = {
            'type': 'filter',
            'prev_query': self._filter_query,
            'chars': list(self._filter_query),
        }

    def _cmd_filter(self, args=''):
        """Set or clear the host filter.

        :filter [pattern]   — set filter to *pattern* (opens prompt if no args)
        :filter --clear     — clear active filter
        """
        a = args.strip()
        if a == '--clear':
            self._filter_query = ''
            self._update_filter_visible()
        elif a:
            self._filter_query = a
            self._update_filter_visible()
        else:
            self._cmd_filter_open()

    def _cmd_close(self, args=''):
        """Close the currently open overlay (help or details)."""
        if self.help_open:
            self.help_open = False
            self.help_search_active = False
            self._current_mode = 'normal'
        elif self.details_open:
            self.details_open = False
            self.details_monitor = None
            self._current_mode = 'normal'

    def _cmd_scroll_overlay(self, args=''):
        """Scroll the active overlay: up/down (±1) or page/page- (±10)."""
        a = args.strip()
        delta = {'up': -1, 'down': 1, 'page-': -10, 'page': 10}.get(a, 0)
        if self.help_open:
            self.help_scroll = max(0, self.help_scroll + delta)
        elif self.details_open:
            self.details_scroll = max(0, self.details_scroll + delta)

    def _cmd_scroll_overlay_h(self, args=''):
        """Scroll the active overlay horizontally: left (−4) or right (+4)."""
        a = args.strip()
        delta = {'left': -4, 'right': 4}.get(a, 0)
        if self.help_open:
            self.help_h_scroll = max(0, self.help_h_scroll + delta)
        elif self.details_open:
            self.details_h_scroll = max(0, self.details_h_scroll + delta)

    def _dispatch_overlay_nav_key(self, key):
        """Handle universal overlay navigation keys (scroll up/down/left/right/page).

        Returns True if the key was handled, False otherwise.  This is called
        from both the help and details overlay key handlers so navigation
        behaviour is identical in all overlay windows without duplicating
        mode-binding definitions.
        """
        if key in (curses.KEY_UP, ord('k')):
            self._cmd_scroll_overlay('up')
        elif key in (curses.KEY_DOWN, ord('j')):
            self._cmd_scroll_overlay('down')
        elif key == curses.KEY_PPAGE:
            self._cmd_scroll_overlay('page-')
        elif key == curses.KEY_NPAGE:
            self._cmd_scroll_overlay('page')
        elif key in (curses.KEY_LEFT, ord('h')):
            self._cmd_scroll_overlay_h('left')
        elif key in (curses.KEY_RIGHT, ord('l')):
            self._cmd_scroll_overlay_h('right')
        else:
            return False
        return True

    def _draw_overlay_box(self, stdscr, height, width, lines, scroll_offset, inner_w, *,
                          handle_dividers=False, search_bar=None,
                          match_set=None, current_match=None, search_query='',
                          h_scroll=0, selected_line=None, pinned_count=0):
        """Draw a centered bordered overlay popup; return (v_scroll, h_scroll).

        Draws a ┌─┐ / │ │ / └─┘ box centered on the terminal.  Content lines
        are rendered with :meth:`_draw_hint_text` so ``[key]`` tokens receive
        hotkey colouring (white/bold) while surrounding text stays plain.

        Parameters
        ----------
        lines           Full content line list.  When *handle_dividers* is
                        True, the sentinel ``"-DIVIDER-"`` draws a ``├─┤`` box
                        divider instead of a content row.
        scroll_offset   First visible line index.  Clamped to a valid range
                        before drawing; the clamped value is returned.
        inner_w         Visible content column width (box is ``inner_w + 2`` wide).
                        When content is wider than ``inner_w``, horizontal
                        scrolling via *h_scroll* reveals the hidden columns.
        handle_dividers When True, ``"-DIVIDER-"`` entries become ├─┤ rules.
        h_scroll        Horizontal scroll offset (columns from the left of each
                        line).  Clamped to [0, max_line_len - inner_w].

        Returns
        -------
        tuple[int, int]
            ``(clamped_v_scroll, clamped_h_scroll)`` actually used.
        """
        box_w = inner_w + 2
        box_h_available = min(len(lines) + 2, height)
        visible_count   = max(0, box_h_available - 2)
        adj_visible     = max(0, visible_count - pinned_count)
        max_scroll      = max(0, len(lines) - pinned_count - adj_visible)
        scroll_offset   = max(0, min(scroll_offset, max_scroll))

        # Compute maximum rendered content width across scrollable (non-pinned) lines.
        max_line_w = max(
            (Application._hint_text_width(line) for line in lines[pinned_count:] if line != '-DIVIDER-'),
            default=0,
        )
        max_h_scroll = max(0, max_line_w - inner_w)
        h_scroll = max(0, min(h_scroll, max_h_scroll))

        col0 = max(0, (width  - box_w)          // 2)
        row0 = max(0, (height - box_h_available) // 2)

        border_attr = curses.A_BOLD

        # Top border — embed scroll indicators when content doesn't fully fit.
        if row0 < height:
            parts = []
            if max_scroll > 0:
                line_first = scroll_offset + 1
                line_last  = scroll_offset + adj_visible
                parts.append(f'↑↓ {line_first}-{line_last}/{len(lines) - pinned_count}')
            if max_h_scroll > 0:
                parts.append(f'←→ {h_scroll + 1}-{h_scroll + inner_w}/{max_line_w}')
            if parts:
                indicator = ' ' + '  '.join(parts) + ' '
                left_w  = max(0, (inner_w - len(indicator)) // 2)
                right_w = max(0, inner_w - left_w - len(indicator))
                top_border = '┌' + '─' * left_w + indicator + '─' * right_w + '┐'
            else:
                top_border = '┌' + '─' * inner_w + '┐'
            try:
                stdscr.addstr(row0, col0, top_border[:width - col0], border_attr)
            except curses.error:
                pass

        # Pinned rows — always visible at the top, not affected by scroll.
        for j, line in enumerate(lines[:pinned_count]):
            r = row0 + 1 + j
            if r >= height:
                break
            if handle_dividers and line == '-DIVIDER-':
                try:
                    stdscr.addstr(r, col0,
                                  ('├' + '─' * inner_w + '┤')[:width - col0],
                                  border_attr)
                except curses.error:
                    pass
            else:
                try:
                    stdscr.addstr(r, col0, '│', border_attr)
                    text = line[:inner_w].ljust(inner_w)[:inner_w]
                    end_col = self._draw_hint_text(stdscr, r, col0 + 1, text,
                                                   col0 + 1 + inner_w + 1)
                    right_border = col0 + 1 + inner_w
                    if end_col < right_border:
                        stdscr.addstr(r, end_col, ' ' * (right_border - end_col))
                    if right_border < width:
                        stdscr.addstr(r, right_border, '│', border_attr)
                except curses.error:
                    pass

        # Scrollable content rows
        visible_lines = lines[pinned_count + scroll_offset:
                              pinned_count + scroll_offset + adj_visible]
        for i, line in enumerate(visible_lines):
            r = row0 + 1 + pinned_count + i
            if r >= height:
                break
            abs_line_idx = pinned_count + scroll_offset + i
            if handle_dividers and line == "-DIVIDER-":
                try:
                    stdscr.addstr(r, col0,
                                  ('├' + '─' * inner_w + '┤')[:width - col0],
                                  border_attr)
                except curses.error:
                    pass
            else:
                try:
                    stdscr.addstr(r, col0, '│', border_attr)
                    # Apply horizontal scroll: slice the line before display.
                    sliced = line[h_scroll:h_scroll + inner_w]
                    # Show … when content is cut on the right
                    if len(line) > h_scroll + inner_w:
                        sliced = sliced[:inner_w - 1] + '…'
                    text = sliced.ljust(inner_w)[:inner_w]
                    # Cursor row in settings overlay: highlight whole line
                    if selected_line is not None and abs_line_idx == selected_line:
                        stdscr.addstr(r, col0 + 1, text, curses.A_BOLD | curses.A_REVERSE)
                        end_col = col0 + 1 + len(text)
                    else:
                        end_col = self._draw_hint_text(stdscr, r, col0 + 1, text,
                                                       col0 + 1 + inner_w + 1)
                    right_border = col0 + 1 + inner_w
                    if end_col < right_border:
                        stdscr.addstr(r, end_col, ' ' * (right_border - end_col))
                    if right_border < width:
                        stdscr.addstr(r, right_border, '│', border_attr)
                    # Highlight search match substring via chgat (overwrites attrs
                    # in-place, so markup colouring from _draw_hint_text is preserved
                    # for non-matching characters).
                    if search_query and match_set and abs_line_idx in match_set:
                        # Strip \[ escapes to get the display text for position lookup.
                        plain = line.replace('\\[', '[').replace('\\]', ']')
                        pos = plain.lower().find(search_query.lower())
                        if pos >= 0:
                            # Adjust position for horizontal scroll offset
                            vis_pos = pos - h_scroll
                            if 0 <= vis_pos < inner_w:
                                hl_col = col0 + 1 + vis_pos
                                hl_len = min(len(search_query), inner_w - vis_pos)
                                hl_attr = (curses.A_REVERSE | curses.A_BOLD
                                           if abs_line_idx == current_match
                                           else curses.A_REVERSE)
                                try:
                                    stdscr.chgat(r, hl_col, hl_len, hl_attr)
                                except curses.error:
                                    pass
                except curses.error:
                    pass

        # Bottom border — replaced by search bar when active
        r = row0 + 1 + visible_count
        if r < height:
            try:
                if search_bar is not None:
                    bar = ('/' + search_bar).ljust(inner_w)[:inner_w]
                    stdscr.addstr(r, col0, '└', border_attr)
                    stdscr.addstr(r, col0 + 1, bar, curses.A_REVERSE | curses.A_BOLD)
                    if col0 + 1 + inner_w < width:
                        stdscr.addstr(r, col0 + 1 + inner_w, '┘', border_attr)
                else:
                    stdscr.addstr(r, col0,
                                  ('└' + '─' * inner_w + '┘')[:width - col0],
                                  border_attr)
            except curses.error:
                pass

        return scroll_offset, h_scroll

    _TAB_NAMES = ('Interactive', 'Hosts file', 'Example', 'Commands', 'Bindings', 'Settings')

    def _build_tab_header_line(self):
        """Build the tab bar line for the top of the help overlay."""
        parts = []
        for i, name in enumerate(self._TAB_NAMES):
            if i == self.help_tab:
                parts.append(f'[{i + 1}:tabactive {name}]')
            else:
                parts.append(f'[{i + 1} {name}]')
        return '  ' + ' '.join(parts)

    # Number of lines always pinned at the top of the help overlay (tab bar + divider).
    _HELP_PINNED = 2

    def _build_tab_lines(self):
        """Return content lines for the current help tab.

        The first _HELP_PINNED lines are always shown at the top regardless of
        scroll position: [tab bar+nav, -DIVIDER-].  The remaining lines
        are the tab-specific scrollable content.
        """
        header = self._build_tab_header_line()
        header += ' [Tab]/[S-Tab] ↔ tab'

        if self.help_tab == 5:  # Settings
            lines = self._build_settings_lines()
            # Shift _settings_line_map keys by _HELP_PINNED (header + '-DIVIDER-').
            self._settings_line_map = {
                k + self._HELP_PINNED: v for k, v in self._settings_line_map.items()
            }
            return [header, '-DIVIDER-'] + lines

        if self.help_tab == 4:  # Bindings
            lines = self._build_all_bindings_lines()
            return [header, '-DIVIDER-'] + lines

        if self.help_tab == 2:  # Example
            example_lines = _EXAMPLE_HELP.rstrip('\n').splitlines()
            return [header, '-DIVIDER-'] + example_lines

        if self.help_tab == 3:  # Commands
            lines = _join_help_fragments(_HELP_CMDS_INTERACTIVE, _HELP_CMDS_HOSTSFILE)
            return [header, '-DIVIDER-'] + lines

        if self.help_tab == 1:  # Hosts file
            lines = _join_help_fragments(
                _HELP_SYNTAX, _HELP_EXPANSION, _HELP_BINDINGS, _HELP_CMDS_HOSTSFILE,
            )
            return [header, '-DIVIDER-'] + lines

        # Tab 0: Interactive
        lines = _join_help_fragments(
            _HELP_LEGEND, _HELP_HOTKEYS, _HELP_SEARCH, _HELP_FOLDING,
            _HELP_CMDS_INTERACTIVE, _HELP_SSH,
        )
        # Append custom user bindings (with --desc) at the end
        by_mode = {}
        for _keys, b in self._key_trie:
            if b.origin == 'user' and b.desc:
                by_mode.setdefault(b.mode or 'normal', []).append(
                    (b.key_notation, b.desc))
        if by_mode:
            lines.append('-DIVIDER-')
            lines.append('─ Custom bindings ─')
            for mode in sorted(by_mode):
                entries = by_mode[mode]
                if entries:
                    lines.append(f'  {mode} mode')
                    for notation, desc in entries:
                        lines.append(f'    {notation:<10} {desc}')

        return [header, '-DIVIDER-'] + lines

    def _update_help_search(self):
        """Recompute help_search_matches from help_search and scroll to first match."""
        q = self.help_search.lower()
        if not q:
            self.help_search_matches = []
            self.help_search_match_idx = 0
            return
        lines = self._build_tab_lines()
        pinned = self._HELP_PINNED
        self.help_search_matches = [
            i for i, line in enumerate(lines)
            if i >= pinned and line != '-DIVIDER-' and q in line.lower()
        ]
        self.help_search_match_idx = 0
        if self.help_search_matches:
            self._help_search_scroll_to_current()
            if self.help_tab == 5:
                self._sync_settings_cursor_to_match()

    def _help_search_jump(self, direction):
        """Move to next (+1) or previous (-1) help search match."""
        if not self.help_search_matches:
            return
        n = len(self.help_search_matches)
        self.help_search_match_idx = (self.help_search_match_idx + direction) % n
        self._help_search_scroll_to_current()
        if self.help_tab == 5:
            self._sync_settings_cursor_to_match()

    def _sync_settings_cursor_to_match(self):
        """Update settings_cursor to the param containing the current search match."""
        if not self.help_search_matches:
            return
        target = self.help_search_matches[self.help_search_match_idx]
        for line_idx in range(target, -1, -1):
            if line_idx in self._settings_line_map:
                self.settings_cursor = self._settings_line_map[line_idx]
                return

    def _help_search_scroll_to_current(self):
        """Scroll the help overlay so the current match is near the top."""
        if not self.help_search_matches:
            return
        target = self.help_search_matches[self.help_search_match_idx]
        # target is an index in the full lines list; scroll is relative to scrollable portion.
        self.help_scroll = max(0, (target - self._HELP_PINNED) - 3)

    def _draw_whichkey_overlay(self, stdscr, height, width):
        """Draw a small which-key popup listing continuations for _key_seq.

        Appears at the bottom-right of the screen (just above the menu bar).
        Each child key of the current trie node is shown with its description.
        """
        node = self._key_trie.node_at(self._key_seq)
        if not node or not node.children:
            return

        ctx_keys = set(self._binding_context().keys())
        prefix_label = _format_key_notation(self._key_seq)

        # Header line + one row per available next key
        lines = [f"  [{prefix_label}] — choose next key"]
        for key_code in sorted(node.children):
            child = node.children[key_code]
            key_label = _format_key_notation([key_code])
            binding = _resolve_binding(child.bindings.get('normal', {}), ctx_keys)
            if binding:
                cmd_str = '(' + ' \\; '.join(binding.commands) + ')'
                desc = binding.desc or binding.hint or ''
                line = f"  [{key_label}]  {cmd_str}"
                if desc:
                    line += f"  {desc}"
            else:
                line = f"  [{key_label}]  …"   # prefix-only node
            lines.append(line)

        inner_w = max(len(l) for l in lines)
        inner_w = max(inner_w, 20)
        inner_w = min(inner_w, width - 4)
        box_w = inner_w + 2

        # Limit height so the popup fits above the menu bar
        max_lines = max(1, height - 2 - 2)  # leave top border + bottom border + menu
        lines = lines[:max_lines]
        box_h = len(lines) + 2

        # Position: bottom-right, just above menu bar
        row0 = max(0, height - 1 - box_h)
        col0 = max(0, width - box_w - 1)

        border_attr = curses.A_BOLD

        # Top border
        try:
            stdscr.addstr(row0, col0,
                          ('┌' + '─' * inner_w + '┐')[:width - col0], border_attr)
        except curses.error:
            pass

        # Content rows
        for i, line in enumerate(lines):
            r = row0 + 1 + i
            if r >= height - 1:
                break
            text = line.ljust(inner_w)[:inner_w]
            try:
                stdscr.addstr(r, col0, '│', border_attr)
                self._draw_hint_text(stdscr, r, col0 + 1, text,
                                     col0 + 1 + inner_w + 1)
                if col0 + 1 + inner_w < width:
                    stdscr.addstr(r, col0 + 1 + inner_w, '│', border_attr)
            except curses.error:
                pass

        # Bottom border
        r = row0 + 1 + len(lines)
        if r < height - 1:
            try:
                stdscr.addstr(r, col0,
                              ('└' + '─' * inner_w + '┘')[:width - col0], border_attr)
            except curses.error:
                pass

    def _draw_help_overlay(self, stdscr, height, width):
        """Draw the help overlay as a centered bordered popup with scroll support.

        Six tabs (Interactive/Hosts/Example/Commands/Bindings/Settings) built by
        _build_tab_lines().  Tab navigation via [Tab]/[S-Tab] or number keys.
        Press [/] to search within the current tab.
        """
        self._settings_content_width = max(20, width - 4)
        lines = self._build_tab_lines()

        # Search state for display
        current_match = None
        if self.help_search_matches:
            current_match = self.help_search_matches[self.help_search_match_idx]

        search_bar = None
        if self.help_search or self.help_search_active:
            n = len(self.help_search_matches)
            if self.help_search:
                count_str = f' {self.help_search_match_idx + 1}/{n}' if n else ' (no match)'
            else:
                count_str = ''
            cursor_ch = '█' if self.help_search_active else ''
            search_bar = f'{self.help_search}{cursor_ch}{count_str}'

        # In settings mode, compute the cursor line to pass to the overlay renderer
        selected_line = None
        pinned = self._HELP_PINNED
        if self.help_tab == 5:
            selected_line = self._settings_param_line(self.settings_cursor)
            # Deferred scroll-to-cursor after _open_settings_overlay set cursor
            if getattr(self, '_settings_scroll_to_cursor', False):
                self._settings_scroll_to_cursor = False
                if selected_line is not None:
                    box_h_est = min(len(lines) + 2, height)
                    adj_vis = max(1, box_h_est - 2 - pinned)
                    adj_sel = selected_line - pinned
                    if adj_sel < self.help_scroll:
                        self.help_scroll = adj_sel
                    elif adj_sel >= self.help_scroll + adj_vis:
                        self.help_scroll = adj_sel - adj_vis + 1

        ideal_w = max(
            (Application._hint_text_width(line) for line in lines if line != "-DIVIDER-"),
            default=20,
        )
        inner_w = min(ideal_w, max(20, width - 4))
        self.help_scroll, self.help_h_scroll = self._draw_overlay_box(
            stdscr, height, width, lines, self.help_scroll, inner_w,
            handle_dividers=True,
            search_bar=search_bar,
            match_set=set(self.help_search_matches) if self.help_search_matches else None,
            current_match=current_match,
            search_query=self.help_search,
            h_scroll=self.help_h_scroll,
            selected_line=selected_line,
            pinned_count=pinned,
        )
        # Store visible count for scroll-to-cursor in _cmd_settings_cursor
        box_h = min(len(lines) + 2, height)
        self._help_visible_count = max(0, box_h - 2 - pinned)

    def _build_settings_lines(self, content_width=72):
        """Build lines for the settings overlay tab as a 4-column table.

        Columns:  Setting  |  Current  |  Values  |  Description
        Column widths are computed from actual data so content is never
        truncated here — the overlay box handles horizontal clipping and
        h-scroll lets the user reveal hidden columns.
        Also rebuilds self._settings_line_map: {line_index -> SET_PARAMS index}.
        """
        max_name = max(len(p.name) for p in SET_PARAMS)
        C1 = len(':set ') + max_name   # e.g. 21: ':set autofold-delay'
        sep = '  '

        # Compute natural column widths from actual data (no truncation).
        cur_vals, vals_strs = [], []
        for p in SET_PARAMS:
            cur_vals.append(p.get_current(self))
            v = p.get_values()
            vals_strs.append('<free-form>' if isinstance(v, str) else ' | '.join(v))
        C2 = max(len(s) for s in cur_vals)
        C3 = max(len(s) for s in vals_strs)

        line_map = {}
        lines = [
            "  [↑/↓] navigate  [Space] cycle value  [Enter] edit  [/] search",
            "-DIVIDER-",
            f"  {'Setting':<{C1}}{sep}{'Current':<{C2}}{sep}{'Values':<{C3}}{sep}Description",
            "-DIVIDER-",
        ]

        for i, (param, cur, vals_str) in enumerate(zip(SET_PARAMS, cur_vals, vals_strs)):
            row = (f"  {(':set ' + param.name):<{C1}}{sep}"
                   f"{cur:<{C2}}{sep}"
                   f"{vals_str:<{C3}}{sep}"
                   f"{param.help}")
            line_map[len(lines)] = i
            lines.append(row)

        self._settings_line_map = line_map
        return lines

    def _build_all_bindings_lines(self):
        """Build auto-generated lines listing every key binding (all origins)."""
        # Group bindings by mode; multi-mode bindings appear in each mode section
        by_mode = {}
        for keys, b in self._key_trie:
            for m in b.mode.split(','):
                m = m.strip()
                by_mode.setdefault(m, []).append((b.key_notation, b.commands,
                                                  b.context, b.origin))

        lines = []
        all_modes = sorted(by_mode, key=lambda m: (m != 'normal', m))
        for mode in all_modes:
            lines.append(f"  {mode} mode")
            seen = set()
            for notation, commands, context, origin in by_mode[mode]:
                ctx_str = _format_context(context)
                dedup_key = (notation, tuple(commands), ctx_str)
                if dedup_key in seen:
                    continue
                seen.add(dedup_key)
                cmds = ' \\; '.join(commands)
                origin_tag = '' if origin == 'default' else '  [user]'
                lines.append(f"    {ctx_str}{notation:<12} → {cmds}{origin_tag}")
            lines.append('-DIVIDER-')
        if lines and lines[-1] == '-DIVIDER-':
            lines.pop()
        return lines

    def _draw_details_overlay(self, stdscr, height, width):
        """Draw the host details overlay as a centered bordered popup.

        Displays comprehensive statistics for self.details_monitor:
          - Host name / IP address
          - Current status (up/down) and last latency
          - Uptime / downtime duration
          - Packet statistics (RX, TX, XX, Loss%)
          - Latency statistics (Min, Max, Avg, StDev)
          - Total pings sent

        The overlay is closed by pressing Enter, q, Q, or Esc (handled in run()).
        """
        if self.details_monitor is None:
            return

        monitor = self.details_monitor

        # Collect stats once at the start to ensure consistency
        with monitor.lock:
            lat_count = monitor._lat_count
            lat_avg   = monitor._lat_mean if lat_count else None
            lat_min   = monitor._lat_min  if lat_count else None
            lat_max   = monitor._lat_max  if lat_count else None
            lat_stdev = (math.sqrt(monitor._lat_m2 / lat_count)
                         if lat_count >= 2 else None)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count
            last = monitor.latency
            alive = monitor.alive
            error = monitor.error

        dns_mode = DNS_MODES[self.dns_mode]
        display_name = monitor.get_display_name(dns_mode)
        if hasattr(monitor, '_build_ping_cmd'):
            raw_cmd_str = shlex.join(monitor._build_ping_cmd())
        else:
            raw_cmd_str = ""
        raw_error_str = error if error is not None else ""

        # Collect host events FIRST — needed to compute ideal overlay width.
        host_events = []
        log_name = monitor.get_display_name(dns_mode='off')
        for event in self.events:
            parts = event.text.split('   ', 1)
            if len(parts) == 2:
                if f" {log_name} " in event.text or event.text.startswith(f"{parts[0]}   {log_name}"):
                    host_events.append(event.text)

        # Calculate dynamic width
        ideal_w = 60
        ideal_w = max(ideal_w, len(f"  Host: {display_name}") + 2)
        ideal_w = max(ideal_w, len(f"  Cmd:  {raw_cmd_str}") + 2)
        if error:
            ideal_w = max(ideal_w, len(f"  Error:  {raw_error_str}") + 2)
        # Expand to fit the widest event line (indented by 4) without wrapping.
        if host_events:
            max_ev_w = max(len(f"    {ev}") for ev in host_events[-50:])
            ideal_w = max(ideal_w, max_ev_w)

        # Constrain to terminal width (leave margin of 4, box borders need 2)
        max_allowed_w = max(20, width - 4)
        inner_w = min(ideal_w, max_allowed_w)

        # Build content lines
        lines = []
        lines.append(f"  Host: {display_name}")

        cmd_wrap_w = max(10, inner_w - 8)
        wrapped_cmd = textwrap.wrap(raw_cmd_str, width=cmd_wrap_w)
        if wrapped_cmd:
            lines.append(f"  Cmd:  {wrapped_cmd[0]}")
            for w_line in wrapped_cmd[1:]:
                lines.append(f"        {w_line}")
        else:
            lines.append(f"  Cmd:  -")

        # Connect status for this host (via :prog-options ssh rules)
        conn_disabled, conn_opts = self._match_prog_options(
            'ssh', monitor.host,
            getattr(monitor, 'resolved_hostname', None) or '')
        if conn_disabled:
            lines.append(f"  Connect: disabled")
        else:
            r = (monitor.resolved_ip
                 if getattr(monitor, 'resolv_static', False) and monitor.resolved_ip
                 else monitor.host)
            conn_str = f"ssh {conn_opts + ' ' if conn_opts else ''}{r}"
            conn_wrap_w = max(10, inner_w - 12)
            wrapped_conn = textwrap.wrap(conn_str, width=conn_wrap_w)
            lines.append(f"  Connect: {wrapped_conn[0] if wrapped_conn else '-'}")
            for w_line in (wrapped_conn[1:] if wrapped_conn else []):
                lines.append(f"           {w_line}")

        lines.append("─" * inner_w)

        # Status
        if error is not None:
            lines.append(f"  Status: ERROR")
            err_wrap_w = max(10, inner_w - 10)
            wrapped_err = textwrap.wrap(raw_error_str, width=err_wrap_w)
            if wrapped_err:
                lines.append(f"  Error:  {wrapped_err[0]}")
                for e_line in wrapped_err[1:]:
                    lines.append(f"          {e_line}")
            else:
                lines.append(f"  Error:  -")
        elif alive is True:
            lines.append(f"  Status: UP")
            if monitor.up_since is not None:
                uptime = time.monotonic() - monitor.up_since
                lines.append(f"  Uptime: {_format_updown_time(uptime)}")
        elif alive is False:
            lines.append(f"  Status: DOWN")
            if monitor.down_since is not None:
                downtime = time.monotonic() - monitor.down_since
                lines.append(f"  Downtime: {_format_updown_time(downtime)}")
        else:
            lines.append(f"  Status: UNKNOWN")

        lines.append("")

        # Current latency
        if last is not None:
            lines.append(f"  Last RTT: {last:.2f} ms")
        else:
            lines.append(f"  Last RTT: -")

        lines.append("")

        # Packet statistics
        lines.append("  Packet Statistics:")
        lines.append(f"    Total sent (TX): {tx}")
        lines.append(f"    Received (RX):   {rx}")
        lines.append(f"    Lost (XX):       {xx}")

        total = rx + xx
        if total > 0:
            loss_pct = (xx / total) * 100
            lines.append(f"    Loss rate:       {loss_pct:.2f}%")
        else:
            lines.append(f"    Loss rate:       -")

        lines.append("")

        # Latency statistics
        lines.append("  Latency Statistics:")
        if lat_count:
            lines.append(f"    Min:     {lat_min:.2f} ms")
            lines.append(f"    Max:     {lat_max:.2f} ms")
            lines.append(f"    Average: {lat_avg:.2f} ms")
            lines.append(f"    StdDev:  {lat_stdev:.2f} ms" if lat_stdev is not None
                         else f"    StdDev:  -")
        else:
            lines.append(f"    Min:     -")
            lines.append(f"    Max:     -")
            lines.append(f"    Average: -")
            lines.append(f"    StdDev:  -")

        lines.append("")

        if host_events:
            lines.append("  Recent Events:")
            for ev in host_events[-50:]:
                indented = f"    {ev}"
                if len(indented) <= inner_w:
                    lines.append(indented)
                else:
                    ev_wrap_w = max(10, inner_w - 4)
                    for e_line in textwrap.wrap(ev, width=ev_wrap_w):
                        lines.append(f"    {e_line}")
            lines.append("")

        if not conn_disabled:
            lines.append("  [c] SSH connect")
        lines.append("  [Enter/q/Esc] Close  [↑/↓/PgUp/PgDn] Scroll  [←/→/h/l] H-Scroll")

        self.details_scroll, self.details_h_scroll = self._draw_overlay_box(
            stdscr, height, width, lines, self.details_scroll, inner_w,
            h_scroll=self.details_h_scroll,
        )

    def _register_shift_tab_seqs(self):
        """Register Shift+Tab escape sequences as KEY_BTAB with ncurses.

        Terminals differ in what they send for Shift+Tab:
          \\x1b[Z         — standard VT100 / xterm (terminfo: kcbt)
          \\x1b[27;2;9~   — XTerm modifyOtherKeys / kitty

        curses only translates \\x1b[Z when the active terminfo entry has 'kcbt';
        many terminals (tmux, screen, SSH clients) lack it.  Python's curses
        module also does not expose define_key(), so we call the underlying
        ncurses library directly via ctypes.

        Both paths are best-effort: any failure is silently ignored so a
        missing curses.define_key or unavailable shared library never prevents
        startup.
        """
        _BTAB_SEQS = (b'\x1b[Z', b'\x1b[27;2;9~')
        try:
            for _seq in _BTAB_SEQS:
                curses.define_key(_seq.decode(), curses.KEY_BTAB)
        except AttributeError:
            try:
                import ctypes
                import ctypes.util
                _lib_name = (ctypes.util.find_library('ncursesw')
                             or ctypes.util.find_library('ncurses'))
                if _lib_name:
                    _nclib = ctypes.CDLL(_lib_name)
                    for _seq in _BTAB_SEQS:
                        _nclib.define_key(_seq, curses.KEY_BTAB)
            except (AttributeError, OSError):
                pass  # best-effort; Shift+Tab falls back to no-op on this terminal

    def _register_ctrl_arrow_seqs(self):
        """Register Ctrl+Arrow escape sequences as KEY_SLEFT / KEY_SRIGHT with ncurses.

        Terminals send various escape sequences for Ctrl+Left / Ctrl+Right:
          \\x1b[1;5D  \\x1b[5D  \\x1bOd   — Ctrl+Left (xterm / VTE / tmux variants)
          \\x1b[1;5C  \\x1b[5C  \\x1bOc   — Ctrl+Right

        We reuse KEY_SLEFT / KEY_SRIGHT (Shift+Left/Right) as the ncurses key
        codes because no standard code exists for Ctrl+Arrow, and those slots
        are otherwise unused in this application.

        Best-effort: any failure is silently ignored.
        """
        _CTRL_LEFT_SEQS  = (b'\x1b[1;5D', b'\x1b[5D', b'\x1bOd')
        _CTRL_RIGHT_SEQS = (b'\x1b[1;5C', b'\x1b[5C', b'\x1bOc')
        try:
            for _seq in _CTRL_LEFT_SEQS:
                curses.define_key(_seq.decode(), curses.KEY_SLEFT)
            for _seq in _CTRL_RIGHT_SEQS:
                curses.define_key(_seq.decode(), curses.KEY_SRIGHT)
        except AttributeError:
            try:
                import ctypes
                import ctypes.util
                _lib_name = (ctypes.util.find_library('ncursesw')
                             or ctypes.util.find_library('ncurses'))
                if _lib_name:
                    _nclib = ctypes.CDLL(_lib_name)
                    for _seq in _CTRL_LEFT_SEQS:
                        _nclib.define_key(_seq, curses.KEY_SLEFT)
                    for _seq in _CTRL_RIGHT_SEQS:
                        _nclib.define_key(_seq, curses.KEY_SRIGHT)
            except (AttributeError, OSError):
                pass  # best-effort; Ctrl+Arrow falls back to no-op on this terminal

    def run(self, stdscr):
        """Main application loop"""
        # Initialize curses
        curses.curs_set(0)
        stdscr.nodelay(1)
        stdscr.timeout(100)
        # Reduce ESC key delay from default 1000ms to 25ms for responsive UI
        curses.set_escdelay(25)

        self._register_shift_tab_seqs()
        self._register_ctrl_arrow_seqs()

        # Initialize colors
        curses.start_color()
        curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)    # Success
        curses.init_pair(2, curses.COLOR_RED, curses.COLOR_BLACK)      # Failure
        curses.init_pair(3, curses.COLOR_YELLOW, curses.COLOR_BLACK)   # Warning (slow)
        curses.init_pair(4, curses.COLOR_WHITE, curses.COLOR_BLACK)    # Hotkey
        curses.init_pair(5, curses.COLOR_MAGENTA, curses.COLOR_BLACK)  # Very slow (>100 ms)
        curses.init_pair(6, curses.COLOR_CYAN, curses.COLOR_BLACK)     # Paused

        self.start_monitoring()

        # Pre-select a host requested via --select (e.g. after a mux relaunch)
        if self.startup_select:
            for i, entry in enumerate(self.entries):
                if isinstance(entry, Monitor) and entry.host == self.startup_select:
                    self.highlighted_index = i
                    break
            self.startup_select = None

        if self.kiosk_mode and not shutil.which('vlock') and not shutil.which('physlock'):
            self.add_event("warn",
                "kiosk: vlock/physlock not found — idle lock-after-time will not work; "
                "install vlock or physlock to enable session locking")

        try:
            while self.running:
                stdscr.erase()
                height, width = stdscr.getmaxyx()

                # Adaptive layout: menu at bottom (height-1), hosts fill from top
                num_hosts = len(self.entries)

                # Column header at row 0 if there is room for at least one host row too
                show_header = height >= 3  # header(1) + host(1) + menu(1)
                hosts_start = 0

                # Host rows fill from hosts_start up to (but not including) the menu row.
                # When the column header is shown it occupies one extra row, so the
                # number of data rows is one less than the total space available.
                header_rows = 1 if show_header else 0
                n_banners = sum(1 for _ in self._mode_banners())
                visible_hosts = min(num_hosts, max(0, height - 1 - header_rows - n_banners))

                # Events get whatever space remains between hosts and the menu row
                section_end = hosts_start + (1 if show_header else 0) + visible_hosts
                events_start = section_end + 1
                self._log_page_size = max(1, height - 1 - events_start - 2)
                show_events = events_start + 2 <= height - 1  # must fit before menu row

                # Draw host list
                self.clamp_host_scroll(visible_hosts)
                self._autofold_tick()
                self.draw_hosts(stdscr, hosts_start, visible_hosts, width, height,
                                show_header=show_header)
                if show_events:
                    self.draw_events(stdscr, events_start, height - 1, width)

                # Bottom row: menu OR command OR prompt (mutually exclusive)
                if self.cmd is not None:
                    self._draw_cmd(stdscr, height, width)
                    curses.curs_set(1)
                elif self.prompt is not None:
                    self._draw_prompt(stdscr, height, width)
                    curses.curs_set(1)
                else:
                    if self._status_msg and time.time() < self._status_msg['expires']:
                        msg = self._status_msg['text']
                        try:
                            stdscr.addstr(height - 1, 0,
                                          msg.ljust(width - 1)[:width - 1],
                                          curses.A_REVERSE)
                        except curses.error:
                            pass
                    else:
                        self._status_msg = None
                        self.draw_menu_bar(stdscr, height, width)
                    curses.curs_set(0)

                # Help overlay drawn last so it floats above everything else
                if self.help_open:
                    self._draw_help_overlay(stdscr, height, width)
                    curses.curs_set(0)

                # Details overlay drawn on top of everything, including help
                if self.details_open:
                    self._draw_details_overlay(stdscr, height, width)
                    curses.curs_set(0)

                # Pending-key indicator: show which-key popup when there are
                # continuations, otherwise just a small corner indicator.
                if self._key_seq:
                    node = self._key_trie.node_at(self._key_seq)
                    if node and node.children:
                        self._draw_whichkey_overlay(stdscr, height, width)
                    else:
                        indicator = f"[{_format_key_notation(self._key_seq)}]"
                        try:
                            stdscr.addstr(height - 1, width - len(indicator) - 1,
                                          indicator, curses.A_REVERSE)
                        except curses.error:
                            pass

                try:
                    stdscr.refresh()
                except KeyboardInterrupt:
                    self._cmd_quit('--confirm')
                    continue

                # Handle input — map Ctrl+C (KeyboardInterrupt) to key code 3
                # so modal layers can handle it uniformly as "cancel / dismiss".
                try:
                    key = stdscr.getch()
                except KeyboardInterrupt:
                    key = 3
                if self.help_open:
                    if key == 3:  # Ctrl+C always closes overlays
                        self.help_open = False
                        self.help_search_active = False
                        self._current_mode = 'normal'
                    elif self.help_search_active:
                        if key in (curses.KEY_BACKSPACE, 127, 8):
                            self.help_search = self.help_search[:-1]
                            self._update_help_search()
                        elif key in (ord('\n'), ord('\r'), curses.KEY_ENTER, ord('/')):
                            self.help_search_active = False  # confirm, keep highlights
                        elif key == 27:  # Esc — cancel search, restore scroll
                            self.help_search = ''
                            self.help_search_active = False
                            self.help_search_matches = []
                            self.help_search_match_idx = 0
                            self.help_scroll = self._help_search_pre_scroll
                        elif 32 <= key <= 126:  # printable
                            self.help_search += chr(key)
                            self._update_help_search()
                    else:
                        if key == ord(':'):
                            self.help_open = False
                            self.help_search_active = False
                            self._current_mode = 'normal'
                            self._open_cmd_line()
                        elif key == ord('/'):
                            self.help_search_active = True
                            self._help_search_pre_scroll = self.help_scroll
                        elif self.help_search and key == ord('n'):
                            self._help_search_jump(+1)
                        elif self.help_search and key == ord('N'):
                            self._help_search_jump(-1)
                        elif self.help_tab == 5 and key in (curses.KEY_UP, ord('k')):
                            self._cmd_settings_cursor('up')
                        elif self.help_tab == 5 and key in (curses.KEY_DOWN, ord('j')):
                            self._cmd_settings_cursor('down')
                        elif self.help_tab == 5 and key == ord(' '):
                            self._cmd_settings_apply()
                        elif self.help_tab == 5 and key in (ord('\n'), ord('\r'), curses.KEY_ENTER):
                            self._cmd_settings_edit()
                        elif not self._dispatch_overlay_nav_key(key):
                            self._dispatch_mode_key('help', key)
                    continue
                if self.details_open:
                    if key == 3:  # Ctrl+C always closes overlays
                        self.details_open = False
                        self.details_monitor = None
                        self._current_mode = 'normal'
                        continue
                    if key == ord(':'):
                        self.details_open = False
                        self.details_monitor = None
                        self._current_mode = 'normal'
                        self._open_cmd_line()
                        continue
                    was_open = self.details_open
                    if not self._dispatch_overlay_nav_key(key):
                        self._dispatch_mode_key('details', key)
                    if was_open and not self.details_open and key == ord('c'):
                        pass  # fall through to normal trie dispatch
                    else:
                        continue
                if self.cmd is not None:
                    if key != -1:
                        self._handle_cmd_key(key)
                    continue
                if self.prompt is not None:
                    if key != -1:
                        self._handle_prompt_key(key)
                    continue
                # ── trie-based key dispatch ────────────────────────────────
                if key == -1:
                    # No key pressed — but if we're mid-sequence, keep waiting
                    if self._key_seq:
                        pass
                    continue
                # Infrastructure keys that always bypass the trie
                if key == ord(':'):
                    self._open_cmd_line()
                    continue
                if key == 3:  # Ctrl+C — quit confirmation (re-press pattern)
                    self._key_seq = []
                    self._cmd_quit('--confirm')
                    continue
                # ── Trie lookup with context resolution ───────────────────
                ctx_keys = set(self._binding_context().keys())
                self._key_seq.append(key)
                binding, has_more = self._key_trie.resolve(
                    self._key_seq, ctx_keys)

                if binding and not has_more:
                    # Exact match, no longer prefixes — execute immediately
                    self._execute_binding(binding)
                    self._key_seq = []
                elif binding and has_more:
                    # Ambiguous: node has both a binding and children
                    if self.multikey_timeout > 0:
                        stdscr.timeout(self.multikey_timeout)
                        next_key = stdscr.getch()
                        stdscr.timeout(100)
                        if next_key == -1:
                            # Timeout expired, no follow-up key — execute
                            self._execute_binding(binding)
                            self._key_seq = []
                        else:
                            # Got a follow-up key — continue trie walk
                            self._key_seq.append(next_key)
                    else:
                        # timeout=0: always wait for the next key
                        pass  # _key_seq stays populated → indicator shows
                elif has_more:
                    # Prefix of longer sequences, no binding here — wait
                    pass  # _key_seq stays populated → indicator shows
                else:
                    # No match at all
                    if len(self._key_seq) > 1:
                        # Bad multi-key sequence — retry the last key alone
                        last = self._key_seq[-1]
                        self._key_seq = []
                        # Re-process as a single key by injecting via ungetch
                        curses.ungetch(last)
                    else:
                        # Single unknown key — ignore
                        self._key_seq = []

        finally:
            for monitor in self.monitors:
                monitor.stop()

def _parse_args():
    """Parse command-line arguments outside of curses so errors print cleanly.

    When invoked with no arguments (no hosts and no -f/--file), the usage/help
    is printed and the program exits immediately — curses is never started.
    Press '?' inside the running app for the full keyboard reference.
    """
    import argparse
    parser = argparse.ArgumentParser(
        prog=_PROG_NAME,
        description='Monitor multiple hosts with continuous ping.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""\
examples:
  {_PROG_NAME} 8.8.8.8 1.1.1.1
  {_PROG_NAME} -f hosts.txt
  {_PROG_NAME} -l events.log 8.8.8.8 192.168.1.{{1..10}}

hosts file format:
  # comment line (ignored)
  ## Title              — level-1 section header (also :title Title)
  ### Sub-title         — level-2 section header (also :title2 Title)
  #### Sub-sub-title    — level-3 section header (also :title3 Title)
  10.0.0.1 ## label     — inline label; ## / ### / #### treated as comment
  :title Title          — same as ##; :title2 = ###; :title3 = ####
  10.0.0.1                  — host or IP to ping
  10.0.0.{{1..5}}             — brace range expansion (5 hosts)
  :resolv <ip> <hostname>   — static DNS override
  :remote-ping [ssh-opts] <relay> <target> — ping via SSH (run on relay host)
  :with remote-ping [ssh-opts] <relay>     — open block (plain lines → :remote-ping commands)
  :with prog-options <prog>                — open block (plain lines → :prog-options rules)
  :end                                     — close :with, :for, or :if block

press '?' inside the app for the full keyboard reference.\
""",
    )

    # Dynamically add arguments from CMD_REGISTRY
    for cmd in CMD_REGISTRY:
        if cmd.cli_flags:
            parser.add_argument(*cmd.cli_flags, **(cmd.cli_kwargs or {}))

    parser.add_argument('hosts', nargs='*', metavar='HOST', help='hosts/IPs to ping')
    parser.add_argument('--kiosk', action='store_true',
                        help='run in kiosk mode: auto-launch tmux, restrict commands, use rnano/rvim')
    parser.add_argument('--select', metavar='HOST', dest='select_host',
                        help=argparse.SUPPRESS)  # internal: pre-select a host by name at startup
    parser.add_argument('--log-level', metavar='LEVEL', dest='log_level',
                        choices=['quiet', 'normal', 'info', 'debug', 'trace'],
                        help='event log verbosity: quiet normal info debug trace (default: normal)')
    parser.add_argument('-v', dest='verbose', action='count', default=0,
                        help='increase log verbosity (-v info, -vv debug)')
    parser.add_argument('-q', dest='quiet', action='count', default=0,
                        help='decrease log verbosity (-q quiet)')
    parser.add_argument('--help-full',    action='store_true',
                        help='show full manual and exit')
    parser.add_argument('--help-example', action='store_true',
                        help='show full advanced example and exit')
    args = parser.parse_args()

    if args.help_full:
        all_lines = _join_help_fragments(
            _HELP_LEGEND, _HELP_HOTKEYS, _HELP_SEARCH, _HELP_FOLDING,
            _HELP_CMDS_INTERACTIVE, _HELP_SSH,
            _HELP_SYNTAX, _HELP_EXPANSION, _HELP_BINDINGS, _HELP_CMDS_HOSTSFILE,
        )
        for line in all_lines:
            if line == '-DIVIDER-':
                print('  ' + '-' * 20)
            else:
                print(_strip_hint_markup(line))
        sys.exit(0)

    if args.help_example:
        print(_EXAMPLE_HELP, end='')
        sys.exit(0)

    if not args.hosts and not args.file:
        parser.print_help()
        sys.exit(0)
    return args


def main(stdscr, args):
    entries = []

    # Load entries from each -f file in order, then append positional hosts
    for fpath in (args.file or []):
        try:
            entries.extend(parse_hosts_file(fpath))
        except OSError as e:
            print(f"{_PROG_NAME}: cannot open '{fpath}': {e}", file=sys.stderr)
            return

    seen_cli_hosts = set()
    for host in args.hosts:
        if host.startswith(':'):
            entries.append(('cmd', host))
        else:
            try:
                expanded = _expand_host(host)
            except ValueError as e:
                entries.append(('error', str(e)))
            else:
                for h in expanded:
                    if h in seen_cli_hosts:
                        entries.append(('warn', f"duplicate host ignored: {h}"))
                    else:
                        seen_cli_hosts.add(h)
                        entries.append(('host', h))

    if not entries:
        print(f"{_PROG_NAME}: no hosts to monitor", file=sys.stderr)
        return

    app = Application(entries, log_file=args.log_file)
    app.hosts_file = args.file[-1] if args.file else None
    app.kiosk_mode = bool(args.kiosk)
    app.startup_select = args.select_host or None

    # Resolve log level: --log-level base, then +verbose/-quiet offset
    _level_names = {'quiet': LEVEL_QUIET, 'normal': LEVEL_NORMAL,
                    'info': LEVEL_INFO, 'debug': LEVEL_DEBUG, 'trace': LEVEL_TRACE}
    base_level = _level_names.get(args.log_level, LEVEL_NORMAL)
    app._set_loglevel(max(LEVEL_QUIET, min(LEVEL_TRACE,
                                           base_level + args.verbose - args.quiet)))

    # Apply any display-mode flags supplied on the command line.
    # These run after _load_config() so they always take precedence over the
    # config file.  Delegate through _dispatch_cmd so validation and cycling
    # logic is identical to the interactive ':cmd value' path.
    if args.dns:
        app._dispatch_cmd(f':set dns {args.dns}')
    if args.stats:
        app._dispatch_cmd(f':set stats {args.stats}')
    if args.sort:
        app._dispatch_cmd(f':set sort {args.sort}')
    if args.ping_view:
        app._dispatch_cmd(f':set ping-view {args.ping_view}')
    if args.sync_history:
        app._dispatch_cmd(f':set sync-history {args.sync_history}')

    app.run(stdscr)

if __name__ == "__main__":
    _args = _parse_args()
    if _args.kiosk:
        # In kiosk mode, auto-relaunch inside tmux if not already inside one
        _tmux = TmuxBackend()
        _screen = ScreenBackend()
        if not _tmux.is_inside() and not _screen.is_inside():
            if _tmux.available():
                _cmd = _tmux.relaunch_cmd(sys.argv, hosts_file=_args.file[-1] if _args.file else None, kiosk_conf=_KIOSK_TMUX_CONF)
                os.execvp(_cmd[0], _cmd)
            elif _screen.available():
                _cmd = _screen.relaunch_cmd(sys.argv, hosts_file=_args.file[-1] if _args.file else None)
                os.execvp(_cmd[0], _cmd)
            # If neither available, fall through and run directly
    curses.wrapper(main, _args)
