# ── Program identity ──────────────────────────────────────────────────────────

def _derive_prog_name(argv=None):
    """Derive the program name from argv[0].

    When argv[0] looks like a Python interpreter (starts with 'python'),
    a test runner ('pytest', '__main__'), or a .py file, the name is taken
    from the *full basename* of the last ``-f`` / ``--file`` argument instead.
    Falls back to ``'ping-bulk'`` when no ``-f`` is present.

    The full basename is used (extension included), so ``-f network.pb``
    yields ``network.pb`` — keeping the name unambiguous and unchanged.

    Examples:
      ``./ping-bulk 8.8.8.8``            → ``ping-bulk``
      ``ping-bulk.evo-lan -f …``         → ``ping-bulk.evo-lan``
      ``python3 ping-bulk 8.8.8.8``      → ``ping-bulk``  (argv[0] is the script)
      ``python3 /usr/bin/ping-bulk``     → ``ping-bulk``
      ``python3 -f network.pb``          → ``network.pb``
      pytest / test import              → ``ping-bulk``   (fallback)
    """
    argv = argv if argv is not None else sys.argv
    argv0 = os.path.basename(argv[0])
    # Treat as "interpreter" when argv[0] looks like Python, a test runner,
    # or '-c' (python -c "code" sets argv[0] to '-c')
    if (argv0.startswith('python') or argv0 in ('pytest', '__main__', '-c')
            or argv0.endswith('.py')):
        for i in range(len(argv) - 1, 0, -1):
            if argv[i] in ('-f', '--file') and i + 1 < len(argv):
                return os.path.basename(argv[i + 1])
            if argv[i].startswith('--file='):
                return os.path.basename(argv[i][7:])
        return 'ping-bulk'
    return argv0


