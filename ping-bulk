    _LOGLEVEL_NAMES = {'quiet': LEVEL_QUIET, 'normal': LEVEL_NORMAL,
                       'info': LEVEL_INFO, 'debug': LEVEL_DEBUG,
                       'trace': LEVEL_TRACE}
    _LOGLEVEL_LABELS = {LEVEL_QUIET: 'quiet', LEVEL_NORMAL: 'normal',
                        LEVEL_INFO: 'info', LEVEL_DEBUG: 'debug',
                        LEVEL_TRACE: 'trace'}

    def _set_loglevel(self, level: int):
        """Set loglevel and update the module-level exec-trace sink."""
        global _exec_trace
        self.loglevel = level
        self._filtered_events_dirty = True  # loglevel change invalidates cached filter
        if level >= LEVEL_TRACE:
            _exec_trace = lambda cmd: self.add_event(
                "exec", shlex.join(cmd), level=LEVEL_TRACE)
        else:
            _exec_trace = None

    def _cmd_loglevel(self, args=''):
        """Set or display the event log verbosity level."""
        val = args.strip().lower()
        if not val:
            label = self._LOGLEVEL_LABELS.get(self.loglevel, str(self.loglevel))
            self.add_event("log-level", f"current log level: {label}")
            return
        if val not in self._LOGLEVEL_NAMES:
            self.add_event("cmd", f"log-level: unknown value '{val}'; "
                           "choices: quiet normal info debug trace")
            return
        self._set_loglevel(self._LOGLEVEL_NAMES[val])
        # Reset scroll so new level is immediately visible from tail
        self.log_offset = 0
        if self._monitoring_started:
            self.add_event("log-level", f"log level set to: {val}")

