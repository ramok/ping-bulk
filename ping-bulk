    def _cmd_help(self, args=''):
        """Open the help overlay (sets self.help_open = True).

        The overlay is drawn by _draw_help_overlay() and is never written to
        the event log or the log file.  Scroll position is reset to the top
        each time the overlay is opened.
        """
        self.help_open = True
        self.help_scroll = 0

    def _draw_help_overlay(self, stdscr, height, width):
        """Draw the help overlay as a centered bordered popup with scroll support.

        Uses _FULL_HELP as content; each line is padded / truncated to
        inner_w characters.  The box is drawn with box-drawing characters
        and rendered in reverse-video so it floats visually above the main UI.
        The overlay is closed by pressing q, Q, or Esc (handled in run()).

        Scrolling:
          self.help_scroll = 0  — top of content
          self.help_scroll > 0  — scrolled down by that many lines
        When the content is taller than the terminal the top border embeds a
        scroll indicator ' ↑↓ n-m/total ' centered in the dashes so the user
        can see where they are.  The scroll position is clamped here so callers
        may increment it freely without worrying about bounds.
        """
        ideal_w = max(len(line) for line in _FULL_HELP if line != "-DIVIDER-")
        inner_w = min(ideal_w, max(20, width - 4))
        box_w = inner_w + 2   # inner width + two border chars

        # Limit the box height to the terminal; always keep room for both borders.
        box_h_available = min(len(_FULL_HELP) + 2, height)
        visible_count = max(0, box_h_available - 2)

        # Clamp scroll position so it never exceeds the last valid window start.
        max_scroll = max(0, len(_FULL_HELP) - visible_count)
        self.help_scroll = max(0, min(self.help_scroll, max_scroll))

        col0 = max(0, (width - box_w) // 2)
        row0 = max(0, (height - box_h_available) // 2)

        attr = curses.A_REVERSE

        # Top border — embed a scroll indicator when not all lines fit on screen.
        if row0 < height:
            if max_scroll > 0:
                line_first = self.help_scroll + 1
                line_last  = self.help_scroll + visible_count
                indicator  = f' ↑↓ {line_first}-{line_last}/{len(_FULL_HELP)} '
                left_w  = (inner_w - len(indicator)) // 2
                right_w = inner_w - left_w - len(indicator)
                inner = '─' * left_w + indicator + '─' * right_w
                top_border = '┌' + inner + '┐'
            else:
                top_border = '┌' + '─' * inner_w + '┐'
            try:
                stdscr.addstr(row0, col0, top_border[:width - col0], attr)
            except curses.error:
                pass

        # Content rows — show only the slice selected by help_scroll.
        visible_lines = _FULL_HELP[self.help_scroll:self.help_scroll + visible_count]
        for i, line in enumerate(visible_lines):
            r = row0 + 1 + i
            if r >= height:
                break
            if line == "-DIVIDER-":
                try:
                    stdscr.addstr(r, col0, ('├' + '─' * inner_w + '┤')[:width - col0], attr)
                except curses.error:
                    pass
            else:
                padded = line.ljust(inner_w)[:inner_w]
                try:
                    stdscr.addstr(r, col0, ('│' + padded + '│')[:width - col0], attr)
                except curses.error:
                    pass

        # Bottom border
        r = row0 + 1 + visible_count
        if r < height:
            try:
                stdscr.addstr(r, col0,
                              ('└' + '─' * inner_w + '┘')[:width - col0], attr)
            except curses.error:
                pass

    def _draw_details_overlay(self, stdscr, height, width):
        """Draw the host details overlay as a centered bordered popup.

        Displays comprehensive statistics for self.details_monitor:
          - Host name / IP address
          - Current status (up/down) and last latency
          - Uptime / downtime duration
          - Packet statistics (RX, TX, XX, Loss%)
          - Latency statistics (Min, Max, Avg, StDev)
          - Total pings sent

        The overlay is closed by pressing Enter, q, Q, or Esc (handled in run()).
        """
        if self.details_monitor is None:
            return

        monitor = self.details_monitor

        # Collect stats once at the start to ensure consistency
        with monitor.lock:
            lats = list(monitor.latencies)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count
            last = monitor.latency
            alive = monitor.alive
            error = monitor.error

        import shlex
        import textwrap

        dns_mode = DNS_MODES[self.dns_mode]
        display_name = monitor.get_display_name(dns_mode)
        if hasattr(monitor, '_build_ping_cmd'):
            raw_cmd_str = shlex.join(monitor._build_ping_cmd())
        else:
            raw_cmd_str = ""
        raw_error_str = error if error is not None else ""

        # Calculate dynamic width
        ideal_w = 60
        ideal_w = max(ideal_w, len(f"  Host: {display_name}") + 2)
        ideal_w = max(ideal_w, len(f"  Cmd:  {raw_cmd_str}") + 2)
        if error:
            ideal_w = max(ideal_w, len(f"  Error:  {raw_error_str}") + 2)

        # Constrain to terminal width (leave margin of 4, box borders need 2)
        max_allowed_w = max(20, width - 4)
        inner_w = min(ideal_w, max_allowed_w)

        # Build content lines
        lines = []
        lines.append(f"  Host: {display_name}")

        cmd_wrap_w = max(10, inner_w - 8)
        wrapped_cmd = textwrap.wrap(raw_cmd_str, width=cmd_wrap_w)
        if wrapped_cmd:
            lines.append(f"  Cmd:  {wrapped_cmd[0]}")
            for w_line in wrapped_cmd[1:]:
                lines.append(f"        {w_line}")
        else:
            lines.append(f"  Cmd:  -")

        # Connect-options status for this host
        conn_disabled, conn_ssh = self._build_connect_cmd(monitor)
        if conn_disabled:
            lines.append(f"  Connect: disabled")
        else:
            conn_str = shlex.join(conn_ssh) if conn_ssh else '-'
            conn_wrap_w = max(10, inner_w - 12)
            wrapped_conn = textwrap.wrap(conn_str, width=conn_wrap_w)
            lines.append(f"  Connect: {wrapped_conn[0] if wrapped_conn else '-'}")
            for w_line in (wrapped_conn[1:] if wrapped_conn else []):
                lines.append(f"           {w_line}")

        lines.append("─" * inner_w)

        # Status
        if error is not None:
            lines.append(f"  Status: ERROR")
            err_wrap_w = max(10, inner_w - 10)
            wrapped_err = textwrap.wrap(raw_error_str, width=err_wrap_w)
            if wrapped_err:
                lines.append(f"  Error:  {wrapped_err[0]}")
                for e_line in wrapped_err[1:]:
                    lines.append(f"          {e_line}")
            else:
                lines.append(f"  Error:  -")
        elif alive is True:
            lines.append(f"  Status: UP")
            if monitor.up_since is not None:
                uptime = time.monotonic() - monitor.up_since
                lines.append(f"  Uptime: {_format_updown_time(uptime)}")
        elif alive is False:
            lines.append(f"  Status: DOWN")
            if monitor.down_since is not None:
                downtime = time.monotonic() - monitor.down_since
                lines.append(f"  Downtime: {_format_updown_time(downtime)}")
        else:
            lines.append(f"  Status: UNKNOWN")

        lines.append("")

        # Current latency
        if last is not None:
            lines.append(f"  Last RTT: {last:.2f} ms")
        else:
            lines.append(f"  Last RTT: -")

        lines.append("")

        # Packet statistics
        lines.append("  Packet Statistics:")
        lines.append(f"    Total sent (TX): {tx}")
        lines.append(f"    Received (RX):   {rx}")
        lines.append(f"    Lost (XX):       {xx}")

        total = rx + xx
        if total > 0:
            loss_pct = (xx / total) * 100
            lines.append(f"    Loss rate:       {loss_pct:.2f}%")
        else:
            lines.append(f"    Loss rate:       -")

        lines.append("")

        # Latency statistics
        lines.append("  Latency Statistics:")
        if lats:
            lines.append(f"    Min:     {min(lats):.2f} ms")
            lines.append(f"    Max:     {max(lats):.2f} ms")
            avg = sum(lats) / len(lats)
            lines.append(f"    Average: {avg:.2f} ms")

            if len(lats) >= 2:
                stdev = math.sqrt(sum((x - avg) ** 2 for x in lats) / len(lats))
                lines.append(f"    StdDev:  {stdev:.2f} ms")
            else:
                lines.append(f"    StdDev:  -")
        else:
            lines.append(f"    Min:     -")
            lines.append(f"    Max:     -")
            lines.append(f"    Average: -")
            lines.append(f"    StdDev:  -")

        lines.append("")

        # Add events related to this host
        host_events = []
        # get_display_name(dns_mode='off') is what add_event uses for logging host names
        log_name = monitor.get_display_name(dns_mode='off')

        # Look for events containing the host name
        for event in self.events:
            # Events look like: "2026-03-20T14:05:32+0200   hostname   message"
            # We split by '   ' (3 spaces) which add_event uses
            parts = event.split('   ', 1)
            if len(parts) == 2:
                rest = parts[1]
                # Hostname is padded with spaces, so we just check if it starts with the log_name followed by space
                # Or just do a simple search
                if f" {log_name} " in event or event.startswith(f"{parts[0]}   {log_name}"):
                    host_events.append(event)

        if host_events:
            lines.append("  Recent Events:")
            # Show up to 50 most recent events for this host
            for ev in host_events[-50:]:
                # Wrap event lines if needed
                ev_wrap_w = max(10, inner_w - 4)
                wrapped_ev = textwrap.wrap(ev, width=ev_wrap_w)
                for e_line in wrapped_ev:
                    lines.append(f"    {e_line}")
            lines.append("")

        if not conn_disabled:
            lines.append("  [c] SSH connect")
        lines.append("  [Enter / q / Esc] Close  [↑ / ↓ / PgUp / PgDn] Scroll")

        # Calculate box dimensions
        # Limit the box height to the terminal; always keep room for both borders.
        box_h_available = min(len(lines) + 2, height)
        visible_count = max(0, box_h_available - 2)

        # Clamp scroll position so it never exceeds the last valid window start.
        max_scroll = max(0, len(lines) - visible_count)
        self.details_scroll = max(0, min(self.details_scroll, max_scroll))

        box_w = inner_w + 2

        # Center the box
        col0 = max(0, (width - box_w) // 2)
        row0 = max(0, (height - box_h_available) // 2)

        attr = curses.A_REVERSE

        # Top border — embed a scroll indicator when not all lines fit on screen.
        if row0 < height:
            if max_scroll > 0:
                line_first = self.details_scroll + 1
                line_last  = self.details_scroll + visible_count
                indicator  = f' ↑↓ {line_first}-{line_last}/{len(lines)} '
                left_w  = (inner_w - len(indicator)) // 2
                right_w = inner_w - left_w - len(indicator)
                inner = '─' * left_w + indicator + '─' * right_w
                top_border = '┌' + inner + '┐'
            else:
                top_border = '┌' + '─' * inner_w + '┐'
            try:
                stdscr.addstr(row0, col0, top_border[:width - col0], attr)
            except curses.error:
                pass

        # Content rows — show only the slice selected by details_scroll.
        visible_lines = lines[self.details_scroll:self.details_scroll + visible_count]
        for i, line in enumerate(visible_lines):
            r = row0 + 1 + i
            if r >= height:
                break
            padded = line.ljust(inner_w)[:inner_w]
            try:
                stdscr.addstr(r, col0, ('│' + padded + '│')[:width - col0], attr)
            except curses.error:
                pass

        # Bottom border
        r = row0 + 1 + visible_count
        if r < height:
            try:
                stdscr.addstr(r, col0, ('└' + '─' * inner_w + '┘')[:width - col0], attr)
            except curses.error:
                pass

    def _register_shift_tab_seqs(self):
        """Register Shift+Tab escape sequences as KEY_BTAB with ncurses.

        Terminals differ in what they send for Shift+Tab:
          \\x1b[Z         — standard VT100 / xterm (terminfo: kcbt)
          \\x1b[27;2;9~   — XTerm modifyOtherKeys / kitty

        curses only translates \\x1b[Z when the active terminfo entry has 'kcbt';
        many terminals (tmux, screen, SSH clients) lack it.  Python's curses
        module also does not expose define_key(), so we call the underlying
        ncurses library directly via ctypes.

        Both paths are best-effort: any failure is silently ignored so a
        missing curses.define_key or unavailable shared library never prevents
        startup.
        """
        _BTAB_SEQS = (b'\x1b[Z', b'\x1b[27;2;9~')
        try:
            for _seq in _BTAB_SEQS:
                curses.define_key(_seq.decode(), curses.KEY_BTAB)
        except AttributeError:
            try:
                import ctypes
                import ctypes.util
                _lib_name = (ctypes.util.find_library('ncursesw')
                             or ctypes.util.find_library('ncurses'))
                if _lib_name:
                    _nclib = ctypes.CDLL(_lib_name)
                    for _seq in _BTAB_SEQS:
                        _nclib.define_key(_seq, curses.KEY_BTAB)
            except Exception:
                pass  # best-effort; Shift+Tab falls back to no-op on this terminal

    def _register_ctrl_arrow_seqs(self):
        """Register Ctrl+Arrow escape sequences as KEY_SLEFT / KEY_SRIGHT with ncurses.

        Terminals send various escape sequences for Ctrl+Left / Ctrl+Right:
          \\x1b[1;5D  \\x1b[5D  \\x1bOd   — Ctrl+Left (xterm / VTE / tmux variants)
          \\x1b[1;5C  \\x1b[5C  \\x1bOc   — Ctrl+Right

        We reuse KEY_SLEFT / KEY_SRIGHT (Shift+Left/Right) as the ncurses key
        codes because no standard code exists for Ctrl+Arrow, and those slots
        are otherwise unused in this application.

        Best-effort: any failure is silently ignored.
        """
        _CTRL_LEFT_SEQS  = (b'\x1b[1;5D', b'\x1b[5D', b'\x1bOd')
        _CTRL_RIGHT_SEQS = (b'\x1b[1;5C', b'\x1b[5C', b'\x1bOc')
        try:
            for _seq in _CTRL_LEFT_SEQS:
                curses.define_key(_seq.decode(), curses.KEY_SLEFT)
            for _seq in _CTRL_RIGHT_SEQS:
                curses.define_key(_seq.decode(), curses.KEY_SRIGHT)
        except AttributeError:
            try:
                import ctypes
                import ctypes.util
                _lib_name = (ctypes.util.find_library('ncursesw')
                             or ctypes.util.find_library('ncurses'))
                if _lib_name:
                    _nclib = ctypes.CDLL(_lib_name)
                    for _seq in _CTRL_LEFT_SEQS:
                        _nclib.define_key(_seq, curses.KEY_SLEFT)
                    for _seq in _CTRL_RIGHT_SEQS:
                        _nclib.define_key(_seq, curses.KEY_SRIGHT)
            except Exception:
                pass  # best-effort; Ctrl+Arrow falls back to no-op on this terminal

    def run(self, stdscr):
        """Main application loop"""
        # Initialize curses
        curses.curs_set(0)
        stdscr.nodelay(1)
        stdscr.timeout(100)
        # Reduce ESC key delay from default 1000ms to 25ms for responsive UI
        curses.set_escdelay(25)

        self._register_shift_tab_seqs()
        self._register_ctrl_arrow_seqs()

        # Initialize colors
        curses.start_color()
        curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)    # Success
        curses.init_pair(2, curses.COLOR_RED, curses.COLOR_BLACK)      # Failure
        curses.init_pair(3, curses.COLOR_YELLOW, curses.COLOR_BLACK)   # Warning (slow)
        curses.init_pair(4, curses.COLOR_WHITE, curses.COLOR_BLACK)    # Hotkey
        curses.init_pair(5, curses.COLOR_MAGENTA, curses.COLOR_BLACK)  # Very slow (>100 ms)
        curses.init_pair(6, curses.COLOR_CYAN, curses.COLOR_BLACK)     # Paused

        self.start_monitoring()

        if self.kiosk_mode and not shutil.which('vlock') and not shutil.which('physlock'):
            self.add_event("warn",
                "kiosk: vlock/physlock not found — idle lock-after-time will not work; "
                "install vlock or physlock to enable session locking")

        try:
            while self.running:
                stdscr.erase()
                height, width = stdscr.getmaxyx()

                # Adaptive layout: menu at bottom (height-1), hosts fill from top
                num_hosts = len(self.entries)

                # Column header at row 0 if there is room for at least one host row too
                show_header = height >= 3  # header(1) + host(1) + menu(1)
                hosts_start = 0

                # Host rows fill from hosts_start up to (but not including) the menu row.
                # When the column header is shown it occupies one extra row, so the
                # number of data rows is one less than the total space available.
                header_rows = 1 if show_header else 0
                visible_hosts = min(num_hosts, max(0, height - 1 - header_rows))

                # Events get whatever space remains between hosts and the menu row
                section_end = hosts_start + (1 if show_header else 0) + visible_hosts
                events_start = section_end + 1
                show_events = events_start + 2 <= height - 1  # must fit before menu row

                # Draw host list
                self.clamp_host_scroll(visible_hosts)
                self.draw_hosts(stdscr, hosts_start, visible_hosts, width, height,
                                show_header=show_header)
                if show_events:
                    self.draw_events(stdscr, events_start, height - 1, width)

                # Bottom row: menu OR command OR prompt (mutually exclusive)
                if self.cmd is not None:
                    self._draw_cmd(stdscr, height, width)
                    curses.curs_set(1)
                elif self.prompt is not None:
                    self._draw_prompt(stdscr, height, width)
                    curses.curs_set(1)
                else:
                    self.draw_menu_bar(stdscr, height, width)
                    curses.curs_set(0)

                # Help overlay drawn last so it floats above everything else
                if self.help_open:
                    self._draw_help_overlay(stdscr, height, width)
                    curses.curs_set(0)

                # Details overlay drawn on top of everything, including help
                if self.details_open:
                    self._draw_details_overlay(stdscr, height, width)
                    curses.curs_set(0)

                # Pending-key indicator — drawn last so nothing overwrites it
                if self.pending_key:
                    indicator = f"[{self.pending_key}]"
                    try:
                        stdscr.addstr(height - 1, width - len(indicator) - 1,
                                      indicator, curses.A_REVERSE)
                    except curses.error:
                        pass

                try:
                    stdscr.refresh()
                except KeyboardInterrupt:
                    self.prompt = {'type': 'quit_confirm', 'chars': []}
                    continue

                # Handle input — map Ctrl+C (KeyboardInterrupt) to key code 3
                # so modal layers can handle it uniformly as "cancel / dismiss".
                try:
                    key = stdscr.getch()
                except KeyboardInterrupt:
                    key = 3
                if self.help_open:
                    if key in (ord('q'), ord('Q'), 27, 3):
                        self.help_open = False
                    elif key == curses.KEY_UP:
                        self.help_scroll = max(0, self.help_scroll - 1)
                    elif key == curses.KEY_DOWN:
                        self.help_scroll += 1  # upper bound clamped in _draw_help_overlay
                    elif key == curses.KEY_PPAGE:
                        self.help_scroll = max(0, self.help_scroll - 10)
                    elif key == curses.KEY_NPAGE:
                        self.help_scroll += 10  # upper bound clamped in _draw_help_overlay
                    continue
                if self.details_open:
                    if key in (curses.KEY_ENTER, ord('\n'), ord('\r'),
                               ord('q'), ord('Q'), 27, 3):
                        self.details_open = False
                        self.details_monitor = None
                    elif key == ord('c') and self.details_monitor is not None:
                        # Connect from details overlay: close overlay then connect
                        self.details_open = False
                        self.details_monitor = None
                        self._connect_to_highlighted()
                    elif key == curses.KEY_UP:
                        self.details_scroll = max(0, self.details_scroll - 1)
                    elif key == curses.KEY_DOWN:
                        self.details_scroll += 1
                    elif key == curses.KEY_PPAGE:
                        self.details_scroll = max(0, self.details_scroll - 10)
                    elif key == curses.KEY_NPAGE:
                        self.details_scroll += 10
                    continue
                if self.cmd is not None:
                    if key != -1:
                        self._handle_cmd_key(key)
                    continue
                if self.prompt is not None:
                    if key != -1:
                        self._handle_prompt_key(key)
                    continue
                # ── pending z* sequence ────────────────────────────────────
                if self.pending_key == 'z':
                    if key != -1:   # real key: complete the sequence
                        self.pending_key = None
                        if key != 27:   # ESC just cancels, doesn't dispatch
                            self._handle_z_sequence(key)
                    continue         # wait (timeout) or move on after dispatch
                if key == -1:
                    continue         # no key pressed this tick
                if key == ord('q') or key == ord('Q'):
                    self.running = False
                    break
                elif key == 3:  # Ctrl+C — ask for confirmation before quitting
                    self.prompt = {'type': 'quit_confirm', 'chars': []}
                elif key == 27:  # Escape — clear host selection
                    self.highlighted_index = None
                elif key == ord('D'):
                    self.cycle_dns(1)
                elif key == ord('s'):
                    self.cycle_stats(1)
                elif key == ord('S'):
                    self._cmd_sync_history()
                elif key == ord('o'):
                    self.cycle_sort(1)
                elif key == ord('O'):
                    self.cycle_sort(-1)
                elif key == ord('p'):
                    # Per-host/section pause: toggle pause on the selected entry.
                    # If nothing is selected, p is a no-op (use P for global).
                    self._apply_pause_toggle(self._get_pause_targets())
                elif key == ord('P'):
                    # Global pause: toggle pause on all monitors.
                    self._apply_pause_toggle(self.monitors)
                elif key == ord('H'):
                    self.cycle_history_mode(1)
                elif key == ord(' '):
                    # If a section header is highlighted, toggle its folded state (= za).
                    # If a PingMonitor is highlighted, Space does nothing.
                    # If nothing is highlighted, insert a 'seen' marker (only if not scrolling log).
                    if (self.highlighted_index is not None and
                        0 <= self.highlighted_index < len(self.entries)):
                        entry = self.entries[self.highlighted_index]
                        if isinstance(entry, SectionLabel):
                            self._do_fold_action('za')
                        # PingMonitor highlighted — no action for Space
                    else:
                        if self.log_offset == 0:
                            self.mark_seen()
                elif key == 0:  # Ctrl+Space — zA: recursive toggle on highlighted section
                    self._do_fold_action('zA')
                elif key == ord('z'):
                    # Start a z* two-key fold sequence; indicator shown in bottom-right
                    self.pending_key = 'z'
                elif key == ord('['):
                    self._fold_all(True)   # fold all (zM alias)
                elif key == ord(']'):
                    self._fold_all(False)  # unfold all (zR alias)
                elif key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                    if (self.highlighted_index is not None and
                            0 <= self.highlighted_index < len(self.entries)):
                        entry = self.entries[self.highlighted_index]
                        if isinstance(entry, Monitor):
                            self.details_open = True
                            self.details_monitor = entry
                elif key == ord('C'):
                    self._open_prompt_clear()
                elif key == ord('c'):
                    self._connect_to_highlighted()
                elif key == ord(':'):
                    self.cmd = {
                        'chars': [], 'cursor': 0,
                        'hist_idx': -1, 'saved_line': '',
                        'completions': [], 'comp_idx': -1, 'comp_prefix': '',
                    }
                elif key == ord('?'):
                    self._cmd_help()
                elif key == 27:  # ESC — clear host selection
                    self.highlighted_index = None
                # History scrolling
                # The history bar shows newest pings on the RIGHT and oldest on the LEFT.
                # Arrow keys move through time naturally:
                #   ← / Ctrl+←  scroll back in time (show older pings, increase offset)
                #   → / Ctrl+→  scroll forward in time (return toward live, decrease offset)
                # Left/Right      — half visible width (step)
                # Ctrl+Left/Right — full visible width (page)
                elif key == curses.KEY_LEFT:
                    self.scroll_history(max(1, self._visible_ping_length // 2))
                elif key == curses.KEY_RIGHT:
                    self.scroll_history(-max(1, self._visible_ping_length // 2))
                elif key == curses.KEY_SLEFT:   # Ctrl+Left (see _register_ctrl_arrow_seqs)
                    self.scroll_history(self._visible_ping_length)
                elif key == curses.KEY_SRIGHT:  # Ctrl+Right
                    self.scroll_history(-self._visible_ping_length)
                # UP/DOWN arrow keys and j/k vim keys: navigate through visible entries only
                # Auto-initialize selection to first visible entry on first press
                elif key in (curses.KEY_UP, ord('k')):
                    if not self.entries:
                        pass  # no entries to navigate
                    else:
                        # Build list of visible entry indices
                        visible_indices = self._get_visible_entry_indices()
                        if not visible_indices:
                            pass  # no visible entries
                        elif self.highlighted_index is None:
                            # First navigation: start at the last visible entry
                            self.highlighted_index = visible_indices[-1]
                        else:
                            # Find current position in visible list and move up
                            try:
                                current_pos = visible_indices.index(self.highlighted_index)
                                if current_pos > 0:
                                    self.highlighted_index = visible_indices[current_pos - 1]
                            except ValueError:
                                # Current highlight is not visible; snap to last visible
                                self.highlighted_index = visible_indices[-1]
                elif key in (curses.KEY_DOWN, ord('j')):
                    if not self.entries:
                        pass  # no entries to navigate
                    else:
                        # Build list of visible entry indices
                        visible_indices = self._get_visible_entry_indices()
                        if not visible_indices:
                            pass  # no visible entries
                        elif self.highlighted_index is None:
                            # First navigation: start at the first visible entry
                            self.highlighted_index = visible_indices[0]
                        else:
                            # Find current position in visible list and move down
                            try:
                                current_pos = visible_indices.index(self.highlighted_index)
                                if current_pos < len(visible_indices) - 1:
                                    self.highlighted_index = visible_indices[current_pos + 1]
                            except ValueError:
                                # Current highlight is not visible; snap to first visible
                                self.highlighted_index = visible_indices[0]
                # PgUp/PgDn: scroll event log only
                elif key == curses.KEY_PPAGE:   # Page Up — scroll log back
                    log_page_size = max(1, height - 1 - events_start - 2)
                    if len(self.events) > log_page_size:
                        self.scroll_log(log_page_size)
                elif key == curses.KEY_NPAGE:   # Page Down — scroll log forward
                    log_page_size = max(1, height - 1 - events_start - 2)
                    if len(self.events) > log_page_size:
                        self.scroll_log(-log_page_size)

        finally:
            for monitor in self.monitors:
                monitor.stop()

def _parse_args():
    """Parse command-line arguments outside of curses so errors print cleanly.

    When invoked with no arguments (no hosts and no -f/--file), the usage/help
    is printed and the program exits immediately — curses is never started.
    Press '?' inside the running app for the full keyboard reference.
    """
    import argparse
    parser = argparse.ArgumentParser(
        prog='ping-bulk',
        description='Monitor multiple hosts with continuous ping.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  ping-bulk 8.8.8.8 1.1.1.1
  ping-bulk -f hosts.txt
  ping-bulk -l events.log 8.8.8.8 192.168.1.{1..10}

hosts file format:
  # comment line (ignored)
  ## Title              — level-1 section header (also :title Title)
  ### Sub-title         — level-2 section header (also :title2 Title)
  #### Sub-sub-title    — level-3 section header (also :title3 Title)
  10.0.0.1 ## label     — inline label; ## / ### / #### treated as comment
  :title Title          — same as ##; :title2 = ###; :title3 = ####
  10.0.0.1                  — host or IP to ping
  10.0.0.{1..5}             — brace range expansion (5 hosts)
  :resolv <ip> <hostname>   — static DNS override
  :ssh [opts] <dest> <host> — ping via SSH
  :ssh-begin [opts] <dest>  — open SSH block (plain lines → :ssh commands)
  :ssh-end                  — close SSH block

press '?' inside the app for the full keyboard reference.\
""",
    )

    # Dynamically add arguments from CMD_REGISTRY
    for cmd in CMD_REGISTRY:
        if cmd.cli_flags:
            parser.add_argument(*cmd.cli_flags, **(cmd.cli_kwargs or {}))

    parser.add_argument('hosts', nargs='*', metavar='HOST', help='hosts/IPs to ping')
    parser.add_argument('--kiosk', action='store_true',
                        help='run in kiosk mode: auto-launch tmux, restrict commands, use rnano/rvim')
    parser.add_argument('--help-full',    action='store_true',
                        help='show full manual and exit')
    parser.add_argument('--help-example', action='store_true',
                        help='show full advanced example and exit')
    args = parser.parse_args()

    if args.help_full:
        print(*['  ' + '-'*20 if x == "-DIVIDER-" else x for x in _FULL_HELP[1:]], sep='\n')
        sys.exit(0)

    if args.help_example:
        print(_EXAMPLE_HELP, end='')
        sys.exit(0)

    if not args.hosts and not args.file:
        parser.print_help()
        sys.exit(0)
    return args


def main(stdscr, args):
    entries = []

    # Load entries from each -f file in order, then append positional hosts
    for fpath in (args.file or []):
        try:
            entries.extend(parse_hosts_file(fpath))
        except OSError as e:
            print(f"ping-bulk: cannot open '{fpath}': {e}", file=sys.stderr)
            return

    seen_cli_hosts = set()
    for host in args.hosts:
        if host.startswith(':'):
            entries.append(('cmd', host))
        else:
            try:
                expanded = _expand_host(host)
            except ValueError as e:
                entries.append(('error', str(e)))
            else:
                for h in expanded:
                    if h in seen_cli_hosts:
                        entries.append(('warn', f"duplicate host ignored: {h}"))
                    else:
                        seen_cli_hosts.add(h)
                        entries.append(('host', h))

    if not entries:
        print("ping-bulk: no hosts to monitor", file=sys.stderr)
        return

    app = Application(entries, log_file=args.log_file)
    app.hosts_file = args.file[-1] if args.file else None
    app.kiosk_mode = bool(args.kiosk)

    # Apply any display-mode flags supplied on the command line.
    # These run after _load_config() so they always take precedence over the
    # config file.  Delegate through _dispatch_cmd so validation and cycling
    # logic is identical to the interactive ':cmd value' path.
    if args.dns:
        app._dispatch_cmd(f':set dns {args.dns}')
    if args.stats:
        app._dispatch_cmd(f':set stats {args.stats}')
    if args.sort:
        app._dispatch_cmd(f':set sort {args.sort}')
    if args.ping_view:
        app._dispatch_cmd(f':set ping-view {args.ping_view}')
    if args.sync_history:
        app._dispatch_cmd(f':set sync-history {args.sync_history}')

    app.run(stdscr)

if __name__ == "__main__":
    _args = _parse_args()
    if _args.kiosk:
        # In kiosk mode, auto-relaunch inside tmux if not already inside one
        _tmux = TmuxBackend()
        _screen = ScreenBackend()
        if not _tmux.is_inside() and not _screen.is_inside():
            if _tmux.available():
                _cmd = _tmux.relaunch_cmd(sys.argv, kiosk_conf=_KIOSK_TMUX_CONF)
                os.execvp(_cmd[0], _cmd)
            elif _screen.available():
                _cmd = _screen.relaunch_cmd(sys.argv)
                os.execvp(_cmd[0], _cmd)
            # If neither available, fall through and run directly
    curses.wrapper(main, _args)
