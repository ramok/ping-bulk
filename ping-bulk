def _subrun(cmd, **kw):
    """Drop-in replacement for subprocess.run() that emits a TRACE log entry."""
    if _exec_trace is not None:
        _exec_trace(cmd)
    return subprocess.run(cmd, **kw)


# Lightweight record stored in the events deque.
class EventEntry:
    """An entry in the event log deque.

    Behaves like a string for ``in``, ``lower()``, ``startswith()``, and
    equality checks so that existing code that treats events as plain text
    continues to work transparently.
    """
    __slots__ = ('level', 'category', 'text')

    def __init__(self, level, category, text):
        self.level    = level
        self.category = category
        self.text     = text

    # --- string-delegation helpers -------------------------------------------

    def __contains__(self, item):
        return item in self.text

    def lower(self):
        return self.text.lower()

    def startswith(self, prefix):
        return self.text.startswith(prefix)

    def __str__(self):
        return self.text

    # Allow ``'substring' in event_list`` (list.__contains__ uses __eq__)
    def __eq__(self, other):
        if isinstance(other, str):
            return self.text == other
        if isinstance(other, EventEntry):
            return (self.level, self.category, self.text) == \
                   (other.level, other.category, other.text)
        return NotImplemented

    def __hash__(self):
        return hash((self.level, self.category, self.text))

    def __repr__(self):
        return (f"EventEntry(level={self.level!r}, "
                f"category={self.category!r}, text={self.text!r})")

