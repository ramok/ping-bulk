def _unknown_directive_warn(cmd_word):
    """Return a ``('warn', …)`` entry for an unrecognised directive.

    Looks up *cmd_word* in ``_CMD_MAP`` plus the parser-only keywords and
    uses :mod:`difflib` to suggest the closest matching directive name.
