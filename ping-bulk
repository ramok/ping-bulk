def _parse_key_notation(notation):
    """Convert vim-like key notation to a list of curses key codes.

    Examples: ``'a'`` → ``[97]``, ``'za'`` → ``[122, 97]``,
    ``'<C-x>'`` → ``[24]``, ``'<CR>'`` → ``[KEY_ENTER]``.
    """
    result = []
    i = 0
    while i < len(notation):
        if notation[i] == '<':
            end = notation.find('>', i)
            if end == -1:
                raise ValueError(f"unclosed angle bracket in key notation: {notation!r}")
            token = notation[i + 1:end]
            token_lower = token.lower()
            # Ctrl+letter: <C-a> … <C-z>
            if token_lower.startswith('c-') and len(token) == 3:
                ch = token[2].lower()
                if 'a' <= ch <= 'z':
                    result.append(ord(ch) - ord('a') + 1)
                    i = end + 1
                    continue
            if token_lower in _KEY_NAME_MAP:
                result.append(_KEY_NAME_MAP[token_lower])
            else:
                raise ValueError(f"unrecognized key notation: <{token}>")
            i = end + 1
        else:
            result.append(ord(notation[i]))
            i += 1
    if not result:
        raise ValueError("empty key notation")
    return result


def _format_key_notation(keys):
    """Convert a list of curses key codes back to human-readable notation."""
    parts = []
    for key in keys:
        if key in _KEY_CODE_NAMES:
            parts.append(_KEY_CODE_NAMES[key])
        elif 1 <= key <= 26:
            parts.append(f'<C-{chr(key - 1 + ord("a"))}>')
        elif 32 < key <= 126:  # printable ASCII excluding space
            parts.append(chr(key))
        else:
            parts.append(f'<0x{key:02X}>')
    return ''.join(parts)


def _parse_context_flags(args):
    """Parse --%x context flags from the beginning of a :bindkey argument string.

    Returns ``(context, remaining_args)`` where *context* is a frozenset of
    variable names (e.g. ``frozenset({'h', 'p'})``) or ``None`` for
    unconditional bindings.  On error returns ``(False, error_message)``.
    """
    ctx_vars = set()
    while args.startswith('--%'):
        var = ''
        i = 3
        while i < len(args) and args[i] not in (' ', '\t'):
            var += args[i]
            i += 1
        if not var or var not in _BINDING_CONTEXT_VARS:
            return (False, f"unknown context flag --%{var}")
        ctx_vars.add(var)
        args = args[i:].lstrip()
    return (frozenset(ctx_vars) if ctx_vars else None, args)


def _format_context(context):
    """Format a context frozenset as '--%x --%y ' prefix, or '' for None."""
    if not context:
        return ''
    return ' '.join(f'--%{v}' for v in sorted(context)) + ' '


def _join_help_fragments(*groups):
    """Join fragment lists with -DIVIDER- separators."""
    result = []
    for g in groups:
        if result:
            result.append('-DIVIDER-')
        result.extend(g)
    return result


