# ── Key binding infrastructure ───────────────────────────────────────────────

class _Binding:
    """A key binding: one or more commands to execute on keypress."""
    __slots__ = ('commands', 'edit_mode', 'key_notation', 'origin', 'context',
                 'mode', 'desc', 'hint')

    def __init__(self, commands, edit_mode=False, key_notation='',
                 origin='default', context=None, mode='normal',
                 desc='', hint=''):
        self.commands = commands
        self.edit_mode = edit_mode
        self.key_notation = key_notation
        self.origin = origin
        self.context = context  # frozenset of required vars or None
        self.mode = mode        # UI mode: 'normal', 'help', 'details', 'command'
        self.desc = desc        # description shown in help overlay
        self.hint = hint        # short label shown in menu bar

    def __repr__(self):
        edit = 'edit' if self.edit_mode else 'exec'
        cmds = ' \\; '.join(self.commands)
        ctx = ''
        if self.context:
            ctx = ' '.join(f'--%{v}' for v in sorted(self.context)) + ' '
        mode_str = f', mode={self.mode}' if self.mode != 'normal' else ''
        return f"_Binding({ctx}{self.key_notation!r}, {edit}, {cmds!r}, {self.origin}{mode_str})"

