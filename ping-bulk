def _strip_inline_comment(line):
    """Strip an inline comment from *line* and return ``(main, comment)``.

    Two forms are recognised:
    - ``## ...`` (two or more ``#`` surrounded by spaces): the ``##`` inline
      comment syntax used on host lines to register a static DNS label.
    - `` # ...`` (single ``#`` preceded by a space): a plain shell-style
      comment usable on any line including ``:resolv``, ``:for``, etc.

    A run of ``##`` at the very start of the line is a section-header —
    not stripped.

    Examples::

        '10.0.0.1 ## router'                      → ('10.0.0.1', 'router')
        ':resolv 10.0.1.1 host  # comment'        → (':resolv 10.0.1.1 host', 'comment')
        '## Section'                               → ('## Section', '')
        '10.0.0.1'                                 → ('10.0.0.1', '')
    """
    if line.startswith('##'):
        return line, ''
    # ## (two or more hashes, space-delimited) — used for IP ## label syntax
    m = re.search(r' #{2,} ', line)
    if m is not None:
        return line[:m.start()].rstrip(), line[m.end():].strip()
    # Single # preceded by a space — plain shell-style comment
    m = re.search(r' #', line)
    if m is not None:
        return line[:m.start()].rstrip(), line[m.end() + 1:].strip()
    return line, ''


def _is_ip(s):
    """Return True if *s* looks like an IPv4 or IPv6 address (not a hostname).

    IPv4: four dot-separated decimal octets (0-255).
    IPv6: any string containing a colon (covers full, compressed, and
          link-local forms without requiring a full parser).
    """
    if ':' in s:
        return True  # IPv6
    parts = s.split('.')
    if len(parts) != 4:
        return False
    for p in parts:
        if not p.isdigit():
            return False
        if not (0 <= int(p) <= 255):
            return False
    return True


def _expand_brace_group(inner):
    """Expand the content of a single (innermost) brace group.

    Supports three forms, which may be mixed freely in a comma-separated list:
      range item  — n..m or n-m  → each integer in [n, m] (inclusive, step ±1)
      literal     — any other token → used as-is

    Returns a list of strings (one per alternative).

    Raises ValueError when the group is invalid:
      - empty group: {}
      - empty item:  {a,,b}  or  {,}  (trailing/leading/consecutive comma)
    """
    if not inner:
        raise ValueError("empty brace group '{}'")

    items = inner.split(',')
    result = []
    for item in items:
        if not item:
            raise ValueError(f"empty item in brace group '{{{inner}}}'")
        range_m = re.fullmatch(r'(-?\d+)(?:\.\.|-)(-?\d+)', item)
        if range_m:
            lo, hi = int(range_m.group(1)), int(range_m.group(2))
            step = 1 if lo <= hi else -1
            result.extend(str(v) for v in range(lo, hi + step, step))
        else:
            result.append(item)
    return result


def parse_target(target):
    """Parse a target string into a (host, port) tuple.

    Supports:
      - Hostnames/IPv4 with port: 'example.com:80', '127.0.0.1:443'
      - Hostnames/IPv4 without port: 'example.com', '127.0.0.1'
      - IPv6 with brackets and port: '[2001:db8::1]:80'
      - IPv6 with brackets and no port: '[2001:db8::1]'
      - Raw IPv6 (no port possible without brackets): '2001:db8::1'
    """
    target = target.strip()
    if not target:
        return ("", None)

    if target.startswith('['):
        close_bracket = target.find(']')
        if close_bracket != -1:
            host = target[1:close_bracket]
            remainder = target[close_bracket+1:]
            if remainder.startswith(':'):
                port = remainder[1:]
                return (host, port if port else None)
            return (host, None)

    if target.count(':') == 1:
        host, port = target.split(':', 1)
        return (host, port if port else None)

    return (target, None)

def _expand_host(s):
    """Expand a host/IP string that may contain brace range/list notation.

    Works for both IP addresses and hostnames.  Supported forms (may be
    combined freely; nested braces are expanded inside-out):

      10.0.0.{1,2,5}          — brace list  → 10.0.0.1, 10.0.0.2, 10.0.0.5
      10.0.0.{1..4}           — brace range → 10.0.0.1 … 10.0.0.4
      10.0.0.{1-4}            — brace range → 10.0.0.1 … 10.0.0.4  (zsh style)
      10.{1..2}.0.{1,5}       — two groups  → 2×2 = 4 addresses (cartesian)
      10.0.0.{10,11..12,14}   — mixed list+range → .10, .11, .12, .14
      web{1..3}.example.com   — brace range → web1.example.com … web3.example.com
      web{a,b,c}.example.com  — brace list  → weba, webb, webc .example.com
      10.0.{1..2}.{10,2{1,2}} — nested braces → cartesian product (8 addresses)

    Strings without any expansion syntax are returned as a single-item list.

    Raises ValueError when a brace group is invalid (empty group, empty item
    after comma split).  Callers should catch this and report the error.
    """
    import re

    # Find the innermost brace group (no nested braces inside).
    m = re.search(r'\{([^{}]*)\}', s)
    if not m:
        return [s]  # no braces — plain string

    alternatives = _expand_brace_group(m.group(1))  # may raise ValueError

    result = []
    for alt in alternatives:
        expanded = s[:m.start()] + alt + s[m.end():]
        result.extend(_expand_host(expanded))  # recurse for remaining braces
    return result


def _expand_host_with_captures(pattern):
    """Expand *pattern* and return a list of ``(expanded_str, captures)`` pairs.

    Like :func:`_expand_host` but also tracks *which value each top-level
    brace group contributed* to every result, enabling ``\\N`` back-references
    in companion strings (e.g. the hostname side of a ``:resolv`` command).

    Algorithm
    ---------
    1. Walk the pattern once and locate every **top-level** ``{…}`` group
       (balanced, left-to-right; nested braces are skipped over).
    2. For each group, split its inner content on top-level commas, then
       expand each item: range notation (``n..m`` or ``n-m``) → integer
       sequence; anything else → via :func:`_expand_host` (handles nested
       braces recursively).  The result is the list of *alternative values*
       for that group.
    3. Compute the cartesian product across all groups.  For each combination
       ``(v1, v2, …)`` build the substituted string and record the captures.

    Returns
    -------
    list of ``(str, list[str])``
        ``expanded_str`` is the fully substituted string (same as what
        :func:`_expand_host` would return).
        ``captures`` is ``[v1, v2, …]`` where ``vi`` is the string value
        that the *i*-th top-level group (1-based) produced for this row.

    Patterns without any brace groups return ``[(pattern, [])]``.

    Raises :exc:`ValueError` for empty groups or empty comma-separated items
    (same contract as :func:`_expand_brace_group`).
    """
    import re
    import itertools

    # ── Step 1: find every top-level balanced brace group ─────────────────
    groups = []  # list of (start, end) — half-open slice, pattern[start:end] == '{…}'
    i = 0
    while i < len(pattern):
        if pattern[i] == '{':
            depth = 1
            j = i + 1
            while j < len(pattern) and depth > 0:
                if pattern[j] == '{':
                    depth += 1
                elif pattern[j] == '}':
                    depth -= 1
                j += 1
            if depth == 0:
                groups.append((i, j))  # j is one past the closing '}'
                i = j
                continue
        i += 1

    if not groups:
        return [(pattern, [])]

    # ── Step 2: expand each group to its list of alternative strings ───────
    group_alts = []
    for start, end in groups:
        inner = pattern[start + 1:end - 1]
        if not inner:
            raise ValueError("empty brace group '{}'")

        # Split inner content on *top-level* commas (ignore commas inside
        # nested braces).
        items = []
        depth = 0
        buf = []
        for ch in inner:
            if ch == '{':
                depth += 1
                buf.append(ch)
            elif ch == '}':
                depth -= 1
                buf.append(ch)
            elif ch == ',' and depth == 0:
                items.append(''.join(buf))
                buf = []
            else:
                buf.append(ch)
        items.append(''.join(buf))

        alts = []
        for item in items:
            if not item:
                raise ValueError(f"empty item in brace group '{{{inner}}}'")
            # Range notation: n..m or n-m
            range_m = re.fullmatch(r'(-?\d+)(?:\.\.|-)(-?\d+)', item)
            if range_m:
                lo, hi = int(range_m.group(1)), int(range_m.group(2))
                step = 1 if lo <= hi else -1
                alts.extend(str(v) for v in range(lo, hi + step, step))
            else:
                # Recurse into nested braces (if any) via the existing helper.
                alts.extend(_expand_host(item))
        group_alts.append(alts)

    # ── Step 3: cartesian product → substituted strings + captures ─────────
    results = []
    for combo in itertools.product(*group_alts):
        # Replace groups right-to-left so earlier offsets stay valid.
        s = pattern
        for (start, end), val in zip(reversed(groups), reversed(combo)):
            s = s[:start] + val + s[end:]
        results.append((s, list(combo)))

    return results


def _apply_backref(template, captures, full_str=None):
    r"""Substitute back-reference placeholders in *template* with captured values.

    Recognised forms:
      Numbered (bare and brace-quoted are equivalent):
        ``$N``   ``${N}``   (N is a single digit 0–9)

      Named (when *captures* is a dict):
        ``$name``   ``${name}``

    ``$0`` / ``${0}`` (bare or braced) is replaced by *full_str* (the complete
    expanded string for this iteration).  ``$N`` / ``${N}`` (N ≥ 1, 1-based) is
    replaced by ``captures[N-1]``.  References to groups that do not exist
    (index out of range, or *full_str* is ``None`` for index 0) are left
    unchanged so the user can see the un-substituted placeholder rather than
    silently getting wrong output.

    The braced forms (``${N}`` / ``${name}``) allow the placeholder to be used
    adjacent to other characters without ambiguity, e.g. ``host${1}9`` expands
    to ``hostX9`` rather than trying to resolve group 19.

    Named backrefs require *captures* to be a dict; when *captures* is a list
    only numbered backrefs are supported.  Missing keys in named backrefs are
    left unchanged (placeholder visible).

    Parameters
    ----------
    template : str
        String that may contain ``$0``…``$9``, ``${0}``…``${9}``, ``$name``,
        or ``${name}`` placeholders.
    captures : list[str] or dict[str, str]
        Values produced by :func:`_expand_host_with_captures` for one row
        (list for numbered backrefs, dict for named backrefs).
    full_str : str or None
        The fully-expanded host string for this iteration; used for ``$0`` /
        ``${0}``.  Pass ``None`` when no full-string context is available.

    Returns
    -------
    str
        *template* with all in-range back-reference sequences replaced.
    """
    import re

    def _sub(m):
        # Extract all groups - numbered and named backrefs
        num_braced, num_bare, name_braced, name_bare = m.groups()

        # Handle named backrefs (groups 3 & 4: ${name} or $name)
        if name_braced or name_bare:
            name = name_braced or name_bare
            # Named backrefs only work when captures is a dict
            if isinstance(captures, dict):
                value = captures.get(name)
                if value is None:
                    return m.group(0)  # key not found — leave placeholder
                return value
            else:
                return m.group(0)  # captures is not a dict — leave placeholder

        # Handle numbered backrefs (groups 1 & 2: ${1} or $1)
        idx = int(num_braced if num_braced is not None else num_bare)
        if idx == 0:
            return full_str if full_str is not None else m.group(0)
        # Numbered backrefs work with both list and dict captures
        if isinstance(captures, dict):
            # For dict captures, treat numbers as string keys for potential future use
            return captures.get(str(idx), m.group(0))
        else:
            return captures[idx - 1] if 1 <= idx <= len(captures) else m.group(0)

    return re.sub(r'\$(?:\{(\d+)\}|(\d)|\{([a-zA-Z_]\w*)\}|([a-zA-Z_]\w*))', _sub, template)


def _has_backref(s):
    r"""Return True if *s* contains any back-reference placeholder.

    Recognised forms: ``$N``, ``${N}`` (N = 0–9), ``$name``, ``${name}``.
    """
    import re
    # Match $N, ${N} (numeric), $name, ${name} (alphabetic identifiers)
    return bool(re.search(r'\$(?:\{\w+\}|\d|[a-zA-Z_]\w*)', s))


def _expand_let_vars(line, variables, backrefs=None, full_str=None):
    r"""Substitute ``:let`` variable references in *line*.

    Recognised forms:

    ``$name`` / ``${name}``
        Both forms are equivalent: substituted with the variable value when
        defined, or the **empty string** when not defined.  ``${name}`` is
        useful to delimit the variable name from adjacent characters.
        Digit-only names (``$0``–``$9``) and named loop back-references are
        left untouched so that ``_apply_backref`` can handle them later.

    ``${name_$N}``
        Brace-delimited with inner digit back-references.  ``$N`` inside
        ``${...}`` is expanded first using *backrefs* / *full_str*, then the
        resulting string is looked up as a variable name.  If the key is not
        found the empty string is substituted.

    Processing is left-to-right; ``${...}`` is handled before bare ``$name``
    because the regex alternation is ordered.

    Parameters
    ----------
    line : str
        Source line that may contain variable references.
    variables : dict[str, str]
        The current ``:let`` variable store.
    backrefs : list[str] or dict[str, str] or None
        Current for-loop back-references (used to expand ``$N`` inside
        ``${...}``).  ``None`` is safe — no inner substitution.
    full_str : str or None
        Full expanded string for ``$0`` inside ``${...}``.

    Returns
    -------
    str
        *line* with all variable references substituted.
    """
    if '$' not in line:
        return line  # fast path: no $ at all

    def _resolve_braced(m):
        expr = m.group(1)
        # Pure digit — this is a numeric back-reference; leave for _apply_backref.
        if expr.isdigit():
            return m.group(0)
        # Inner pass: expand $N inside the expression using backrefs.
        if backrefs is not None and re.search(r'\$\d', expr):
            expr = _apply_backref(expr, backrefs, full_str)
        # Named loop back-reference (e.g. $x from `:for x in ...`): leave
        # unchanged so that _apply_backref can resolve it after us.
        if isinstance(backrefs, dict) and expr in backrefs:
            return m.group(0)
        return variables.get(expr, '')  # empty string if not defined

    def _resolve_bare(m):
        name = m.group(1)
        if name.isdigit():
            return m.group(0)  # leave $N for _apply_backref
        # Named loop back-references take priority; leave them for _apply_backref.
        if isinstance(backrefs, dict) and name in backrefs:
            return m.group(0)
        return variables.get(name, '')  # empty string if not defined

    # First handle ${expr} (brace-delimited, may contain $N inside)
    result = re.sub(r'\$\{([^}]*)\}', _resolve_braced, line)
    # Then handle bare $name (identifier, not digit)
    result = re.sub(r'\$([a-zA-Z_]\w*)', _resolve_bare, result)
    return result


def _config_path():
    """Return the XDG-compliant config file path for ping-bulk.

    Respects ``$XDG_CONFIG_HOME`` when set; falls back to ``~/.config``.
    The returned path is ``<base>/ping-bulk/config``.
    """
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = xdg if xdg else os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'ping-bulk', 'config')


def _history_path():
    """Return the XDG-compliant command history file path for ping-bulk.

    Respects ``$XDG_STATE_HOME`` when set; falls back to ``~/.local/state``.
    The returned path is ``<base>/ping-bulk/history``.
    """
    xdg = os.environ.get('XDG_STATE_HOME', '')
    base = xdg if xdg else os.path.join(os.path.expanduser('~'), '.local', 'state')
    return os.path.join(base, 'ping-bulk', 'history')


def _format_updown_time(seconds):
    """Format a duration in seconds into a compact human-readable string.

    Output examples and maximum widths:
      < 60 s       → "59s"        (3 chars)
      < 1 h        → "59m 59s"    (7 chars)
      < 24 h       → "23h 59m"    (7 chars)
      ≥ 24 h       → "365d 23h"   (8 chars)

    The returned string is at most 8 characters wide.
    """
    secs = int(seconds)
    if secs < 60:
        return f"{secs}s"
    mins = secs // 60
    secs_rem = secs % 60
    if mins < 60:
        return f"{mins}m {secs_rem}s"
    hours = mins // 60
    mins_rem = mins % 60
    if hours < 24:
        return f"{hours}h {mins_rem}m"
    days = hours // 24
    hours_rem = hours % 24
    return f"{days}d {hours_rem}h"


def _history_char(val, mode):
    """Convert a raw history value (float ms, None, or 'ERR') to a single display character.

    success — '.' for any successful ping, 'X' for timeout, '?' for process error
    rtt     — last digit of int(ms) for success, 'X' for timeout, '?' for process error
    scaled  — digit 0-9 mapping 10 ms buckets (0=<10ms … 9=90+ms), 'X' for timeout,
              '?' for process error
    """
    if val == 'ERR':
        return '?'
    if val is None:
        return 'X'
    if mode == 'rtt':
        return str(int(round(val)))[-1]
    if mode == 'scaled':
        scaled = round(val / 100 * 9)
        return '>' if scaled > 9 else str(scaled)
    return '.'  # 'success' mode


class Monitor(ABC):
    def __init__(self, host):
        self.host = host
        self.resolved_ip = None        # IP address resolved from a hostname
        self.resolved_hostname = None  # hostname resolved from an IP (reverse DNS)
        self.alive = None
        self.latency = None
        self.history = deque(maxlen=100)
        self.history_times = deque(maxlen=100)  # parallel wall-clock timestamps
        self.latencies = []    # all recorded latency values (successful pings)
        self.rx_count = 0      # total successful pings (RX)
        self.xx_count = 0      # total failed pings (XX)
        self.last_state = None
        self.down_since = None  # monotonic timestamp of when the host went down
        self.up_since = None    # monotonic timestamp of when the host came up
        self.ping_count = 0     # total pings ever sent (never capped, unlike history deque)
        self.running = True
        self.paused = False
        self._pause_event = threading.Event()
        self._pause_event.set()    # set = running; clear = paused
        self.lock = threading.Lock()
        self.error = None          # str when a fatal process-level error occurred, else None
        self.error_logged = False  # True once the error has been added to the event log
        self._proc = None          # active Popen handle for the persistent ping subprocess
        self.resolv_static = False # True when a :resolv static mapping overrides DNS

    def resolve_dns(self):
        """Resolve the host to both its IP address and its hostname."""
        try:
            ip = socket.gethostbyname(self.host)
            self.resolved_ip = ip
        except Exception:
            self.resolved_ip = None

        lookup_addr = self.resolved_ip if self.resolved_ip else self.host
        try:
            self.resolved_hostname = socket.gethostbyaddr(lookup_addr)[0]
        except Exception:
            self.resolved_hostname = None

    def get_display_name(self, dns_mode="off"):
        """Return the display name for this host according to dns_mode."""
        if dns_mode == "hostname":
            return self.resolved_hostname or self.host
        if dns_mode == "ip":
            return self.resolved_ip or self.host
        return self.host

    def get_history_string(self, length=50, offset=0, mode="success", cell_width=1,
                           sync=False, end_time=None):
        """Get history as a string of given length ending offset steps from the newest sample.

        sync=True uses wall-clock time buckets (1 bucket = 1 second) so all monitors
        share the same time axis, with spaces for seconds where no ping arrived.
        end_time is the right-edge wall-clock time; offset is in seconds in sync mode.
        """
        # Fatal-error hosts show '??' in the stat column; history bar is suppressed.
        with self.lock:
            is_fatal = self.error is not None
        if is_fatal:
            return (' ' * cell_width) * length if cell_width > 1 else ' ' * length

        if sync and end_time is not None:
            with self.lock:
                history_list = list(self.history)
                times_list   = list(self.history_times)
            t_end = int(end_time - offset)
            # One pass: map each (timestamp, value) to a bucket index.
            # Bucket 0 = the current second; bucket i = i seconds ago.
            # Each ping belongs to the second it arrived in: int(ts) i.e. floor(ts).
            # This ensures all pings within the same second land in the same bucket
            # regardless of their sub-second offset, preventing per-host jitter.
            if cell_width > 1:
                result = [' ' * cell_width] * length
            else:
                result = [' '] * length
            for ts, val in zip(times_list, history_list):
                bucket = t_end - int(ts)
                if 0 <= bucket < length:
                    if cell_width > 1:
                        num_w = cell_width - 1
                        if val is None:
                            cell = "X" * num_w + " "
                        elif val == "ERR":
                            cell = "?" * num_w + " "
                        else:
                            capped = min(int(round(val)), 10 ** num_w - 1)
                            cell = f"{capped:>{num_w}} "
                    else:
                        cell = _history_char(val, mode)
                    result[bucket] = cell
            return "".join(result)  # result[0]=newest, result[length-1]=oldest (no reversal)

        with self.lock:
            history_list = list(self.history)
            total = len(history_list)
            end = total - offset
            start = end - length
            result = []
            for i in range(start, end):
                if i < 0 or i >= total:
                    cell = " " * cell_width if cell_width > 1 else " "
                else:
                    val = history_list[i]
                    if cell_width > 1:
                        num_w = cell_width - 1
                        if val is None:
                            cell = "X" * num_w + " "
                        elif val == "ERR":
                            cell = "?" * num_w + " "
                        else:
                            capped = min(int(round(val)), 10**num_w - 1)
                            cell = f"{capped:>{num_w}} "
                    else:
                        cell = _history_char(val, mode)
                result.append(cell)
            return "".join(reversed(result))

    def stop(self):
        """Stop the ping loop and terminate the subprocess cleanly."""
        self.running = False
        self._pause_event.set()   # unblock thread if waiting so it can exit
        if self._proc is not None:
            try:
                self._proc.terminate()
            except Exception:
                pass

    def pause(self):
        """Pause monitoring: block the ping thread and kill the active subprocess."""
        self.paused = True
        self._pause_event.clear()
        if self._proc is not None:
            try:
                self._proc.terminate()
            except Exception:
                pass

    def unpause(self):
        """Resume monitoring: wake the ping thread so it starts a fresh subprocess."""
        self.paused = False
        self._pause_event.set()

    @abstractmethod
    def ping(self):
        pass


class PingMonitor(Monitor):
    def _build_ping_cmd(self):
        """Return the command list used to launch the ping subprocess.

        Subclasses override this to run ping over a different transport
        (e.g. SSH).  The default implementation runs the local system ping
        with '-O' (report unanswered probes) and '-D' (Unix-timestamp prefix).

        When resolv_static is True a :resolv mapping has been applied, so ping
        targets the resolved IP directly instead of the original hostname.
        """
        target = self.resolved_ip if (self.resolv_static and self.resolved_ip) else self.host
        return ['ping', '-O', '-D', target]

    def ping(self):
        """Continuously ping the host using a single persistent subprocess.

        Launches 'ping -O -D <host>' once and reads its stdout line-by-line,
        updating stats on each success ('time=') or -O timeout
        ('no answer yet') line.  The '-D' Unix-timestamp prefix is stripped
        before parsing.

        Fatal errors (e.g. unknown host, permission denied) set self.error
        and stop the loop permanently.  Unexpected exits are retried with
        exponential backoff (1 s → 2 s → 4 s … capped at 30 s); the backoff
        resets whenever any ping-result output is received.
        """
        backoff = 1  # seconds; doubles on each unexpected exit, capped at 30

        while self.running:
            self._pause_event.wait()
            if not self.running:
                break
            try:
                self._proc = subprocess.Popen(
                    self._build_ping_cmd(),
                    stdin=subprocess.DEVNULL,   # never let the child read the terminal
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,  # line-buffered; iputils-ping flushes per line
                )
            except Exception as exc:
                self.error = str(exc)
                with self.lock:
                    self.history.append('ERR')
                    self.history_times.append(time.time())
                break

            got_output = False

            for raw_line in self._proc.stdout:
                if not self.running:
                    break

                line = raw_line.rstrip()

                # Strip the '-D' Unix-timestamp prefix: '[1234567890.123] rest';
                # capture the timestamp for wall-clock-aligned history.
                ping_ts = None
                if line.startswith('['):
                    close = line.find(']')
                    if close != -1:
                        try:
                            ping_ts = float(line[1:close])
                        except ValueError:
                            pass
                        line = line[close + 2:]  # skip past '] '
                if ping_ts is None:
                    ping_ts = time.time()

                if 'time=' in line:
                    # Successful reply — extract RTT
                    try:
                        latency = float(line.split('time=')[1].split()[0])
                    except (IndexError, ValueError):
                        continue
                    with self.lock:
                        self.latency = latency
                        self.alive = True
                        self.history.append(latency)
                        self.history_times.append(ping_ts)
                        self.rx_count += 1
                        self.latencies.append(latency)
                    self.ping_count += 1
                    got_output = True
                    backoff = 1  # reset on any successful output
                elif 'no answer yet' in line:
                    # '-O' timeout line — one per missed icmp_seq
                    with self.lock:
                        self.alive = False
                        self.latency = None
                        self.history.append(None)
                        self.history_times.append(ping_ts)
                        self.xx_count += 1
                    self.ping_count += 1
                    got_output = True
                    backoff = 1  # reset on any output

            # Stdout closed — process has exited (or we broke out on shutdown)
            if not self.running:
                break

            # Drain stderr to check for a fatal error message
            try:
                stderr_text = self._proc.stderr.read()
            except Exception:
                stderr_text = ''
            self._proc.wait()

            if self._is_fatal_error(stderr_text):
                self.error = stderr_text.strip()
                with self.lock:
                    self.history.append('ERR')
                    self.history_times.append(time.time())
                break  # do not restart for fatal errors

            # Unexpected (non-fatal) exit — restart after backoff
            if not got_output:
                # Process exited before producing any result lines;
                # keep the current backoff penalty instead of resetting.
                pass
            time.sleep(backoff)
            backoff = min(backoff * 2, 30)

    @staticmethod
    def _is_fatal_error(stderr_text):
        """Return True if stderr_text contains a known non-retryable error pattern."""
        text = stderr_text.lower()
        return any(pattern in text for pattern in _FATAL_PING_ERRORS)


class PortMonitor(Monitor):
    """A PingMonitor that checks a TCP port instead of ICMP ping.

    Instead of spawning a subprocess, it uses Python's socket module to
    attempt a TCP connection.
    """

    def __init__(self, host, port, port_map=None):
        self.port = port
        self.port_num = None
        self.port_name = None
        self._port_map = port_map or {}
        super().__init__(f"{host}:{port}")
        self._ping_host = host
        # Try to resolve port name/number immediately
        self._resolve_port()

    def _resolve_port(self):
        try:
            self.port_num = int(self.port)
            # Check port_map first for custom port→service mapping
            if self.port_num in self._port_map:
                self.port_name = self._port_map[self.port_num]
            else:
                try:
                    self.port_name = socket.getservbyport(self.port_num)
                except (OSError, OverflowError):
                    self.port_name = str(self.port_num)
        except ValueError:
            self.port_name = self.port
            # Check port_map first for custom service→port mapping
            if self.port in self._port_map:
                self.port_num = self._port_map[self.port]
            else:
                try:
                    self.port_num = socket.getservbyname(self.port)
                except OSError:
                    self.port_num = None

    def resolve_dns(self):
        """Resolve the host to both its IP address and its hostname."""
        try:
            ip = socket.gethostbyname(self._ping_host)
            self.resolved_ip = ip
        except Exception:
            self.resolved_ip = None

        lookup_addr = self.resolved_ip if self.resolved_ip else self._ping_host
        try:
            self.resolved_hostname = socket.gethostbyaddr(lookup_addr)[0]
        except Exception:
            self.resolved_hostname = None

    def get_display_name(self, dns_mode="off"):
        """Return the display name for this host according to dns_mode."""
        if dns_mode == "off":
            return self.host

        host_part = self._ping_host
        if dns_mode == "hostname":
            host_part = self.resolved_hostname or self._ping_host
        elif dns_mode == "ip":
            host_part = self.resolved_ip or self._ping_host

        port_part = self.port
        if dns_mode == "hostname" and self.port_name:
            port_part = self.port_name
        elif dns_mode == "ip" and self.port_num:
            port_part = str(self.port_num)

        return f"{host_part}:{port_part}"

    def ping(self):
        """Continuously check the TCP port using socket connections."""

        if self.port_num is None:
            self.error = f"unknown port: {self.port}"
            with self.lock:
                self.history.append("ERR")
            return

        while self.running:
            self._pause_event.wait()
            if not self.running:
                break
            target = (
                self.resolved_ip
                if (self.resolv_static and self.resolved_ip)
                else self._ping_host
            )

            start_time = time.monotonic()
            wall_time  = time.time()
            success = False

            try:
                # 1 second timeout for the connection attempt
                with socket.create_connection((target, self.port_num), timeout=1.0):
                    success = True
            except (ConnectionRefusedError, TimeoutError, OSError):
                success = False
            except Exception as exc:
                # Other errors might be fatal
                self.error = str(exc)
                with self.lock:
                    self.history.append("ERR")
                    self.history_times.append(wall_time)
                break

            latency_ms = (time.monotonic() - start_time) * 1000.0

            if success:
                with self.lock:
                    self.latency = latency_ms
                    self.alive = True
                    self.history.append(latency_ms)
                    self.history_times.append(wall_time)
                    self.rx_count += 1
                    self.latencies.append(latency_ms)
            else:
                with self.lock:
                    self.alive = False
                    self.latency = None
                    self.history.append(None)
                    self.history_times.append(wall_time)
                    self.xx_count += 1

            self.ping_count += 1

            # Sleep for exactly 1 second minus the time taken to check,
            # ensuring roughly 1 check per second like standard ping.
            sleep_time = max(0.1, 1.0 - (latency_ms / 1000.0))

            # If not running anymore, don't sleep
            if not self.running:
                break

            time.sleep(sleep_time)


class SshPingMonitor(Monitor):
    """A PingMonitor that runs ping remotely over an SSH connection.

    Connects to the remote host using 'ssh -o BatchMode=yes' (no interactive
    password prompts) and executes 'ping -O -D <ping_host>' on the remote side.

    Constructor arguments:
      ssh_args        — list of SSH argument tokens (everything after 'ssh'),
                        e.g. ['-J', 'bastion', 'user@remote'] or ['user@remote'].
                        The SSH destination (last token) is extracted for display.
      ping_host       — the host that the remote ping will target (may already be
                        an IP when a :resolv mapping was applied before :ssh).
      ping_host_label — original (pre-resolv) name of the ping target, used as the
                        display label in dns_mode='off' and 'hostname'.  Defaults
                        to ping_host when not supplied.
      original_ssh_args — original SSH args before :resolv resolution, used for
                          display purposes to show jump hosts as originally specified.
      hosts_map       — reference to Application.hosts_map for reverse :resolv lookup

    The remote ping command is:
      ssh -o BatchMode=yes <ssh_args…> ping -O -D <ping_host>

    Fatal SSH errors (permission denied, host-key mismatch, …) stop the
    monitor permanently.  Network-level failures (connection refused, no
    route, timeout) are transient and trigger the normal retry/backoff loop.
    """

    def __init__(self, ssh_args, ping_host='localhost', ping_host_label=None, original_ssh_args=None, hosts_map=None):
        self._ssh_dest = ssh_args[-1] if ssh_args else ''
        self._ssh_dest_label = (original_ssh_args[-1] if original_ssh_args else None) or self._ssh_dest
        self._ping_host_label = ping_host_label or ping_host
        display = f"{self._ssh_dest_label}→{self._ping_host_label}"
        super().__init__(display)
        self._ssh_args = ssh_args      # e.g. ['-J', '10.0.0.1', 'user@remote'] (resolved)
        self._original_ssh_args = original_ssh_args or ssh_args.copy()  # original args before :resolv
        self._ping_host = ping_host    # host that the remote ping targets
        self._hosts_map = hosts_map or {}  # reference to Application.hosts_map
        # Pre-populate resolved_ip when ping_host is already an IP address.
        # This covers the :resolv case where actual_ping_host is already an IP
        # so dns_mode='ip' works immediately without an extra resolution thread.
        if _is_ip(ping_host):
            self.resolved_ip = ping_host

    @staticmethod
    def _strip_username(host_string):
        """Strip username@ prefix from hostname for display.

        Args:
            host_string: Host specification, optionally prefixed with 'user@'

        Returns:
            Hostname without username prefix

        Examples:
            'host' → 'host'
            'user@host' → 'host'
            '10.0.0.1' → '10.0.0.1'
            'user@10.0.0.1' → '10.0.0.1'
        """
        if '@' in host_string:
            return host_string.split('@', 1)[1]
        return host_string

    def _extract_jump_hosts(self, ssh_args):
        """Extract jump hosts from -J and -o ProxyJump flags in SSH arguments.

        Parses SSH command arguments to find ProxyJump hosts specified
        via the -J flag or -o ProxyJump= option. Handles comma-separated
        multi-hop jumps.

        Args:
            ssh_args: List of SSH command arguments to parse

        Returns:
            List of jump host strings in order (e.g., ['host1', 'user@host2'])
            Empty list if no jump hosts found
        """
        jump_hosts = []
        i = 0
        while i < len(ssh_args):
            if ssh_args[i] == '-J' and i + 1 < len(ssh_args):
                # Split comma-separated hosts: -J host1,host2,host3
                hosts_str = ssh_args[i + 1]
                jump_hosts.extend([h.strip() for h in hosts_str.split(',') if h.strip()])
                i += 2
            elif ssh_args[i].startswith('-oProxyJump='):
                # Format: -oProxyJump=host (no space)
                hosts_str = ssh_args[i].split('=', 1)[1]
                jump_hosts.extend([h.strip() for h in hosts_str.split(',') if h.strip()])
                i += 1
            elif ssh_args[i] == '-o' and i + 1 < len(ssh_args):
                # Format: -o ProxyJump=host (with space)
                next_arg = ssh_args[i + 1]
                if next_arg.startswith('ProxyJump='):
                    hosts_str = next_arg.split('=', 1)[1]
                    jump_hosts.extend([h.strip() for h in hosts_str.split(',') if h.strip()])
                    i += 2
                else:
                    i += 1
            else:
                i += 1
        return jump_hosts

    def resolve_dns(self):
        """Resolve the *ping host* (not the SSH destination) to its IP and hostname.

        Overrides PingMonitor.resolve_dns() to target self._ping_host instead
        of self.host (the composite label), so dns_mode='ip' and 'hostname'
        show the address of the host being pinged, not the SSH destination.
        """
        try:
            ip = socket.gethostbyname(self._ping_host)
            self.resolved_ip = ip
        except Exception:
            self.resolved_ip = None

        lookup_addr = self.resolved_ip if self.resolved_ip else self._ping_host
        try:
            self.resolved_hostname = socket.gethostbyaddr(lookup_addr)[0]
        except Exception:
            self.resolved_hostname = None

    def _reverse_lookup_alias(self, host_or_ip):
        """Look up the original alias for a resolved host/IP in hosts_map.

        Checks if host_or_ip appears as a resolved value in self._hosts_map
        and returns the corresponding alias. Falls back to host_or_ip if no
        mapping is found or _hosts_map is unavailable.

        If host_or_ip contains user@host format, strips the username before
        performing the lookup, then returns the result (username is stripped
        for display purposes by the caller).

        Args:
            host_or_ip: Resolved host or IP address to look up, optionally
                       prefixed with 'user@'

        Returns:
            Original alias if found in hosts_map, otherwise the host part
            (with username stripped if present)
        """
        if not hasattr(self, '_hosts_map') or not self._hosts_map:
            return host_or_ip

        # Strip username if present for lookup
        lookup_target = self._strip_username(host_or_ip)

        # Perform reverse lookup on the host/IP part only
        for alias, (resolved_ip, _) in self._hosts_map.items():
            if resolved_ip == lookup_target:
                return alias
        return lookup_target

    def get_display_name(self, dns_mode='off'):
        """Return the display label with complete jump host chain.

        Format: jump1 → jump2 → ... → destination → ping-host

        All hosts in the chain respect dns_mode:
          off      — original aliases/names as defined by user (via :resolv reverse lookup)
          ip       — resolved IP addresses (from :resolv mappings)
          hostname — hostnames from reverse DNS lookup

        The ping-host part is adjusted according to dns_mode:
          off      — self._ping_host_label (original name as typed on command line)
          ip       — self.resolved_ip, falling back to self._ping_host
          hostname — self.resolved_hostname, falling back to self._ping_host_label

        Username prefixes (user@) are stripped from all hosts in the chain.
        """
        display_parts = []

        # Add jump host chain respecting dns_mode
        jump_hosts = self._extract_jump_hosts(self._ssh_args)
        for jump_host in jump_hosts:
            if dns_mode == 'ip':
                # dns_mode='ip': show resolved IP
                display_parts.append(self._strip_username(jump_host))
            else:
                # dns_mode='off' or 'hostname': reverse lookup to get alias
                alias = self._reverse_lookup_alias(jump_host)
                display_parts.append(self._strip_username(alias))

        # Add SSH destination (the host we SSH into before running ping)
        if dns_mode == 'ip':
            # dns_mode='ip': show resolved value
            display_parts.append(self._strip_username(self._ssh_dest))
        else:
            # dns_mode='off' or 'hostname': reverse lookup to get alias/label
            ssh_dest_display = self._reverse_lookup_alias(self._ssh_dest_label)
            display_parts.append(self._strip_username(ssh_dest_display))

        # Add ping host with dns_mode adjustment
        if dns_mode == 'ip':
            ping_part = self.resolved_ip or self._ping_host
        elif dns_mode == 'hostname':
            ping_part = self.resolved_hostname or self._ping_host_label
        else:
            ping_part = self._ping_host_label
        display_parts.append(self._strip_username(ping_part))

        return " → ".join(display_parts)

    def _build_ping_cmd(self):
        """Build: ssh -o BatchMode=yes <ssh_args…> ping -O -D <ping_host>"""
        #return ['ssh', '-o', 'ControlMaster=no', '-o', 'BatchMode=yes'] + self._ssh_args + [
        return ['ssh', '-o', 'BatchMode=yes'] + self._ssh_args + [
            'ping', '-O', '-D', self._ping_host
        ]

    @staticmethod
    def _is_fatal_error(stderr_text):
        """Return True if stderr_text contains a known non-retryable SSH or ping error."""
        text = stderr_text.lower()
        return any(pattern in text for pattern in _FATAL_SSH_ERRORS + _FATAL_PING_ERRORS)

    def ping(self):
        """Continuously ping the host using a single persistent subprocess.

        Launches the remote ping command and reads its stdout line-by-line,
        updating stats on each success ('time=') or -O timeout
        ('no answer yet') line.  The '-D' Unix-timestamp prefix is stripped
        before parsing.
        """
        backoff = 1  # seconds; doubles on each unexpected exit, capped at 30

        while self.running:
            self._pause_event.wait()
            if not self.running:
                break
            try:
                self._proc = subprocess.Popen(
                    self._build_ping_cmd(),
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,
                )
            except Exception as exc:
                self.error = str(exc)
                with self.lock:
                    self.history.append("ERR")
                    self.history_times.append(time.time())
                break

            got_output = False

            for raw_line in self._proc.stdout:
                if not self.running:
                    break

                line = raw_line.rstrip()

                # Always use local receive time for history_times so all monitors
                # share the same clock reference regardless of remote clock skew.
                ping_ts = time.time()
                if line.startswith("["):
                    close = line.find("]")
                    if close != -1:
                        line = line[close + 2:]

                if "time=" in line:
                    try:
                        latency = float(line.split("time=")[1].split()[0])
                    except (IndexError, ValueError):
                        continue
                    with self.lock:
                        self.latency = latency
                        self.alive = True
                        self.history.append(latency)
                        self.history_times.append(ping_ts)
                        self.rx_count += 1
                        self.latencies.append(latency)
                    self.ping_count += 1
                    got_output = True
                    backoff = 1
                elif "no answer yet" in line:
                    with self.lock:
                        self.alive = False
                        self.latency = None
                        self.history.append(None)
                        self.history_times.append(ping_ts)
                        self.xx_count += 1
                    self.ping_count += 1
                    got_output = True
                    backoff = 1

            if not self.running:
                break

            try:
                stderr_text = self._proc.stderr.read()
            except Exception:
                stderr_text = ""
            self._proc.wait()

            if self._is_fatal_error(stderr_text):
                self.error = stderr_text.strip()
                with self.lock:
                    self.history.append("ERR")
                    self.history_times.append(time.time())
                break

            if not got_output:
                pass
            time.sleep(backoff)
            backoff = min(backoff * 2, 30)


class SectionLabel:
    """A non-pingable display row for section headers (## / :title)."""
    def __init__(self, title, level=1, folded_default=False):
        self.title = title
        self.level = max(1, int(level))  # 1 = top-level, 2 = sub-section, …
        self.folded = bool(folded_default)  # True = starts collapsed


def _process_for_loop(pattern, body_lines, seen_hosts, ssh_block_args=None,
                      var_names=None, variables=None):
    """Expand a ``:for`` loop and return a list of entry tuples.

    Applies back-references (``$0``–``$9`` or ``$name``) to each body
    line for every expansion of *pattern*.  Body lines that contain no
    back-reference are included only once (on the very first iteration) and a
    ``('warn', …)`` entry is emitted so the event log surfaces the issue.

    Parameters
    ----------
    pattern : str
        The ``:for`` expansion pattern (e.g. ``sensor-hub-{1-3,5}``).
    body_lines : list[str]
        Stripped body lines collected between ``:for`` and ``:done``
        (comments and blank lines are already excluded).
    seen_hosts : set
        Mutable set of already-encountered host/SSH-command strings; updated
        in place so deduplication spans the whole file.
    ssh_block_args : str or None
        When non-``None`` the loop is nested inside an ``:ssh-begin`` block;
        plain host lines become ``:ssh <ssh_block_args> <host>`` commands.
    var_names : list[str] or None
        When non-``None``, a list of variable names for named back-references
        (e.g. ``['x', 'y']`` from ``:for x,y in pattern``).
        When ``None``, numbered back-references are used (``$1``, ``$2``, ...).
    variables : dict[str, str] or None
        ``:let`` variable store from the enclosing parse context.  Each body
        line is passed through ``_expand_let_vars`` before back-reference
        substitution.  A ``None`` value is treated as an empty dict.

    Returns
    -------
    list of (str, str)
        Tuples of the same kinds as :func:`parse_hosts_file` returns, plus
        ``('warn', message)`` for no-backref and duplicate-host situations.
    """
    if variables is None:
        variables = {}
    entries = []
    try:
        rows = _expand_host_with_captures(pattern)
    except ValueError as e:
        return [('error', f":for expansion error: {e}")]

    # Track no-backref body lines already emitted (add-once logic).
    no_backref_emitted = set()

    # Local SSH context tracking for nested :ssh-begin/:ssh-end inside :for
    local_ssh_args = None
    in_local_ssh_block = False

    for iteration_idx, (full_str, captures) in enumerate(rows):
        if var_names is not None:
            captures = dict(zip(var_names, captures))
        # Loop-local variable copy so :let inside the body doesn't bleed out
        local_vars = dict(variables)
        for line in body_lines:
            # ── :let inside loop body ──────────────────────────────────────
            if line.startswith(':'):
                _parts = line.split(None, 1)
                if _parts[0][1:].lower() == 'let':
                    let_rest = _parts[1] if len(_parts) > 1 else ''
                    _lp = let_rest.split(None, 1)
                    if _lp:
                        let_name_tmpl = _lp[0]
                        let_val_tmpl  = _lp[1] if len(_lp) > 1 else ''
                        # Expand name template with current back-refs
                        let_name_exp = _apply_backref(let_name_tmpl, captures, full_str)
                        try:
                            name_rows = _expand_host_with_captures(let_name_exp)
                        except ValueError:
                            name_rows = [(let_name_exp, [], let_name_exp)]
                        for exp_name, name_caps in name_rows:
                            exp_val = _apply_backref(let_val_tmpl, captures, full_str)
                            local_vars[exp_name] = exp_val
                    continue  # :let produces no host/cmd entries

            # ── variable expansion ─────────────────────────────────────────
            # Save the pre-expansion line to check for variable back-refs; a line
            # containing $name / ${...} that gets substituted counts as dynamic
            # (should produce one entry per iteration, not be deduplicated).
            original_line = line
            line = _expand_let_vars(line, local_vars, captures, full_str)
            if not line.strip():
                continue  # expansion produced empty line — skip
            # A line is "dynamic" if it had any back-ref BEFORE expansion (including
            # $name variable refs) or still has some after (numeric $N).
            _line_was_dynamic = _has_backref(original_line)

            if line.startswith('##'):
                # Section header — apply back-references and emit every iteration.
                n_hashes = len(line) - len(line.lstrip('#'))
                rest = line[n_hashes:]
                folded_default = rest.startswith('-')
                if folded_default:
                    rest = rest[1:]
                title_tmpl = rest.strip()
                title = _apply_backref(title_tmpl, captures, full_str)
                entries.append(('section', title, n_hashes - 1, folded_default))

            elif line.startswith(':'):
                parts = line.split(None, 1)
                cmd_word = parts[0][1:].lower()
                m_title = re.match(r'^title(\d*)([-]?)$', cmd_word)
                if m_title:
                    level = int(m_title.group(1)) if m_title.group(1) else 1
                    folded_default = m_title.group(2) == '-'
                    title_tmpl = parts[1].strip() if len(parts) > 1 else ''
                    title = _apply_backref(title_tmpl, captures, full_str)
                    entries.append(('section', title, level, folded_default))
                elif cmd_word == 'ssh-begin':
                    # Open local SSH block — captures args with back-reference expansion
                    ssh_args_tmpl = parts[1].strip() if len(parts) > 1 else ''
                    in_local_ssh_block = True
                    local_ssh_args = _apply_backref(ssh_args_tmpl, captures, full_str)
                    continue  # Don't emit a command entry for :ssh-begin
                elif cmd_word == 'ssh-end':
                    # Close local SSH block
                    in_local_ssh_block = False
                    local_ssh_args = None
                    continue  # Don't emit a command entry for :ssh-end
                elif cmd_word == 'ssh':
                    # :ssh command inside :for loop
                    # If we have an effective SSH context (local or outer), chain them
                    effective_ssh_args = local_ssh_args if in_local_ssh_block else ssh_block_args
                    inner_ssh_args_tmpl = parts[1].strip() if len(parts) > 1 else ''
                    inner_ssh_args = _apply_backref(inner_ssh_args_tmpl, captures, full_str)

                    if effective_ssh_args is not None:
                        # Chain with -J: :ssh -J <outer> <inner>
                        chained_cmd = f':ssh -J {effective_ssh_args} {inner_ssh_args}'
                    else:
                        # No outer SSH context, emit as-is
                        chained_cmd = f':ssh {inner_ssh_args}'

                    # Deduplicate: use command as key
                    key = ('ssh', chained_cmd)
                    if key in seen_hosts:
                        entries.append(('warn', f'duplicate SSH command ignored: {chained_cmd}'))
                    else:
                        seen_hosts.add(key)
                        entries.append(('cmd', chained_cmd))
                else:
                    # Generic command — apply back-references and emit every iteration.
                    expanded_cmd = _apply_backref(line, captures, full_str)
                    entries.append(('cmd', expanded_cmd))

            else:
                # Host line.  A leading '?' marks it as optional: silently skip if the
                # expanded name has no :resolv mapping at Application init time.
                optional = line.startswith('?')
                host_line = line[1:] if optional else line
                if _has_backref(host_line) or _line_was_dynamic:
                    # Substitute back-references then expand remaining brace groups.
                    expanded_tmpl = _apply_backref(host_line, captures, full_str)
                    try:
                        expanded_hosts = _expand_host(expanded_tmpl)
                    except ValueError as e:
                        entries.append(('error', str(e)))
                        continue
                    effective_ssh_args = local_ssh_args if in_local_ssh_block else ssh_block_args
                    for host in expanded_hosts:
                        key = (effective_ssh_args, host)
                        if key in seen_hosts:
                            entries.append(('warn', f"duplicate host ignored: {host}"))
                        else:
                            seen_hosts.add(key)
                            if effective_ssh_args is not None:
                                # '?' not supported for SSH hosts inside :for — add normally.
                                entries.append(('cmd', f':ssh {effective_ssh_args} {host}'))
                            else:
                                entries.append(('optional_host' if optional else 'host', host))
                else:
                    # No back-reference — include only on first encounter, then warn.
                    if host_line not in no_backref_emitted:
                        no_backref_emitted.add(host_line)
                        entries.append(('warn',
                            f"host {host_line!r} inside :for loop has no back-reference; added once"))
                        try:
                            expanded_hosts = _expand_host(host_line)
                        except ValueError as e:
                            entries.append(('error', str(e)))
                            continue
                        effective_ssh_args = local_ssh_args if in_local_ssh_block else ssh_block_args
                        for host in expanded_hosts:
                            key = (effective_ssh_args, host)
                            if key in seen_hosts:
                                entries.append(('warn', f"duplicate host ignored: {host}"))
                            else:
                                seen_hosts.add(key)
                                if effective_ssh_args is not None:
                                    entries.append(('cmd', f':ssh {effective_ssh_args} {host}'))
                                else:
                                    entries.append(('optional_host' if optional else 'host', host))

    return entries


def parse_hosts_file(filename, variables=None):
    """Parse a hosts file and return an ordered list of entry tuples.

    Each tuple is one of:
      ('host',    'hostname-or-ip')  — a host to ping
      ('section', 'Title text')      — a section header (display-only row)
      ('cmd',     ':cmd [args]')     — a startup command applied before monitoring begins
      ('warn',    'message')         — non-fatal warning (duplicate host, no back-ref, …)
      ('error',   'message')         — non-fatal parse/expansion error

    File format rules:
      ## Title        — section header (legacy); 'Title' is everything after '## '
      :title Title    — section header (preferred); 'Title' is everything after ':title '
      :let name val   — define a variable; ``$name`` is substituted in subsequent lines.
                        The name may contain brace expansion (e.g. ``name{1..4}``);
                        ``$N`` in the value is eagerly expanded per brace index.
      :ssh-begin [ssh-opts] <dest>
                      — open an SSH block; all plain host lines until :ssh-end are
                        expanded into ':ssh [ssh-opts] <dest> <host>' commands.
                        Blocks may not be nested.
      :ssh-end        — close the current SSH block
      :for pattern    — open a loop; every body line is repeated for each expansion
                        of *pattern*, with back-references (\\N / $N) substituted.
                        :for may appear inside an :ssh-begin block.
      :done           — close the most recent :for loop; if the file ends without
                        :done, an implicit :done is applied at EOF so the loop still
                        produces its entries (useful for :source'd files)
      :cmd [args]     — any other ':'-prefixed line is treated as a startup command
                        (same syntax as the interactive ':' command line)
      # ...           — comment line; ignored entirely
      (empty)         — blank line; ignored
      anything else   — treated as a host/IP address to ping (or, inside an
                        :ssh-begin block, expanded to an :ssh command)
    """
    if variables is None:
        variables = {}
    entries = []
    ssh_block_args = None  # None = not inside an :ssh-begin block; str = SSH args

    # Global dedup: (ssh_block_args_or_None, host) → already seen.
    seen_hosts = set()

    # :for loop state
    for_loop_pattern = None   # None = not inside a :for loop; str = loop pattern
    for_loop_var_name = None  # None = legacy mode; str = named variable (e.g. 'x' from ':for x in pattern')
    for_loop_body = []        # body lines collected between :for and :done
    for_loop_ssh_args = None  # ssh_block_args captured when :for was opened

    with open(filename) as f:
        # Pre-process: join continuation lines (a line ending with '\' is
        # concatenated with the next line, with the backslash removed).
        # This enables the portable self-executing hosts-file idiom:
        #   # \
        #   exec ping-bulk -f "$0" "$@"
        # Shell ignores '# \' as a comment and runs the exec; ping-bulk joins
        # the two lines into '# exec ping-bulk …' which it then skips as a comment.
        raw_lines = []
        buf = ''
        for raw in f:
            stripped = raw.rstrip('\n')
            if stripped.endswith('\\'):
                buf += stripped[:-1]
            else:
                raw_lines.append(buf + stripped)
                buf = ''
        if buf:
            raw_lines.append(buf)

        for line in raw_lines:
            line = line.strip()
            if not line:
                continue

            # Strip inline comments: '## label' on host lines, ' # comment' on any line.
            # Section-header lines (starting with '##') are left untouched.
            line, inline_comment = _strip_inline_comment(line)
            if not line:
                continue

            # ── :for body collection ───────────────────────────────────────
            if for_loop_pattern is not None:
                # Skip comments inside the body (but keep ## section headers).
                if line.startswith('#') and not line.startswith('##'):
                    continue
                if line.startswith(':'):
                    parts = line.split(None, 1)
                    cmd_word = parts[0][1:].lower()
                    if cmd_word == 'done':
                        # End of loop — process the collected body.
                        entries.extend(_process_for_loop(
                            for_loop_pattern, for_loop_body,
                            seen_hosts, for_loop_ssh_args,
                            var_names=for_loop_var_name,
                            variables=variables,
                        ))
                        for_loop_pattern = None
                        for_loop_body = []
                        for_loop_ssh_args = None
                        continue
                    elif cmd_word == 'for':
                        entries.append(('error', "nested :for is not supported"))
                        continue
                    elif cmd_word == 'ssh-begin':
                        entries.append(('error', ":ssh-begin inside :for is not supported"))
                        continue
                    elif cmd_word == 'ssh-end':
                        entries.append(('error', ":ssh-end inside :for is not supported"))
                        continue
                for_loop_body.append(line)
                continue

            # ── Normal line processing (outside a :for loop) ───────────────
            if line.startswith('##'):
                n_hashes = len(line) - len(line.lstrip('#'))
                rest = line[n_hashes:]
                folded_default = rest.startswith('-')
                if folded_default:
                    rest = rest[1:]
                title = rest.strip()
                entries.append(('section', title, n_hashes - 1, folded_default))
            elif line.startswith('#'):
                continue  # comment — skip
            elif line.startswith(':'):
                parts = line.split(None, 1)
                cmd_word = parts[0][1:].lower()  # strip leading ':'
                if cmd_word == 'let':
                    # :let name [value]  — define or redefine a variable.
                    # The name itself may contain brace expansion; $N in the value is
                    # eagerly expanded once per brace-index iteration.
                    let_rest = parts[1].strip() if len(parts) > 1 else ''
                    let_parts = let_rest.split(None, 1)
                    if not let_parts:
                        entries.append(('error', ':let: missing variable name'))
                    else:
                        let_name_tmpl = let_parts[0]
                        let_val_tmpl  = let_parts[1] if len(let_parts) > 1 else ''
                        try:
                            name_rows = _expand_host_with_captures(let_name_tmpl)
                        except ValueError as e:
                            entries.append(('error', f':let name expansion error: {e}'))
                            name_rows = []
                        for exp_name, name_caps in name_rows:
                            exp_val = _apply_backref(let_val_tmpl, name_caps, let_val_tmpl)
                            variables[exp_name] = exp_val
                    continue
                # Apply variable expansion to all other :-directives before parsing them.
                line = _expand_let_vars(line, variables)
                if not line.strip():
                    continue
                parts = line.split(None, 1)
                cmd_word = parts[0][1:].lower()  # re-parse after expansion
                m_title = re.match(r'^title(\d*)([-]?)$', cmd_word)
                if m_title:
                    level = int(m_title.group(1)) if m_title.group(1) else 1
                    folded_default = m_title.group(2) == '-'
                    title = parts[1].strip() if len(parts) > 1 else ''
                    entries.append(('section', title, level, folded_default))
                elif cmd_word == 'ssh-begin':
                    # Start SSH block — remainder of line is the SSH args (opts + dest)
                    ssh_block_args = parts[1].strip() if len(parts) > 1 else ''
                elif cmd_word == 'ssh-end':
                    ssh_block_args = None
                elif cmd_word == 'for':
                    # Start :for loop — capture pattern and current SSH context.
                    # Support both syntaxes:
                    #   :for pattern              → numbered backrefs ($1, $2, ...)
                    #   :for x,y in pattern       → named backrefs ($x, $y, ...)
                    for_args = parts[1].strip() if len(parts) > 1 else ''
                    if ' in ' in for_args:
                        var_part, pattern_part = for_args.split(' in ', 1)
                        var_names = [v.strip() for v in var_part.split(',')]
                        for_loop_pattern = pattern_part.strip()
                        for_loop_var_name = var_names  # store as list for processing
                    else:
                        for_loop_pattern = for_args
                        for_loop_var_name = None
                    for_loop_body = []
                    for_loop_ssh_args = ssh_block_args
                elif cmd_word == 'done':
                    entries.append(('error', ":done without :for"))
                elif cmd_word == 'ssh' and ssh_block_args is not None:
                    # Nested :ssh inside :ssh-begin — chain the jump hosts
                    # :ssh-begin user1@host1 + :ssh user2@host2 target
                    # becomes: :ssh -J user1@host1 user2@host2 target
                    inner_ssh_args = parts[1].strip() if len(parts) > 1 else ''
                    chained_cmd = f':ssh -J {ssh_block_args} {inner_ssh_args}'
                    entries.append(('cmd', chained_cmd))
                else:
                    entries.append(('cmd', line))
            else:
                # Apply variable expansion before processing host lines.
                line = _expand_let_vars(line, variables)
                if not line.strip():
                    continue
                if ssh_block_args is not None:
                    # Inside an :ssh-begin block — expand each host and emit an :ssh command.
                    try:
                        expanded = _expand_host(line)
                    except ValueError as e:
                        entries.append(('error', str(e)))
                    else:
                        for host in expanded:
                            key = (ssh_block_args, host)
                            if key in seen_hosts:
                                entries.append(('warn', f"duplicate host ignored: {host}"))
                            else:
                                seen_hosts.add(key)
                                entries.append(('cmd', f':ssh {ssh_block_args} {host}'))
                else:
                    # Plain host line — expand brace notation into individual entries.
                    # A leading '?' marks the host as optional: silently skip at init
                    # time if no :resolv mapping has been registered for the expanded name.
                    optional = line.startswith('?')
                    host_line = line[1:] if optional else line
                    # Use _expand_host_with_captures so that back-references in the
                    # inline ## comment (e.g. '10.0.0.{1..4} ## host$1') are resolved
                    # to the value each brace group contributed for that row.
                    try:
                        expanded = _expand_host_with_captures(host_line)
                    except ValueError as e:
                        entries.append(('error', str(e)))
                    else:
                        for host, captures in expanded:
                            key = (None, host)
                            if key in seen_hosts:
                                entries.append(('warn', f"duplicate host ignored: {host}"))
                            else:
                                seen_hosts.add(key)
                                if inline_comment and _is_ip(host):
                                    resolved_comment = _apply_backref(
                                        inline_comment, captures, host
                                    )
                                    entries.append(('cmd', f':resolv {host} {resolved_comment}'))
                                entries.append(('optional_host' if optional else 'host', host))

    # EOF while inside a :for loop — treat as implicit :done so that files
    # ending with a :for block (no trailing :done) work correctly, including
    # when loaded interactively via :source.
    if for_loop_pattern is not None:
        entries.extend(_process_for_loop(
            for_loop_pattern, for_loop_body,
            seen_hosts, for_loop_ssh_args,
            var_names=for_loop_var_name,
            variables=variables,
        ))

    return entries


class CmdDef:
    """Descriptor for a single ':' command: names, handler, completion choices, help text.

    names         — list of accepted command names / aliases (all lower-case)
    action        — name of the Application method to call: ``method(self, args: str)``
    arg_choices   — None, a static list[str], or a zero-argument callable returning list[str];
                    used by _get_completions to offer Tab-completion on the second token
    arg_completer — None, or a callable ``(prefix: str) -> list[str]`` for dynamic completion
                    (e.g. filesystem paths); takes priority over arg_choices when set
    usage         — short argument synopsis shown in help (e.g. '[off|hostname|ip]')
    help          — one-line description shown in the help overlay
    cli_flags     — tuple of CLI flags (e.g. ('-f', '--file')), if this command can be passed via CLI
    cli_kwargs    — dict of kwargs to pass to argparse.add_argument() for the cli_flags
    """
    __slots__ = ('names', 'action', 'arg_choices', 'arg_completer', 'usage', 'help', 'completable', 'cli_flags', 'cli_kwargs')

    def __init__(self, names, action, arg_choices=None, usage='', help='', arg_completer=None, completable=True, cli_flags=None, cli_kwargs=None):
        self.names         = names
        self.action        = action
        self.arg_choices   = arg_choices
        self.arg_completer = arg_completer
        self.usage         = usage
        self.help          = help
        self.completable   = completable
        self.cli_flags     = cli_flags
        self.cli_kwargs    = cli_kwargs


def _complete_log_arg(prefix):
    """Return Tab-completion candidates for the :log command argument.

    Combines the static keyword 'off' with live filesystem completions rooted
    at *prefix*.  Directories are returned with a trailing '/' so the user can
    keep pressing Tab to descend into them.
    """
    import glob as _glob

    results = []
    # Static keyword — include when it matches the prefix (case-insensitive)
    if 'off'.startswith(prefix.lower()):
        results.append('off')
    # Filesystem completions
    pattern = prefix + '*'
    try:
        matches = _glob.glob(pattern)
    except Exception:
        matches = []
    for m in sorted(matches):
        results.append(m + '/' if os.path.isdir(m) else m)
    return results


def _complete_path_arg(prefix):
    import glob as _glob
    results = []
    pattern = prefix + '*'
    try:
        matches = _glob.glob(pattern)
    except Exception:
        matches = []
    for m in sorted(matches):
        results.append(m + '/' if os.path.isdir(m) else m)
    return results

