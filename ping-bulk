class _KeyTrie:
    """Prefix tree mapping key-code sequences to mode- and context-aware bindings.

    Each node stores a dict ``bindings`` keyed by UI mode name (``'normal'``,
    ``'help'``, ``'details'``, ``'command'``).  Each mode bucket maps context
    keys to ``_Binding`` objects.  A ``None`` context key is the unconditional
    (fallback) binding; a frozenset key restricts the binding to states where
    all listed context variables are available.

    This single structure replaces the former ``_mode_bindings`` parallel dict,
    giving one dispatch path and one save/load path for all modes.
    """
    __slots__ = ('children', 'bindings')

    def __init__(self):
        self.children = {}   # dict[int, _KeyTrie]
        self.bindings = {}   # dict[mode_str, dict[frozenset|None, _Binding]]

    def insert(self, keys, binding):
        """Insert a binding for a sequence of key codes.

        The binding's ``mode`` attribute (comma-separated) determines which
        mode buckets it is stored in.  For non-normal modes context guards are
        irrelevant, so the binding is always stored under the ``None`` context
        key in those buckets (the same ``_Binding`` object is shared).
        """
        node = self
        for key in keys:
            if key not in node.children:
                node.children[key] = _KeyTrie()
            node = node.children[key]
        for mode in binding.mode.split(','):
            mode = mode.strip()
            ctx_key = binding.context if mode == 'normal' else None
            node.bindings.setdefault(mode, {})[ctx_key] = binding

    def lookup(self, keys):
        """Look up a key sequence.

        Returns ``(bindings_dict, has_children)`` where *bindings_dict* maps
        mode names to context-keyed dicts of ``_Binding`` objects.
        """
        node = self
        for key in keys:
            if key not in node.children:
                return ({}, False)
            node = node.children[key]
        return (node.bindings, bool(node.children))

    def resolve(self, keys, ctx_keys, mode='normal'):
        """Look up a key sequence and resolve the best matching binding.

        *ctx_keys* is a set of available context variable names (e.g.
        ``{'h', 'i'}`` when a host is selected).  *mode* selects the mode
        bucket to search in.

        Returns ``(binding|None, has_children)``.  The most-specific
        matching context wins (largest subset of *ctx_keys*); ``None``
        context is the fallback.
        """
        node = self
        for key in keys:
            if key not in node.children:
                return (None, False)
            node = node.children[key]
        binding = _resolve_binding(node.bindings.get(mode, {}), ctx_keys)
        return (binding, bool(node.children))

    def remove(self, keys, context=None, mode='normal'):
        """Remove binding at *keys* for *context* in *mode*, pruning empty ancestors.

        Returns True if a binding was removed.
        """
        if not keys:
            return False
        path = [self]
        node = self
        for key in keys:
            if key not in node.children:
                return False
            node = node.children[key]
            path.append(node)
        mode_dict = node.bindings.get(mode)
        if mode_dict is None or context not in mode_dict:
            return False
        del mode_dict[context]
        if not mode_dict:
            del node.bindings[mode]
        # Prune empty ancestors
        for i in range(len(keys) - 1, -1, -1):
            child = path[i + 1]
            if child.bindings or child.children:
                break
            del path[i].children[keys[i]]
        return True

    def remove_all(self, keys, mode=None):
        """Remove ALL bindings at *keys* for *mode* (or all modes if None).

        Returns True if any binding was removed.
        """
        if not keys:
            return False
        path = [self]
        node = self
        for key in keys:
            if key not in node.children:
                return False
            node = node.children[key]
            path.append(node)
        if mode is not None:
            if mode not in node.bindings:
                return False
            del node.bindings[mode]
        else:
            if not node.bindings:
                return False
            node.bindings.clear()
        # Prune empty ancestors
        for i in range(len(keys) - 1, -1, -1):
            child = path[i + 1]
            if child.bindings or child.children:
                break
            del path[i].children[keys[i]]
        return True

    def clear_subtree(self, keys):
        """Remove all children under *keys* (keep the node's own bindings)."""
        node = self
        for key in keys:
            if key not in node.children:
                return
            node = node.children[key]
        node.children.clear()

    def __iter__(self):
        """Yield ``(key_list, binding)`` for every binding (DFS, sorted).

        Multi-mode bindings (same ``_Binding`` object in multiple mode buckets)
        are yielded only once.
        """
        seen_ids = set()

        def _walk(node, prefix):
            for mode in sorted(node.bindings):
                ctx_dict = node.bindings[mode]
                for ctx in sorted(ctx_dict, key=lambda c: (c is not None, c or frozenset())):
                    b = ctx_dict[ctx]
                    if id(b) not in seen_ids:
                        seen_ids.add(id(b))
                        yield (prefix[:], b)
            for key, child in sorted(node.children.items()):
                prefix.append(key)
                yield from _walk(child, prefix)
                prefix.pop()

        yield from _walk(self, [])

    def node_at(self, keys):
        """Return the trie node reached by *keys*, or None if the path doesn't exist."""
        node = self
        for key in keys:
            if key not in node.children:
                return None
            node = node.children[key]
        return node

def _resolve_binding(bindings, ctx_keys):
    """Pick the best _Binding from *bindings* dict for *ctx_keys*.

    Most-specific context (largest matching frozenset) wins.
    ``None`` context is the fallback.
    """
    if not bindings:
        return None
    best = None
    best_size = -1
    for ctx, b in bindings.items():
        if ctx is None:
            if best_size < 0:
                best = b
                best_size = 0
        elif ctx <= ctx_keys:
            if len(ctx) > best_size:
                best = b
                best_size = len(ctx)
    return best


