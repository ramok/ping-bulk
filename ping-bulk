def _is_ip(s):
    """Return True if *s* looks like an IPv4 or IPv6 address (not a hostname).

    IPv4: four dot-separated decimal octets (0-255).
    IPv6: any string containing a colon (covers full, compressed, and
          link-local forms without requiring a full parser).
    """
    if ':' in s:
        return True  # IPv6
    parts = s.split('.')
    if len(parts) != 4:
        return False
    for p in parts:
        if not p.isdigit():
            return False
        if not (0 <= int(p) <= 255):
            return False
    return True


def _expand_brace_group(inner):
    """Expand the content of a single (innermost) brace group.

    Supports three forms, which may be mixed freely in a comma-separated list:
      range item  — n..m or n-m  → each integer in [n, m] (inclusive, step ±1)
      literal     — any other token → used as-is

    Returns a list of strings (one per alternative).

    Raises ValueError when the group is invalid:
      - empty group: {}
      - empty item:  {a,,b}  or  {,}  (trailing/leading/consecutive comma)
    """
    import re

    if not inner:
        raise ValueError("empty brace group '{}'")

    items = inner.split(',')
    result = []
    for item in items:
        if not item:
            raise ValueError(f"empty item in brace group '{{{inner}}}'")
        range_m = re.fullmatch(r'(-?\d+)(?:\.\.|-)(-?\d+)', item)
        if range_m:
            lo, hi = int(range_m.group(1)), int(range_m.group(2))
            step = 1 if lo <= hi else -1
            result.extend(str(v) for v in range(lo, hi + step, step))
        else:
            result.append(item)
    return result


def _expand_host(s):
    """Expand a host/IP string that may contain brace range/list notation.

    Works for both IP addresses and hostnames.  Supported forms (may be
    combined freely; nested braces are expanded inside-out):

      10.0.0.{1,2,5}          — brace list  → 10.0.0.1, 10.0.0.2, 10.0.0.5
      10.0.0.{1..4}           — brace range → 10.0.0.1 … 10.0.0.4
      10.0.0.{1-4}            — brace range → 10.0.0.1 … 10.0.0.4  (zsh style)
      10.{1..2}.0.{1,5}       — two groups  → 2×2 = 4 addresses (cartesian)
      10.0.0.{10,11..12,14}   — mixed list+range → .10, .11, .12, .14
      web{1..3}.example.com   — brace range → web1.example.com … web3.example.com
      web{a,b,c}.example.com  — brace list  → weba, webb, webc .example.com
      10.0.{1..2}.{10,2{1,2}} — nested braces → cartesian product (8 addresses)

    Strings without any expansion syntax are returned as a single-item list.

    Raises ValueError when a brace group is invalid (empty group, empty item
    after comma split).  Callers should catch this and report the error.
    """
    import re

    # Find the innermost brace group (no nested braces inside).
    m = re.search(r'\{([^{}]*)\}', s)
    if not m:
        return [s]  # no braces — plain string

    alternatives = _expand_brace_group(m.group(1))  # may raise ValueError

    result = []
    for alt in alternatives:
        expanded = s[:m.start()] + alt + s[m.end():]
        result.extend(_expand_host(expanded))  # recurse for remaining braces
    return result


def _expand_host_with_captures(pattern):
    """Expand *pattern* and return a list of ``(expanded_str, captures)`` pairs.

    Like :func:`_expand_host` but also tracks *which value each top-level
    brace group contributed* to every result, enabling ``\\N`` back-references
    in companion strings (e.g. the hostname side of a ``:resolv`` command).

    Algorithm
    ---------
    1. Walk the pattern once and locate every **top-level** ``{…}`` group
       (balanced, left-to-right; nested braces are skipped over).
    2. For each group, split its inner content on top-level commas, then
       expand each item: range notation (``n..m`` or ``n-m``) → integer
       sequence; anything else → via :func:`_expand_host` (handles nested
       braces recursively).  The result is the list of *alternative values*
       for that group.
    3. Compute the cartesian product across all groups.  For each combination
       ``(v1, v2, …)`` build the substituted string and record the captures.

    Returns
    -------
    list of ``(str, list[str])``
        ``expanded_str`` is the fully substituted string (same as what
        :func:`_expand_host` would return).
        ``captures`` is ``[v1, v2, …]`` where ``vi`` is the string value
        that the *i*-th top-level group (1-based) produced for this row.

    Patterns without any brace groups return ``[(pattern, [])]``.

    Raises :exc:`ValueError` for empty groups or empty comma-separated items
    (same contract as :func:`_expand_brace_group`).
    """
    import re
    import itertools

    # ── Step 1: find every top-level balanced brace group ─────────────────
    groups = []  # list of (start, end) — half-open slice, pattern[start:end] == '{…}'
    i = 0
    while i < len(pattern):
        if pattern[i] == '{':
            depth = 1
            j = i + 1
            while j < len(pattern) and depth > 0:
                if pattern[j] == '{':
                    depth += 1
                elif pattern[j] == '}':
                    depth -= 1
                j += 1
            if depth == 0:
                groups.append((i, j))  # j is one past the closing '}'
                i = j
                continue
        i += 1

    if not groups:
        return [(pattern, [])]

    # ── Step 2: expand each group to its list of alternative strings ───────
    group_alts = []
    for start, end in groups:
        inner = pattern[start + 1:end - 1]
        if not inner:
            raise ValueError("empty brace group '{}'")

        # Split inner content on *top-level* commas (ignore commas inside
        # nested braces).
        items = []
        depth = 0
        buf = []
        for ch in inner:
            if ch == '{':
                depth += 1
                buf.append(ch)
            elif ch == '}':
                depth -= 1
                buf.append(ch)
            elif ch == ',' and depth == 0:
                items.append(''.join(buf))
                buf = []
            else:
                buf.append(ch)
        items.append(''.join(buf))

        alts = []
        for item in items:
            if not item:
                raise ValueError(f"empty item in brace group '{{{inner}}}'")
            # Range notation: n..m or n-m
            range_m = re.fullmatch(r'(-?\d+)(?:\.\.|-)(-?\d+)', item)
            if range_m:
                lo, hi = int(range_m.group(1)), int(range_m.group(2))
                step = 1 if lo <= hi else -1
                alts.extend(str(v) for v in range(lo, hi + step, step))
            else:
                # Recurse into nested braces (if any) via the existing helper.
                alts.extend(_expand_host(item))
        group_alts.append(alts)

    # ── Step 3: cartesian product → substituted strings + captures ─────────
    results = []
    for combo in itertools.product(*group_alts):
        # Replace groups right-to-left so earlier offsets stay valid.
        s = pattern
        for (start, end), val in zip(reversed(groups), reversed(combo)):
            s = s[:start] + val + s[end:]
        results.append((s, list(combo)))

    return results


def _apply_backref(template, captures):
    r"""Substitute ``\1``…``\9`` in *template* with values from *captures*.

    ``\N`` (1-based) is replaced by ``captures[N-1]``.  References to
    groups that do not exist (index out of range) are left unchanged so
    the user can see the un-substituted placeholder rather than silently
    getting wrong output.

    Parameters
    ----------
    template : str
        String that may contain ``\1`` … ``\9`` placeholders.
    captures : list[str]
        Values produced by :func:`_expand_host_with_captures` for one row.

    Returns
    -------
    str
        *template* with all in-range ``\N`` sequences replaced.
    """
    import re

    def _sub(m):
        idx = int(m.group(1))
        return captures[idx - 1] if 1 <= idx <= len(captures) else m.group(0)

    return re.sub(r'\\(\d)', _sub, template)


def _config_path():
    """Return the XDG-compliant config file path for ping-bulk.

    Respects ``$XDG_CONFIG_HOME`` when set; falls back to ``~/.config``.
    The returned path is ``<base>/ping-bulk/config``.
    """
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = xdg if xdg else os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'ping-bulk', 'config')


def _history_path():
    """Return the XDG-compliant command history file path for ping-bulk.

    Respects ``$XDG_STATE_HOME`` when set; falls back to ``~/.local/state``.
    The returned path is ``<base>/ping-bulk/history``.
    """
    xdg = os.environ.get('XDG_STATE_HOME', '')
    base = xdg if xdg else os.path.join(os.path.expanduser('~'), '.local', 'state')
    return os.path.join(base, 'ping-bulk', 'history')


def _history_char(val, mode):
    """Convert a raw history value (float ms, None, or 'ERR') to a single display character.

    success — '.' for any successful ping, 'X' for timeout, '?' for process error
    rtt     — last digit of int(ms) for success, 'X' for timeout, '?' for process error
    scaled  — digit 0-9 mapping 10 ms buckets (0=<10ms … 9=90+ms), 'X' for timeout,
              '?' for process error
    """
    if val == 'ERR':
        return '?'
    if val is None:
        return 'X'
    if mode == 'rtt':
        return str(int(round(val)))[-1]
    if mode == 'scaled':
        scaled = round(val / 100 * 9)
        return '>' if scaled > 9 else str(scaled)
    return '.'  # 'success' mode

class PingMonitor:
    def __init__(self, host):
        self.host = host
        self.resolved_ip = None        # IP address resolved from a hostname
        self.resolved_hostname = None  # hostname resolved from an IP (reverse DNS)
        self.alive = None
        self.latency = None
        self.history = deque(maxlen=100)
        self.latencies = []    # all recorded latency values (successful pings)
        self.rx_count = 0      # total successful pings (RX)
        self.xx_count = 0      # total failed pings (XX)
        self.last_state = None
        self.down_since = None  # monotonic timestamp of when the host went down
        self.ping_count = 0    # total pings ever sent (never capped, unlike history deque)
        self.running = True
        self.lock = threading.Lock()
        self.error = None          # str when a fatal process-level error occurred, else None
        self.error_logged = False  # True once the error has been added to the event log
        self._proc = None          # active Popen handle for the persistent ping subprocess
        self.resolv_static = False  # True when a :resolv static mapping overrides DNS

    def resolve_dns(self):
        """Resolve the host to both its IP address and its hostname.

        resolved_ip       — forward DNS: hostname → IP (or self if already an IP)
        resolved_hostname — reverse DNS: IP → hostname (or self if already a hostname)
        Both fields are populated in a single call so switching modes never
        requires a second resolution thread.
        """
        # Forward: resolve to IP address
        try:
            ip = socket.gethostbyname(self.host)
            self.resolved_ip = ip
        except Exception:
            self.resolved_ip = None

        # Reverse: resolve to hostname via the IP we just found (or the host itself)
        lookup_addr = self.resolved_ip if self.resolved_ip else self.host
        try:
            self.resolved_hostname = socket.gethostbyaddr(lookup_addr)[0]
        except Exception:
            self.resolved_hostname = None

    def _build_ping_cmd(self):
        """Return the command list used to launch the ping subprocess.

        Subclasses override this to run ping over a different transport
        (e.g. SSH).  The default implementation runs the local system ping
        with '-O' (report unanswered probes) and '-D' (Unix-timestamp prefix).

        When resolv_static is True a :resolv mapping has been applied, so ping
        targets the resolved IP directly instead of the original hostname.
        """
        target = self.resolved_ip if (self.resolv_static and self.resolved_ip) else self.host
        return ['ping', '-O', '-D', target]

    def ping(self):
        """Continuously ping the host using a single persistent subprocess.

        Launches 'ping -O -D <host>' once and reads its stdout line-by-line,
        updating stats on each success ('time=') or -O timeout
        ('no answer yet') line.  The '-D' Unix-timestamp prefix is stripped
        before parsing.

        Fatal errors (e.g. unknown host, permission denied) set self.error
        and stop the loop permanently.  Unexpected exits are retried with
        exponential backoff (1 s → 2 s → 4 s … capped at 30 s); the backoff
        resets whenever any ping-result output is received.
        """
        backoff = 1  # seconds; doubles on each unexpected exit, capped at 30

        while self.running:
            try:
                self._proc = subprocess.Popen(
                    self._build_ping_cmd(),
                    stdin=subprocess.DEVNULL,   # never let the child read the terminal
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,  # line-buffered; iputils-ping flushes per line
                )
            except Exception as exc:
                self.error = str(exc)
                with self.lock:
                    self.history.append('ERR')
                break

            got_output = False  # True once any ping-result line is received

            for raw_line in self._proc.stdout:
                if not self.running:
                    break

                line = raw_line.rstrip()

                # Strip the '-D' Unix-timestamp prefix: '[1234567890.123] rest'
                if line.startswith('['):
                    close = line.find(']')
                    if close != -1:
                        line = line[close + 2:]  # skip past '] '

                if 'time=' in line:
                    # Successful reply — extract RTT
                    try:
                        latency = float(line.split('time=')[1].split()[0])
                    except (IndexError, ValueError):
                        continue
                    with self.lock:
                        self.latency = latency
                        self.alive = True
                        self.history.append(latency)
                        self.rx_count += 1
                        self.latencies.append(latency)
                    self.ping_count += 1
                    got_output = True
                    backoff = 1  # reset on any successful output
                elif 'no answer yet' in line:
                    # '-O' timeout line — one per missed icmp_seq
                    with self.lock:
                        self.alive = False
                        self.latency = None
                        self.history.append(None)
                        self.xx_count += 1
                    self.ping_count += 1
                    got_output = True
                    backoff = 1  # reset on any output

            # Stdout closed — process has exited (or we broke out on shutdown)
            if not self.running:
                break

            # Drain stderr to check for a fatal error message
            try:
                stderr_text = self._proc.stderr.read()
            except Exception:
                stderr_text = ''
            self._proc.wait()

            if self._is_fatal_error(stderr_text):
                self.error = stderr_text.strip()
                with self.lock:
                    self.history.append('ERR')
                break  # do not restart for fatal errors

            # Unexpected (non-fatal) exit — restart after backoff
            if not got_output:
                # Process exited before producing any result lines;
                # keep the current backoff penalty instead of resetting.
                pass
            time.sleep(backoff)
            backoff = min(backoff * 2, 30)

    def stop(self):
        """Stop the ping loop and terminate the subprocess cleanly."""
        self.running = False
        if self._proc is not None:
            try:
                self._proc.terminate()
            except Exception:
                pass

    @staticmethod
    def _is_fatal_error(stderr_text):
        """Return True if stderr_text contains a known non-retryable error pattern."""
        text = stderr_text.lower()
        return any(pattern in text for pattern in _FATAL_PING_ERRORS)

    def get_history_string(self, length=50, offset=0, mode='success', cell_width=1):
        """Get history as a string of given length ending offset steps from the newest sample.
        offset=0     -> most recent samples (live view)
        offset>0     -> scroll back into the past
        mode         -> one of HISTORY_MODES ('success', 'rtt', 'scaled')
        cell_width   -> characters per ping cell; >1 used by 'rtt' mode only

        When cell_width > 1 (rtt mode) each cell is exactly cell_width characters wide:
          success  -> right-justified integer in (cell_width-1) chars + one trailing space
          timeout  -> 'X' repeated (cell_width-1) times + one trailing space
          error    -> '?' repeated (cell_width-1) times + one trailing space
          blank    -> cell_width spaces
        The returned string therefore has length * cell_width characters.
        """
        with self.lock:
            history_list = list(self.history)
            total = len(history_list)
            end = total - offset
            start = end - length
            result = []
            for i in range(start, end):
                if i < 0 or i >= total:
                    cell = ' ' * cell_width if cell_width > 1 else ' '
                else:
                    val = history_list[i]
                    if cell_width > 1:
                        # rtt mode: right-justify ms value in a fixed-width field
                        num_w = cell_width - 1  # digits field width
                        if val is None:
                            cell = 'X' * num_w + ' '
                        elif val == 'ERR':
                            cell = '?' * num_w + ' '
                        else:
                            # Cap at the max representable value so the field never overflows
                            # (Python's str.format does NOT truncate, it just widens).
                            capped = min(int(round(val)), 10 ** num_w - 1)
                            cell = f"{capped:>{num_w}} "
                    else:
                        cell = _history_char(val, mode)
                result.append(cell)
            return ''.join(reversed(result))

    def get_display_name(self, dns_mode='off'):
        """Return the display name for this host according to dns_mode.

        off      — return self.host exactly as given on the command line
        hostname — return resolved_hostname if available, else fall back to host
        ip       — return resolved_ip if available, else fall back to host
        """
        if dns_mode == 'hostname':
            return self.resolved_hostname or self.host
        if dns_mode == 'ip':
            return self.resolved_ip or self.host
        return self.host  # 'off'


class SshPingMonitor(PingMonitor):
    """A PingMonitor that runs ping remotely over an SSH connection.

    Connects to the remote host using 'ssh -o BatchMode=yes' (no interactive
    password prompts) and executes 'ping -O -D <ping_host>' on the remote side.

    Constructor arguments:
      ssh_args   — list of SSH argument tokens (everything after 'ssh'),
                   e.g. ['-J', 'bastion', 'user@remote'] or ['user@remote'].
                   The SSH destination (last non-flag token) is extracted
                   automatically.
      ping_host  — the host that the remote ping will target.
      label      — display name shown in the UI (e.g. 'user@remote').

    The remote ping command is:
      ssh -o BatchMode=yes <ssh_args…> ping -O -D <ping_host>

    Fatal SSH errors (permission denied, host-key mismatch, …) stop the
    monitor permanently.  Network-level failures (connection refused, no
    route, timeout) are transient and trigger the normal retry/backoff loop.
    """

    def __init__(self, ssh_args, ping_host='localhost', label=None):
        # Use label (the SSH destination) as the display name; fall back to ping_host.
        display = label or ping_host
        super().__init__(display)
        self._ssh_args = ssh_args      # e.g. ['-J', 'bastion', 'user@remote']
        self._ping_host = ping_host    # host that the remote ping targets

    def _build_ping_cmd(self):
        """Build: ssh -o BatchMode=yes <ssh_args…> ping -O -D <ping_host>"""
        return ['ssh', '-o', 'BatchMode=yes'] + self._ssh_args + [
            'ping', '-O', '-D', self._ping_host
        ]

    @staticmethod
    def _is_fatal_error(stderr_text):
        """Return True if stderr_text contains a known non-retryable SSH or ping error."""
        text = stderr_text.lower()
        return any(pattern in text for pattern in _FATAL_SSH_ERRORS + _FATAL_PING_ERRORS)


class SectionLabel:
    """A non-pingable display row for ## section headers from a hosts file."""
    def __init__(self, title):
        self.title = title


def parse_hosts_file(filename):
    """Parse a hosts file and return an ordered list of entry tuples.

    Each tuple is one of:
      ('host',    'hostname-or-ip')  — a host to ping
      ('section', 'Title text')      — a section header (display-only row)
      ('cmd',     ':cmd [args]')     — a startup command applied before monitoring begins

    File format rules:
      ## Title        — section header (legacy); 'Title' is everything after '## '
      :title Title    — section header (preferred); 'Title' is everything after ':title '
      :ssh-begin [ssh-opts] <dest>
                      — open an SSH block; all plain host lines until :ssh-end are
                        expanded into ':ssh [ssh-opts] <dest> <host>' commands.
                        Blocks may not be nested.
      :ssh-end        — close the current SSH block
      :cmd [args]     — any other ':'-prefixed line is treated as a startup command
                        (same syntax as the interactive ':' command line)
      # ...           — comment line; ignored entirely
      (empty)         — blank line; ignored
      anything else   — treated as a host/IP address to ping (or, inside an
                        :ssh-begin block, expanded to an :ssh command)
    """
    entries = []
    ssh_block_args = None  # None = not inside an :ssh-begin block; str = SSH args
    with open(filename) as f:
        # Pre-process: join continuation lines (a line ending with '\' is
        # concatenated with the next line, with the backslash removed).
        # This enables the portable self-executing hosts-file idiom:
        #   # \
        #   exec ping-bulk -f "$0" "$@"
        # Shell ignores '# \' as a comment and runs the exec; ping-bulk joins
        # the two lines into '# exec ping-bulk …' which it then skips as a comment.
        raw_lines = []
        buf = ''
        for raw in f:
            stripped = raw.rstrip('\n')
            if stripped.endswith('\\'):
                buf += stripped[:-1]
            else:
                raw_lines.append(buf + stripped)
                buf = ''
        if buf:
            raw_lines.append(buf)

        for line in raw_lines:
            line = line.strip()
            if not line:
                continue
            if line.startswith('##'):
                title = line[2:].strip()
                entries.append(('section', title))
            elif line.startswith('#'):
                continue  # comment — skip
            elif line.startswith(':'):
                parts = line.split(None, 1)
                cmd_word = parts[0][1:].lower()  # strip leading ':'
                if cmd_word == 'title':
                    title = parts[1].strip() if len(parts) > 1 else ''
                    entries.append(('section', title))
                elif cmd_word == 'ssh-begin':
                    # Start SSH block — remainder of line is the SSH args (opts + dest)
                    ssh_block_args = parts[1].strip() if len(parts) > 1 else ''
                elif cmd_word == 'ssh-end':
                    ssh_block_args = None
                else:
                    entries.append(('cmd', line))
            else:
                if ssh_block_args is not None:
                    # Inside an :ssh-begin block — expand each host and emit an :ssh command
                    try:
                        expanded = _expand_host(line)
                    except ValueError as e:
                        entries.append(('error', str(e)))
                    else:
                        for host in expanded:
                            entries.append(('cmd', f':ssh {ssh_block_args} {host}'))
                else:
                    # Plain host line — expand brace notation into individual entries
                    try:
                        expanded = _expand_host(line)
                    except ValueError as e:
                        entries.append(('error', str(e)))
                    else:
                        for host in expanded:
                            entries.append(('host', host))
    return entries


class CmdDef:
    """Descriptor for a single ':' command: names, handler, completion choices, help text.

    names         — list of accepted command names / aliases (all lower-case)
    action        — name of the Application method to call: ``method(self, args: str)``
    arg_choices   — None, a static list[str], or a zero-argument callable returning list[str];
                    used by _get_completions to offer Tab-completion on the second token
    arg_completer — None, or a callable ``(prefix: str) -> list[str]`` for dynamic completion
                    (e.g. filesystem paths); takes priority over arg_choices when set
    usage         — short argument synopsis shown in help (e.g. '[off|hostname|ip]')
    help          — one-line description shown in the help overlay
    """
    __slots__ = ('names', 'action', 'arg_choices', 'arg_completer', 'usage', 'help', 'completable')

    def __init__(self, names, action, arg_choices=None, usage='', help='', arg_completer=None, completable=True):
        self.names         = names
        self.action        = action
        self.arg_choices   = arg_choices
        self.arg_completer = arg_completer
        self.usage         = usage
        self.help          = help
        self.completable   = completable


def _complete_log_arg(prefix):
    """Return Tab-completion candidates for the :log command argument.

    Combines the static keyword 'off' with live filesystem completions rooted
    at *prefix*.  Directories are returned with a trailing '/' so the user can
    keep pressing Tab to descend into them.
    """
    import glob as _glob

    results = []
    # Static keyword — include when it matches the prefix (case-insensitive)
    if 'off'.startswith(prefix.lower()):
        results.append('off')
    # Filesystem completions
    pattern = prefix + '*'
    try:
        matches = _glob.glob(pattern)
    except Exception:
        matches = []
    for m in sorted(matches):
        results.append(m + '/' if os.path.isdir(m) else m)
    return results


# Master command registry — single source of truth for names, handlers, and completions.
CMD_REGISTRY = [
    CmdDef(['q', 'quit'],        '_cmd_quit',      None,
           '',                    'quit the application'),
    CmdDef(['dns'],              '_cmd_dns',        lambda: [m.lower() for m in DNS_MODES],
           '[off|hostname|ip]',   'cycle or set DNS display mode'),
    CmdDef(['stats'],            '_cmd_stats',      lambda: [m.lower() for m in STATS_MODES],
           '[mode]',              'cycle or set stats column'),
    CmdDef(['sort'],             '_cmd_sort',       ['none', 'name', 'status', 'latency'],
           '[mode]',              'cycle or set sort order'),
    CmdDef(['history', 'hist'],  '_cmd_history',    lambda: [m.lower() for m in HISTORY_MODES],
           '[mode]',              'cycle or set history display mode'),
    CmdDef(['pause'],            '_cmd_pause',      None,
           '',                    'toggle pause on/off'),
    CmdDef(['seen'],             '_cmd_seen',       None,
           '',                    "insert 'seen' marker in event log"),
    CmdDef(['clear'],            '_cmd_clear',      None,
           '',                    'clear event log'),
    CmdDef(['log'],              '_cmd_log',        None,
           '[file|off]',          'show/set/disable the streaming log file',
           arg_completer=_complete_log_arg),
    CmdDef(['saveconfig'],       '_cmd_saveconfig', None,
           '',                    'save current settings to config file'),
    CmdDef(['resolv'],           '_cmd_resolv',     None,
           '<ip> <host>',         'static name→IP mapping (overrides DNS for ping and SSH)'),
    CmdDef(['ssh'],              '_cmd_ssh',        None,
           '[opts] <dest> <host>', 'remote ping over SSH (BatchMode, no password)'),
    CmdDef(['ssh-begin'],        '_cmd_ssh_begin',  None,
           '[opts] <dest>',       'open SSH block (hosts file only)',       completable=False),
    CmdDef(['ssh-end'],          '_cmd_ssh_end',    None,
           '',                    'close SSH block (hosts file only)',       completable=False),
    CmdDef(['help'],             '_cmd_help',       None,
           '',                    'show this help'),
]

# Flat name/alias → CmdDef lookup used by _dispatch_cmd and _get_completions.
_CMD_MAP: dict = {name: cmd for cmd in CMD_REGISTRY for name in cmd.names}


class Application:
    def __init__(self, entries, log_file=None):
        """Initialise the application from an ordered list of entry tuples.

        entries  — list of ('host', name), ('section', title), or ('cmd', text)
                   tuples, as returned by parse_hosts_file() or built from argv.
        log_file — optional path; new events are appended here in real time.
        self.monitors — PingMonitor instances only (used for stats/threading).
        self.entries  — ordered display list mixing PingMonitor and SectionLabel.

        All entry types are processed in a single pass in document order:
          • 'host'    — creates a PingMonitor; any static DNS override stored in
                        hosts_map by an earlier :resolv command is applied immediately.
          • 'section' — creates a SectionLabel display row.
          • 'cmd'     — dispatched inline via _dispatch_cmd() so that structural
                        commands (:ssh) appear at their correct position in the
                        display list, and configuration commands (:dns, :resolv, …)
                        take effect at the point they are encountered in the file.
        """
        self.entries = []   # ordered display list: PingMonitor | SectionLabel
        self.monitors = []  # pure PingMonitor list for stats, threading, DNS
        self.hosts_map = {}  # static DNS overrides: ip→(ip, hostname) and hostname→(ip, hostname)
        self.events = deque(maxlen=50)
        self.paused = False
        self.dns_mode = 0      # index into DNS_MODES; 0 = off (as-is)
        self.stats_mode = 0    # index into STATS_MODES; 0 = off
        self.sort_by = 'none'  # none, name, status, latency
        self.history_mode = 0  # index into HISTORY_MODES
        self.history_offset = 0  # 0 = live (newest), >0 = scrolled back
        self.log_offset = 0      # 0 = tail mode, >0 = scrolled back in event log
        self.log_file = None        # path to append event log, or None
        self._monitoring_started = False  # set True once start_monitoring() is called
        self._load_config()         # apply config-file settings (before hosts-file commands)
        if log_file is not None:    # command-line -l/--log-file always overrides config
            self.log_file = log_file
        if not os.path.exists(_config_path()):
            self._create_default_config()
        self.prompt = None        # None = no prompt; dict = prompt is open (see _open_prompt_*)
        self.cmd = None           # None = inactive; dict = command mode open (text buffer + cursor)
        self.cmd_history = []     # list of previously entered commands (oldest first)
        self._load_cmd_history()
        self.help_open = False    # True while the help overlay is visible
        self.help_scroll = 0      # first visible line index in the help overlay
        self.running = True
        self.threads = []

        for kind, value in entries:
            if kind == 'host':
                m = PingMonitor(value)
                # Apply any :resolv static DNS override that was processed earlier
                # in the same file (hosts_map is populated by _apply_hosts_entry).
                if value in self.hosts_map:
                    ip, hostname = self.hosts_map[value]
                    m.resolved_ip = ip
                    m.resolved_hostname = hostname
                    m.resolv_static = True
                self.monitors.append(m)
                self.entries.append(m)
            elif kind == 'section':
                self.entries.append(SectionLabel(value))
            elif kind == 'cmd':
                self._dispatch_cmd(value)
            elif kind == 'error':
                self.add_event("hosts", f"expansion error: {value}")

    def add_event(self, host, message):
        """Add an event to the in-memory log and, if a log file is configured,
        append it immediately to that file.

        Timestamp format: ISO 8601 with timezone offset (e.g. 2026-03-20T14:05:32+0200).
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        max_host_len = max((len(m.host) for m in self.monitors), default=len(host))
        line = f"{timestamp}   {host:<{max_host_len}} {message}"
        self.events.append(line)
        if self.log_file:
            try:
                with open(self.log_file, 'a') as f:
                    f.write(line + "\n")
            except OSError:
                pass  # silently ignore file write errors to avoid recursive events

    def _load_config(self):
        """Load settings from the XDG config file, silently ignoring a missing file.

        The file uses the same ':cmd [args]' syntax as the interactive command
        line and hosts files.  Lines starting with '#' are comments; lines that
        do not start with ':' are silently skipped.

        Supported commands:
          :dns [off|hostname|ip]   — set DNS display mode
          :stats [mode]            — set stats column mode
          :sort [mode]             — set sort order
          :history [mode]          — set history display mode
          :log [path|off]          — set or disable the streaming log file

        All commands are dispatched through _dispatch_cmd().  Because
        _monitoring_started is False at this point, no add_event() calls are
        made and no side-effects (prompts, file I/O) are triggered.
        """
        path = _config_path()
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith('#'):
                        continue
                    if not line.startswith(':'):
                        continue  # silently ignore non-command lines
                    self._dispatch_cmd(line)
        except OSError:
            pass  # missing or unreadable config file is not an error

    def _save_config(self):
        """Write current settings to the XDG config file, creating dirs as needed.

        Uses the same ':cmd args' syntax as the interactive command line so the
        file can be edited by hand with the same commands used at the ':' prompt.

        Returns True on success, False on failure (error is also logged to events).
        """
        path = _config_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                f.write("# ping-bulk configuration\n")
                f.write(f":dns {DNS_MODES[self.dns_mode]}\n")
                f.write(f":stats {STATS_MODES[self.stats_mode]}\n")
                f.write(f":sort {self.sort_by}\n")
                f.write(f":history {HISTORY_MODES[self.history_mode]}\n")
                if self.log_file:
                    f.write(f":log {self.log_file}\n")
                else:
                    f.write("# :log\n")
        except OSError as e:
            self.add_event("config", f"error saving config: {e}")
            return False
        return True

    def _create_default_config(self):
        """Create a config file with commented defaults on first run.

        Silently ignores errors (e.g. read-only filesystem or no home directory)
        so a failed write never prevents the app from starting.
        """
        path = _config_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                f.write("# ping-bulk configuration\n")
                f.write("# Generated on first run — edit as needed.\n")
                f.write("#\n")
                f.write(f"# :dns off          # choices: {' | '.join(DNS_MODES)}\n")
                f.write(f"# :stats off        # choices: {' | '.join(STATS_MODES)}\n")
                f.write( "# :sort none        # choices: none | name | status | latency\n")
                f.write(f"# :history success  # choices: {' | '.join(HISTORY_MODES)}\n")
                f.write( "# :log              # path to stream event log; leave blank to disable\n")
        except OSError:
            pass  # silently ignore — e.g. read-only filesystem or missing home directory

    def _load_cmd_history(self):
        """Load command history from the XDG state file, silently ignoring errors.

        The history file contains one command per line (oldest first).  Blank
        lines and lines that are only whitespace are skipped.  The most recent
        _HISTORY_MAXLEN entries are kept in self.cmd_history.
        """
        _HISTORY_MAXLEN = 500
        path = _history_path()
        try:
            with open(path) as f:
                lines = [l.rstrip('\n') for l in f if l.strip()]
            self.cmd_history = lines[-_HISTORY_MAXLEN:]
        except OSError:
            pass  # missing file is fine

    def _save_cmd_history(self):
        """Persist self.cmd_history to the XDG state file, creating dirs as needed.

        Only the most recent _HISTORY_MAXLEN entries are written; errors are
        silently ignored so a failed write never disrupts interactive use.
        """
        _HISTORY_MAXLEN = 500
        path = _history_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                for line in self.cmd_history[-_HISTORY_MAXLEN:]:
                    f.write(line + '\n')
        except OSError:
            pass  # silently ignore — e.g. read-only filesystem

    def _get_completions(self, text):
        """Return a sorted list of completion candidates for the current cmd-line text.

        Context-sensitive:
          empty / first token (no trailing space)
                          — command names matching the typed prefix
          two tokens / first token + trailing space
                          — argument values for the recognised command
          three or more tokens
                          — no completions (return [])
        """
        parts = text.split()
        completing_cmd = not parts or (len(parts) == 1 and not text.endswith(' '))
        if completing_cmd:
            prefix = parts[0].lstrip(':').lower() if parts else ''
            return sorted(name for name in _CMD_MAP
                          if name.startswith(prefix) and _CMD_MAP[name].completable)

        cmd = parts[0].lstrip(':').lower()
        # Offer argument completions for the second token only.
        # Condition: we have at most 2 tokens and we are NOT positioned after a
        # completed second token followed by a space (which would be the 3rd).
        if len(parts) <= 2 and not (len(parts) == 2 and text.endswith(' ')):
            arg_prefix = parts[1] if len(parts) == 2 else ''
            cmd_def = _CMD_MAP.get(cmd)
            if cmd_def and cmd_def.arg_completer is not None:
                return cmd_def.arg_completer(arg_prefix)
            if cmd_def and cmd_def.arg_choices is not None:
                arg_prefix_lower = arg_prefix.lower()
                choices = (cmd_def.arg_choices()
                           if callable(cmd_def.arg_choices)
                           else cmd_def.arg_choices)
                return [c for c in choices if c.startswith(arg_prefix_lower)]

        return []

    @staticmethod
    def _apply_completion(c, candidate):
        """Replace the partial token at the end of c['chars'] with *candidate*.

        The text before the last whitespace-separated token is kept unchanged;
        only the rightmost token (or empty string after a trailing space) is
        replaced.  The cursor is moved to the end of the substituted text.
        """
        text = ''.join(c['chars'])
        last_space = text.rfind(' ')
        if last_space == -1:
            new_text = candidate
        else:
            new_text = text[:last_space + 1] + candidate
        c['chars'] = list(new_text)
        c['cursor'] = len(new_text)

    def start_monitoring(self):
        """Start all ping threads"""
        self._monitoring_started = True
        for monitor in self.monitors:
            thread = threading.Thread(target=monitor.ping, daemon=True)
            thread.start()
            self.threads.append(thread)

        # Check for state changes
        checker = threading.Thread(target=self.check_state_changes, daemon=True)
        checker.start()

    @staticmethod
    def _format_downtime(seconds):
        """Format a duration in seconds into a human-readable string"""
        secs = int(seconds)
        mins = secs // 60
        remaining = secs % 60
        if mins > 0:
            return f"{secs} sec ({mins} min {remaining} sec)"
        return f"{secs} sec"

    def check_state_changes(self):
        """Monitor state changes and log events"""
        while self.running:
            for monitor in self.monitors:
                # Log a fatal process error exactly once, as soon as it is detected.
                if monitor.error is not None and not monitor.error_logged:
                    monitor.error_logged = True
                    self.add_event(monitor.host, f"error: {monitor.error}")

                current_state = monitor.alive
                if monitor.last_state is None:
                    monitor.last_state = current_state
                    if current_state:
                        self.add_event(monitor.host, "host starts up")
                    elif current_state is False:
                        monitor.down_since = time.monotonic()
                        self.add_event(monitor.host, "host down")
                elif monitor.last_state != current_state:
                    if current_state:
                        # Host recovered — report downtime if tracked
                        if monitor.down_since is not None:
                            downtime = time.monotonic() - monitor.down_since
                            monitor.down_since = None
                            msg = f"host recover. Down time: {self._format_downtime(downtime)}"
                        else:
                            msg = "host recover"
                        self.add_event(monitor.host, msg)
                    else:
                        monitor.down_since = time.monotonic()
                        self.add_event(monitor.host, "host down")
                    monitor.last_state = current_state
            time.sleep(0.5)

    def cycle_dns(self, direction=1):
        """Cycle through DNS display modes. direction=1 forward, -1 backward."""
        self.dns_mode = (self.dns_mode + direction) % len(DNS_MODES)
        # Trigger resolution threads for monitors not yet resolved when entering a resolve mode
        if DNS_MODES[self.dns_mode] in ('hostname', 'ip'):
            for monitor in self.monitors:
                if monitor.resolved_ip is None:
                    threading.Thread(target=monitor.resolve_dns, daemon=True).start()

    def cycle_stats(self, direction=1):
        """Cycle through stats display modes. direction=1 forward, -1 backward."""
        self.stats_mode = (self.stats_mode + direction) % len(STATS_MODES)

    def cycle_sort(self, direction=1):
        """Cycle through sort options. direction=1 forward, -1 backward."""
        sorts = ['none', 'name', 'status', 'latency']
        current_idx = sorts.index(self.sort_by)
        self.sort_by = sorts[(current_idx + direction) % len(sorts)]

    def cycle_history_mode(self, direction=1):
        """Cycle through history display modes. direction=1 forward, -1 backward."""
        self.history_mode = (self.history_mode + direction) % len(HISTORY_MODES)

    def scroll_history(self, delta):
        """Scroll history view by delta steps (positive = back in time)"""
        max_offset = self.monitors[0].history.maxlen if self.monitors else 100
        self.history_offset = max(0, min(max_offset, self.history_offset + delta))

    def scroll_log(self, delta):
        """Scroll event log by delta lines (positive = up/back in time, negative = down/forward)"""
        total = len(self.events)
        max_offset = max(0, total - 1)
        self.log_offset = max(0, min(max_offset, self.log_offset + delta))

    def mark_seen(self):
        """Append a visual 'seen' separator line to the event log (and log file if set).

        The marker includes the current timestamp so the user can tell exactly
        when they last reviewed the log.
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        line = f"{timestamp}   ══════════════════ seen ══════════════════"
        self.events.append(line)
        if self.log_file:
            try:
                with open(self.log_file, 'a') as f:
                    f.write(line + "\n")
            except OSError:
                pass

    def get_sorted_monitors(self):
        """Get display entries sorted by current sort option.

        none    — return self.entries preserving original order, including SectionLabels.
        other   — return sorted self.monitors only (SectionLabels are omitted when sorting).
        """
        if self.sort_by == 'name':
            return sorted(self.monitors, key=lambda m: m.host)
        elif self.sort_by == 'status':
            return sorted(self.monitors, key=lambda m: (m.alive is not True, m.host))
        elif self.sort_by == 'latency':
            return sorted(self.monitors, key=lambda m: (
                m.latency if m.latency is not None else float('inf'), m.host
            ))
        return self.entries  # 'none': preserve original order with section labels

    def draw_menu_bar(self, stdscr, width):
        """Draw the top menu bar with highlighted hotkeys.

        Labels use [x] notation to mark the hotkey character, e.g. '[q]uit'.
        The character inside brackets is rendered with bold+underline to stand out.
        """
        menu_items = [
            (f"[d]NS:{DNS_MODES[self.dns_mode]}", self.dns_mode != 0),
            (f"[s]tats:{STATS_MODES[self.stats_mode]:<5}", False),
            (f"[o]rder by {self.sort_by}", False),
            (f"[h]istory:{HISTORY_MODES[self.history_mode]}", False),
            (f"[p]ause {'on' if self.paused else 'off'}", self.paused),
            ("[Space]seen", False),
            ("[C]lear log", False),
            ("[q]uit", False),
        ]

        prefix = "ping-bulk: "
        stdscr.addstr(0, 0, prefix)
        col = len(prefix)

        for idx, (label, active) in enumerate(menu_items):
            if col >= width - 1:
                break

            # Render each character; highlight hotkey (inside [...]) in white
            i = 0
            while i < len(label) and col < width - 1:
                ch = label[i]
                if ch == '[':
                    i += 1
                    # Collect everything up to the closing ']'
                    token = []
                    while i < len(label) and label[i] != ']':
                        token.append(label[i])
                        i += 1
                    if i < len(label):
                        i += 1  # skip ']'

                    if len(token) == 1:
                        # Single-char hotkey: highlight without brackets (standard look)
                        if col < width - 1:
                            stdscr.addstr(0, col, token[0], curses.color_pair(4) | curses.A_BOLD)
                            col += 1
                    else:
                        # Multi-char hotkey (e.g. "Space"): show '[…]' with all chars highlighted
                        if col < width - 1:
                            stdscr.addstr(0, col, '[')
                            col += 1
                        for tc in token:
                            if col < width - 1:
                                stdscr.addstr(0, col, tc, curses.color_pair(4) | curses.A_BOLD)
                                col += 1
                        if col < width - 1:
                            stdscr.addstr(0, col, ']')
                            col += 1
                else:
                    stdscr.addstr(0, col, ch)
                    col += 1
                    i += 1

            # Separator
            sep = " | " if idx < len(menu_items) - 1 else ""
            if col + len(sep) < width:
                stdscr.addstr(0, col, sep)
                col += len(sep)

    def _rtt_cell_width(self):
        """Compute the cell width needed for rtt mode based on max RTT across all monitors.

        cell_width = len(str(max_rtt_ms)) + 1  (digits field + 1 trailing space)
        Minimum is 3 (2-digit field covers values up to 99 ms + 1 space).
        Uses monitor.latencies (never-capped) for a stable maximum.
        """
        max_rtt = 0
        for monitor in self.monitors:
            with monitor.lock:
                for val in monitor.latencies:
                    if val > max_rtt:
                        max_rtt = val
        return max(3, len(str(int(max_rtt))) + 1)

    def draw_hosts(self, stdscr, start_row, max_rows, width, show_header=True):
        """Draw host list with ping history.

        Layout per stats mode:
          off         — stat_col: Last latency (colored), history full width
          single mode — stat_col: stat value (replaces Last), history full width
          All         — all stats flush-left after hostname, history fills remaining width
        """
        mode_name = STATS_MODES[self.stats_mode]
        show_all = (mode_name == 'All')
        show_single = (self.stats_mode > 0 and not show_all)

        # Adaptive hostname column: wide enough for all display names and the header label
        max_name_len = max(
            (len(m.get_display_name(DNS_MODES[self.dns_mode])) for m in self.monitors), default=8
        )
        name_col_width = max(len("Hostname"), max_name_len)
        stat_col = name_col_width + 1   # stat value starts 1 col after hostname
        hist_col = stat_col + 7         # history starts 7 cols after stat (6-char value + 1 gap)

        # In 'All' mode the stats block sits flush-left immediately after the hostname;
        # the ping history bar then fills the remaining screen width to the right.
        # 9 × 6-char fields + 8 × 2-char separators = 70 characters total.
        ALL_STATS_WIDTH = 70
        all_stats_col = stat_col  # stats start right after the hostname column
        hist_col_effective = (all_stats_col + ALL_STATS_WIDTH + 1) if show_all else hist_col

        if show_header:
            stdscr.addstr(start_row, 0, "Hostname", curses.A_BOLD)

            if not show_all:
                # stat_col header: mode label when a single stat is active, "ms" otherwise
                # Left-justify within the 6-char stat field to align with data rows
                col25_label = mode_name if show_single else "ms"
                stdscr.addstr(start_row, stat_col, f"{col25_label:>6}", curses.A_BOLD)

            # Always show track mode; append scroll indicator when not in live view
            mode_label = HISTORY_MODES[self.history_mode]
            display_label = 'scaled/100ms' if mode_label == 'scaled' else mode_label
            history_header = f"Ping history [{display_label}]"
            if self.history_offset > 0:
                history_header = f"Ping history [{display_label}] [<{self.history_offset}s]"
            stdscr.addstr(start_row, hist_col_effective, history_header, curses.A_BOLD)

            if show_all and all_stats_col < width:
                all_header = (f"{'ms':>6}  {'Avg':>6}  {'Min':>6}  {'Max':>6}  "
                              f"{'Loss%':>6}  {'StDev':>6}  {'RX':>6}  {'TX':>6}  {'XX':>6}")
                stdscr.addstr(start_row, all_stats_col, all_header, curses.A_BOLD)

        data_start = start_row + (1 if show_header else 0)
        row = data_start
        sorted_monitors = self.get_sorted_monitors()

        # In rtt/scaled mode use multi-character cells; success mode uses 1 char per ping.
        hist_mode = HISTORY_MODES[self.history_mode]
        if hist_mode == 'rtt':
            cell_width = self._rtt_cell_width()
        else:
            cell_width = 1  # 'success' and 'scaled' both use one column per ping

        # Resize every monitor's history deque to match the current terminal width
        # so that recorded history always fills the full available column.
        # Always size by screen columns (not ping count) so switching modes keeps data.
        normal_history_length = max(1, width - hist_col - 1)
        for m in self.monitors:
            with m.lock:
                if m.history.maxlen != normal_history_length:
                    m.history = deque(m.history, maxlen=normal_history_length)

        for item in sorted_monitors:
            if row >= data_start + max_rows:
                break

            # Section label — render as a bold divider row and skip to the next entry
            if isinstance(item, SectionLabel):
                stdscr.addstr(row, 0, f"── {item.title}"[:width - 1], curses.A_BOLD)
                row += 1
                continue

            monitor = item

            # Hostname
            display_name = monitor.get_display_name(DNS_MODES[self.dns_mode])
            stdscr.addstr(row, 0, display_name[:name_col_width].ljust(name_col_width))

            # Stat col: Last latency (off) or single stat value; hidden in All mode
            if not show_all:
                if show_single:
                    stat_str = self._compute_stat(monitor, mode_name)
                    # _compute_stat() returns '    ??' when monitor.error is set
                    stat_color = (curses.color_pair(2) | curses.A_BOLD) if monitor.error is not None else 0
                    stdscr.addstr(row, stat_col, stat_str, stat_color)
                else:
                    # off mode — show Last latency with color; '    ??' in bright red on error
                    if monitor.error is not None:
                        stdscr.addstr(row, stat_col, "    ??", curses.color_pair(2) | curses.A_BOLD)
                    elif monitor.latency is not None:
                        color = curses.color_pair(1) if monitor.latency < 50 else curses.color_pair(3)
                        stdscr.addstr(row, stat_col, f"{monitor.latency:6.1f}", color)
                    else:
                        stdscr.addstr(row, stat_col, "     -", curses.color_pair(2))

            # Ping history — full screen width in all modes; extends to right edge.
            # get_history_string() pads with spaces for columns beyond actual deque content.
            col_length = max(0, width - hist_col_effective - 1)

            # Number of ping samples that fit in the available columns.
            # In rtt mode each sample occupies cell_width columns; other modes use 1.
            ping_length = max(1, col_length // cell_width)

            # Sweep mode: fill 0→ping_length once, then snap to half and grow again.
            # ping_count is never capped (unlike the history deque).
            half = max(1, ping_length // 2)

            if self.history_offset > 0:
                # Scrolled view: always show the full available width
                display_count = ping_length
            else:
                max_pings = max((m.ping_count for m in self.monitors), default=0)
                if max_pings < ping_length:
                    # Initial fill phase: grow from 0 to ping_length
                    display_count = max_pings
                else:
                    # Sweep phase: snap to half, grow back to ping_length-1, repeat
                    display_count = half + ((max_pings - ping_length) % half)

            history = monitor.get_history_string(
                display_count, self.history_offset, hist_mode, cell_width
            )

            # Color code the history.
            col = hist_col_effective
            if cell_width > 1:
                # rtt mode: iterate cell_width characters at a time.
                # Each cell is (cell_width-1) digit chars + 1 trailing space.
                for i in range(0, len(history), cell_width):
                    if col >= width - 1:
                        break
                    cell = history[i:i + cell_width]
                    content = cell[:cell_width - 1].lstrip()
                    if not content:
                        # blank padding cell
                        stdscr.addstr(row, col, cell)
                    elif content[0] == 'X':
                        stdscr.addstr(row, col, cell, curses.color_pair(2))  # red
                    elif content[0] == '?':
                        stdscr.addstr(row, col, cell, curses.color_pair(2) | curses.A_BOLD)  # bright red — process error
                    elif content[0] == '>':
                        stdscr.addstr(row, col, cell, curses.color_pair(3))  # yellow — >100 ms
                    else:
                        val = int(content)
                        if hist_mode == 'scaled':
                            # scaled values are 0-9; threshold at 5 (≈55 ms)
                            color = curses.color_pair(1) if val < 5 else curses.color_pair(3)
                        else:
                            color = curses.color_pair(1) if val < 50 else curses.color_pair(3)
                        stdscr.addstr(row, col, cell, color)
                    col += cell_width
            else:
                # success / scaled mode: one character per ping.
                for char in history:
                    if col >= width - 1:
                        break
                    if char == 'X':
                        stdscr.addstr(row, col, char, curses.color_pair(2))  # red
                    elif char == '?':
                        stdscr.addstr(row, col, char, curses.color_pair(2) | curses.A_BOLD)  # bright red — process error
                    elif char == '.':
                        stdscr.addstr(row, col, char, curses.color_pair(1))  # green
                    elif char in '01234':
                        stdscr.addstr(row, col, char, curses.color_pair(1))  # green
                    elif char in '56789':
                        stdscr.addstr(row, col, char, curses.color_pair(3))  # yellow
                    elif char == '>':
                        stdscr.addstr(row, col, char, curses.color_pair(5))  # magenta — >100 ms
                    else:
                        stdscr.addstr(row, col, char)
                    col += 1

            # All-stats block flush-left after hostname
            if show_all and all_stats_col < width:
                all_str = self._compute_all_stats(monitor)
                all_color = (curses.color_pair(2) | curses.A_BOLD) if monitor.error is not None else 0
                stdscr.addstr(row, all_stats_col, all_str, all_color)

            row += 1

        return row

    @staticmethod
    def _compute_stat(monitor, mode):
        """Compute a formatted stat string for a given STATS_MODES label.

        Returns '    ??' (6 chars) for all fields when monitor.error is set.
        """
        if monitor.error is not None:
            return "    ??"
        with monitor.lock:
            lats = list(monitor.latencies)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count
            last = monitor.latency

        if mode == 'Last':
            return f"{last:6.1f}" if last is not None else "     -"
        elif mode == 'Loss%':
            total = rx + xx
            if total == 0:
                return "     -"
            return f"{xx / total * 100:5.1f}%"
        elif mode == 'Avg':
            if not lats:
                return "     -"
            return f"{sum(lats) / len(lats):6.1f}"
        elif mode == 'Min':
            if not lats:
                return "     -"
            return f"{min(lats):6.1f}"
        elif mode == 'Max':
            if not lats:
                return "     -"
            return f"{max(lats):6.1f}"
        elif mode == 'StDev':
            if len(lats) < 2:
                return "     -"
            avg = sum(lats) / len(lats)
            stdev = math.sqrt(sum((x - avg) ** 2 for x in lats) / len(lats))
            return f"{stdev:6.1f}"
        elif mode == 'RX':
            return f"{rx:6d}"
        elif mode == 'TX':
            return f"{tx:6d}"
        elif mode == 'XX':
            return f"{xx:6d}"
        return "     -"

    @staticmethod
    def _compute_all_stats(monitor):
        """Compute a compact all-stats string for 'All' mode.

        Returns a row of '    ??' placeholders (9 fields, 70 chars total) when
        monitor.error is set.
        Format (aligned to match the header in draw_hosts):
          ms     Avg    Min    Max    Loss%  StDev  RX     TX     XX
        """
        if monitor.error is not None:
            placeholder = "    ??"
            sep = "  "
            return (sep.join([placeholder] * 9))
        with monitor.lock:
            lats = list(monitor.latencies)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count
            last = monitor.latency

        # Last (ms)
        ms_s = f"{last:6.1f}" if last is not None else "     -"

        # Avg
        if lats:
            avg_s = f"{sum(lats) / len(lats):6.1f}"
        else:
            avg_s = "     -"

        # Min
        min_s = f"{min(lats):6.1f}" if lats else "     -"

        # Max
        max_s = f"{max(lats):6.1f}" if lats else "     -"

        # Loss%
        total = rx + xx
        if total == 0:
            loss_s = "    - "
        else:
            loss_s = f"{xx / total * 100:5.1f}%"

        # StDev
        if len(lats) >= 2:
            avg = sum(lats) / len(lats)
            stdev = math.sqrt(sum((x - avg) ** 2 for x in lats) / len(lats))
            stdev_s = f"{stdev:6.1f}"
        else:
            stdev_s = "     -"

        return (f"{ms_s}  {avg_s}  {min_s}  {max_s}  {loss_s}  "
                f"{stdev_s}  {rx:6d}  {tx:6d}  {xx:6d}")

    def draw_events(self, stdscr, start_row, height, width):
        """Draw event log at bottom with optional scroll support.

        log_offset=0  -> tail mode (newest events always visible)
        log_offset>0  -> scrolled back; header shows position and resume hint
        """
        page_size = max(1, height - start_row - 2)  # rows available for event lines
        total = len(self.events)
        event_list = list(self.events)

        overflows = total > page_size  # True when the log cannot fit on screen

        if self.log_offset == 0:
            # Live tail mode
            visible = event_list[-page_size:]
            header = "Events"
            if overflows:
                header += " [↑/PgUp to scroll]"
        else:
            end = total - self.log_offset
            start = max(0, end - page_size)
            visible = event_list[start:end]
            line_start = start + 1
            line_end = end
            header = f"Events [lines {line_start}-{line_end}/{total}  ↓/PgDn to resume]"

        if self.log_file:
            header += f" → {self.log_file}"

        stdscr.addstr(start_row, 0, header[:width - 1], curses.A_BOLD)

        row = start_row + 1
        for event in visible:
            if row >= height - 1:
                break
            stdscr.addstr(row, 0, event[:width - 1])
            row += 1

    def _open_prompt_save(self):
        """Open the save-log prompt (non-blocking; state stored in self.prompt)."""
        self.prompt = {
            'type': 'save',
            'chars': list(self.log_file) if self.log_file else [],
        }

    def _open_prompt_clear(self):
        """Open the clear-log confirmation prompt (non-blocking)."""
        self.prompt = {'type': 'clear', 'chars': []}

    def _draw_prompt(self, stdscr, height, width):
        """Draw the active prompt on the bottom line and position the text cursor.

        Called every frame (after all other drawing) when self.prompt is not None.
        The caller is responsible for calling curses.curs_set(1) before refresh.
        """
        p = self.prompt
        if p['type'] == 'save':
            label = "Write log to: "
            text  = ''.join(p['chars'])
            line  = (label + text).ljust(width - 1)[:width - 1]
            stdscr.addstr(height - 1, 0, line, curses.A_REVERSE)
            cursor_x = min(len(label) + len(text), width - 2)
            stdscr.move(height - 1, cursor_x)
        elif p['type'] == 'save_confirm':
            line = "File exists: [t]runcate  [a]ppend  Esc=cancel"
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'clear':
            line = "Clear event log? [y/N]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'quit_confirm':
            line = "Quit? [y/N]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))

    def _handle_prompt_key(self, key):
        """Process one keypress while a prompt is active.

        Updates self.prompt in place; sets self.prompt = None when the prompt
        is dismissed (confirmed or cancelled).
        Ctrl+C (key == 3) always cancels any prompt immediately.
        """
        # Ctrl+C — cancel any prompt unconditionally
        if key == 3:
            self.prompt = None
            return

        p = self.prompt

        if p['type'] == 'save':
            if key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                filename = ''.join(p['chars']).strip()
                if filename:
                    if os.path.exists(filename):
                        # Advance to the truncate/append confirmation step
                        self.prompt = {'type': 'save_confirm', 'filename': filename, 'chars': []}
                    else:
                        self.save_to_file(filename)
                        self.log_file = filename
                        self.prompt = None
                else:
                    self.prompt = None  # empty filename — cancel
            elif key == 27:  # Escape — cancel
                self.prompt = None
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                if p['chars']:
                    p['chars'].pop()
            elif 32 <= key < 127:
                p['chars'].append(chr(key))

        elif p['type'] == 'save_confirm':
            filename = p['filename']
            if key in (ord('t'), ord('T')):
                self.save_to_file(filename, append=False)
                self.log_file = filename
            elif key in (ord('a'), ord('A')):
                if self.log_file != filename:
                    self.save_to_file(filename, append=True, write_separator=True)
                self.log_file = filename
            # Any other key (Esc, Enter, …) — cancel without saving
            self.prompt = None

        elif p['type'] == 'clear':
            if key in (ord('y'), ord('Y')):
                self.events.clear()
                self.log_offset = 0  # reset scroll position after clearing
            self.prompt = None  # any key closes the clear prompt

        elif p['type'] == 'quit_confirm':
            if key in (ord('y'), ord('Y')):
                self.running = False
            self.prompt = None  # any key closes the quit prompt

    def save_to_file(self, filename, append=False, write_separator=True):
        """Write the current event log to a file.

        Each line is already fully formatted by add_event() with an ISO 8601
        timestamp, so the file is a plain sequence of event lines preceded by
        a one-line header.

        append=False         — overwrite the file with a header + all events.
        append=True          — append events to the existing file.
        write_separator=True — when appending, prepend a separator line with a
                               timestamp; set to False when the file is already
                               the active streaming log (no gap to mark).
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        try:
            if append:
                with open(filename, 'a') as f:
                    if write_separator:
                        f.write(f"\n# ========== appended {timestamp} ==========\n")
                    for event in self.events:
                        f.write(event + "\n")
            else:
                with open(filename, 'w') as f:
                    f.write(f"# ping-bulk event log — saved {timestamp}\n")
                    for event in self.events:
                        f.write(event + "\n")
        except OSError as e:
            self.add_event("save", f"error: {e}")

    def _draw_cmd(self, stdscr, height, width):
        """Draw the active command line on the bottom row with a text cursor.

        Renders ':' followed by the typed text, reversed-video style, and
        positions the terminal cursor at the insertion point.

        When completions are available (after the first Tab press) a popup
        menu is drawn immediately above the command line.  The currently
        highlighted candidate (comp_idx) is shown in bold+reverse; all others
        are shown in plain reverse.  The popup scrolls so the highlighted entry
        is always in view.
        """
        c = self.cmd
        completions = c.get('completions', [])
        comp_idx = c.get('comp_idx', -1)

        if completions:
            # How many rows the popup can occupy (leave room for the cmd line itself)
            max_popup_rows = min(len(completions), height - 2)
            # Scroll the popup view so the highlighted entry is always visible.
            if comp_idx < 0:
                view_start = 0
            else:
                view_start = max(0, min(comp_idx, len(completions) - max_popup_rows))
            for i, candidate in enumerate(completions[view_start:view_start + max_popup_rows]):
                row = height - 1 - max_popup_rows + i
                if row < 0:
                    continue
                actual_idx = view_start + i
                attr = (curses.A_REVERSE | curses.A_BOLD) if actual_idx == comp_idx else curses.A_REVERSE
                try:
                    stdscr.addstr(row, 0, candidate.ljust(width - 1)[:width - 1], attr)
                except curses.error:
                    pass

        text = ''.join(c['chars'])
        line = (':' + text).ljust(width - 1)[:width - 1]
        stdscr.addstr(height - 1, 0, line, curses.A_REVERSE)
        cursor_x = min(1 + c['cursor'], width - 2)
        stdscr.move(height - 1, cursor_x)

    def _handle_cmd_key(self, key):
        """Process one keypress while command mode is active (readline-style editing).

        Supported bindings:
          Tab            — complete to longest common prefix; list all matches (no cycling)
          Enter          — dispatch the command (if non-empty) and save to history
          Esc / Ctrl+C   — cancel and close command line
          Backspace/^H   — delete character before cursor
          Delete         — delete character at cursor
          Left / Right   — move cursor one character
          Home / Ctrl+A  — move cursor to start
          End  / Ctrl+E  — move cursor to end
          Ctrl+K         — kill from cursor to end of line
          Ctrl+U         — kill from start of line to cursor
          Ctrl+W         — kill word backward (stop at whitespace boundary)
          Up / Down      — navigate command history (Up=older, Down=newer)
          printable char — insert at cursor position
        """
        c = self.cmd
        chars = c['chars']
        cursor = c['cursor']

        # ── Tab — completion (early return; never resets completion state) ─────
        if key == ord('\t'):
            text = ''.join(chars)

            if not c['completions']:
                # First Tab press: compute candidates from current text.
                c['comp_prefix'] = text
                c['completions'] = self._get_completions(text)
                c['comp_idx'] = -1

                if len(c['completions']) == 1:
                    # Exactly one match — apply it directly and append a trailing
                    # space so the user can immediately type the next argument.
                    # Exception: directory paths (ending with '/') get no space
                    # so the user can keep typing deeper into the path.
                    c['comp_idx'] = 0
                    c['chars'] = list(c['comp_prefix'])
                    c['cursor'] = len(c['comp_prefix'])
                    self._apply_completion(c, c['completions'][0])
                    if not c['completions'][0].endswith('/'):
                        c['chars'].append(' ')
                        c['cursor'] += 1
                    c['completions'] = []  # no popup needed for a unique match
                    return

                if len(c['completions']) > 1:
                    # Multiple candidates — vim wildmode=longest: complete to the
                    # longest common prefix (LCP) first.  If the LCP extends the
                    # current partial token, apply it and leave the popup open so
                    # the user can see the full candidate list.  If the LCP is no
                    # longer than what is already typed, the popup stays as-is.
                    lcp = c['completions'][0]
                    for s in c['completions'][1:]:
                        while not s.startswith(lcp):
                            lcp = lcp[:-1]
                            if not lcp:
                                break

                    # The "current token" is whatever _apply_completion would
                    # replace: everything after the last space (or the whole text).
                    last_space = text.rfind(' ')
                    current_token = text[last_space + 1:] if last_space != -1 else text

                    if len(lcp) > len(current_token):
                        # LCP is longer — fill it in and wait for the next Tab.
                        c['chars'] = list(c['comp_prefix'])
                        c['cursor'] = len(c['comp_prefix'])
                        self._apply_completion(c, lcp)
                        return  # popup stays visible; next Tab will cycle

                if not c['completions']:
                    return  # no matches at all

                # LCP gave no extension — popup is already showing; nothing more to do.
                return  # wildmode=list: no cycling

            # Popup already open — no-op (wildmode=list; Tab does not cycle).
            return

        # ── All non-Tab keys clear the completion popup ────────────────────────
        c['completions'] = []
        c['comp_idx'] = -1

        if key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            text = ''.join(chars).strip()
            self.cmd = None
            if text:
                # Deduplicate: remove an earlier identical entry so the most
                # recent invocation always sits at the end of the history list.
                if text in self.cmd_history:
                    self.cmd_history.remove(text)
                self.cmd_history.append(text)
                self._save_cmd_history()
                self._dispatch_cmd(text)

        elif key in (27, 3):  # Escape / Ctrl+C — cancel
            self.cmd = None

        elif key == curses.KEY_UP:
            hist = self.cmd_history
            if hist:
                if c['hist_idx'] == -1:
                    # First Up press: save the current (unsaved) line so it can
                    # be restored when the user presses Down past the end.
                    c['saved_line'] = ''.join(chars)
                    c['hist_idx'] = len(hist) - 1
                elif c['hist_idx'] > 0:
                    c['hist_idx'] -= 1
                entry = hist[c['hist_idx']]
                c['chars'] = list(entry)
                c['cursor'] = len(entry)

        elif key == curses.KEY_DOWN:
            if c['hist_idx'] != -1:
                hist = self.cmd_history
                if c['hist_idx'] < len(hist) - 1:
                    c['hist_idx'] += 1
                    entry = hist[c['hist_idx']]
                    c['chars'] = list(entry)
                    c['cursor'] = len(entry)
                else:
                    # Past the newest history entry — restore the saved line
                    c['hist_idx'] = -1
                    entry = c['saved_line']
                    c['chars'] = list(entry)
                    c['cursor'] = len(entry)

        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if cursor > 0:
                del chars[cursor - 1]
                c['cursor'] -= 1
            c['hist_idx'] = -1  # text edit breaks history navigation

        elif key == curses.KEY_DC:  # Delete key
            if cursor < len(chars):
                del chars[cursor]
            c['hist_idx'] = -1

        elif key == curses.KEY_LEFT:
            if cursor > 0:
                c['cursor'] -= 1
            # Cursor movement does NOT reset hist_idx

        elif key == curses.KEY_RIGHT:
            if cursor < len(chars):
                c['cursor'] += 1

        elif key in (curses.KEY_HOME, 1):  # Home / Ctrl+A
            c['cursor'] = 0

        elif key in (curses.KEY_END, 5):  # End / Ctrl+E
            c['cursor'] = len(chars)

        elif key == 11:  # Ctrl+K — kill to end of line
            del chars[cursor:]
            c['hist_idx'] = -1

        elif key == 21:  # Ctrl+U — kill to start of line
            del chars[:cursor]
            c['cursor'] = 0
            c['hist_idx'] = -1

        elif key == 23:  # Ctrl+W — kill word backward
            end = cursor
            while cursor > 0 and chars[cursor - 1] == ' ':
                cursor -= 1
            while cursor > 0 and chars[cursor - 1] != ' ':
                cursor -= 1
            del chars[cursor:end]
            c['cursor'] = cursor
            c['hist_idx'] = -1

        elif 32 <= key < 127:
            chars.insert(cursor, chr(key))
            c['cursor'] += 1
            c['hist_idx'] = -1

    def _apply_hosts_entry(self, ip, hostname):
        """Apply a static DNS override pair to any matching monitors.

        Stores the mapping in self.hosts_map (keyed by both ip and hostname so
        either can be used as monitor.host) and sets resolved_ip /
        resolved_hostname directly on any PingMonitor whose host matches either
        the ip or the hostname.  Also sets resolv_static = True so that the
        ping subprocess targets the IP address directly instead of the hostname.

        This is called at startup (via _dispatch_cmd from hosts-file :resolv
        lines) and interactively.  Silent on success; reports a warning to the
        event log only when no monitor matches.
        """
        self.hosts_map[ip] = (ip, hostname)
        self.hosts_map[hostname] = (ip, hostname)

        matched = 0
        for monitor in self.monitors:
            if monitor.host == ip or monitor.host == hostname:
                monitor.resolved_ip = ip
                monitor.resolved_hostname = hostname
                monitor.resolv_static = True
                matched += 1

        if matched == 0 and self._monitoring_started:
            # Only warn when running interactively — during __init__ the host entry
            # may simply appear later in the file and will pick up the mapping then.
            self.add_event("resolv",
                f"no monitor matched '{ip}' / '{hostname}' — mapping stored for future use")

    def _dispatch_cmd(self, text):
        """Dispatch a command string entered via the ':' command line.

        Parses the first word as the command name (stripping any leading ':')
        and passes the remainder as arguments.  Supported commands:

          q / quit               — quit the application
          dns  [off|hostname|ip] — cycle (no arg) or set DNS display mode
          stats [mode]           — cycle (no arg) or set stats column mode
          sort  [mode]           — cycle (no arg) or set sort order
          history/hist [mode]    — cycle (no arg) or set history display mode
          pause                  — toggle pause
          seen                   — insert 'seen' marker in event log
          clear                  — clear event log
          log [file]             — show active log file; or save/stream log to file
          help                   — open the help overlay

        Unknown commands are reported to the event log.
        """
        parts = text.split(None, 1)
        cmd  = parts[0].lstrip(':').lower()
        args = parts[1].strip() if len(parts) > 1 else ''

        cmd_def = _CMD_MAP.get(cmd)
        if cmd_def:
            getattr(self, cmd_def.action)(args)
        else:
            self.add_event("cmd",
                f"unknown command: {cmd}" + (f" {args}" if args else "")
                + "  (try :help)")

    def _cmd_quit(self, args=''):
        """Quit the application."""
        self.running = False

    def _cmd_dns(self, args=''):
        """Cycle (no arg) or set DNS display mode."""
        if args:
            modes_lower = [m.lower() for m in DNS_MODES]
            if args.lower() in modes_lower:
                self.dns_mode = modes_lower.index(args.lower())
                if DNS_MODES[self.dns_mode] in ('hostname', 'ip'):
                    for monitor in self.monitors:
                        if monitor.resolved_ip is None:
                            threading.Thread(
                                target=monitor.resolve_dns, daemon=True
                            ).start()
            else:
                self.add_event("cmd",
                    f"dns: unknown mode '{args}' — choices: {' '.join(DNS_MODES)}")
        else:
            self.cycle_dns(1)

    def _cmd_stats(self, args=''):
        """Cycle (no arg) or set stats column mode."""
        if args:
            modes_lower = [m.lower() for m in STATS_MODES]
            if args.lower() in modes_lower:
                self.stats_mode = modes_lower.index(args.lower())
            else:
                self.add_event("cmd",
                    f"stats: unknown mode '{args}' — choices: {' '.join(STATS_MODES)}")
        else:
            self.cycle_stats(1)

    def _cmd_sort(self, args=''):
        """Cycle (no arg) or set sort order."""
        sorts = ['none', 'name', 'status', 'latency']
        if args:
            if args.lower() in sorts:
                self.sort_by = args.lower()
            else:
                self.add_event("cmd",
                    f"sort: unknown mode '{args}' — choices: {' '.join(sorts)}")
        else:
            self.cycle_sort(1)

    def _cmd_history(self, args=''):
        """Cycle (no arg) or set history display mode."""
        if args:
            modes_lower = [m.lower() for m in HISTORY_MODES]
            if args.lower() in modes_lower:
                self.history_mode = modes_lower.index(args.lower())
            else:
                self.add_event("cmd",
                    f"history: unknown mode '{args}' — choices: {' '.join(HISTORY_MODES)}")
        else:
            self.cycle_history_mode(1)

    def _cmd_pause(self, args=''):
        """Toggle pause on/off."""
        self.paused = not self.paused

    def _cmd_seen(self, args=''):
        """Insert a 'seen' marker in the event log."""
        self.mark_seen()

    def _cmd_clear(self, args=''):
        """Clear the event log."""
        self.events.clear()
        self.log_offset = 0

    def _cmd_log(self, args=''):
        """Show active log file, set/stream log to file, or disable logging."""
        if args:
            if args.lower() == 'off':
                if self._monitoring_started:
                    if self.log_file:
                        self.add_event("log", f"logging stopped (was: {self.log_file})")
                    else:
                        self.add_event("log", "logging is already off")
                self.log_file = None
            else:
                old = self.log_file
                self.log_file = args
                if self._monitoring_started and old != args:
                    self.add_event("log", f"logging to: {args}")
        else:
            if self.log_file:
                self.add_event("log", f"active log file: {self.log_file}")
            else:
                self.add_event("log", "no log file active")

    def _cmd_saveconfig(self, args=''):
        """Save current settings to config file."""
        if self._save_config():
            self.add_event("config", f"settings saved to {_config_path()}")

    def _cmd_resolv(self, args=''):
        """Apply a static DNS override: :resolv <ip-pattern> <hostname-template>."""
        parts = args.split(None, 1)
        if len(parts) != 2:
            self.add_event("cmd", "resolv: usage: :resolv <ip> <hostname>")
        else:
            ip_pattern, hostname_tmpl = parts[0], parts[1].strip()
            try:
                rows = _expand_host_with_captures(ip_pattern)
            except ValueError as e:
                self.add_event("cmd", f"resolv: brace expansion error: {e}")
            else:
                for expanded_ip, captures in rows:
                    if not _is_ip(expanded_ip):
                        self.add_event("cmd",
                            f"resolv: '{expanded_ip}' is not a valid IP address — skipped")
                        continue
                    hostname = _apply_backref(hostname_tmpl, captures)
                    self._apply_hosts_entry(expanded_ip, hostname)

    def _cmd_ssh(self, args=''):
        """Add a remote-ping monitor: :ssh [opts] <dest> <ping-host>."""
        if not args:
            self.add_event("cmd",
                "ssh: usage: :ssh [opts] <dest> <ping-host>")
        else:
            try:
                tokens = shlex.split(args)
            except ValueError as e:
                self.add_event("cmd", f"ssh: parse error: {e}")
            else:
                if len(tokens) < 2:
                    self.add_event("cmd",
                        "ssh: usage: :ssh [opts] <dest> <ping-host>")
                else:
                    ping_host_pattern = tokens[-1]
                    ssh_args = tokens[:-1]
                    ssh_dest = ssh_args[-1]
                    try:
                        expanded_hosts = _expand_host(ping_host_pattern)
                    except ValueError as e:
                        self.add_event("cmd", f"ssh: brace expansion error: {e}")
                    else:
                        for ping_host in expanded_hosts:
                            actual_ping_host = (self.hosts_map[ping_host][0]
                                                if ping_host in self.hosts_map
                                                else ping_host)
                            label = f"{ssh_dest}→{ping_host}"
                            monitor = SshPingMonitor(ssh_args, actual_ping_host, label=label)
                            self.monitors.append(monitor)
                            self.entries.append(monitor)
                            if self._monitoring_started:
                                thread = threading.Thread(
                                    target=monitor.ping, daemon=True
                                )
                                thread.start()
                                self.threads.append(thread)

    def _cmd_ssh_begin(self, args=''):
        """Report that :ssh-begin is a hosts-file-only directive."""
        self.add_event("cmd",
            "ssh-begin: only supported in hosts files — use :ssh for interactive SSH")

    def _cmd_ssh_end(self, args=''):
        """Report that :ssh-end is a hosts-file-only directive."""
        self.add_event("cmd",
            "ssh-end: only supported in hosts files — use :ssh for interactive SSH")

    def _cmd_help(self, args=''):
        """Open the help overlay (sets self.help_open = True).

        The overlay is drawn by _draw_help_overlay() and is never written to
        the event log or the log file.  Scroll position is reset to the top
        each time the overlay is opened.
        """
        self.help_open = True
        self.help_scroll = 0

    def _draw_help_overlay(self, stdscr, height, width):
        """Draw the help overlay as a centered bordered popup with scroll support.

        Uses _HELP_LINES as content; each line is padded / truncated to
        _HELP_INNER_W characters.  The box is drawn with box-drawing characters
        and rendered in reverse-video so it floats visually above the main UI.
        The overlay is closed by pressing q, Q, or Esc (handled in run()).

        Scrolling:
          self.help_scroll = 0  — top of content
          self.help_scroll > 0  — scrolled down by that many lines
        When the content is taller than the terminal the top border embeds a
        scroll indicator ' ↑↓ n-m/total ' centered in the dashes so the user
        can see where they are.  The scroll position is clamped here so callers
        may increment it freely without worrying about bounds.
        """
        box_w = _HELP_INNER_W + 2   # inner width + two border chars

        # Limit the box height to the terminal; always keep room for both borders.
        box_h_available = min(len(_HELP_LINES) + 2, height)
        visible_count = max(0, box_h_available - 2)

        # Clamp scroll position so it never exceeds the last valid window start.
        max_scroll = max(0, len(_HELP_LINES) - visible_count)
        self.help_scroll = max(0, min(self.help_scroll, max_scroll))

        col0 = max(0, (width - box_w) // 2)
        row0 = max(0, (height - box_h_available) // 2)

        attr = curses.A_REVERSE

        # Top border — embed a scroll indicator when not all lines fit on screen.
        if row0 < height:
            if max_scroll > 0:
                line_first = self.help_scroll + 1
                line_last  = self.help_scroll + visible_count
                indicator  = f' ↑↓ {line_first}-{line_last}/{len(_HELP_LINES)} '
                left_w  = (_HELP_INNER_W - len(indicator)) // 2
                right_w = _HELP_INNER_W - left_w - len(indicator)
                inner = '─' * left_w + indicator + '─' * right_w
                top_border = '┌' + inner + '┐'
            else:
                top_border = '┌' + '─' * _HELP_INNER_W + '┐'
            try:
                stdscr.addstr(row0, col0, top_border[:width - col0], attr)
            except curses.error:
                pass

        # Content rows — show only the slice selected by help_scroll.
        visible_lines = _HELP_LINES[self.help_scroll:self.help_scroll + visible_count]
        for i, line in enumerate(visible_lines):
            r = row0 + 1 + i
            if r >= height:
                break
            padded = line.ljust(_HELP_INNER_W)[:_HELP_INNER_W]
            try:
                stdscr.addstr(r, col0, ('│' + padded + '│')[:width - col0], attr)
            except curses.error:
                pass

        # Bottom border
        r = row0 + 1 + visible_count
        if r < height:
            try:
                stdscr.addstr(r, col0,
                              ('└' + '─' * _HELP_INNER_W + '┘')[:width - col0], attr)
            except curses.error:
                pass

    def run(self, stdscr):
        """Main application loop"""
        # Initialize curses
        curses.curs_set(0)
        stdscr.nodelay(1)
        stdscr.timeout(100)

        # Initialize colors
        curses.start_color()
        curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)    # Success
        curses.init_pair(2, curses.COLOR_RED, curses.COLOR_BLACK)      # Failure
        curses.init_pair(3, curses.COLOR_YELLOW, curses.COLOR_BLACK)   # Warning (slow)
        curses.init_pair(4, curses.COLOR_WHITE, curses.COLOR_BLACK)    # Hotkey
        curses.init_pair(5, curses.COLOR_MAGENTA, curses.COLOR_BLACK)  # Very slow (>100 ms)

        self.start_monitoring()

        try:
            while self.running:
                stdscr.erase()
                height, width = stdscr.getmaxyx()

                # Adaptive layout: prioritise host rows, then header, then menu, then events
                num_hosts = len(self.entries)

                # Show menu bar only if there is room for menu(1)+blank(1)+header(1)+all hosts
                show_menu = height >= num_hosts + 3
                hosts_start = 2 if show_menu else 0

                # Show column header only if there is room for it above all host rows
                show_header = height >= hosts_start + num_hosts + 1

                # How many host data rows actually fit
                available = height - hosts_start - (1 if show_header else 0)
                visible_hosts = min(num_hosts, max(0, available))

                # Events get whatever space remains (need at least header + 1 line)
                section_end = hosts_start + (1 if show_header else 0) + visible_hosts
                events_start = section_end + 1
                show_events = events_start + 2 <= height

                # Draw sections
                if show_menu:
                    self.draw_menu_bar(stdscr, width)
                self.draw_hosts(stdscr, hosts_start, visible_hosts, width,
                                show_header=show_header)
                if show_events:
                    self.draw_events(stdscr, events_start, height, width)

                if self.cmd is not None:
                    self._draw_cmd(stdscr, height, width)
                    curses.curs_set(1)
                elif self.prompt is not None:
                    self._draw_prompt(stdscr, height, width)
                    curses.curs_set(1)
                else:
                    curses.curs_set(0)

                # Help overlay drawn last so it floats above everything else
                if self.help_open:
                    self._draw_help_overlay(stdscr, height, width)
                    curses.curs_set(0)

                stdscr.refresh()

                # Handle input — map Ctrl+C (KeyboardInterrupt) to key code 3
                # so modal layers can handle it uniformly as "cancel / dismiss".
                try:
                    key = stdscr.getch()
                except KeyboardInterrupt:
                    key = 3
                if self.help_open:
                    if key in (ord('q'), ord('Q'), 27, 3):
                        self.help_open = False
                    elif key == curses.KEY_UP:
                        self.help_scroll = max(0, self.help_scroll - 1)
                    elif key == curses.KEY_DOWN:
                        self.help_scroll += 1  # upper bound clamped in _draw_help_overlay
                    elif key == curses.KEY_PPAGE:
                        self.help_scroll = max(0, self.help_scroll - 10)
                    elif key == curses.KEY_NPAGE:
                        self.help_scroll += 10  # upper bound clamped in _draw_help_overlay
                    continue
                if self.cmd is not None:
                    if key != -1:
                        self._handle_cmd_key(key)
                    continue
                if self.prompt is not None:
                    if key != -1:
                        self._handle_prompt_key(key)
                    continue
                if key == ord('q') or key == ord('Q'):
                    self.running = False
                    break
                elif key == 3:  # Ctrl+C — ask for confirmation before quitting
                    self.prompt = {'type': 'quit_confirm', 'chars': []}
                elif key == ord('d'):
                    self.cycle_dns(1)
                elif key == ord('D'):
                    self.cycle_dns(-1)
                elif key == ord('s'):
                    self.cycle_stats(1)
                elif key == ord('S'):
                    self.cycle_stats(-1)
                elif key == ord('o'):
                    self.cycle_sort(1)
                elif key == ord('O'):
                    self.cycle_sort(-1)
                elif key == ord('p') or key == ord('P'):
                    self.paused = not self.paused
                elif key == ord('h'):
                    self.cycle_history_mode(1)
                elif key == ord('H'):
                    self.cycle_history_mode(-1)
                elif key == ord(' '):
                    self.mark_seen()
                elif key == ord('C'):
                    self._open_prompt_clear()
                elif key == ord(':'):
                    self.cmd = {
                        'chars': [], 'cursor': 0,
                        'hist_idx': -1, 'saved_line': '',
                        'completions': [], 'comp_idx': -1, 'comp_prefix': '',
                    }
                elif key == ord('?'):
                    self._cmd_help()
                # History scrolling (left/right arrows)
                elif key == curses.KEY_LEFT:
                    self.scroll_history(1)
                elif key == curses.KEY_RIGHT:
                    self.scroll_history(-1)
                # Event log scrolling (up/down arrows and PgUp/PgDn)
                # Only active when the log overflows the visible area.
                elif key == curses.KEY_UP:
                    if len(self.events) > max(1, height - events_start - 2):
                        self.scroll_log(1)
                elif key == curses.KEY_DOWN:
                    if len(self.events) > max(1, height - events_start - 2):
                        self.scroll_log(-1)
                elif key == curses.KEY_PPAGE:   # Page Up — scroll log back
                    log_page_size = max(1, height - events_start - 2)
                    if len(self.events) > log_page_size:
                        self.scroll_log(log_page_size)
                elif key == curses.KEY_NPAGE:   # Page Down — scroll log forward
                    log_page_size = max(1, height - events_start - 2)
                    if len(self.events) > log_page_size:
                        self.scroll_log(-log_page_size)

        finally:
            for monitor in self.monitors:
                monitor.stop()


def _parse_args():
    """Parse command-line arguments outside of curses so errors print cleanly.

    When invoked with no arguments (no hosts and no -f/--file), the usage/help
    is printed and the program exits immediately — curses is never started.
    Press '?' inside the running app for the full keyboard reference.
    """
    import argparse
    parser = argparse.ArgumentParser(
        prog='ping-bulk',
        description='Monitor multiple hosts with continuous ping.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  ping-bulk 8.8.8.8 1.1.1.1
  ping-bulk -f hosts.txt
  ping-bulk -l events.log 8.8.8.8 192.168.1.{1..10}

hosts file format:
  # comment line (ignored)
  ## Section title          — section divider in the UI
  :title Section title      — preferred section divider syntax
  10.0.0.1                  — host or IP to ping
  10.0.0.{1..5}             — brace range expansion (5 hosts)
  :resolv <ip> <hostname>   — static DNS override
  :ssh [opts] <dest> <host> — ping via SSH
  :ssh-begin [opts] <dest>  — open SSH block (plain lines → :ssh commands)
  :ssh-end                  — close SSH block

press '?' inside the app for the full keyboard reference.\
""",
    )
    parser.add_argument(
        '-f', '--file',
        metavar='FILE',
        help='hosts file (# comment, ## section header, one host per line)',
    )
    parser.add_argument(
        '-l', '--log-file',
        metavar='LOGFILE',
        help='append event log entries to this file in real time',
    )
    parser.add_argument(
        'hosts',
        nargs='*',
        metavar='HOST',
        help='hosts/IPs to ping',
    )
    args = parser.parse_args()
    if not args.hosts and not args.file:
        parser.print_help()
        sys.exit(0)
    return args


def main(stdscr, args):
    entries = []

    # Load entries from file first, then append positional hosts
    if args.file:
        try:
            entries.extend(parse_hosts_file(args.file))
        except OSError as e:
            print(f"ping-bulk: cannot open '{args.file}': {e}", file=sys.stderr)
            return

    for host in args.hosts:
        if host.startswith(':'):
            entries.append(('cmd', host))
        else:
            entries.append(('host', host))

    if not entries:
        print("ping-bulk: no hosts to monitor", file=sys.stderr)
        return

    app = Application(entries, log_file=args.log_file)
    app.run(stdscr)

if __name__ == "__main__":
    _args = _parse_args()
    curses.wrapper(main, _args)
