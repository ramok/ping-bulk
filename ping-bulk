# ── Terminal backend abstraction ─────────────────────────────────────────────
# Covers tmux, screen, and X/Wayland terminal emulators (implemented).
# Kiosk mode uses tmux only.

_KIOSK_TMUX_CONF = '/etc/ping-bulk/kiosk.tmux.conf'
_KIOSK_SSH_IDENTITY = '/etc/ping-bulk/id_ed25519'


class TerminalBackend(ABC):
    """Abstract base for terminal multiplexer / emulator backends."""

    @classmethod
    @abstractmethod
    def available(cls) -> bool:
        """True if the backend binary is found in PATH."""

    @abstractmethod
    def is_inside(self) -> bool:
        """True if currently running inside this backend's session."""

    @abstractmethod
    def split(self, direction: str, command: list) -> None:
        """Open command in a split pane.  direction: 'v' (below) or 'h' (right)."""

    @abstractmethod
    def new_window(self, command: list) -> None:
        """Open command in a new window."""

    @abstractmethod
    def relaunch_cmd(self, argv: list, kiosk_conf: str = None) -> list:
        """Return argv to relaunch inside this backend."""


def _session_name_from_argv(argv: list) -> str:
    """Derive a mux session name from the last -f/--file argument in argv.

    Uses the basename (without extension) of the last -f value given.
    Falls back to 'ping-bulk' when no -f argument is present.
    """
    last_f = None
    it = iter(argv[1:])
    for tok in it:
        if tok in ('-f', '--file'):
            try:
                last_f = next(it)
            except StopIteration:
                pass
        elif tok.startswith('-f') and not tok.startswith('--'):
            last_f = tok[2:]
        elif tok.startswith('--file='):
            last_f = tok[len('--file='):]
    if last_f:
        name = os.path.splitext(os.path.basename(last_f))[0]
        return name or 'ping-bulk'
    return 'ping-bulk'


class TmuxBackend(TerminalBackend):
    """tmux backend."""

    @classmethod
    def available(cls) -> bool:
        return shutil.which('tmux') is not None

    def is_inside(self) -> bool:
        return bool(os.environ.get('TMUX'))

    def split(self, direction: str, command: list) -> None:
        flag = '-v' if direction == 'v' else '-h'
        r = subprocess.run(['tmux', 'split-window', flag, '--'] + command,
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"tmux exited {r.returncode}")

    def new_window(self, command: list) -> None:
        r = subprocess.run(['tmux', 'new-window', '--'] + command,
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"tmux exited {r.returncode}")

    def relaunch_cmd(self, argv: list, kiosk_conf: str = None) -> list:
        cmd = ['tmux']
        if kiosk_conf and os.path.exists(kiosk_conf):
            cmd += ['-f', kiosk_conf]
        cmd += ['new', '-As', _session_name_from_argv(argv), '--']
        cmd += argv
        return cmd


class ScreenBackend(TerminalBackend):
    """GNU screen backend."""

    @classmethod
    def available(cls) -> bool:
        return shutil.which('screen') is not None

    def is_inside(self) -> bool:
        return bool(os.environ.get('STY'))

    @staticmethod
    def _screen_token(tok: str) -> str:
        """Quote a single token for use inside a screen eval command string."""
        if ' ' not in tok and "'" not in tok:
            return tok
        return "'" + tok.replace("'", r"'\''") + "'"

    def split(self, direction: str, command: list) -> None:
        # direction='v' → pane below  = screen horizontal split (default 'split')
        # direction='h' → pane right  = screen vertical split ('split -v')
        split_cmd = 'split' if direction == 'v' else 'split -v'
        cmd_str = 'screen ' + ' '.join(self._screen_token(t) for t in command)
        sty = os.environ.get('STY', '')
        base = ['screen']
        if sty:
            base += ['-S', sty]
        r = subprocess.run(base + ['-X', 'eval', split_cmd, 'focus', cmd_str],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"screen exited {r.returncode}")

    def new_window(self, command: list) -> None:
        sty = os.environ.get('STY', '')
        base = ['screen']
        if sty:
            base += ['-S', sty]
        r = subprocess.run(base + ['-X', 'screen'] + command,
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"screen exited {r.returncode}")

    def relaunch_cmd(self, argv: list, kiosk_conf: str = None) -> list:
        cmd = ['screen']
        if kiosk_conf and os.path.exists(kiosk_conf):
            cmd += ['-c', kiosk_conf]
        cmd += ['-d', '-RR', '-S', _session_name_from_argv(argv)] + argv
        return cmd


# Known X terminal emulators: (binary, separator_before_command)
# separator None means command is appended directly (e.g. kitty).
_XTERM_CANDIDATES = [
    ('x-terminal-emulator', '-e'),   # Debian/Ubuntu alternatives default
    ('xterm',               '-e'),   # fallback
]


class XTermBackend(TerminalBackend):
    """X / Wayland terminal emulator backend.

    Opens commands in a new terminal window.  Cannot split; split() falls
    back to new_window().  Detection requires DISPLAY or WAYLAND_DISPLAY.
    """

    def __init__(self):
        self.terminal = 'auto'  # 'auto' or explicit binary name

    @classmethod
    def available(cls) -> bool:
        return bool(
            (os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY'))
            and cls._find_binary('auto')
        )

    @classmethod
    def _find_binary(cls, name: str) -> str | None:
        if name and name != 'auto':
            return shutil.which(name)
        for cand, _ in _XTERM_CANDIDATES:
            found = shutil.which(cand)
            if found:
                return found
        return None

    def is_inside(self) -> bool:
        return False  # you're never "inside" an X terminal emulator

    def _build_cmd(self, command: list) -> list:
        binary = self._find_binary(self.terminal)
        if not binary:
            return []
        name = os.path.basename(binary)
        sep = next((s for b, s in _XTERM_CANDIDATES if b == name), '-e')
        if sep is None:
            return [binary] + command
        return [binary, sep] + command

    def split(self, direction: str, command: list) -> None:
        self.new_window(command)  # X terminals can't split; open a new window

    def new_window(self, command: list) -> None:
        cmd = self._build_cmd(command)
        if not cmd:
            return
        proc = subprocess.Popen(cmd, stderr=subprocess.PIPE)
        # Poll briefly — terminal emulators fail immediately if display is missing
        try:
            proc.wait(timeout=0.2)
            if proc.returncode != 0:
                stderr = proc.stderr.read().decode(errors='replace').strip()
                raise RuntimeError(stderr or f"terminal exited {proc.returncode}")
        except subprocess.TimeoutExpired:
            pass  # still running — opened successfully

    def relaunch_cmd(self, argv: list, kiosk_conf: str = None) -> list:
        return argv  # not applicable for terminal emulators


_MUX_BACKENDS: dict[str, TerminalBackend] = {
    'tmux':     TmuxBackend(),
    'screen':   ScreenBackend(),
    'terminal': XTermBackend(),
}


def _resolve_mux_backend(preference: str = None) -> TerminalBackend | None:
    """Return the TerminalBackend to use, or None if none is available.

    If already inside a specific multiplexer, always use that one.
    Otherwise, use *preference* (the command alias name) as a hint,
    falling back to whichever backend is available (tmux → screen → terminal).
    """
    for name, backend in _MUX_BACKENDS.items():
        if name != 'terminal' and backend.is_inside():
            return backend
    order = ([preference] if preference and preference in _MUX_BACKENDS else []) \
            + ['tmux', 'screen', 'terminal']
    seen = set()
    for name in order:
        if name and name not in seen and name in _MUX_BACKENDS:
            seen.add(name)
            b = _MUX_BACKENDS[name]
            if b.available():
                return b
    return None


def _kiosk_ssh_flags() -> list:
    """Return SSH flags that isolate kiosk sessions from the user's home directory.

    -F none              — ignore ~/.ssh/config
    -o IdentityFile=none — no default identity files from ~/.ssh/
    -o IdentitiesOnly=yes — only use explicitly listed identity files

    If the kiosk SSH identity key exists, it is appended as -i <path>.
    """
    flags = ['-F', 'none', '-o', 'IdentityFile=none', '-o', 'IdentitiesOnly=yes']
    if os.path.exists(_KIOSK_SSH_IDENTITY):
        flags += ['-i', _KIOSK_SSH_IDENTITY]
    return flags


class Application:
    def __init__(self, entries, log_file=None):
        """Initialise the application from an ordered list of entry tuples.

        entries  — list of ('host', name), ('section', title), or ('cmd', text)
                   tuples, as returned by parse_hosts_file() or built from argv.
        log_file — optional path; new events are appended here in real time.
        self.monitors — PingMonitor instances only (used for stats/threading).
        self.entries  — ordered display list mixing PingMonitor and SectionLabel.

        All entry types are processed in a single pass in document order:
          • 'host'    — creates a PingMonitor; any static DNS override stored in
                        hosts_map by an earlier :resolv command is applied immediately.
          • 'section' — creates a SectionLabel display row.
          • 'cmd'     — dispatched inline via _dispatch_cmd() so that structural
                        commands (:ssh) appear at their correct position in the
                        display list, and configuration commands (:dns, :resolv, …)
                        take effect at the point they are encountered in the file.
        """
        self.entries = []   # ordered display list: PingMonitor | SectionLabel
        self.monitors = []  # pure PingMonitor list for stats, threading, DNS
        self.hosts_map = {}  # static DNS overrides: ip→(ip, hostname) and hostname→(ip, hostname)
        self.port_map = {}   # static port overrides: port_num→service_name and service_name→port_num
        self.history_size = 86400  # per-host ping history deque size (default 24 h at 1 ping/s)
        self.sync_history = False  # align history bars to wall-clock time (off by default)
        self.log_size = 10000
        self.events = deque(maxlen=self.log_size)
        self.dns_mode = 0      # index into DNS_MODES; 0 = off (as-is)
        self.stats_mode = 0    # index into STATS_MODES; 0 = off
        self.stats_custom = None  # list[str] of canonical stat names when in custom mode, else None
        self._custom_col_hwm: dict = {}   # cname -> high-water-mark width (expands fast, shrinks slow)
        self._custom_col_hwm_age: dict = {}  # cname -> render frames since last expansion
        self.sort_by = 'none'  # none, name, status, latency
        self.history_mode = 0  # index into HISTORY_MODES
        self.history_offset = 0  # 0 = live (newest), >0 = scrolled back
        self._visible_ping_length = 50  # updated by draw_hosts(); used for scroll step
        self.log_offset = 0      # 0 = tail mode, >0 = scrolled back in event log
        self.host_scroll = 0     # number of entries to skip from top of host list
        self.highlighted_index = None  # None = no selection; int = index in self.entries
        self.log_file = None        # path to append event log, or None
        self.variables: dict[str, str] = {}  # :let variable store (name → value)
        self.connect_rules: list = []  # [(glob_pattern, ssh_opts | None), ...]; None = disabled
        self.mux_split = 'v'           # default mux split direction: v=below, h=right, window
        self.terminal_emulator = 'auto'  # X terminal emulator name ('auto' or binary)
        self.kiosk_mode = False        # set True by --kiosk flag
        self.hosts_file = None         # path of the active hosts file (for :edit)
        self._monitoring_started = False  # set True once start_monitoring() is called
        self._load_config()         # apply config-file settings (before hosts-file commands)
        if log_file is not None:    # command-line -l/--log-file always overrides config
            self.log_file = log_file
        if not os.path.exists(_config_path()):
            self._create_default_config()
        self.prompt = None        # None = no prompt; dict = prompt is open (see _open_prompt_*)
        self.cmd = None           # None = inactive; dict = command mode open (text buffer + cursor)
        self.cmd_history = []     # list of previously entered commands (oldest first)
        self._load_cmd_history()
        self.help_open = False    # True while the help overlay is visible
        self.help_scroll = 0      # first visible line index in the help overlay
        self.details_open = False # True while the host details overlay is visible
        self.details_monitor = None  # PingMonitor instance whose details are shown
        self.details_scroll = 0   # Scroll offset for the host details overlay
        self.pending_key = None   # Pending multi-key prefix (e.g. 'z' waiting for second key)
        self.running = True
        self.threads = []
        self._start_time = None

        for kind, *rest in entries:
            value = rest[0] if rest else ''
            if kind == 'host':
                host_str, port_str = parse_target(value)
                if port_str:
                    m = PortMonitor(host_str, port_str, port_map=self.port_map)
                else:
                    m = PingMonitor(host_str)
                # Apply any :resolv static DNS override that was processed earlier
                # in the same file (hosts_map is populated by _apply_hosts_entry).
                if host_str in self.hosts_map:
                    ip, hostname = self.hosts_map[host_str]
                    m.resolved_ip = ip
                    m.resolved_hostname = hostname
                    m.resolv_static = True
                self.monitors.append(m)
                self.entries.append(m)
            elif kind == 'optional_host':
                # Only add the monitor when a :resolv mapping exists for this host.
                # Used by '?host' lines (inside or outside :for loops) to skip hosts
                # that are absent from the topology without raising an error.
                host_str, port_str = parse_target(value)
                if host_str not in self.hosts_map:
                    continue  # no :resolv mapping → silently skip
                ip, hostname = self.hosts_map[host_str]
                if port_str:
                    m = PortMonitor(host_str, port_str, port_map=self.port_map)
                else:
                    m = PingMonitor(host_str)
                m.resolved_ip = ip
                m.resolved_hostname = hostname
                m.resolv_static = True
                self.monitors.append(m)
                self.entries.append(m)
            elif kind == 'section':
                level = rest[1] if len(rest) > 1 else 1
                folded_default = rest[2] if len(rest) > 2 else False
                self.entries.append(SectionLabel(value, level, folded_default))
            elif kind == 'cmd':
                self._dispatch_cmd(value)
            elif kind == 'warn':
                self.add_event("hosts", f"warning: {value}")
            elif kind == 'error':
                self.add_event("hosts", f"expansion error: {value}")

    def add_event(self, host, message):
        """Add an event to the in-memory log and, if a log file is configured,
        append it immediately to that file.

        Timestamp format: ISO 8601 with timezone offset (e.g. 2026-03-20T14:05:32+0200).
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        max_host_len = max((len(m.get_display_name(dns_mode='off')) for m in self.monitors), default=len(host))
        line = f"{timestamp}   {host:<{max_host_len}} {message}"
        self.events.append(line)
        if self.log_file:
            try:
                with open(self.log_file, 'a') as f:
                    f.write(line + "\n")
            except OSError:
                pass  # silently ignore file write errors to avoid recursive events

    def _load_config(self):
        """Load settings from the XDG config file, silently ignoring a missing file.

        The file uses the same ':cmd [args]' syntax as the interactive command
        line and hosts files.  Lines starting with '#' are comments; lines that
        do not start with ':' are silently skipped.

        Supported commands:
          :set dns [off|hostname|ip]   — set DNS display mode
          :set stats [mode]            — set stats column mode
          :set sort [mode]             — set sort order
          :set ping-view [mode]        — set history display mode
          :log [path|off]          — set or disable the streaming log file

        All commands are dispatched through _dispatch_cmd().  Because
        _monitoring_started is False at this point, no add_event() calls are
        made and no side-effects (prompts, file I/O) are triggered.
        """
        path = _config_path()
        try:
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith('#'):
                        continue
                    if not line.startswith(':'):
                        continue  # silently ignore non-command lines
                    self._dispatch_cmd(line)
        except OSError:
            pass  # missing or unreadable config file is not an error

    def _save_config(self):
        """Write current settings to the XDG config file, creating dirs as needed.

        Uses the same ':cmd args' syntax as the interactive command line so the
        file can be edited by hand with the same commands used at the ':' prompt.

        Returns True on success, False on failure (error is also logged to events).
        """
        path = _config_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                f.write("# ping-bulk configuration\n")
                f.write(f":set dns {DNS_MODES[self.dns_mode]}\n")
                if self.stats_custom is not None:
                    custom_str = ','.join(h.lower() for h in self.stats_custom)
                    f.write(f":set stats {custom_str}\n")
                else:
                    f.write(f":set stats {STATS_MODES[self.stats_mode]}\n")
                f.write(f":set sort {self.sort_by}\n")
                f.write(f":set ping-view {HISTORY_MODES[self.history_mode]}\n")
                f.write(f":set log-size {self.log_size}\n")
                f.write(f":set history-size {self.history_size}\n")
                f.write(f":set sync-history {'on' if self.sync_history else 'off'}\n")
                f.write(f":set mux-split {self.mux_split}\n")
                if self.terminal_emulator != 'auto':
                    f.write(f":set terminal {self.terminal_emulator}\n")
                if self.log_file:
                    f.write(f":log {self.log_file}\n")
                else:
                    f.write("# :log\n")
        except OSError as e:
            self.add_event("config", f"error saving config: {e}")
            return False
        return True

    def _create_default_config(self):
        """Create a config file with commented defaults on first run.

        Silently ignores errors (e.g. read-only filesystem or no home directory)
        so a failed write never prevents the app from starting.
        """
        path = _config_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                f.write("# ping-bulk configuration\n")
                f.write("# Generated on first run — edit as needed.\n")
                f.write("#\n")
                f.write(f"# :set dns off            # choices: {' | '.join(DNS_MODES)}\n")
                f.write(f"# :set stats off          # choices: {' | '.join(STATS_MODES)}\n")
                f.write( "# :set sort none          # choices: none | name | status | latency\n")
                f.write(f"# :set ping-view success  # choices: {' | '.join(HISTORY_MODES)}\n")
                f.write( "# :set log-size 10000     # event log max lines\n")
                f.write( "# :set history-size 86400 # per-host ping history depth (default 24 h at 1 ping/s)\n")
                f.write( "# :log                    # path to stream event log; leave blank to disable\n")
        except OSError:
            pass  # silently ignore — e.g. read-only filesystem or missing home directory

    def _load_cmd_history(self):
        """Load command history from the XDG state file, silently ignoring errors.

        The history file contains one command per line (oldest first).  Blank
        lines and lines that are only whitespace are skipped.  The most recent
        _HISTORY_MAXLEN entries are kept in self.cmd_history.
        """
        _HISTORY_MAXLEN = 500
        path = _history_path()
        try:
            with open(path) as f:
                lines = [l.rstrip('\n') for l in f if l.strip()]
            self.cmd_history = lines[-_HISTORY_MAXLEN:]
        except OSError:
            pass  # missing file is fine

    def _save_cmd_history(self):
        """Persist self.cmd_history to the XDG state file, creating dirs as needed.

        Only the most recent _HISTORY_MAXLEN entries are written; errors are
        silently ignored so a failed write never disrupts interactive use.
        """
        _HISTORY_MAXLEN = 500
        path = _history_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w') as f:
                for line in self.cmd_history[-_HISTORY_MAXLEN:]:
                    f.write(line + '\n')
        except OSError:
            pass  # silently ignore — e.g. read-only filesystem

    def _get_completions(self, text):
        """Return a sorted list of completion candidates for the current cmd-line text.

        Context-sensitive:
          empty / first token (no trailing space)
                          — command names matching the typed prefix
          two tokens / first token + trailing space
                          — argument values for the recognised command
          three or more tokens
                          — no completions (return [])
        """
        parts = text.split()
        completing_cmd = not parts or (len(parts) == 1 and not text.endswith(' '))
        if completing_cmd:
            prefix = parts[0].lstrip(':').lower() if parts else ''
            return sorted(name for name in _CMD_MAP
                          if name.startswith(prefix) and _CMD_MAP[name].completable)

        cmd = parts[0].lstrip(':').lower()
        # Offer argument completions for the second token only.
        # Condition: we have at most 2 tokens and we are NOT positioned after a
        # completed second token followed by a space (which would be the 3rd).
        if len(parts) <= 2 and not (len(parts) == 2 and text.endswith(' ')):
            arg_prefix = parts[1] if len(parts) == 2 else ''
            cmd_def = _CMD_MAP.get(cmd)
            if cmd_def and cmd_def.arg_completer is not None:
                if isinstance(cmd_def.arg_completer, str):
                    return getattr(self, cmd_def.arg_completer)(arg_prefix)
                return cmd_def.arg_completer(arg_prefix)
            if cmd_def and cmd_def.arg_choices is not None:
                arg_prefix_lower = arg_prefix.lower()
                choices = (cmd_def.arg_choices()
                           if callable(cmd_def.arg_choices)
                           else cmd_def.arg_choices)
                return [c for c in choices if c.startswith(arg_prefix_lower)]

        # Special case: ':set <param> [value]' — complete the value for the given parameter.
        # This is a 3-token completion that the generic 2-token block above cannot handle.
        if cmd == 'set' and len(parts) >= 2:
            subcmd = parts[1].lower()
            param = _SET_PARAM_MAP.get(subcmd)
            if param is not None:
                # Complete the value token (3rd), but not beyond it.
                if len(parts) <= 3 and not (len(parts) == 3 and text.endswith(' ')):
                    arg_prefix = parts[2] if len(parts) == 3 else ''
                    # If values is a method name string, delegate to that completer.
                    if isinstance(param.values, str):
                        return getattr(self, param.values)(arg_prefix)
                    arg_prefix_lower = arg_prefix.lower()
                    return [v for v in param.get_values() if v.startswith(arg_prefix_lower)]

        return []

    @staticmethod
    def _apply_completion(c, candidate):
        """Replace the partial token at the end of c['chars'] with *candidate*.

        The text before the last whitespace-separated token is kept unchanged;
        only the rightmost token (or empty string after a trailing space) is
        replaced.  The cursor is moved to the end of the substituted text.
        """
        text = ''.join(c['chars'])
        last_space = text.rfind(' ')
        if last_space == -1:
            new_text = candidate
        else:
            new_text = text[:last_space + 1] + candidate
        c['chars'] = list(new_text)
        c['cursor'] = len(new_text)

    def _complete_ping_arg(self, prefix):
        """Return Tab-completion candidates for the :ping command argument.

        Matches against statically mapped IPs and hostnames (from :resolv).
        """
        prefix_lower = prefix.lower()
        return sorted(k for k in self.hosts_map if k.lower().startswith(prefix_lower))

    def _complete_stats_arg(self, prefix):
        """Return Tab-completion candidates for the :stats / :set stats argument.

        - No comma in prefix: offer all STATS_MODES names (lowercase).
        - Comma present: the user is building a comma list; offer remaining valid
          STAT_NAMES (excluding already-used names, 'all', and 'off') filtered
          by what has been typed after the last comma.
        """
        if ',' not in prefix:
            # Single-mode completion: all STATS_MODES + STAT_NAMES aliases
            all_names = sorted(set(m.lower() for m in STATS_MODES) | set(STAT_NAMES.keys()))
            return [n for n in all_names if n.startswith(prefix.lower())]
        # Comma-list completion
        parts = [p.strip().lower() for p in prefix.split(',')]
        already_used = set(parts[:-1])  # everything before the last comma
        last = parts[-1]  # what's typed after the last comma
        # Offer STAT_NAMES keys excluding already-used, 'all', 'off'
        candidates = sorted(
            k for k in STAT_NAMES
            if k not in already_used and k not in ('all', 'off')
            and k.startswith(last)
        )
        # Return as full replacements: keep everything up to last comma + candidate
        prefix_base = prefix[:prefix.rfind(',') + 1]
        return [prefix_base + c for c in candidates]

    def start_monitoring(self):
        """Start all ping threads"""
        self._monitoring_started = True
        self._start_time = time.monotonic()
        for monitor in self.monitors:
            thread = threading.Thread(target=monitor.ping, daemon=True)
            thread.start()
            self.threads.append(thread)

        # Check for state changes
        checker = threading.Thread(target=self.check_state_changes, daemon=True)
        checker.start()

    @staticmethod
    def _format_downtime(seconds):
        """Format a duration in seconds into a human-readable string"""
        secs = int(seconds)
        mins = secs // 60
        remaining = secs % 60
        if mins > 0:
            return f"{secs} sec ({mins} min {remaining} sec)"
        return f"{secs} sec"

    def check_state_changes(self):
        """Monitor state changes and log events"""
        while self.running:
            for monitor in self.monitors:
                # Log a fatal process error exactly once, as soon as it is detected.
                if monitor.error is not None and not monitor.error_logged:
                    monitor.error_logged = True
                    display_name = monitor.get_display_name(dns_mode='off')
                    for err_line in monitor.error.splitlines():
                        if err_line.strip():
                            self.add_event(display_name, f"error: {err_line.strip()}")

                current_state = monitor.alive
                if monitor.last_state is None:
                    monitor.last_state = current_state
                    if current_state:
                        monitor.up_since = time.monotonic()
                        display_name = monitor.get_display_name(dns_mode='off')
                        self.add_event(display_name, "host starts up")
                    elif current_state is False:
                        monitor.down_since = time.monotonic()
                        display_name = monitor.get_display_name(dns_mode='off')
                        self.add_event(display_name, "host down")
                elif monitor.last_state != current_state:
                    display_name = monitor.get_display_name(dns_mode='off')
                    if current_state:
                        # Host recovered — report downtime if tracked
                        if monitor.down_since is not None:
                            downtime = time.monotonic() - monitor.down_since
                            monitor.down_since = None
                            msg = f"host recover. Down time: {self._format_downtime(downtime)}"
                        else:
                            msg = "host recover"
                        monitor.up_since = time.monotonic()
                        self.add_event(display_name, msg)
                    else:
                        monitor.down_since = time.monotonic()
                        monitor.up_since = None
                        self.add_event(display_name, "host down")
                    monitor.last_state = current_state
            time.sleep(0.5)

    def cycle_dns(self, direction=1):
        """Cycle through DNS display modes. direction=1 forward, -1 backward."""
        self.dns_mode = (self.dns_mode + direction) % len(DNS_MODES)
        # Trigger resolution threads for monitors not yet resolved when entering a resolve mode
        if DNS_MODES[self.dns_mode] in ('hostname', 'ip'):
            for monitor in self.monitors:
                if monitor.resolved_ip is None:
                    threading.Thread(target=monitor.resolve_dns, daemon=True).start()

    def cycle_stats(self, direction=1):
        """Cycle through stats display modes. direction=1 forward, -1 backward.

        When a custom column set is active it occupies one extra slot at index
        _CUSTOM_STATS_SENTINEL (== len(STATS_MODES)) in the cycle.
        """
        cycle_len = len(STATS_MODES) + (1 if self.stats_custom is not None else 0)
        self.stats_mode = (self.stats_mode + direction) % cycle_len

    def cycle_sort(self, direction=1):
        """Cycle through sort options. direction=1 forward, -1 backward."""
        sorts = ['none', 'name', 'status', 'latency']
        current_idx = sorts.index(self.sort_by)
        self.sort_by = sorts[(current_idx + direction) % len(sorts)]

    def cycle_history_mode(self, direction=1):
        """Cycle through history display modes. direction=1 forward, -1 backward."""
        self.history_mode = (self.history_mode + direction) % len(HISTORY_MODES)

    def scroll_history(self, delta):
        """Scroll history view by delta steps (positive = back in time).

        No-op when every ping fits in the visible window (nothing off-screen to
        scroll to).  The maximum offset is capped at the number of pings that
        have actually been stored in the history deque (len(m.history)) minus
        the current visible window width, so the user can never scroll past the
        oldest available sample.
        """
        max_history_len = max((len(m.history) for m in self.monitors), default=0)
        max_offset = max(0, max_history_len - self._visible_ping_length)
        if max_offset == 0:
            return  # all pings fit on screen — nothing to scroll
        self.history_offset = max(0, min(max_offset, self.history_offset + delta))

    def scroll_log(self, delta):
        """Scroll event log by delta lines (positive = up/back in time, negative = down/forward)"""
        total = len(self.events)
        max_offset = max(0, total - 1)
        self.log_offset = max(0, min(max_offset, self.log_offset + delta))

    def clamp_host_scroll(self, visible_rows: int) -> None:
        """Adjust host_scroll so that:
        - it never exceeds the last scrollable position (always applied), and
        - the highlighted entry is within the visible window (when selection is active).

        visible_rows — number of rows available for the host list (max_rows).
        """
        visible_indices = self._get_visible_entry_indices()
        # Always bound host_scroll to the valid range regardless of selection state.
        max_scroll = max(0, len(visible_indices) - visible_rows)
        self.host_scroll = max(0, min(max_scroll, self.host_scroll))

        if self.highlighted_index is None or not visible_indices:
            return
        try:
            pos = visible_indices.index(self.highlighted_index)
        except ValueError:
            return
        # Scroll so that pos is within [host_scroll, host_scroll + visible_rows - 1]
        if pos < self.host_scroll:
            self.host_scroll = pos
        elif pos >= self.host_scroll + visible_rows:
            self.host_scroll = pos - visible_rows + 1

    def _get_pause_targets(self):
        """Return the list of monitors that `p` should toggle pause on.

        - Section selected → all monitors under that section (recursive).
        - Host selected    → just that monitor.
        - Nothing selected → empty list (p is a no-op; P handles global).
        """
        if self.highlighted_index is None:
            return []
        entry = self.entries[self.highlighted_index]
        if isinstance(entry, SectionLabel):
            return self._get_section_monitors(self.highlighted_index)
        # entry is a Monitor
        return [entry]

    def _apply_pause_toggle(self, targets):
        """Pause or unpause *targets*.  If all are paused already, unpause; otherwise pause."""
        if not targets:
            return
        all_paused = all(m.paused for m in targets)
        for m in targets:
            m.unpause() if all_paused else m.pause()

    def mark_seen(self):
        """Append a visual 'seen' separator line to the event log (and log file if set).

        The marker includes the current timestamp so the user can tell exactly
        when they last reviewed the log.
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        line = f"{timestamp}   ══════════════════ seen ══════════════════"
        self.events.append(line)
        if self.log_file:
            try:
                with open(self.log_file, 'a') as f:
                    f.write(line + "\n")
            except OSError:
                pass

    # ── Fold helpers ──────────────────────────────────────────────────────────

    def _section_set_fold(self, section, state, recursive=False):
        """Set the folded state of *section*, optionally recursively.

        When *recursive* is True, all descendant SectionLabels (those with
        a higher level immediately following *section* in self.entries) are
        set to *state* as well.
        """
        section.folded = state
        if not recursive:
            return
        in_subtree = False
        for entry in self.entries:
            if entry is section:
                in_subtree = True
                continue
            if not isinstance(entry, SectionLabel):
                continue
            if in_subtree and entry.level > section.level:
                entry.folded = state
            elif in_subtree and entry.level <= section.level:
                break  # left the subtree

    def _fold_all(self, state):
        """Set all SectionLabels to *state* (True = folded, False = open)."""
        for entry in self.entries:
            if isinstance(entry, SectionLabel):
                entry.folded = state

    def _fold_level_step(self, direction):
        """Open or close sections one level at a time (global, like zr/zm).

        direction < 0 (zr): find the deepest closed level and open all at that level.
        direction > 0 (zm): find the shallowest open level and close all at that level.
        """
        sections = [e for e in self.entries if isinstance(e, SectionLabel)]
        if not sections:
            return
        levels = sorted({s.level for s in sections})
        if direction > 0:
            # zm — close the shallowest level that has any open section
            for lvl in levels:
                if any(s.level == lvl and not s.folded for s in sections):
                    for s in sections:
                        if s.level == lvl:
                            s.folded = True
                    break
        else:
            # zr — open the deepest level that has any closed section
            for lvl in reversed(levels):
                if any(s.level == lvl and s.folded for s in sections):
                    for s in sections:
                        if s.level == lvl:
                            s.folded = False
                    break

    def _do_fold_action(self, action):
        """Execute a named fold action (zo, zO, zc, zC, za, zA, zR, zM, zr, zm).

        Section-specific actions (zo/zO/zc/zC/za/zA) act on the currently
        highlighted SectionLabel; they are silently ignored when no section is
        highlighted.  Global actions (zR/zM/zr/zm) work regardless of selection.
        """
        entry = None
        if (self.highlighted_index is not None and
                0 <= self.highlighted_index < len(self.entries)):
            entry = self.entries[self.highlighted_index]
        section = entry if isinstance(entry, SectionLabel) else None

        if action == 'zo':
            if section:
                self._section_set_fold(section, False, recursive=False)
        elif action == 'zO':
            if section:
                self._section_set_fold(section, False, recursive=True)
        elif action == 'zc':
            if section:
                self._section_set_fold(section, True, recursive=False)
        elif action == 'zC':
            if section:
                self._section_set_fold(section, True, recursive=True)
        elif action == 'za':
            if section:
                self._section_set_fold(section, not section.folded, recursive=False)
        elif action == 'zA':
            if section:
                self._section_set_fold(section, not section.folded, recursive=True)
        elif action == 'zR':
            self._fold_all(False)
        elif action == 'zM':
            self._fold_all(True)
        elif action == 'zr':
            self._fold_level_step(-1)
        elif action == 'zm':
            self._fold_level_step(1)

    def _handle_z_sequence(self, key):
        """Dispatch a z* two-key fold sequence after 'z' was pressed.

        Unrecognised follow-up keys are silently ignored.
        """
        action_map = {
            ord('o'): 'zo', ord('O'): 'zO',
            ord('c'): 'zc', ord('C'): 'zC',
            ord('a'): 'za', ord('A'): 'zA',
            ord('R'): 'zR', ord('M'): 'zM',
            ord('r'): 'zr', ord('m'): 'zm',
        }
        action = action_map.get(key)
        if action:
            self._do_fold_action(action)

    # ── Section summary helpers ───────────────────────────────────────────────

    def _get_section_monitors(self, section_idx):
        """Return all Monitor descendants of the section at *section_idx*.

        Walks self.entries forward from section_idx+1, collecting every Monitor
        until a SectionLabel whose level is <= the parent section's level is
        encountered (i.e. a sibling or ancestor section).  Sub-sections and
        their hosts are included.
        """
        section = self.entries[section_idx]
        monitors = []
        for entry in self.entries[section_idx + 1:]:
            if isinstance(entry, SectionLabel):
                if entry.level <= section.level:
                    break  # sibling or ancestor — stop
            else:
                monitors.append(entry)
        return monitors

    @staticmethod
    def _worst_history_char(chars):
        """Return the worst character from a list of per-monitor history chars.

        Priority (worst first): '?' (process error) > 'X' (timeout) > '.' (ok) > ' ' (no data).
        """
        if '?' in chars:
            return '?'
        if 'X' in chars:
            return 'X'
        if '.' in chars:
            return '.'
        return ' '

    def _section_summary(self, monitors, length, offset, sync=False, end_time=None):
        """Compute ``(badge_parts, history_str)`` for a list of monitors.

        badge_parts — list of ``(text, color_pair_id)`` segments.
        history_str — worst-of-all-monitors per time slot, always in 'success' mode.
        sync/end_time are forwarded to get_history_string for wall-clock alignment.
        """
        # Badge — list of (text, color_pair_id) so each segment is coloured individually.
        # Color ids: 1=green (up), 2=red (down), 3=yellow (unknown), 6=cyan (paused), 0=default.
        paused  = sum(1 for m in monitors if m.paused)
        active  = [m for m in monitors if not m.paused]
        up      = sum(1 for m in active if m.alive is True)
        down    = sum(1 for m in active if m.alive is False)
        unknown = sum(1 for m in active if m.alive is None)
        has_error = any(m.error is not None for m in monitors)
        segs = []
        if up:      segs.append((f"{up}↑",    1))
        if down:    segs.append((f"{down}↓",  2))
        if unknown: segs.append((f"{unknown}-", 3))
        if paused:  segs.append((f"{paused}⏸", 6))
        # Build interleaved list with '/' separators between segments
        badge_parts: list = []
        for i, seg in enumerate(segs):
            if i:
                badge_parts.append(('/', 0))
            badge_parts.append(seg)
        if not badge_parts:
            badge_parts = [('-', 0)]

        # History — worst char per slot across all monitors
        if not monitors:
            history = ' ' * length
        else:
            per_monitor = [
                m.get_history_string(length=length, offset=offset, mode='success',
                                     cell_width=1, sync=sync, end_time=end_time)
                for m in monitors
            ]
            history = ''.join(
                self._worst_history_char([row[i] for row in per_monitor])
                for i in range(length)
            )

        return badge_parts, history

    def _get_visible_entry_indices(self):
        """Return a list of self.entries indices that are currently visible.

        An entry is visible if:
        - It's a section label AND sort_by == 'none' AND no ancestor section is folded
        - It's a monitor AND (sort_by != 'none' OR no ancestor section is folded)

        Folding is hierarchical: folding a level-1 section hides its level-2
        subsections and all hosts underneath.  A section stack tracks ancestors
        — when a level-N section is encountered, all stack entries with
        level >= N are popped first.

        Returns indices in display order (sorted when sort_by != 'none').
        """
        if self.sort_by == 'none':
            visible = []
            section_stack = []  # list of SectionLabel, shallowest first
            for idx, entry in enumerate(self.entries):
                if isinstance(entry, SectionLabel):
                    # Pop sections at same or deeper level — they are siblings/children
                    # of the new section and no longer in scope.
                    while section_stack and section_stack[-1].level >= entry.level:
                        section_stack.pop()
                    # This section is visible only if no ancestor is folded
                    if not any(s.folded for s in section_stack):
                        visible.append(idx)
                    section_stack.append(entry)
                else:
                    # Monitor: visible only if no section in the stack is folded
                    if not any(s.folded for s in section_stack):
                        visible.append(idx)
            return visible
        else:
            # Sorting active: only monitors are shown, no section labels
            # Return indices of all monitors in self.entries, in sorted display order
            sorted_monitors = self.get_sorted_monitors()
            return [self.entries.index(m) for m in sorted_monitors if m in self.entries]

    def get_sorted_monitors(self):
        """Get display entries sorted by current sort option.

        none    — return self.entries preserving original order, including SectionLabels.
        other   — return sorted self.monitors only (SectionLabels are omitted when sorting).
        """
        if self.sort_by == 'name':
            return sorted(self.monitors, key=lambda m: m.host)
        elif self.sort_by == 'status':
            return sorted(self.monitors, key=lambda m: (m.alive is not True, m.host))
        elif self.sort_by == 'latency':
            return sorted(self.monitors, key=lambda m: (
                m.latency if m.latency is not None else float('inf'), m.host
            ))
        return self.entries  # 'none': preserve original order with section labels

    def draw_menu_bar(self, stdscr, height, width):
        """Draw the bottom menu bar with highlighted hotkeys.

        Labels use [x] notation to mark the hotkey character, e.g. '[q]uit'.
        The character inside brackets is rendered with bold+underline to stand out.
        """
        row = height - 1
        paused_count = sum(1 for m in self.monitors if m.paused)
        if paused_count == 0:
            pause_label = "[P]ause"
        elif paused_count == len(self.monitors):
            pause_label = "[P]ause:all"
        else:
            pause_label = f"[P]ause:{paused_count}"
        if self.stats_custom is not None:
            custom_label = ','.join(h.lower() for h in self.stats_custom)
            stats_label = f"[s]tats:{custom_label}"
        else:
            stats_label = f"[s]tats:{STATS_MODES[self.stats_mode]:<5}"
        menu_items = [
            (f"[D]NS:{DNS_MODES[self.dns_mode]}", self.dns_mode != 0),
            (stats_label, False),
            (f"[o]rder:{self.sort_by}", False),
            (f"[H]istory:{HISTORY_MODES[self.history_mode]}", False),
            (f"[S]ync:{'on' if self.sync_history else 'off'}", self.sync_history),
            (pause_label, paused_count > 0),
        ]
        menu_items.extend([
            ("[C]lear log", False),
            ("help:[?]", False),
            ("[q]uit", False),
        ])

        col = 0

        for idx, (label, active) in enumerate(menu_items):
            if col >= width - 1:
                break

            # Render each character; highlight hotkey (inside [...]) in white.
            # Single-char hotkeys are shown without brackets; multi-char with brackets.
            i = 0
            while i < len(label) and col < width - 1:
                ch = label[i]
                if ch == '[':
                    i += 1
                    token = []
                    while i < len(label) and label[i] != ']':
                        token.append(label[i])
                        i += 1
                    if i < len(label):
                        i += 1  # skip ']'
                    if len(token) == 1:
                        # Single-char hotkey: no brackets
                        if col < width - 1:
                            stdscr.addstr(row, col, token[0], curses.color_pair(4) | curses.A_BOLD)
                            col += 1
                    else:
                        # Multi-char hotkey: keep brackets, highlight content
                        if col < width - 1:
                            stdscr.addstr(row, col, '[')
                            col += 1
                        for tc in token:
                            if col < width - 1:
                                stdscr.addstr(row, col, tc, curses.color_pair(4) | curses.A_BOLD)
                                col += 1
                        if col < width - 1:
                            stdscr.addstr(row, col, ']')
                            col += 1
                else:
                    stdscr.addstr(row, col, ch)
                    col += 1
                    i += 1

            # Separator
            sep = " | " if idx < len(menu_items) - 1 else ""
            if col + len(sep) < width:
                stdscr.addstr(row, col, sep)
                col += len(sep)

    @staticmethod
    def _draw_hint_text(stdscr, row, col, text, width):
        """Render *text* onto *stdscr* at (*row*, *col*) with hotkey colouring.

        Tokens of the form ``[key desc]`` are parsed:
          - The outer ``[`` and ``]`` are drawn in the default colour.
          - The *key* part (everything before the first space inside the token)
            is drawn in white/bold (``color_pair(4) | A_BOLD``).
          - The *desc* part (from the first space to ``]``) is drawn in the
            default colour.
          - ``\\[`` and ``\\]`` inside a token represent literal bracket
            characters that are part of the key (e.g. ``\\[`` → ``[``).
        Plain text outside tokens is drawn in the default colour.

        Returns the column position after the last character drawn.
        """
        i = 0
        while i < len(text) and col < width - 1:
            ch = text[i]
            if ch == '[':
                stdscr.addstr(row, col, ch)
                col += 1
                i += 1
                # Collect token content; \[ and \] are escaped literal brackets
                token = []
                while i < len(text) and text[i] != ']':
                    if text[i] == '\\' and i + 1 < len(text) and text[i + 1] in '[]':
                        token.append(text[i + 1])
                        i += 2
                    else:
                        token.append(text[i])
                        i += 1
                content = ''.join(token)
                space_pos = content.find(' ')
                if space_pos == -1:
                    key_part, desc_part = content, ''
                else:
                    key_part, desc_part = content[:space_pos], content[space_pos:]
                for tc in key_part:
                    if col < width - 1:
                        stdscr.addstr(row, col, tc, curses.color_pair(4) | curses.A_BOLD)
                        col += 1
                for tc in desc_part:
                    if col < width - 1:
                        stdscr.addstr(row, col, tc)
                        col += 1
                if i < len(text):  # closing ']'
                    if col < width - 1:
                        stdscr.addstr(row, col, ']')
                        col += 1
                    i += 1
            else:
                stdscr.addstr(row, col, ch)
                col += 1
                i += 1
        return col

    def _draw_column_header(self, stdscr, row, col, title, suffix, width):
        """Draw a column header: *title* in white/bold then *suffix* via _draw_hint_text.

        Returns the column position after the last character drawn.
        """
        if col < width - 1:
            stdscr.addstr(row, col, title, curses.color_pair(4) | curses.A_BOLD)
            col += len(title)
        return self._draw_hint_text(stdscr, row, col, suffix, width)

    def _rtt_cell_width(self):
        """Compute the cell width needed for rtt mode based on max RTT across all monitors.

        cell_width = len(str(max_rtt_ms)) + 1  (digits field + 1 trailing space)
        Minimum is 3 (2-digit field covers values up to 99 ms + 1 space).
        Uses monitor.latencies (never-capped) for a stable maximum.
        """
        max_rtt = 0
        for monitor in self.monitors:
            with monitor.lock:
                for val in monitor.latencies:
                    if val > max_rtt:
                        max_rtt = val
        return max(3, len(str(int(max_rtt))) + 1)

    def draw_hosts(self, stdscr, start_row, max_rows, width, height, show_header=True):
        """Draw host list with ping history.

        Layout per stats mode:
          off         — stat_col: Last latency (colored), history full width
          single mode — stat_col: stat value (replaces Last), history full width
          All         — all stats flush-left after hostname, history fills remaining width
          custom      — dynamic multi-column block after hostname, history fills remaining width
        """
        mode_name = STATS_MODES[self.stats_mode] if self.stats_mode < len(STATS_MODES) else 'custom'
        show_all    = (mode_name == 'All')
        show_custom = (self.stats_custom is not None and self.stats_mode == _CUSTOM_STATS_SENTINEL)
        show_single = (self.stats_mode > 0 and not show_all and not show_custom)

        # Adaptive hostname column: wide enough for all display names (including
        # their per-level indentation), the header label, and section title prefixes.
        dns_mode_str = DNS_MODES[self.dns_mode]
        # Walk entries tracking current section level to compute indented name width.
        max_name_len = len("Hostname")
        _sec_stack: list[SectionLabel] = []
        for e in self.entries:
            if isinstance(e, SectionLabel):
                while _sec_stack and _sec_stack[-1].level >= e.level:
                    _sec_stack.pop()
                _sec_stack.append(e)
            elif isinstance(e, Monitor):
                indent = _sec_stack[-1].level * 2 if _sec_stack else 0
                max_name_len = max(max_name_len, indent + len(e.get_display_name(dns_mode_str)))
        # Each section header: (level-1)*2 spaces + "── [-] " (7) + title
        max_section_len = max(
            ((e.level - 1) * 2 + 7 + len(e.title)
             for e in self.entries if isinstance(e, SectionLabel)),
            default=0
        )
        name_col_width = max(len("Hostname"), max_name_len, max_section_len)
        stat_col = name_col_width + 1   # stat value starts 1 col after hostname
        # Badge width: worst case is all monitors in one section → "N↑/N↓/N-"
        n = len(self.monitors)
        has_sections = any(isinstance(e, SectionLabel) for e in self.entries)
        max_badge_w = len(f"{n}↑/{n}↓/{n}-") if has_sections else 0
        stat_field_w = max(6, max_badge_w)
        hist_col = stat_col + stat_field_w + 1  # history starts after stat field + 1 gap

        # In 'All' mode the stats block sits flush-left immediately after the hostname;
        # the ping history bar then fills the remaining screen width to the right.
        # Layout: ms(6) + 2 + Up/Down(var) + 2 + tail(8×6 + 7×2 = 62) = dynamic width.
        updown_col_w = self._updown_col_width()
        ALL_STATS_WIDTH = 8 + updown_col_w + 2 + 62
        all_stats_col = stat_col + (stat_field_w - 6)
        ms_col = all_stats_col
        updown_col = ms_col + 8
        tail_col = updown_col + updown_col_w + 2

        # In custom mode, compute per-column widths with a high-water-mark:
        # expands immediately when a wider value appears, but only shrinks after
        # _CUSTOM_COL_SHRINK_LAG consecutive frames of narrower values.
        _CUSTOM_COL_SHRINK_LAG = 20
        custom_col_widths = []   # list of int, one per column in stats_custom
        custom_start_col = all_stats_col  # same anchor as All mode
        if show_custom and self.stats_custom:
            for cname in self.stats_custom:
                header = _STAT_HEADER.get(cname, cname)
                actual_w = len(header)
                for m in self.monitors:
                    val = self._compute_stat(m, cname)
                    actual_w = max(actual_w, len(val.strip()))
                hwm = self._custom_col_hwm.get(cname, 0)
                if actual_w >= hwm:
                    # Expand (or same width): update immediately, reset decay counter.
                    self._custom_col_hwm[cname] = actual_w
                    self._custom_col_hwm_age[cname] = 0
                else:
                    # Narrower: increment decay counter; only shrink after the lag.
                    age = self._custom_col_hwm_age.get(cname, 0) + 1
                    self._custom_col_hwm_age[cname] = age
                    if age >= _CUSTOM_COL_SHRINK_LAG:
                        self._custom_col_hwm[cname] = actual_w
                        self._custom_col_hwm_age[cname] = 0
                custom_col_widths.append(self._custom_col_hwm[cname])
        custom_total_w = (sum(custom_col_widths) + 2 * max(0, len(custom_col_widths) - 1)
                          if custom_col_widths else 0)

        if show_all:
            hist_col_effective = all_stats_col + ALL_STATS_WIDTH + 1
        elif show_custom:
            hist_col_effective = custom_start_col + custom_total_w + 1
        else:
            hist_col_effective = hist_col

        if show_header:
            stdscr.addstr(start_row, 0, "Hostname", curses.A_BOLD)

            if not show_all and not show_custom:
                # stat_col header: mode label when a single stat is active, "ms" otherwise
                col25_label = mode_name if show_single else "ms"
                stdscr.addstr(start_row, stat_col, f"{col25_label:>{stat_field_w}}", curses.A_BOLD)

            # Title includes elapsed time when running; rendered in white/bold.
            if self._start_time is not None:
                elapsed = time.monotonic() - self._start_time
                hist_title = f"Ping history: {_format_updown_time(elapsed)}"
            else:
                hist_title = "Ping history"
            hist_suffix = ""

            if not self.help_open and not self.details_open and self.cmd is None and self.prompt is None:
                if self.highlighted_index is None:
                    hist_suffix += " [↑↓/jk select host]"
                else:
                    entry = self.entries[self.highlighted_index] if 0 <= self.highlighted_index < len(self.entries) else None
                    if isinstance(entry, SectionLabel):
                        hist_suffix += " [↑↓/jk navigate] [SPACE hide/show] [p pause section] [ESC clear]"
                    else:
                        hist_suffix += " [↑↓/jk navigate] [ENTER details] [p pause host] [ESC clear]"
                        # Show connect hint if connect is not disabled for this host
                        if isinstance(entry, Monitor):
                            disabled, _ = self._build_connect_cmd(entry)
                            if not disabled:
                                hist_suffix += " [c connect]"
                if any(isinstance(e, SectionLabel) for e in self.entries):
                    # \[ and \] inside [..] are escaped bracket literals used as hotkey chars
                    hist_suffix += r"  [\[ fold-all]  [\] unfold-all]"

            if self.history_offset > 0:
                hist_suffix += f" [←{self.history_offset}  →live]"

            # Draw title in white/bold, then hints with [key desc] colouring.
            self._draw_column_header(stdscr, start_row, hist_col_effective,
                                     hist_title, hist_suffix, width)

            if show_all and all_stats_col < width:
                all_header = (f"{'ms':>6}  {'Up/Down':>{updown_col_w}}  "
                              f"{'Avg':>6}  {'Min':>6}  {'Max':>6}  "
                              f"{'Loss%':>6}  {'StDev':>6}  {'RX':>6}  {'TX':>6}  {'XX':>6}")
                stdscr.addstr(start_row, all_stats_col, all_header, curses.A_BOLD)

            if show_custom and self.stats_custom and custom_start_col < width:
                parts = []
                for i, cname in enumerate(self.stats_custom):
                    w = custom_col_widths[i]
                    header = _STAT_HEADER.get(cname, cname)
                    parts.append(f"{header:>{w}}")
                custom_header = "  ".join(parts)
                stdscr.addstr(start_row, custom_start_col,
                              custom_header[:max(0, width - 1 - custom_start_col)], curses.A_BOLD)

        data_start = start_row + (1 if show_header else 0)
        row = data_start
        sorted_monitors = self.get_sorted_monitors()

        # Cap usable column to width-1: curses raises an error when writing to
        # the very last cell (height-1, width-1) because the cursor would advance
        # off-screen. Using safe_width throughout avoids that corner-case.
        safe_width = max(0, width - 1)

        # In rtt/scaled mode use multi-character cells; success mode uses 1 char per ping.
        hist_mode = HISTORY_MODES[self.history_mode]
        if hist_mode == 'rtt':
            cell_width = self._rtt_cell_width()
        else:
            cell_width = 1  # 'success' and 'scaled' both use one column per ping

        # Resize every monitor's history deque to match the current terminal width
        # so that recorded history always fills the full available column.
        # Always size by screen columns (not ping count) so switching modes keeps data.
        normal_history_length = self.history_size
        for m in self.monitors:
            with m.lock:
                if m.history.maxlen != normal_history_length:
                    m.history       = deque(m.history,       maxlen=normal_history_length)
                    m.history_times = deque(m.history_times, maxlen=normal_history_length)

        # Compute layout constants once — they are the same for every monitor row.
        col_length = max(0, width - hist_col_effective)
        ping_length = max(1, col_length // cell_width)
        self._visible_ping_length = ping_length
        half = max(1, ping_length // 2)

        max_ping_count = max((m.ping_count for m in self.monitors), default=0)

        # Wall-clock reference time for sync-history mode; floored to whole second
        # so bucket boundaries are stable — gaps only move once per second.
        render_time = int(time.time())
        sync = self.sync_history
        if sync:
            # Shift t_end back by 1s: position 0 = previous (already-received) second,
            # so the display is stable — no transient empty at position 0 while waiting
            # for the current second's ping to arrive.
            render_time -= 1

        if sync or self.history_offset > 0:
            # Sync mode: always show the full width — new pings land at bucket 0
            # and old ones fall off naturally; sweep animation is irrelevant.
            # Scrolled view: always show the full available width too.
            display_count = ping_length
        else:
            if max_ping_count < ping_length:
                # Initial fill phase: grow from 0 to ping_length
                display_count = max_ping_count
            else:
                # Sweep phase: snap to half, grow back to ping_length-1, repeat
                display_count = half + ((max_ping_count - ping_length) % half)

        # Section stack for hierarchical fold tracking (shallowest first)
        section_stack = []
        entry_index = 0  # index in self.entries (not sorted_monitors)
        skipped = 0       # entries skipped due to host_scroll

        for item in sorted_monitors:
            if row >= data_start + max_rows or row >= height:
                break

            # Skip the first host_scroll visible entries (vertical scroll offset).
            if skipped < self.host_scroll:
                # Still need to track section_stack even for skipped entries so
                # that section indent / fold state is correct for visible rows.
                if isinstance(item, SectionLabel):
                    while section_stack and section_stack[-1].level >= item.level:
                        section_stack.pop()
                    section_stack.append(item)
                if self.sort_by == 'none':
                    actual_entry_index = entry_index
                else:
                    try:
                        actual_entry_index = self.entries.index(item)
                    except ValueError:
                        actual_entry_index = -1
                entry_index += 1
                skipped += 1
                continue

            # Find the actual index of this item in self.entries for highlighting
            # (sorted_monitors may be in different order than self.entries)
            if self.sort_by == 'none':
                # No sorting: entry_index matches position in sorted_monitors
                actual_entry_index = entry_index
            else:
                # Sorted: find the item's position in original self.entries
                try:
                    actual_entry_index = self.entries.index(item)
                except ValueError:
                    actual_entry_index = -1  # not found (shouldn't happen)

            # Check if this entry is highlighted
            is_highlighted = (self.highlighted_index is not None and
                             actual_entry_index == self.highlighted_index)

            # Base attribute for the entire row (highlight if selected)
            row_attr = curses.A_REVERSE if is_highlighted else 0

            # Section label — render header row with status badge, and history when folded
            if isinstance(item, SectionLabel):
                # Maintain the section stack: pop same/deeper levels
                while section_stack and section_stack[-1].level >= item.level:
                    section_stack.pop()
                section_stack.append(item)

                # Compute badge parts and (if folded) history for all descendant monitors
                sec_monitors = self._get_section_monitors(actual_entry_index)
                badge_parts, sec_history = self._section_summary(
                    sec_monitors, display_count, self.history_offset,
                    sync=sync, end_time=render_time
                )
                has_error = any(m.error is not None for m in sec_monitors)

                # Show fold indicator: [+] if folded, [-] if expanded
                fold_indicator = "[+]" if item.folded else "[-]"
                sec_indent = ' ' * ((item.level - 1) * 2)
                prefix = f"{sec_indent}── {fold_indicator} "
                # Truncate title so badge and history have room
                title_max = stat_col - len(prefix) - 1
                title_part = item.title[:max(0, title_max)]
                section_text = (prefix + title_part).ljust(stat_col - 1)[:stat_col - 1]

                section_attr = curses.A_BOLD | row_attr
                stdscr.addstr(row, 0, section_text, section_attr)

                # Badge at stat_col — right-aligned in the stat field,
                # each part (N↑, N↓, N-) gets its own colour.
                if stat_col < safe_width:
                    badge_total_len = sum(len(text) for text, _ in badge_parts)
                    col = stat_col + max(0, stat_field_w - badge_total_len)
                    for text, pair_id in badge_parts:
                        if col >= safe_width:
                            break
                        if pair_id == 0:
                            attr = row_attr
                        else:
                            attr = curses.color_pair(pair_id) | row_attr
                            if has_error and pair_id in (2, 3):
                                attr |= curses.A_BOLD
                        try:
                            stdscr.addstr(row, col, text, attr)
                        except curses.error:
                            pass
                        col += len(text)

                # History bar — only when folded
                if item.folded and hist_col_effective < safe_width:
                    col = hist_col_effective
                    for char in sec_history:
                        if col >= safe_width:
                            break
                        if char == 'X':
                            attr = curses.color_pair(2) | row_attr
                        elif char == '?':
                            attr = curses.color_pair(2) | curses.A_BOLD | row_attr
                        elif char == '.':
                            attr = curses.color_pair(1) | row_attr
                        else:
                            attr = row_attr
                        try:
                            stdscr.addstr(row, col, char, attr)
                        except curses.error:
                            pass
                        col += 1

                row += 1
                entry_index += 1
                continue

            # Skip this monitor if any section in the stack is folded
            if any(s.folded for s in section_stack):
                entry_index += 1
                continue

            monitor = item

            # Hostname (indented by current section depth)
            host_indent = section_stack[-1].level * 2 if section_stack else 0
            display_name = monitor.get_display_name(DNS_MODES[self.dns_mode])
            display_width = name_col_width - host_indent
            padded_name = (' ' * host_indent + display_name[:display_width]).ljust(name_col_width)
            stdscr.addstr(row, 0, padded_name, row_attr)

            # Stat col: Last latency (off) or single stat value; hidden in All/custom mode
            if not show_all and not show_custom:
                stat_value_col = stat_col + (stat_field_w - 6)
                if monitor.paused:
                    # Paused: show ⏸ in cyan regardless of stats mode
                    # Right-align in the stat field (5 spaces + symbol = 6 display cols)
                    stdscr.addstr(row, stat_value_col, "     ⏸", curses.color_pair(6) | row_attr)
                elif show_single:
                    stat_str = self._compute_stat(monitor, mode_name)
                    # _compute_stat() returns '    ??' when monitor.error is set
                    if monitor.error is not None:
                        stat_color = curses.color_pair(2) | curses.A_BOLD
                    elif mode_name == 'Down':
                        _, is_down = Application._compute_updown(monitor)
                        stat_color = curses.color_pair(2) if is_down else 0
                    else:
                        stat_color = 0
                    stdscr.addstr(row, stat_value_col, stat_str, stat_color | row_attr)
                else:
                    # off mode — show Last latency with color; '    ??' in bright red on error
                    if monitor.error is not None:
                        stdscr.addstr(row, stat_value_col, "    ??", curses.color_pair(2) | curses.A_BOLD | row_attr)
                    elif monitor.latency is not None:
                        color = curses.color_pair(1) if monitor.latency < 50 else curses.color_pair(3)
                        stdscr.addstr(row, stat_value_col, f"{monitor.latency:6.1f}", color | row_attr)
                    else:
                        stdscr.addstr(row, stat_value_col, "     -", curses.color_pair(2) | row_attr)

            history = monitor.get_history_string(
                display_count, self.history_offset, hist_mode, cell_width,
                sync=sync, end_time=render_time
            )

            # Color code the history.
            col = hist_col_effective
            if cell_width > 1:
                # rtt mode: iterate cell_width characters at a time.
                # Each cell is (cell_width-1) digit chars + 1 trailing space.
                for i in range(0, len(history), cell_width):
                    if col >= safe_width:
                        break
                    cell = history[i:i + cell_width]
                    content = cell[:cell_width - 1].lstrip()
                    if not content:
                        # blank padding cell
                        stdscr.addstr(row, col, cell, row_attr)
                    elif content[0] == 'X':
                        stdscr.addstr(row, col, cell, curses.color_pair(2) | row_attr)  # red
                    elif content[0] == '?':
                        stdscr.addstr(row, col, cell, curses.color_pair(2) | curses.A_BOLD | row_attr)  # bright red — process error
                    elif content[0] == '>':
                        stdscr.addstr(row, col, cell, curses.color_pair(3) | row_attr)  # yellow — >100 ms
                    else:
                        val = int(content)
                        if hist_mode == 'scaled':
                            # scaled values are 0-9; threshold at 5 (≈55 ms)
                            color = curses.color_pair(1) if val < 5 else curses.color_pair(3)
                        else:
                            color = curses.color_pair(1) if val < 50 else curses.color_pair(3)
                        stdscr.addstr(row, col, cell, color | row_attr)
                    col += cell_width
            else:
                # success / scaled mode: one character per ping.
                for char in history:
                    if col >= safe_width:
                        break
                    if char == 'X':
                        stdscr.addstr(row, col, char, curses.color_pair(2) | row_attr)  # red
                    elif char == '?':
                        stdscr.addstr(row, col, char, curses.color_pair(2) | curses.A_BOLD | row_attr)  # bright red — process error
                    elif char == '.':
                        stdscr.addstr(row, col, char, curses.color_pair(1) | row_attr)  # green
                    elif char in '01234':
                        stdscr.addstr(row, col, char, curses.color_pair(1) | row_attr)  # green
                    elif char in '56789':
                        stdscr.addstr(row, col, char, curses.color_pair(3) | row_attr)  # yellow
                    elif char == '>':
                        stdscr.addstr(row, col, char, curses.color_pair(5) | row_attr)  # magenta — >100 ms
                    else:
                        stdscr.addstr(row, col, char, row_attr)  # blank padding
                    col += 1

            # Right-edge scroll indicator: overwrite the last rendered history column
            # with '→' when older pings exist beyond the visible window.  This covers
            # two cases:
            #   history_offset > 0        — user has scrolled back; newer pings are off
            #                               to the right of the drawn bar.
            #   max_ping_count > display_count — sweep phase (offset == 0): the bar is
            #                               not yet full-width, so older samples recorded
            #                               before the current sweep window are off-screen.
            if (self.history_offset > 0 or max_ping_count > display_count) and col > hist_col_effective:
                try:
                    stdscr.addstr(row, width - 1, '→', curses.A_BOLD | row_attr)
                except curses.error:
                    pass  # writing to bottom-right corner may fail; ignore

            # All-stats block flush-left after hostname
            if show_all and all_stats_col < width:
                # ms (Last latency)
                if monitor.error is not None:
                    stdscr.addstr(row, ms_col, "    ??", curses.color_pair(2) | curses.A_BOLD | row_attr)
                elif monitor.latency is not None:
                    ms_color = curses.color_pair(1) if monitor.latency < 50 else curses.color_pair(3)
                    stdscr.addstr(row, ms_col, f"{monitor.latency:6.1f}", ms_color | row_attr)
                else:
                    stdscr.addstr(row, ms_col, "     -", curses.color_pair(2) | row_attr)
                # Up/Down
                updown_str, is_down = Application._compute_updown(monitor)
                updown_color = curses.color_pair(2) if is_down else 0
                stdscr.addstr(row, updown_col, f"{updown_str:>{updown_col_w}}", updown_color | row_attr)
                # Avg Min Max Loss% StDev RX TX XX
                all_str = self._compute_all_stats(monitor)
                all_color = (curses.color_pair(2) | curses.A_BOLD) if monitor.error is not None else 0
                stdscr.addstr(row, tail_col, all_str, all_color | row_attr)

            # Custom stats block flush-left after hostname
            if show_custom and self.stats_custom and custom_start_col < width:
                if monitor.paused:
                    stdscr.addstr(row, custom_start_col, "⏸", curses.color_pair(6) | row_attr)
                else:
                    col = custom_start_col
                    for i, cname in enumerate(self.stats_custom):
                        if col >= safe_width:
                            break
                        w = custom_col_widths[i]
                        val = self._compute_stat(monitor, cname)
                        val_stripped = val.strip()
                        val_padded = f"{val_stripped:>{w}}"
                        if monitor.error is not None:
                            attr = curses.color_pair(2) | curses.A_BOLD | row_attr
                        elif cname == 'Down':
                            _, is_down = Application._compute_updown(monitor)
                            attr = (curses.color_pair(2) if is_down else 0) | row_attr
                        elif cname == 'Last':
                            if monitor.latency is not None:
                                attr = (curses.color_pair(1) if monitor.latency < 50
                                        else curses.color_pair(3)) | row_attr
                            else:
                                attr = curses.color_pair(2) | row_attr
                        else:
                            attr = row_attr
                        try:
                            stdscr.addstr(row, col, val_padded, attr)
                        except curses.error:
                            pass
                        col += w + (2 if i < len(self.stats_custom) - 1 else 0)

            entry_index += 1
            row += 1

        return row

    @staticmethod
    def _compute_stat(monitor, mode):
        """Compute a formatted stat string for a given STATS_MODES label.

        Returns '    ??' (6 chars) for all fields when monitor.error is set.
        """
        if monitor.error is not None:
            return "    ??"
        with monitor.lock:
            lats = list(monitor.latencies)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count
            last = monitor.latency

        if mode == 'Last':
            return f"{last:6.1f}" if last is not None else "     -"
        elif mode == 'Loss%':
            total = rx + xx
            if total == 0:
                return "     -"
            return f"{xx / total * 100:5.1f}%"
        elif mode == 'Avg':
            if not lats:
                return "     -"
            return f"{sum(lats) / len(lats):6.1f}"
        elif mode == 'Min':
            if not lats:
                return "     -"
            return f"{min(lats):6.1f}"
        elif mode == 'Max':
            if not lats:
                return "     -"
            return f"{max(lats):6.1f}"
        elif mode == 'StDev':
            if len(lats) < 2:
                return "     -"
            avg = sum(lats) / len(lats)
            stdev = math.sqrt(sum((x - avg) ** 2 for x in lats) / len(lats))
            return f"{stdev:6.1f}"
        elif mode == 'RX':
            return f"{rx:6d}"
        elif mode == 'TX':
            return f"{tx:6d}"
        elif mode == 'XX':
            return f"{xx:6d}"
        elif mode == 'Down':
            s, _ = Application._compute_updown(monitor)
            compact = s.replace(' ', '')
            return f"{compact:>6}"[:6]
        return "     -"

    @staticmethod
    def _compute_updown(monitor):
        """Return (display_str, is_down) for the Up/Down time column.

        display_str — compact human-readable duration (via _format_updown_time)
                      or '??' on process error, or '-' when timing is unknown.
        is_down     — True when the host is currently down (used to colour the cell).
        """
        if monitor.error is not None:
            return ('??', False)
        if monitor.alive is True and monitor.up_since is not None:
            elapsed = time.monotonic() - monitor.up_since
            return (_format_updown_time(elapsed), False)
        if monitor.alive is False and monitor.down_since is not None:
            elapsed = time.monotonic() - monitor.down_since
            return (_format_updown_time(elapsed), True)
        return ('-', False)

    def _updown_col_width(self):
        """Return the column width needed for the Up/Down cell across all monitors.

        At least len('Up/Down') (7) so the header always fits.
        Scans all monitors and widens the column if any current value is longer.
        """
        max_w = len('Up/Down')
        for monitor in self.monitors:
            s, _ = Application._compute_updown(monitor)
            if len(s) > max_w:
                max_w = len(s)
        return max_w

    @staticmethod
    def _compute_all_stats(monitor):
        """Compute a compact all-stats string for 'All' mode.

        Returns a row of '    ??' placeholders (8 fields, 62 chars total) when
        monitor.error is set.
        Format (aligned to match the tail header in draw_hosts):
          Avg    Min    Max    Loss%  StDev  RX     TX     XX
        """
        if monitor.error is not None:
            placeholder = "    ??"
            sep = "  "
            return sep.join([placeholder] * 8)
        with monitor.lock:
            lats = list(monitor.latencies)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count

        # Avg
        if lats:
            avg_s = f"{sum(lats) / len(lats):6.1f}"
        else:
            avg_s = "     -"

        # Min
        min_s = f"{min(lats):6.1f}" if lats else "     -"

        # Max
        max_s = f"{max(lats):6.1f}" if lats else "     -"

        # Loss%
        total = rx + xx
        if total == 0:
            loss_s = "    - "
        else:
            loss_s = f"{xx / total * 100:5.1f}%"

        # StDev
        if len(lats) >= 2:
            avg = sum(lats) / len(lats)
            stdev = math.sqrt(sum((x - avg) ** 2 for x in lats) / len(lats))
            stdev_s = f"{stdev:6.1f}"
        else:
            stdev_s = "     -"

        return (f"{avg_s}  {min_s}  {max_s}  {loss_s}  "
                f"{stdev_s}  {rx:6d}  {tx:6d}  {xx:6d}")

    def draw_events(self, stdscr, start_row, height, width):
        """Draw event log at bottom with optional scroll support.

        log_offset=0  -> tail mode (newest events always visible)
        log_offset>0  -> scrolled back; header shows position and resume hint
        """
        page_size = max(1, height - start_row - 2)  # rows available for event lines
        total = len(self.events)
        event_list = list(self.events)

        overflows = total > page_size  # True when the log cannot fit on screen

        if self.log_offset == 0:
            # Live tail mode
            visible = event_list[-page_size:]
            header_title = 'Events'
            header_suffix = ' [SPACE to set "seen" mark]'
            if overflows:
                header_suffix += " [PgUp to scroll]"
        else:
            end = total - self.log_offset
            start = max(0, end - page_size)
            visible = event_list[start:end]
            line_start = start + 1
            line_end = end
            header_title = 'Events'
            header_suffix = f" lines {line_start}-{line_end}/{total} [PgDn to resume]"

        if self.log_file:
            header_suffix += f" → {self.log_file}"

        # Render title in white/bold; [key desc] tokens have key in white, desc default.
        self._draw_column_header(stdscr, start_row, 0, header_title, header_suffix, width)

        row = start_row + 1
        for event in visible:
            if row >= height - 1:
                break
            stdscr.addstr(row, 0, event[:width - 1])
            row += 1

    def _open_prompt_save(self):
        """Open the save-log prompt (non-blocking; state stored in self.prompt)."""
        self.prompt = {
            'type': 'save',
            'chars': list(self.log_file) if self.log_file else [],
        }

    def _open_prompt_clear(self):
        """Open the clear-log confirmation prompt (non-blocking)."""
        self.prompt = {'type': 'clear', 'chars': []}

    def _draw_prompt(self, stdscr, height, width):
        """Draw the active prompt on the bottom line and position the text cursor.

        Called every frame (after all other drawing) when self.prompt is not None.
        The caller is responsible for calling curses.curs_set(1) before refresh.
        """
        p = self.prompt
        if p['type'] == 'save':
            label = "Write log to: "
            text  = ''.join(p['chars'])
            line  = (label + text).ljust(width - 1)[:width - 1]
            stdscr.addstr(height - 1, 0, line, curses.A_REVERSE)
            cursor_x = min(len(label) + len(text), width - 2)
            stdscr.move(height - 1, cursor_x)
        elif p['type'] == 'save_confirm':
            line = "File exists: [t]runcate  [a]ppend  Esc=cancel"
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'clear':
            line = "Clear event log? [y/N]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'quit_confirm':
            line = "Quit? [y/N]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'mux_relaunch':
            line = "Not in a multiplexer — relaunch inside tmux? [Y/n]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'edit_reload':
            line = f"Reload '{p.get('file', '')}' ? [Y/n]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))

    def _handle_prompt_key(self, key):
        """Process one keypress while a prompt is active.

        Updates self.prompt in place; sets self.prompt = None when the prompt
        is dismissed (confirmed or cancelled).
        Ctrl+C (key == 3) always cancels any prompt immediately.
        """
        # Ctrl+C — cancel any prompt unconditionally
        if key == 3:
            self.prompt = None
            return

        p = self.prompt

        if p['type'] == 'save':
            if key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                filename = ''.join(p['chars']).strip()
                if filename:
                    if os.path.exists(filename):
                        # Advance to the truncate/append confirmation step
                        self.prompt = {'type': 'save_confirm', 'filename': filename, 'chars': []}
                    else:
                        self.save_to_file(filename)
                        self.log_file = filename
                        self.prompt = None
                else:
                    self.prompt = None  # empty filename — cancel
            elif key == 27:  # Escape — cancel
                self.prompt = None
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                if p['chars']:
                    p['chars'].pop()
            elif 32 <= key < 127:
                p['chars'].append(chr(key))

        elif p['type'] == 'save_confirm':
            filename = p['filename']
            if key in (ord('t'), ord('T')):
                self.save_to_file(filename, append=False)
                self.log_file = filename
            elif key in (ord('a'), ord('A')):
                if self.log_file != filename:
                    self.save_to_file(filename, append=True, write_separator=True)
                self.log_file = filename
            # Any other key (Esc, Enter, …) — cancel without saving
            self.prompt = None

        elif p['type'] == 'clear':
            if key in (ord('y'), ord('Y')):
                self.events.clear()
                self.log_offset = 0  # reset scroll position after clearing
            self.prompt = None  # any key closes the clear prompt

        elif p['type'] == 'quit_confirm':
            if key in (ord('y'), ord('Y')):
                self.running = False
            self.prompt = None  # any key closes the quit prompt

        elif p['type'] == 'mux_relaunch':
            if key not in (ord('n'), ord('N'), 27):
                # Y / Enter / any affirmative key → relaunch in tmux
                backend = _MUX_BACKENDS.get('tmux') or next(
                    (b for b in _MUX_BACKENDS.values() if b.available()), None)
                if backend:
                    cmd = backend.relaunch_cmd(sys.argv)
                    self.prompt = None
                    curses.endwin()
                    os.execvp(cmd[0], cmd)
                else:
                    self.add_event("cmd", "relaunch: tmux/screen not found")
            self.prompt = None

        elif p['type'] == 'edit_reload':
            if key not in (ord('n'), ord('N'), 27):
                self._cmd_source(p.get('file', ''))
                self.add_event("cmd", f"edit: reloaded {p.get('file', '')}")
            self.prompt = None

    def save_to_file(self, filename, append=False, write_separator=True):
        """Write the current event log to a file.

        Each line is already fully formatted by add_event() with an ISO 8601
        timestamp, so the file is a plain sequence of event lines preceded by
        a one-line header.

        append=False         — overwrite the file with a header + all events.
        append=True          — append events to the existing file.
        write_separator=True — when appending, prepend a separator line with a
                               timestamp; set to False when the file is already
                               the active streaming log (no gap to mark).
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        try:
            if append:
                with open(filename, 'a') as f:
                    if write_separator:
                        f.write(f"\n# ========== appended {timestamp} ==========\n")
                    for event in self.events:
                        f.write(event + "\n")
            else:
                with open(filename, 'w') as f:
                    f.write(f"# ping-bulk event log — saved {timestamp}\n")
                    for event in self.events:
                        f.write(event + "\n")
        except OSError as e:
            self.add_event("save", f"error: {e}")

    def _draw_cmd(self, stdscr, height, width):
        """Draw the active command line on the bottom row with a text cursor.

        Renders ':' followed by the typed text, reversed-video style, and
        positions the terminal cursor at the insertion point.

        When completions are available (after the first Tab press) a popup
        menu is drawn immediately above the command line.  The currently
        highlighted candidate (comp_idx) is shown in bold+reverse; all others
        are shown in plain reverse.  The popup scrolls so the highlighted entry
        is always in view.
        """
        c = self.cmd
        completions = c.get('completions', [])
        comp_idx = c.get('comp_idx', -1)

        if completions:
            # How many rows the popup can occupy (leave room for the cmd line itself)
            max_popup_rows = min(len(completions), height - 2)
            # Scroll the popup view so the highlighted entry is always visible.
            if comp_idx < 0:
                view_start = 0
            else:
                view_start = max(0, min(comp_idx, len(completions) - max_popup_rows))
            for i, candidate in enumerate(completions[view_start:view_start + max_popup_rows]):
                row = height - 1 - max_popup_rows + i
                if row < 0:
                    continue
                actual_idx = view_start + i
                attr = (curses.A_REVERSE | curses.A_BOLD) if actual_idx == comp_idx else curses.A_REVERSE
                try:
                    stdscr.addstr(row, 0, candidate.ljust(width - 1)[:width - 1], attr)
                except curses.error:
                    pass

        text = ''.join(c['chars'])
        line = (':' + text).ljust(width - 1)[:width - 1]
        stdscr.addstr(height - 1, 0, line, curses.A_REVERSE)
        cursor_x = min(1 + c['cursor'], width - 2)
        stdscr.move(height - 1, cursor_x)

    def _handle_cmd_key(self, key):
        """Process one keypress while command mode is active (readline-style editing).

        Supported bindings:
          Tab            — complete to LCP; open popup; then cycle forward through candidates
          Shift+Tab      — cycle backward through completion candidates
          Enter          — dispatch the command (if non-empty) and save to history
          Esc / Ctrl+C   — cancel and close command line
          Backspace/^H   — delete character before cursor
          Delete         — delete character at cursor
          Left / Right   — move cursor one character
          Home / Ctrl+A  — move cursor to start
          End  / Ctrl+E  — move cursor to end
          Ctrl+K         — kill from cursor to end of line
          Ctrl+U         — kill from start of line to cursor
          Ctrl+W         — kill word backward (stop at whitespace boundary)
          Up / Down      — navigate command history (Up=older, Down=newer)
          printable char — insert at cursor position
        """
        c = self.cmd
        chars = c['chars']
        cursor = c['cursor']

        # ── Tab — completion (early return; never resets completion state) ─────
        if key == ord('\t'):
            text = ''.join(chars)

            if not c['completions']:
                # First Tab press: compute candidates from current text.
                c['comp_prefix'] = text
                c['completions'] = self._get_completions(text)
                c['comp_idx'] = -1

                if len(c['completions']) == 1:
                    # Exactly one match — apply it directly and append a trailing
                    # space so the user can immediately type the next argument.
                    # Exception: directory paths (ending with '/') get no space
                    # so the user can keep typing deeper into the path.
                    c['comp_idx'] = 0
                    c['chars'] = list(c['comp_prefix'])
                    c['cursor'] = len(c['comp_prefix'])
                    self._apply_completion(c, c['completions'][0])
                    if not c['completions'][0].endswith('/'):
                        c['chars'].append(' ')
                        c['cursor'] += 1
                    c['completions'] = []  # no popup needed for a unique match
                    return

                if len(c['completions']) > 1:
                    # Multiple candidates — vim wildmode=longest: complete to the
                    # longest common prefix (LCP) first.  If the LCP extends the
                    # current partial token, apply it and leave the popup open so
                    # the user can see the full candidate list.  If the LCP is no
                    # longer than what is already typed, the popup stays as-is.
                    lcp = c['completions'][0]
                    for s in c['completions'][1:]:
                        while not s.startswith(lcp):
                            lcp = lcp[:-1]
                            if not lcp:
                                break

                    # The "current token" is whatever _apply_completion would
                    # replace: everything after the last space (or the whole text).
                    last_space = text.rfind(' ')
                    current_token = text[last_space + 1:] if last_space != -1 else text

                    if len(lcp) > len(current_token):
                        # LCP is longer — fill it in and wait for the next Tab.
                        c['chars'] = list(c['comp_prefix'])
                        c['cursor'] = len(c['comp_prefix'])
                        self._apply_completion(c, lcp)
                        return  # popup stays visible; next Tab will cycle

                if not c['completions']:
                    return  # no matches at all

                # LCP gave no extension — popup is already showing; nothing more to do.
                return  # wildmode=list: no cycling

            # Popup already open — cycle forward through candidates.
            n = len(c['completions'])
            c['comp_idx'] = (c['comp_idx'] + 1) % n
            c['chars'] = list(c['comp_prefix'])
            c['cursor'] = len(c['comp_prefix'])
            self._apply_completion(c, c['completions'][c['comp_idx']])
            return

        # ── Shift+Tab — cycle backward through completion candidates ──────────
        if key == curses.KEY_BTAB:
            if not c['completions']:
                # No popup yet — compute completions from current text.
                text = ''.join(chars)
                c['comp_prefix'] = text
                c['completions'] = self._get_completions(text)
                c['comp_idx'] = -1
                if not c['completions']:
                    return
                if len(c['completions']) == 1:
                    # Unique match — apply immediately (same as Tab unique-match).
                    c['comp_idx'] = 0
                    c['chars'] = list(c['comp_prefix'])
                    c['cursor'] = len(c['comp_prefix'])
                    self._apply_completion(c, c['completions'][0])
                    if not c['completions'][0].endswith('/'):
                        c['chars'].append(' ')
                        c['cursor'] += 1
                    c['completions'] = []
                    return
            # Cycle backward: wrap from 0 (or -1) to the last candidate.
            n = len(c['completions'])
            idx = c['comp_idx']
            c['comp_idx'] = (n - 1) if idx <= 0 else (idx - 1)
            c['chars'] = list(c['comp_prefix'])
            c['cursor'] = len(c['comp_prefix'])
            self._apply_completion(c, c['completions'][c['comp_idx']])
            return

        # ── All non-Tab keys clear the completion popup ────────────────────────
        c['completions'] = []
        c['comp_idx'] = -1

        if key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            text = ''.join(chars).strip()
            self.cmd = None
            if text:
                # Deduplicate: remove an earlier identical entry so the most
                # recent invocation always sits at the end of the history list.
                if text in self.cmd_history:
                    self.cmd_history.remove(text)
                self.cmd_history.append(text)
                self._save_cmd_history()
                self._dispatch_cmd(text)

        elif key in (27, 3):  # Escape / Ctrl+C — cancel
            self.cmd = None

        elif key == curses.KEY_UP:
            hist = self.cmd_history
            if hist:
                if c['hist_idx'] == -1:
                    # First Up press: save the current (unsaved) line so it can
                    # be restored when the user presses Down past the end.
                    c['saved_line'] = ''.join(chars)
                    c['hist_idx'] = len(hist) - 1
                elif c['hist_idx'] > 0:
                    c['hist_idx'] -= 1
                entry = hist[c['hist_idx']]
                c['chars'] = list(entry)
                c['cursor'] = len(entry)

        elif key == curses.KEY_DOWN:
            if c['hist_idx'] != -1:
                hist = self.cmd_history
                if c['hist_idx'] < len(hist) - 1:
                    c['hist_idx'] += 1
                    entry = hist[c['hist_idx']]
                    c['chars'] = list(entry)
                    c['cursor'] = len(entry)
                else:
                    # Past the newest history entry — restore the saved line
                    c['hist_idx'] = -1
                    entry = c['saved_line']
                    c['chars'] = list(entry)
                    c['cursor'] = len(entry)

        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if cursor > 0:
                del chars[cursor - 1]
                c['cursor'] -= 1
            c['hist_idx'] = -1  # text edit breaks history navigation

        elif key == curses.KEY_DC:  # Delete key
            if cursor < len(chars):
                del chars[cursor]
            c['hist_idx'] = -1

        elif key == curses.KEY_LEFT:
            if cursor > 0:
                c['cursor'] -= 1
            # Cursor movement does NOT reset hist_idx

        elif key == curses.KEY_RIGHT:
            if cursor < len(chars):
                c['cursor'] += 1

        elif key in (curses.KEY_HOME, 1):  # Home / Ctrl+A
            c['cursor'] = 0

        elif key in (curses.KEY_END, 5):  # End / Ctrl+E
            c['cursor'] = len(chars)

        elif key == 11:  # Ctrl+K — kill to end of line
            del chars[cursor:]
            c['hist_idx'] = -1

        elif key == 21:  # Ctrl+U — kill to start of line
            del chars[:cursor]
            c['cursor'] = 0
            c['hist_idx'] = -1

        elif key == 23:  # Ctrl+W — kill word backward
            end = cursor
            while cursor > 0 and chars[cursor - 1] == ' ':
                cursor -= 1
            while cursor > 0 and chars[cursor - 1] != ' ':
                cursor -= 1
            del chars[cursor:end]
            c['cursor'] = cursor
            c['hist_idx'] = -1

        elif 32 <= key < 127:
            chars.insert(cursor, chr(key))
            c['cursor'] += 1
            c['hist_idx'] = -1

    def _resolve_ssh_host(self, host):
        """Apply :resolv mapping to an SSH host, preserving user@ prefix if present.

        Examples:
          'ps-supervisor'      → '10.10.6.117' (if mapped)
          'user@ps-supervisor' → 'user@10.10.6.117' (if mapped)
          'unmapped-host'      → 'unmapped-host' (unchanged)

        Returns the resolved host string.
        """
        if '@' in host:
            user, hostname = host.rsplit('@', 1)
            if hostname in self.hosts_map:
                resolved_ip = self.hosts_map[hostname][0]
                return f"{user}@{resolved_ip}"
            return host
        else:
            if host in self.hosts_map:
                return self.hosts_map[host][0]
            return host

    def _apply_hosts_entry(self, ip, hostname):
        """Apply a static DNS override pair to any matching monitors.

        Stores the mapping in self.hosts_map (keyed by both ip and hostname so
        either can be used as monitor.host) and sets resolved_ip /
        resolved_hostname directly on any PingMonitor whose host matches either
        the ip or the hostname.  Also sets resolv_static = True so that the
        ping subprocess targets the IP address directly instead of the hostname.

        This is called at startup (via _dispatch_cmd from hosts-file :resolv
        lines) and interactively.  Silent on success; reports a warning to the
        event log only when no monitor matches.
        """
        self.hosts_map[ip] = (ip, hostname)
        self.hosts_map[hostname] = (ip, hostname)

        matched = 0
        for monitor in self.monitors:
            if monitor.host == ip or monitor.host == hostname:
                monitor.resolved_ip = ip
                monitor.resolved_hostname = hostname
                monitor.resolv_static = True
                matched += 1

        if matched == 0 and self._monitoring_started:
            # Only warn when running interactively — during __init__ the host entry
            # may simply appear later in the file and will pick up the mapping then.
            self.add_event("resolv",
                f"no monitor matched '{ip}' / '{hostname}' — mapping stored for future use")

    def _dispatch_cmd(self, text):
        """Dispatch a command string entered via the ':' command line.

        Parses the first word as the command name (stripping any leading ':')
        and passes the remainder as arguments.  Supported commands:

          q / quit               — quit the application
          dns  [off|hostname|ip] — cycle (no arg) or set DNS display mode
          stats [mode]           — cycle (no arg) or set stats column mode
          sort  [mode]           — cycle (no arg) or set sort order
          history/hist [mode]    — cycle (no arg) or set history display mode
          pause                  — toggle pause
          seen                   — insert 'seen' marker in event log
          clear                  — clear event log
          log [file]             — show active log file; or save/stream log to file
          help                   — open the help overlay

        Unknown commands are reported to the event log.
        """
        parts = text.split(None, 1)
        cmd  = parts[0].lstrip(':').lower()
        args = parts[1].strip() if len(parts) > 1 else ''

        cmd_def = _CMD_MAP.get(cmd)
        if cmd_def:
            self._last_cmd_name = cmd  # let handlers know which alias was used
            getattr(self, cmd_def.action)(args)
        else:
            self.add_event("cmd",
                f"unknown command: {cmd}" + (f" {args}" if args else "")
                + "  (try :help)")

    def _cmd_quit(self, args=''):
        """Quit the application."""
        self.running = False

    def _cmd_ping(self, args=''):
        """Ping a host directly.
        Usage: :ping <host>[:port]
        """
        if not args:
            self.add_event("cmd", "ping: missing host argument")
            return

        target = args.split()[0]
        host, port = parse_target(target)

        if target in [m.host for m in self.monitors]:
            self.add_event("cmd", f"ping: host '{target}' already monitored")
            return

        if port:
            monitor = PortMonitor(host, port, port_map=self.port_map)
        else:
            monitor = PingMonitor(host)

        self.monitors.append(monitor)
        self.entries.append(monitor)

        if self._monitoring_started:
            thread = threading.Thread(target=monitor.ping, daemon=True)
            thread.start()
            self.threads.append(thread)

        self.add_event("cmd", f"ping: added '{target}' to monitor list")


    def _cmd_source(self, args=""):
        """Source a file containing hosts and commands.
        Usage: :source <file>
        """
        if not args:
            self.add_event("cmd", "source: missing file argument")
            return

        filename = args.strip()

        if not os.path.exists(filename):
            self.add_event("cmd", f"source: file '{filename}' not found")
            return

        try:
            new_entries = parse_hosts_file(filename, variables=self.variables)
            for kind, *rest in new_entries:
                value = rest[0] if rest else ''
                if kind == 'host':
                    host_str, port_str = parse_target(value)

                    target = f"{host_str}:{port_str}" if port_str else host_str

                    if target not in [m.host for m in self.monitors]:
                        if port_str:
                            m = PortMonitor(host_str, port_str, port_map=self.port_map)
                        else:
                            m = PingMonitor(host_str)
                        # Apply any :resolv static DNS override
                        if host_str in self.hosts_map:
                            ip, hostname = self.hosts_map[host_str]
                            m.resolved_ip = ip
                            m.resolved_hostname = hostname
                            m.resolv_static = True
                        self.monitors.append(m)
                        self.entries.append(m)
                        if self._monitoring_started:
                            thread = threading.Thread(target=m.ping, daemon=True)
                            thread.start()
                            self.threads.append(thread)
                elif kind == 'section':
                    level = rest[1] if len(rest) > 1 else 1
                    folded_default = rest[2] if len(rest) > 2 else False
                    self.entries.append(SectionLabel(value, level, folded_default))
                elif kind == 'cmd':
                    self._dispatch_cmd(value)
                elif kind == 'warn':
                    self.add_event("hosts", f"warning: {value}")
                elif kind == 'error':
                    self.add_event("hosts", f"expansion error: {value}")
            self.add_event("cmd", f"source: loaded '{filename}'")
        except Exception as e:
            self.add_event("cmd", f"source error: {e}")

    def _cmd_let(self, args=''):
        """Define or redefine a :let variable.

        Usage: :let <name> [value]

        Sets self.variables[name] = value (empty string when value omitted).
        The name may contain brace expansion; $N in the value is eagerly
        substituted per brace index.  Takes effect immediately for subsequent
        :source or :for loops loaded in the same session.
        """
        if not args:
            self.add_event("cmd", "let: usage: :let <name> [value]")
            return
        parts = args.split(None, 1)
        name_tmpl = parts[0]
        val_tmpl  = parts[1] if len(parts) > 1 else ''
        try:
            name_rows = _expand_host_with_captures(name_tmpl)
        except ValueError as e:
            self.add_event("cmd", f"let: name expansion error: {e}")
            return
        for exp_name, name_caps in name_rows:
            exp_val = _apply_backref(val_tmpl, name_caps, val_tmpl)
            self.variables[exp_name] = exp_val
        if self._monitoring_started:
            preview = ', '.join(
                f'{n}={v!r}' for n, *rest in name_rows[:3]
                for v in [_apply_backref(val_tmpl, rest[0] if rest else [], val_tmpl)]
            )
            self.add_event("cmd", f"let: set {preview}"
                           + (' …' if len(name_rows) > 3 else ''))


    # ── :mux / :tmux / :screen / :term ──────────────────────────────────────

    def _cmd_mux_split(self, args=''):
        """Set or cycle the default mux split direction (:set mux-split v|h|window)."""
        valid = ['v', 'h', 'window']
        if not args:
            idx = valid.index(self.mux_split) if self.mux_split in valid else 0
            self.mux_split = valid[(idx + 1) % len(valid)]
        elif args in valid:
            self.mux_split = args
        else:
            self.add_event("cmd", f"mux-split: invalid value '{args}'; choices: v h window")
            return
        if self._monitoring_started:
            self.add_event("cmd", f"mux-split: {self.mux_split}")

    def _cmd_set_terminal(self, args=''):
        """Set the X/Wayland terminal emulator used by :term (:set terminal <name>|auto)."""
        value = args.strip() or 'auto'
        self.terminal_emulator = value
        _MUX_BACKENDS['terminal'].terminal = value
        if self._monitoring_started:
            self.add_event("cmd", f"terminal: {value}")

    def _cmd_mux(self, args=''):
        """Run a command in a tmux/screen pane, window, or X terminal.

        :mux [-v|-h|-w] <command...>
        :tmux / :screen are aliases; the alias name hints at a preferred backend.
        :term / :terminal / :xterm force the X terminal emulator backend.
        """
        # Determine which alias was used (stored briefly on self._last_cmd_name).
        _alias = getattr(self, '_last_cmd_name', None)
        _alias_map = {'tmux': 'tmux', 'screen': 'screen',
                      'term': 'terminal', 'terminal': 'terminal', 'xterm': 'terminal'}
        preference = _alias_map.get(_alias)

        tokens = args.split() if args else []

        # Parse optional split-direction override
        direction = self.mux_split
        if tokens and tokens[0] in ('-v', '-h', '-w'):
            flag = tokens.pop(0)
            direction = {'-v': 'v', '-h': 'h', '-w': 'window'}.get(flag, flag[1:])

        if not tokens:
            self.add_event("cmd", "mux: usage: :mux [-v|-h|-w] <command...>")
            return

        # Kiosk whitelist: only ssh and login are permitted; X terminal not allowed
        if self.kiosk_mode:
            cmd_name = tokens[0].lower()
            if cmd_name not in ('ssh', 'login'):
                self.add_event("cmd",
                    f"mux: '{cmd_name}' not allowed in kiosk mode (only ssh/login)")
                return
            # Kiosk only supports tmux
            backend = _MUX_BACKENDS.get('tmux')
            if backend is None or not backend.available():
                self.add_event("cmd", "mux: kiosk mode requires tmux (not found)")
                return
        else:
            # When the user explicitly names a multiplexer (e.g. :tmux or :screen),
            # verify we are actually inside that session before trying — otherwise
            # the backend binary exists but the session socket does not and the
            # subprocess prints its error directly to the terminal.
            if preference in ('tmux', 'screen'):
                named = _MUX_BACKENDS[preference]
                if not named.is_inside():
                    if not named.available():
                        self.add_event("cmd",
                            f"mux: {preference} is not installed")
                    else:
                        self.prompt = {'type': 'mux_relaunch', 'chars': []}
                    return
            backend = _resolve_mux_backend(preference)
            if backend is None:
                self.add_event("cmd",
                    "mux: no terminal multiplexer or X terminal available "
                    "(install tmux, screen, or an X terminal emulator)")
                return
            # For real mux backends (tmux/screen): if we're not currently inside
            # a session, the backend binary exists but has no session socket —
            # offer to relaunch inside one instead of hitting a cryptic error.
            if backend is not _MUX_BACKENDS.get('terminal') and not backend.is_inside():
                self.prompt = {'type': 'mux_relaunch', 'chars': []}
                return

        try:
            if direction == 'window':
                backend.new_window(tokens)
            else:
                backend.split(direction, tokens)
        except RuntimeError as e:
            self.add_event("cmd", f"mux: {e}")

    def _build_connect_cmd(self, monitor) -> tuple:
        """Return (disabled: bool, ssh_cmd: list) for the 'c' hotkey.

        Iterates connect_rules with fnmatch (last-match wins).  Returns
        (True, []) if a disable rule matched, or (False, ssh_cmd_tokens) otherwise.
        """
        host = getattr(monitor, 'host', '')
        resolved = getattr(monitor, 'resolved_hostname', '') or ''

        matched_opts = ''
        matched_disabled = False
        for pattern, opts in self.connect_rules:
            if fnmatch.fnmatch(host, pattern) or fnmatch.fnmatch(resolved, pattern):
                if opts is None:
                    matched_disabled = True
                else:
                    matched_disabled = False
                    matched_opts = opts

        if matched_disabled:
            return True, []

        # Build ssh command tokens
        if isinstance(monitor, SshPingMonitor):
            # Reuse the existing SSH args (jump hosts, user, etc.) from the monitor
            ssh_parts = list(monitor._original_ssh_args)
        else:
            # Plain PingMonitor or PortMonitor
            if isinstance(monitor, PortMonitor):
                target = monitor._ping_host
            else:
                target = monitor.host
            ssh_parts = [target]

        # Prepend connect-options flags (before target host)
        if matched_opts:
            try:
                opt_tokens = shlex.split(matched_opts)
            except ValueError:
                opt_tokens = matched_opts.split()
            ssh_parts = opt_tokens + ssh_parts

        # In kiosk mode, inject SSH key isolation flags at the front
        if self.kiosk_mode:
            ssh_parts = _kiosk_ssh_flags() + ssh_parts

        return False, ['ssh'] + ssh_parts

    def _open_cmd_prefill(self, text: str):
        """Open command mode with the given text pre-filled and cursor at the end."""
        self.cmd = {
            'chars': list(text),
            'cursor': len(text),
            'hist_idx': -1,
            'saved_line': '',
            'completions': [], 'comp_idx': -1, 'comp_prefix': '',
        }

    def _connect_to_highlighted(self):
        """Handle the 'c' hotkey: build an SSH command for the highlighted host
        and open command mode pre-filled with 'mux ssh <cmd>'.

        If not inside any multiplexer and not in kiosk mode, offer to relaunch.
        If the host has a disable rule in connect_rules, flash a message instead.
        """
        if self.highlighted_index is None or \
                not (0 <= self.highlighted_index < len(self.entries)):
            self.add_event("cmd", "c: select a host first (\u2191/\u2193 to navigate)")
            return

        entry = self.entries[self.highlighted_index]
        if not isinstance(entry, Monitor):
            self.add_event("cmd", "c: select a host line (not a section header)")
            return

        backend = _resolve_mux_backend()
        if backend is None:
            if self.kiosk_mode:
                self.add_event("cmd", "c: no terminal multiplexer (install tmux)")
                return
            # Offer relaunch — open a Y/n prompt
            self.prompt = {'type': 'mux_relaunch', 'chars': []}
            return

        disabled, ssh_cmd = self._build_connect_cmd(entry)
        if disabled:
            self.add_event("cmd", f"c: connect disabled for {entry.host}")
            return

        prefill = 'mux ' + shlex.join(ssh_cmd)
        self._open_cmd_prefill(prefill)

    # ── :connect-options ────────────────────────────────────────────────────

    def _cmd_connect_options(self, args=''):
        """Manage glob-based SSH connect rules.

        :connect-options <glob> <ssh-opts>  — add/replace rule (opts='-' to disable)
        :connect-options <glob>             — remove rule for that pattern
        :connect-options                    — clear all rules
        """
        if not args.strip():
            self.connect_rules.clear()
            if self._monitoring_started:
                self.add_event("cmd", "connect-options: all rules cleared")
            return

        parts = args.split(None, 1)
        pattern = parts[0]
        if len(parts) == 1:
            # Remove the rule for this pattern
            before = len(self.connect_rules)
            self.connect_rules = [(p, o) for p, o in self.connect_rules if p != pattern]
            if self._monitoring_started:
                removed = before - len(self.connect_rules)
                self.add_event("cmd",
                    f"connect-options: removed {removed} rule(s) for '{pattern}'")
            return

        opts_str = parts[1].strip()
        # '-' is the special disable marker -> store as None
        opts = None if opts_str == '-' else opts_str
        # Replace existing rule for the same pattern
        self.connect_rules = [(p, o) for p, o in self.connect_rules if p != pattern]
        self.connect_rules.append((pattern, opts))
        if self._monitoring_started:
            status = 'disabled' if opts is None else f'opts={opts_str!r}'
            self.add_event("cmd", f"connect-options: '{pattern}' → {status}")

    # ── :edit ────────────────────────────────────────────────────────────────

    def _resolve_editor(self) -> list:
        """Return [editor_binary] or [editor_binary, flags] to open a file.

        Kiosk mode uses rnano (restricted nano, no shell escape), then rvim.
        All environment variables ($VISUAL/$EDITOR) are ignored in kiosk mode.
        Normal mode respects $VISUAL, $EDITOR, then Debian's 'editor' alternative.
        """
        if self.kiosk_mode:
            for candidate in ('rnano', 'rvim'):
                if shutil.which(candidate):
                    return [candidate]
            if shutil.which('vim'):
                return ['vim', '-Z']
            return []
        for candidate in [
            os.environ.get('VISUAL'),
            os.environ.get('EDITOR'),
            'editor', 'vim', 'vi',
        ]:
            if candidate and shutil.which(candidate):
                return [candidate]
        return []

    def _cmd_edit(self, args=''):
        """Open the active hosts file in an external editor, then reload it."""
        if not self.hosts_file:
            self.add_event("cmd", "edit: no hosts file loaded (use -f <file>)")
            return

        if not os.access(self.hosts_file, os.W_OK):
            self.add_event("cmd",
                f"edit: no write permission for {self.hosts_file}")
            return

        editor_cmd = self._resolve_editor()
        if not editor_cmd:
            if self.kiosk_mode:
                self.add_event("cmd",
                    "edit: no restricted editor found (install rnano or rvim)")
            else:
                self.add_event("cmd", "edit: no editor found "
                               "(set $VISUAL or $EDITOR, or install vim)")
            return

        import curses as _curses
        _curses.endwin()
        try:
            subprocess.call(editor_cmd + [self.hosts_file])
        finally:
            _curses.doupdate()

        if self.kiosk_mode:
            self._cmd_source(self.hosts_file)
            self.add_event("cmd", f"edit: reloaded {self.hosts_file}")
        else:
            self.prompt = {'type': 'edit_reload', 'chars': [], 'file': self.hosts_file}

    def _cmd_dns(self, args=''):
        """Cycle (no arg) or set DNS display mode."""
        if args:
            modes_lower = [m.lower() for m in DNS_MODES]
            if args.lower() in modes_lower:
                self.dns_mode = modes_lower.index(args.lower())
                if DNS_MODES[self.dns_mode] in ('hostname', 'ip'):
                    for monitor in self.monitors:
                        if monitor.resolved_ip is None:
                            threading.Thread(
                                target=monitor.resolve_dns, daemon=True
                            ).start()
            else:
                self.add_event("cmd",
                    f"dns: unknown mode '{args}' — choices: {' '.join(DNS_MODES)}")
        else:
            self.cycle_dns(1)

    def _cmd_stats(self, args=''):
        """Cycle (no arg), set single-mode, or set custom comma-separated column list.

        Examples:
          :set stats avg          — single mode
          :set stats last,avg,stdev — custom multi-column
          :set stats ,            — clear custom, back to off
        """
        if not args:
            self.cycle_stats(1)
            return

        args = args.strip()

        # Bare comma or empty list → clear custom, reset to off
        if args in (',', ''):
            self.stats_custom = None
            self.stats_mode = 0
            return

        # Comma list → custom multi-column mode
        if ',' in args:
            tokens = [t.strip().lower() for t in args.split(',') if t.strip()]
            if not tokens:
                self.stats_custom = None
                self.stats_mode = 0
                return
            unknown = [t for t in tokens if t not in STAT_NAMES]
            if unknown:
                valid = sorted(STAT_NAMES.keys())
                self.add_event("cmd",
                    f"stats: unknown column(s): {', '.join(unknown)} — "
                    f"valid: {', '.join(valid)}")
                return
            self.stats_custom = [STAT_NAMES[t] for t in tokens]
            self.stats_mode = _CUSTOM_STATS_SENTINEL
            return

        # Single name — could be standard STATS_MODES or a STAT_NAMES alias
        arg_lower = args.lower()
        modes_lower = [m.lower() for m in STATS_MODES]
        if arg_lower in modes_lower:
            self.stats_mode = modes_lower.index(arg_lower)
            self.stats_custom = None
        elif arg_lower in STAT_NAMES:
            # e.g. ':set stats last' → treat as custom single-column
            self.stats_custom = [STAT_NAMES[arg_lower]]
            self.stats_mode = _CUSTOM_STATS_SENTINEL
        else:
            valid = sorted(set(modes_lower) | set(STAT_NAMES.keys()))
            self.add_event("cmd",
                f"stats: unknown mode '{args}' — "
                f"choices: {', '.join(v for v in valid if v != 'last')}"
                f" (or comma list e.g. last,avg,stdev)")


    def _cmd_sort(self, args=''):
        """Cycle (no arg) or set sort order."""
        sorts = ['none', 'name', 'status', 'latency']
        if args:
            if args.lower() in sorts:
                self.sort_by = args.lower()
            else:
                self.add_event("cmd",
                    f"sort: unknown mode '{args}' — choices: {' '.join(sorts)}")
        else:
            self.cycle_sort(1)

    def _cmd_history(self, args=''):
        """Cycle (no arg) or set history display mode."""
        if args:
            modes_lower = [m.lower() for m in HISTORY_MODES]
            if args.lower() in modes_lower:
                self.history_mode = modes_lower.index(args.lower())
            else:
                self.add_event("cmd",
                    f"history: unknown mode '{args}' — choices: {' '.join(HISTORY_MODES)}")
        else:
            self.cycle_history_mode(1)

    def _cmd_set(self, args=''):
        """Set a display mode by name: :set <setting> [value].

        Delegates to the corresponding individual command handler, so every
        value accepted by the individual commands is also accepted here.
        With no value the targeted setting is cycled forward (same behaviour
        as calling the individual command with no argument).

        Supported settings are defined in SET_PARAMS (dns, stats, sort,
        ping-view).  Each entry maps to the corresponding _cmd_* method.
        """
        parts = args.split(None, 1)
        if not parts:
            choices = '|'.join(p.name for p in SET_PARAMS)
            self.add_event("cmd", f"set: usage: :set {choices} [value]")
            return
        subcmd = parts[0].lower()
        subargs = parts[1].strip() if len(parts) > 1 else ''
        param = _SET_PARAM_MAP.get(subcmd)
        if param is None:
            choices = '  '.join(p.name for p in SET_PARAMS)
            self.add_event("cmd",
                f"set: unknown setting '{subcmd}' — choices: {choices}")
        else:
            getattr(self, param.action)(subargs)

    def _cmd_pause(self, args=''):
        """Toggle or set global pause (all monitors). Args: on | off | (empty = toggle)."""
        val = args.strip().lower()
        all_paused = all(m.paused for m in self.monitors)
        if val == 'on':
            want_pause = True
        elif val == 'off':
            want_pause = False
        else:
            want_pause = not all_paused
        for m in self.monitors:
            m.pause() if want_pause else m.unpause()

    def _cmd_seen(self, args=''):
        """Insert a 'seen' marker in the event log."""
        self.mark_seen()

    def _cmd_clear(self, args=''):
        """Clear the event log."""
        self.events.clear()
        self.log_offset = 0

    def _cmd_log(self, args=''):
        """Show active log file, set/stream log to file, or disable logging."""
        if args:
            if args.lower() == 'off':
                if self._monitoring_started:
                    if self.log_file:
                        self.add_event("log", f"logging stopped (was: {self.log_file})")
                    else:
                        self.add_event("log", "logging is already off")
                self.log_file = None
            else:
                old = self.log_file
                self.log_file = args
                if self._monitoring_started and old != args:
                    self.add_event("log", f"logging to: {args}")
        else:
            if self.log_file:
                self.add_event("log", f"active log file: {self.log_file}")
            else:
                self.add_event("log", "no log file active")

    def _cmd_log_size(self, args=''):
        """Set the event log maximum line count: :set log-size <n>."""
        if not args:
            self.add_event("log-size", f"current log size: {self.log_size}")
            return
        try:
            n = int(args)
            if n < 1:
                raise ValueError
        except ValueError:
            self.add_event("cmd", f"log-size: invalid value '{args}' — must be a positive integer")
            return
        self.log_size = n
        self.events = deque(self.events, maxlen=n)
        if self._monitoring_started:
            self.add_event("log-size", f"event log size set to {n}")

    def _cmd_history_size(self, args=''):
        """Set the per-host ping history depth: :history-size <n>.

        Resizes the history deque on every monitor in place, preserving as
        many existing samples as the new size permits.
        """
        if not args:
            self.add_event("history-size", f"current history size: {self.history_size}")
            return
        try:
            n = int(args)
            if n < 1:
                raise ValueError
        except ValueError:
            self.add_event("cmd",
                f"history-size: invalid value '{args}' — must be a positive integer")
            return
        self.history_size = n
        for monitor in self.monitors:
            with monitor.lock:
                monitor.history       = deque(monitor.history,       maxlen=n)
                monitor.history_times = deque(monitor.history_times, maxlen=n)
        if self._monitoring_started:
            self.add_event("history-size", f"per-host ping history size set to {n}")

    def _cmd_sync_history(self, args=''):
        """Toggle or set sync-history mode (on/off)."""
        val = args.strip().lower()
        if val == 'on':
            self.sync_history = True
        elif val == 'off':
            self.sync_history = False
        else:
            self.sync_history = not self.sync_history
        state = 'on' if self.sync_history else 'off'
        if self._monitoring_started:
            self.add_event("sync-history", f"wall-clock history alignment {state}")

