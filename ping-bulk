class SetParam:
    """Descriptor for a single ':set' sub-command parameter.

    name   — sub-command name used after ':set' (e.g. 'dns', 'ping-view')
    action — name of the Application method to delegate to (e.g. '_cmd_dns')
    values — list[str] or zero-argument callable returning list[str]
    help   — short description shown in the help overlay
    getter — callable(app) -> str returning the current value; used by the
             settings overlay to display live values without side-effects
    """
    __slots__ = ('name', 'action', 'values', 'help', 'getter')

    def __init__(self, name, action, values, help='', getter=None):
        self.name   = name
        self.action = action
        self.values = values
        self.help   = help
        self.getter = getter

    def get_values(self):
        """Return the list of valid values, evaluating a callable if necessary."""
        return self.values() if callable(self.values) else self.values

    def get_current(self, app):
        """Return the current value string for this parameter (read-only, no side-effects)."""
        if self.getter is not None:
            try:
                return str(self.getter(app))
            except Exception:
                pass
        return '?'

    def next_value(self, app, direction=1):
        """Return the next (direction=+1) or previous (direction=-1) value, or None if free-form."""
        vals = self.get_values()
        # String sentinel '_complete_stats_arg' means free-form (stats column)
        if not vals or self.values == '_complete_stats_arg':
            return None
        cur = self.get_current(app).lower()
        vals_lower = [v.lower() for v in vals]
        try:
            idx = vals_lower.index(cur)
        except ValueError:
            idx = -1
        return vals[(idx + direction) % len(vals)]


