    def _execute_binding(self, binding):
        """Execute a _Binding (one or more commands, or fill command line).

        Variable tokens (%h, %i, %r, %d, %H, %p, %j, %s, %%, %{X:sep}) are
        expanded from the currently highlighted entry.  If a required variable
        is unavailable the keypress is silently ignored and a warning logged.
        """
        commands, warning = self._expand_binding_commands(binding.commands)
        if warning:
            self.add_event("bind-key", warning)
            return

        if binding.edit_mode:
            cmd_text = ' \\; '.join(commands)
            if cmd_text.startswith(':'):
                cmd_text = cmd_text[1:]
            self.cmd = {
                'chars': list(cmd_text), 'cursor': len(cmd_text),
                'hist_idx': -1, 'saved_line': '',
                'completions': [], 'comp_idx': -1, 'comp_prefix': '',
            }
        else:
            self._mux_from_binding = True
            try:
                for cmd in commands:
                    self._dispatch_cmd(cmd)
            finally:
                self._mux_from_binding = False

    def _dispatch_mode_key(self, mode, key):
        """Dispatch a keypress in a non-normal UI mode (help/details/command).

        Looks up *key* in the trie for *mode* and executes the binding's
        commands via _dispatch_cmd.  Returns True if a binding was found and
        executed, False otherwise.
        """
        binding, _ = self._key_trie.resolve([key], set(), mode=mode)
        if binding is None:
            return False
        for cmd in binding.commands:
            self._dispatch_cmd(cmd)
        return True

    # ── Binding variable expansion ────────────────────────────────────────

    _BINDING_VAR_RE = re.compile(
        r'%\{(?P<svar>\w+):(?P<sep>[^}]*)\}|%(?P<var>[a-zA-Z%])')

    # Matches %{var?template} where template may contain one level of nested {…}
    # (to support patterns like %{j?-J %{j:,}}).
    _COND_RE = re.compile(r'%\{(\w+)\?([^{}]*(?:\{[^{}]*\}[^{}]*)*)\}')

    def _expand_conditional(self, s, ctx):
        """Expand %{var?template} blocks before the main variable pass.

        If *var* is present in *ctx* the inner *template* is expanded using
        the normal ``_replace_var`` logic.  Any missing variable inside the
        template (or an absent *var*) causes the whole block to become ``''``.
        """
        def replace_cond(m):
            var, template = m.group(1), m.group(2)
            if var not in ctx:
                return ''
            try:
                return self._BINDING_VAR_RE.sub(
                    lambda tm: self._replace_var(tm, ctx), template)
            except _BindingVarMissing:
                return ''
        return self._COND_RE.sub(replace_cond, s)

    def _expand_binding_commands(self, commands):
        """Expand %vars in a list of command strings.

        Returns ``(expanded_commands, warning_or_None)``.
        On missing required variable returns the original commands and a warning.
        """
        ctx = self._binding_context()
        try:
            expanded = [self._expand_conditional(c, ctx) for c in commands]
            return ([self._BINDING_VAR_RE.sub(
                lambda m: self._replace_var(m, ctx), c) for c in expanded], None)
        except _BindingVarMissing as e:
            return (commands, str(e))

    def _binding_context(self):
        """Build the variable context dict from current selection.

        Keys and their meaning:
          h  — entry.host (display name, always set for Monitor entries)
          i  — resolved IP (DNS or :resolv static)
          r  — connectable target: static :resolv IP when available, else host
          d  — SSH destination (SshPingMonitor only: _ssh_dest)
          j  — jump host list (SshPingMonitor only, from -J flags; list like %H)
          p  — TCP port number (PortMonitor only)
          s  — section title (SectionLabel entries)
          H  — list of display names for all hosts in section (always a list)
          R  — list of connectable targets for all hosts in section (%r logic)
        """
        def _entry_r(e):
            """Return the connectable target for a Monitor entry (%r logic)."""
            if isinstance(e, PortMonitor):
                return (e._ping_host if not (e.resolv_static and e.resolved_ip)
                        else e.resolved_ip)
            elif isinstance(e, SshPingMonitor):
                return e._ping_host
            else:
                # PingMonitor
                return (e.resolved_ip if e.resolv_static and e.resolved_ip
                        else e.host)

        ctx = {}
        entry = None
        if (self.highlighted_index is not None and
                0 <= self.highlighted_index < len(self.entries)):
            entry = self.entries[self.highlighted_index]
        if isinstance(entry, Monitor):
            ctx['h'] = entry.host
            if entry.resolved_ip:
                ctx['i'] = entry.resolved_ip
            if isinstance(entry, PortMonitor):
                ctx['p'] = str(entry.port)
                ctx['r'] = _entry_r(entry)
            elif isinstance(entry, SshPingMonitor):
                ctx['r'] = _entry_r(entry)
                # %d — the SSH endpoint being connected to
                ctx['d'] = entry._ssh_dest
                # %j — jump host list from -J flags (absent when no jumps)
                jump_hosts = entry._extract_jump_hosts(entry._ssh_args)
                if jump_hosts:
                    ctx['j'] = jump_hosts
            else:
                ctx['r'] = _entry_r(entry)
        elif isinstance(entry, SectionLabel):
            ctx['s'] = entry.title
        # %H / %R — all hosts in the section containing the selection
        if entry is not None:
            section_entries = self._monitors_in_section(self.highlighted_index)
            if section_entries:
                ctx['H'] = [e.host for e in section_entries]
                ctx['R'] = [_entry_r(e) for e in section_entries]
        return ctx

    def _hosts_in_section(self, idx):
        """Return list of host names for the section containing *idx*."""
        return [e.host for e in self._monitors_in_section(idx)]

    def _monitors_in_section(self, idx):
        """Return list of Monitor objects for the section containing *idx*."""
        # Walk backward to find the enclosing SectionLabel
        si = idx
        while si >= 0 and not isinstance(self.entries[si], SectionLabel):
            si -= 1
        if si < 0:
            # No section — collect all monitors
            return [e for e in self.entries if isinstance(e, Monitor)]
        # Collect monitors until next section at the same or lower level
        level = self.entries[si].level
        monitors = []
        for e in self.entries[si + 1:]:
            if isinstance(e, SectionLabel) and e.level <= level:
                break
            if isinstance(e, Monitor):
                monitors.append(e)
        return monitors

    @staticmethod
    def _replace_var(m, ctx):
        """Regex replacement callback for binding variable expansion."""
        var = m.group('var') or m.group('svar')
        sep = m.group('sep')
        if var == '%':
            return '%'
        value = ctx.get(var)
        if value is None:
            raise _BindingVarMissing(
                f"%{var}: no value (nothing selected or wrong host type)")
        if isinstance(value, list):
            s = (sep if sep is not None else ' ').replace('\\n', '\n').replace('\\t', '\t')
            return s.join(value)
        return value

    def _cmd_bindkey_show_all(self):
        """Open the help overlay on the Bindings tab."""
        self._cmd_help()
        self.help_tab = 4

    def _cmd_bindkey(self, args=''):
        """Bind, unbind, or list key bindings.  Also dispatched by :unbind-key.

        :bind-key [--show]                      — list all bindings in [A] overlay
        :bind-key [--mode MODE] [--%x] <key>    — query: show what is bound
        :bind-key [--mode MODE] [--desc TEXT] [--hint TEXT] [--%x] <key> <cmd>
                                                — bind key to command(s)
        :unbind-key [--mode MODE] [--%x] <key>  — remove a binding

        --mode MODE:  normal (default), help, details, command
                      comma-separated to bind in multiple overlay modes at once:
                        --mode help,details,settings
                        --mode normal,help,details
        --desc TEXT:  description shown in help overlay custom-bindings section
        --hint TEXT:  short label shown in the menu bar (e.g. "[t]ool")
        --if-cmd PRG: only bind if PRG is found in PATH (shutil.which)
        --if-sh "CMD": only bind if CMD exits 0 (blocked in kiosk mode)
        Context flags (--%h/--%s/--%p/--%r/--%d/--%j) restrict to context (normal only).
        """
        if self.kiosk_mode and not getattr(self, '_loading_file', False):
            self.add_event("cmd", "bind-key: blocked in kiosk mode")
            return

        args = args.strip()

        # no args or --show: open [A] all-bindings overlay
        if not args or args == '--show':
            self._cmd_bindkey_show_all()
            return

        # Parse --mode, --desc, --hint, --if-cmd, --if-sh flags before context flags
        bind_modes = ['normal']
        bind_desc = ''
        bind_hint = ''
        if_cmd_checks = []
        if_sh_checks = []
        for _ in range(16):
            if args.startswith('--mode '):
                rest = args[7:].lstrip()
                val, _, args = rest.partition(' ')
                bind_modes = [m.strip() for m in val.split(',') if m.strip()]
                args = args.strip()
            elif args.startswith('--desc '):
                rest = args[7:].lstrip()
                if rest and rest[0] in ('"', "'"):
                    q = rest[0]
                    end = rest.find(q, 1)
                    if end != -1:
                        bind_desc = rest[1:end]
                        args = rest[end + 1:].lstrip()
                    else:
                        bind_desc = rest[1:]
                        args = ''
                else:
                    parts = rest.split(' --', 1)
                    bind_desc = parts[0].strip()
                    args = ('--' + parts[1]) if len(parts) > 1 else ''
            elif args.startswith('--hint '):
                rest = args[7:].lstrip()
                if rest and rest[0] in ('"', "'"):
                    q = rest[0]
                    end = rest.find(q, 1)
                    if end != -1:
                        bind_hint = rest[1:end]
                        args = rest[end + 1:].lstrip()
                    else:
                        bind_hint = rest[1:]
                        args = ''
                else:
                    parts = rest.split(' --', 1)
                    bind_hint = parts[0].strip()
                    args = ('--' + parts[1]) if len(parts) > 1 else ''
            elif args.startswith('--if-cmd '):
                rest = args[9:].lstrip()
                val, _, args = rest.partition(' ')
                if_cmd_checks.append(val.strip())
                args = args.strip()
            elif args.startswith('--if-sh '):
                rest = args[8:].lstrip()
                if rest and rest[0] in ('"', "'"):
                    q = rest[0]
                    end = rest.find(q, 1)
                    if end != -1:
                        if_sh_checks.append(rest[1:end])
                        args = rest[end + 1:].lstrip()
                    else:
                        if_sh_checks.append(rest[1:])
                        args = ''
                else:
                    parts = rest.split(' --', 1)
                    if_sh_checks.append(parts[0].strip())
                    args = ('--' + parts[1]) if len(parts) > 1 else ''
            else:
                break

        _VALID_MODES = frozenset(('normal', 'help', 'details', 'command'))
        invalid = [m for m in bind_modes if m not in _VALID_MODES]
        if invalid:
            self.add_event("cmd",
                f"bind-key: unknown mode(s) {', '.join(repr(m) for m in invalid)}"
                " (use normal/help/details/command)")
            return

        # Evaluate --if-cmd / --if-sh conditions (load-time gates)
        if if_sh_checks and self.kiosk_mode:
            self.add_event("bind-key",
                           "skipped: --if-sh blocked in kiosk mode",
                           level=LEVEL_INFO)
            return
        for prog in if_cmd_checks:
            if not shutil.which(prog):
                self.add_event("bind-key",
                               f"skipped ({prog} not in PATH)",
                               level=LEVEL_INFO)
                return
        for sh_cmd in if_sh_checks:
            try:
                result = subprocess.run(
                    sh_cmd, shell=True, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, timeout=5)
                if result.returncode != 0:
                    self.add_event("bind-key",
                                   f"skipped (--if-sh failed: {sh_cmd})",
                                   level=LEVEL_INFO)
                    return
            except (subprocess.TimeoutExpired, OSError):
                self.add_event("bind-key",
                               f"skipped (--if-sh error: {sh_cmd})",
                               level=LEVEL_INFO)
                return

        # Parse context flags (--%h, --%s, --%p, --%j) — only for normal mode
        context = None
        if bind_modes == ['normal']:
            context, args = _parse_context_flags(args)
            if context is False:
                self.add_event("cmd", f"bind-key: {args}")
                return
            args = args.strip()

        if not args:
            self.add_event("cmd", "bind-key: missing key notation")
            return

        # Parse key notation (first token or angle-bracket group)
        key_str, _, rest = self._split_bindkey_args(args)
        try:
            key_codes = _parse_key_notation(key_str)
        except ValueError as e:
            self.add_event("cmd", f"bind-key: {e}")
            return

        overlay_modes = [m for m in bind_modes if m != 'normal']
        has_normal = 'normal' in bind_modes
        mode_str = ','.join(bind_modes)

        # For overlay-mode operations we only support single key_code (no multi-key)
        if overlay_modes:
            key_code = key_codes[0] if key_codes else None
            if key_code is None:
                self.add_event("cmd", "bind-key: empty key sequence")
                return

        if not rest:
            # Query or unbind
            is_unbind = getattr(self, '_last_cmd_name', None) == 'unbind-key'
            if has_normal:
                ctx_str = _format_context(context)
                if is_unbind:
                    removed = self._key_trie.remove(key_codes, context)
                    if removed:
                        self._unbound_defaults.add(f"{ctx_str}{key_str}")
                        self.add_event("bind-key", f"unbound {ctx_str}{key_str}")
                    else:
                        self.add_event("bind-key", f"no binding for {key_str}")
                else:
                    bindings_dict, has_children = self._key_trie.lookup(key_codes)
                    normal_bindings = bindings_dict.get('normal', {})
                    if normal_bindings:
                        b = next(iter(normal_bindings.values()))
                        cmds_display = ' \\; '.join(b.commands)
                        suffix = '...' if b.edit_mode else ''
                        self.add_event("bind-key",
                                       f"{ctx_str}{key_str} → {cmds_display}{suffix}")
                    elif has_children:
                        self.add_event("bind-key",
                                       f"{ctx_str}{key_str} is a prefix (multi-key sequence)")
                    else:
                        self.add_event("bind-key", f"no binding for {key_str}")
            for bm in overlay_modes:
                if is_unbind:
                    removed = self._key_trie.remove([key_code], None, mode=bm)
                    if removed:
                        self._unbound_defaults.add(f"--mode {bm} {key_str}")
                        self.add_event("bind-key", f"unbound --mode {bm} {key_str}")
                    else:
                        self.add_event("bind-key",
                                       f"no binding for --mode {bm} {key_str}")
                else:
                    b, _ = self._key_trie.resolve([key_code], set(), mode=bm)
                    if b:
                        cmds_display = ' \\; '.join(b.commands)
                        self.add_event("bind-key",
                                       f"--mode {bm} {key_str} → {cmds_display}")
                    else:
                        self.add_event("bind-key",
                                       f"no binding for --mode {bm} {key_str}")
            return

        # Bind: parse the command(s)
        edit_mode = rest.endswith('...')
        cmd_text = rest[:-3].rstrip() if edit_mode else rest
        commands = [c.strip() for c in re.split(r'(?<!\\)\\\;', cmd_text)]
        commands = [c for c in commands if c]
        if not commands:
            self.add_event("cmd", "bind-key: empty command")
            return

        binding = _Binding(commands, edit_mode=edit_mode,
                           key_notation=key_str, origin='user',
                           context=context, mode=mode_str,
                           desc=bind_desc, hint=bind_hint)

        # If replacing a normal-mode prefix node with a binding, clear the children
        bindings_dict, has_children = self._key_trie.lookup(key_codes)
        if has_children and not bindings_dict:
            self._key_trie.clear_subtree(key_codes)

        self._key_trie.insert(key_codes, binding)

        # For non-normal modes with <CR>, also register the other Enter variants
        if overlay_modes and key_codes == [curses.KEY_ENTER]:
            for extra in (ord('\n'), ord('\r')):
                self._key_trie.insert([extra], binding)

        if has_normal:
            ctx_str = _format_context(context)
            self._unbound_defaults.discard(f"{ctx_str}{key_str}")
        for bm in overlay_modes:
            self._unbound_defaults.discard(f"--mode {bm} {key_str}")

        cmds_display = ' \\; '.join(commands)
        suffix = '...' if edit_mode else ''
        if has_normal and not overlay_modes:
            ctx_str = _format_context(context)
            desc_str = f'  [{bind_desc}]' if bind_desc else ''
            self.add_event("bind-key",
                           f"{ctx_str}{key_str} → {cmds_display}{suffix}{desc_str}")
        else:
            self.add_event("bind-key",
                           f"--mode {mode_str} {key_str} → {cmds_display}{suffix}")

    @staticmethod
    def _split_bindkey_args(args):
        """Split ':bindkey' args into (key_notation, separator, rest).

        The key is the first whitespace-delimited token unless it starts
        with '<', in which case it extends to the matching '>'.
        Multi-char sequences like 'za' are a single token.
        """
        args = args.strip()
        if not args:
            return ('', '', '')
        # Consume key notation: angle-bracket groups and bare chars
        i = 0
        while i < len(args):
            if args[i] == '<':
                end = args.find('>', i)
                if end == -1:
                    break
                i = end + 1
            elif args[i] in (' ', '\t'):
                break
            else:
                i += 1
        key_str = args[:i]
        rest = args[i:].lstrip()
        return (key_str, ' ' if rest else '', rest)

    # ── Section summary helpers ───────────────────────────────────────────────

    def _get_section_monitors(self, section_idx):
        """Return all Monitor descendants of the section at *section_idx*.

        Walks self.entries forward from section_idx+1, collecting every Monitor
        until a SectionLabel whose level is <= the parent section's level is
        encountered (i.e. a sibling or ancestor section).  Sub-sections and
        their hosts are included.
        """
        section = self.entries[section_idx]
        monitors = []
        for entry in self.entries[section_idx + 1:]:
            if isinstance(entry, SectionLabel):
                if entry.level <= section.level:
                    break  # sibling or ancestor — stop
            else:
                monitors.append(entry)
        return monitors

    def _get_direct_section_monitors(self, section_idx):
        """Return only the direct Monitor children of the section at *section_idx*.

        Stops at the first SectionLabel (of any level), so sub-section hosts are
        NOT included.  Used for per-section autofold liveness checks.
        """
        monitors = []
        for entry in self.entries[section_idx + 1:]:
            if isinstance(entry, SectionLabel):
                break  # any sub-section boundary — stop
            monitors.append(entry)
        return monitors

    def _get_hidden_section_monitors(self, section_idx):
        """Return monitors under *section_idx* that are hidden due to folding.

        A monitor is hidden when its immediate parent section (in the nesting
        stack) is folded.  Monitors under visible but unfolded subsections are
        not included — they are already on screen.  This matches the rendering
        rule in draw_hosts: sections are always navigable, only their direct
        monitors are hidden when they fold.
        """
        section = self.entries[section_idx]
        hidden = []
        stack = [section]
        for entry in self.entries[section_idx + 1:]:
            if isinstance(entry, SectionLabel):
                if entry.level <= section.level:
                    break
                while len(stack) > 1 and stack[-1].level >= entry.level:
                    stack.pop()
                stack.append(entry)
            else:
                if stack[-1].folded:
                    hidden.append(entry)
        return hidden

    def _section_autofold_locked(self, section_idx):
        """Return True if this section is locked open by autofold.

        A section is locked when autofold is on, it is not exempt (no_autofold),
        and at least one of its *direct* monitors is currently down.  In this
        state autofold will immediately reopen the section if the user folds it.
        """
        if not self.autofold:
            return False
        entry = self.entries[section_idx]
        if not isinstance(entry, SectionLabel) or entry.no_autofold:
            return False
        monitors = self._get_direct_section_monitors(section_idx)
        active = [m for m in monitors if not m.paused]
        if not active:
            return False
        known = [m for m in active if m.alive is not None]
        return bool(known) and any(m.alive is False for m in known)

    def _autofold_tick(self):
        """Check all sections for autofold/autounfold conditions."""
        if not self.autofold:
            return
        now = time.time()
        for idx, entry in enumerate(self.entries):
            if not isinstance(entry, SectionLabel):
                continue
            if entry.no_autofold:
                continue
            # Each section is evaluated by its DIRECT monitors only.
            # Subsections are evaluated independently — folding a parent only
            # hides its own direct monitors; subsection headers stay navigable.
            # Using all descendants would cause the parent to remain permanently
            # unfolded whenever any nested host is down, which also blocks
            # manual folding (autofold would immediately re-open the section).
            monitors = self._get_direct_section_monitors(idx)
            active = [m for m in monitors if not m.paused]
            if not active:
                continue
            # Determine liveness: ignore monitors still initialising (alive=None)
            known = [m for m in active if m.alive is not None]
            if not known:
                continue
            any_down = any(m.alive is False for m in known)
            all_alive = all(m.alive is True for m in known)
            sid = id(entry)
            if any_down:
                # Unfold immediately
                self._autofold_ts.pop(sid, None)
                if entry.folded:
                    entry.folded = False
            elif all_alive:
                if not entry.folded:
                    # Start or maintain countdown
                    if sid not in self._autofold_ts:
                        self._autofold_ts[sid] = now
                    elif now - self._autofold_ts[sid] >= self.autofold_delay:
                        entry.folded = True
                        self._autofold_ts.pop(sid, None)
            else:
                # Mixed alive/None — reset countdown
                self._autofold_ts.pop(sid, None)

    @staticmethod
    def _worst_history_char(chars):
        """Return the worst character from a list of per-monitor history chars.

        Priority (worst first): '?' (process error) > 'X' (timeout) > '.' (ok) > ' ' (no data).
        """
        if '?' in chars:
            return '?'
        if 'X' in chars:
            return 'X'
        if '.' in chars:
            return '.'
        return ' '

    def _section_summary(self, monitors, length, offset, sync=False, end_time=None,
                         history_monitors=None):
        """Compute ``(badge_parts, history_str, slot_ok_ratios)`` for monitors.

        badge_parts     — list of ``(text, color_pair_id)`` segments built from
                          *monitors* (all descendants).
        history_str     — worst-of per time slot, built from *history_monitors*
                          when given, otherwise from *monitors*.
        slot_ok_ratios  — per-slot fraction of monitors with ``'.'`` (0.0–1.0);
                          used by the caller to choose yellow vs red for ``'X'``.
        sync/end_time are forwarded to get_history_string for wall-clock alignment.
        """
        # Badge — list of (text, color_pair_id) so each segment is coloured individually.
        # Color ids: 1=green (up), 2=red (down), 3=yellow (unknown), 6=cyan (paused), 0=default.
        paused  = sum(1 for m in monitors if m.paused)
        active  = [m for m in monitors if not m.paused]
        up      = sum(1 for m in active if m.alive is True)
        down    = sum(1 for m in active if m.alive is False)
        unknown = sum(1 for m in active if m.alive is None)
        has_error = any(m.error is not None for m in monitors)
        segs = []
        if up:      segs.append((f"{up}↑",    1))
        if down:    segs.append((f"{down}↓",  2))
        if unknown: segs.append((f"{unknown}-", 3))
        if paused:  segs.append((f"{paused}⏸", 6))
        # Build interleaved list with '/' separators between segments
        badge_parts: list = []
        for i, seg in enumerate(segs):
            if i:
                badge_parts.append(('/', 0))
            badge_parts.append(seg)
        if not badge_parts:
            badge_parts = [('-', 0)]

        # History — worst char per slot; use history_monitors if provided
        hist_src = history_monitors if history_monitors is not None else monitors
        if not hist_src:
            history = ' ' * length
            slot_ok_ratios = [1.0] * length
        else:
            per_monitor = [
                m.get_history_string(length=length, offset=offset, mode='success',
                                     cell_width=1, sync=sync, end_time=end_time)
                for m in hist_src
            ]
            history = ''.join(
                self._worst_history_char([row[i] for row in per_monitor])
                for i in range(length)
            )
            slot_ok_ratios = []
            for i in range(length):
                chars = [row[i] for row in per_monitor]
                with_data = [c for c in chars if c != ' ']
                ok = sum(1 for c in with_data if c == '.')
                slot_ok_ratios.append(ok / len(with_data) if with_data else 1.0)

        return badge_parts, history, slot_ok_ratios

    def _get_visible_entry_indices(self):
        """Return a list of self.entries indices that are currently visible.

        An entry is visible if:
        - It's a section label AND sort_by == 'none' AND no ancestor section is folded
        - It's a monitor AND (sort_by != 'none' OR no ancestor section is folded)

        When a filter is active (_filter_query is set), only entries in
        _filter_visible are included.

        Folding is hierarchical: folding a level-1 section hides its level-2
        subsections and all hosts underneath.  A section stack tracks ancestors
        — when a level-N section is encountered, all stack entries with
        level >= N are popped first.

        Returns indices in display order (sorted when sort_by != 'none').
        """
        if self.sort_by == 'none':
            visible = []
            section_stack = []  # list of SectionLabel, shallowest first
            for idx, entry in enumerate(self.entries):
                if isinstance(entry, SectionLabel):
                    # Pop sections at same or deeper level — they are siblings/children
                    # of the new section and no longer in scope.
                    while section_stack and section_stack[-1].level >= entry.level:
                        section_stack.pop()
                    # Section labels are always navigable regardless of parent fold state:
                    # folding a parent hides its direct monitors but keeps nested section
                    # headers visible so the user can still navigate to them.
                    if not self._filter_query or idx in self._filter_visible:
                        visible.append(idx)
                    section_stack.append(entry)
                else:
                    # Monitor: visible only if its immediate parent section is not folded.
                    if not (section_stack and section_stack[-1].folded):
                        if not self._filter_query or idx in self._filter_visible:
                            visible.append(idx)
            return visible
        else:
            # Sorting active: only monitors are shown, no section labels
            # Return indices of all monitors in self.entries, in sorted display order
            sorted_monitors = self.get_sorted_monitors()
            entry_idx = {id(e): i for i, e in enumerate(self.entries)}
            result = [entry_idx[id(m)] for m in sorted_monitors if id(m) in entry_idx]
            if self._filter_query:
                result = [i for i in result if i in self._filter_visible]
            return result

    def get_sorted_monitors(self):
        """Get display entries sorted by current sort option.

        none    — return self.entries preserving original order, including SectionLabels.
        other   — return sorted self.monitors only (SectionLabels are omitted when sorting).
        """
        if self.sort_by == 'name':
            return sorted(self.monitors, key=lambda m: m.host)
        elif self.sort_by == 'status':
            return sorted(self.monitors, key=lambda m: (m.alive is not True, m.host))
        elif self.sort_by == 'latency':
            return sorted(self.monitors, key=lambda m: (
                m.latency if m.latency is not None else float('inf'), m.host
            ))
        return self.entries  # 'none': preserve original order with section labels

    @staticmethod
    def _safe_addstr(stdscr, row, col, text, attr=0):
        """Write *text* at (row, col) ignoring curses.error (e.g. bottom-right corner)."""
        try:
            stdscr.addstr(row, col, text, attr)
        except curses.error:
            pass

    @staticmethod
    def _truncate_pad(text, width):
        """Return *text* left-padded or truncated to exactly *width* characters."""
        return text.ljust(width)[:width]

    def draw_menu_bar(self, stdscr, height, width):
        """Draw the bottom menu bar with highlighted hotkeys.

        Labels use [x] notation to mark the hotkey character, e.g. '[q]uit'.
        The character inside brackets is rendered with bold+underline to stand out.
        """
        row = height - 1
        paused_count = sum(1 for m in self.monitors if m.paused)
        if paused_count == 0:
            pause_label = "[P]ause"
        elif paused_count == len(self.monitors):
            pause_label = "[P]ause:all"
        else:
            pause_label = f"[P]ause:{paused_count}"
        if self.stats_custom is not None:
            custom_label = ','.join(h.lower() for h in self.stats_custom)
            stats_label = f"[s]tats:{custom_label}"
        else:
            stats_label = f"[s]tats:{STATS_MODES[self.stats_mode]:<5}"
        menu_items = [
            (f"[D]NS:{DNS_MODES[self.dns_mode]}", self.dns_mode != 0),
            (stats_label, False),
            (f"[o]rder:{self.sort_by}", False),
            (f"[H]istory:{HISTORY_MODES[self.history_mode]}", False),
            (f"[S]ync:{'on' if self.sync_history else 'off'}", self.sync_history),
            (pause_label, paused_count > 0),
            (f"[A]utofold:{'on' if self.autofold else 'off'}", self.autofold),
        ]
        # Add hint items from trie bindings (all modes, deduplicated by id)
        seen_hints = set()
        for _keys, b in self._key_trie:
            if b.hint and b.hint not in seen_hints:
                seen_hints.add(b.hint)
                menu_items.append((b.hint, False))

        col = 0

        for idx, (label, active) in enumerate(menu_items):
            if col >= width - 1:
                break

            # Render each character; highlight hotkey (inside [...]) in white.
            # Single-char hotkeys are shown without brackets; multi-char with brackets.
            i = 0
            while i < len(label) and col < width - 1:
                ch = label[i]
                if ch == '[':
                    i += 1
                    token = []
                    while i < len(label) and label[i] != ']':
                        token.append(label[i])
                        i += 1
                    if i < len(label):
                        i += 1  # skip ']'
                    if len(token) == 1:
                        # Single-char hotkey: no brackets
                        if col < width - 1:
                            stdscr.addstr(row, col, token[0], curses.color_pair(4) | curses.A_BOLD)
                            col += 1
                    else:
                        # Multi-char hotkey: keep brackets, highlight content
                        if col < width - 1:
                            stdscr.addstr(row, col, '[')
                            col += 1
                        for tc in token:
                            if col < width - 1:
                                stdscr.addstr(row, col, tc, curses.color_pair(4) | curses.A_BOLD)
                                col += 1
                        if col < width - 1:
                            stdscr.addstr(row, col, ']')
                            col += 1
                else:
                    stdscr.addstr(row, col, ch)
                    col += 1
                    i += 1

            # Separator
            sep = " | " if idx < len(menu_items) - 1 else ""
            if col + len(sep) < width:
                stdscr.addstr(row, col, sep)
                col += len(sep)

    @staticmethod
    def _hint_text_width(text):
        """Return the rendered column width of *text* as drawn by _draw_hint_text.

        Mirrors the parser in _draw_hint_text without touching curses, so callers
        can compute the visual width of a line for layout / sizing purposes.
        Color annotations (``key:colorname``) are stripped — they contribute no
        visible columns.  The ``|`` no-space separator and ``\\[`` escapes are
        handled identically to the renderer.
        """
        width = 0
        i = 0
        while i < len(text):
            ch = text[i]
            if ch == '\\' and i + 1 < len(text) and text[i + 1] == '[':
                width += 1   # literal '['
                i += 2
            elif ch == '[':
                width += 1   # opening '['
                i += 1
                token = []
                while i < len(text) and text[i] != ']':
                    if text[i] == '\\' and i + 1 < len(text) and text[i + 1] in '[]':
                        token.append(text[i + 1])
                        i += 2
                    else:
                        token.append(text[i])
                        i += 1
                content = ''.join(token)
                pipe_pos = content.find('|')
                space_pos = content.find(' ')
                if pipe_pos != -1 and (space_pos == -1 or pipe_pos < space_pos):
                    key_part, desc_part = content[:pipe_pos], content[pipe_pos + 1:]
                elif space_pos == -1:
                    key_part, desc_part = content, ''
                else:
                    key_part, desc_part = content[:space_pos], content[space_pos:]
                # Strip optional colour annotation (e.g. ".:green" → ".")
                colon = key_part.rfind(':')
                if colon > 0 and key_part[colon + 1:] in _HINT_KEY_COLORS:
                    key_part = key_part[:colon]
                # Count '/' separators as single chars between sub-keys
                sub_keys = key_part.split('/')
                if len(sub_keys) > 1 and all(sub_keys):
                    width += len(key_part)   # chars + '/' separators already counted
                else:
                    width += len(key_part)
                width += len(desc_part)
                if i < len(text):   # closing ']'
                    width += 1
                    i += 1
            else:
                width += 1
                i += 1
        return width

    @staticmethod
    def _draw_hint_text(stdscr, row, col, text, width):
        """Render *text* onto *stdscr* at (*row*, *col*) with hotkey colouring.

        Tokens of the form ``[key desc]`` are parsed:
          - The outer ``[`` and ``]`` are drawn in the default colour.
          - The *key* part (everything before the first space or ``|``) is drawn
            in white/bold (``color_pair(4) | A_BOLD``) by default.
          - An optional colour annotation ``key:colorname`` overrides the key
            colour; recognised names: green red yellow magenta cyan brightred.
            Example: ``[.:green = reply]`` draws ``.`` in green.
          - The *desc* part (after the separator) is drawn in the default colour.
          - ``\\[`` and ``\\]`` inside a token represent literal bracket chars.
        Plain text outside tokens is drawn in the default colour.

        Returns the column position after the last character drawn.

        Outside a token, ``\\[`` is an escaped literal ``[`` (prevents token
        parsing for lines that contain a bare ``[`` character as a hotkey label).
        """
        i = 0
        while i < len(text) and col < width - 1:
            ch = text[i]
            if ch == '\\' and i + 1 < len(text) and text[i + 1] == '[':
                # \[ outside a token → draw a literal '[' without starting a token
                stdscr.addstr(row, col, '[')
                col += 1
                i += 2
            elif ch == '[':
                open_bracket_col = col
                stdscr.addstr(row, col, ch)
                col += 1
                i += 1
                # Collect token content; \[ and \] are escaped literal brackets
                token = []
                while i < len(text) and text[i] != ']':
                    if text[i] == '\\' and i + 1 < len(text) and text[i + 1] in '[]':
                        token.append(text[i + 1])
                        i += 2
                    else:
                        token.append(text[i])
                        i += 1
                content = ''.join(token)
                pipe_pos = content.find('|')
                space_pos = content.find(' ')
                if pipe_pos != -1 and (space_pos == -1 or pipe_pos < space_pos):
                    # [key|rest] — key is bold, rest follows without a leading space
                    key_part, desc_part = content[:pipe_pos], content[pipe_pos + 1:]
                elif space_pos == -1:
                    key_part, desc_part = content, ''
                else:
                    key_part, desc_part = content[:space_pos], content[space_pos:]
                # Optional colour annotation: [key:colorname desc]
                # Resolve before '/' splitting so each sub-key shares the same colour.
                colon = key_part.rfind(':')
                if colon > 0:
                    _cname = key_part[colon + 1:]
                    _cpair, _cextra = _HINT_KEY_COLORS.get(_cname, (None, 0))
                    if _cpair is not None:
                        key_part = key_part[:colon]
                        key_attr = curses.color_pair(_cpair) | _cextra
                    else:
                        _cname = None
                        key_attr = curses.color_pair(4) | curses.A_BOLD
                else:
                    _cname = None
                    key_attr = curses.color_pair(4) | curses.A_BOLD
                _full_token = _cname in _HINT_KEY_FULL_TOKENS if _cname else False
                if _full_token:
                    stdscr.addstr(row, open_bracket_col, '[', key_attr)
                # Support "key1/key2" notation: split on '/' so each sub-key is
                # bold but the separator is normal.  Guard: if splitting yields any
                # empty part (e.g. key_part IS '/'), treat the whole thing as one key.
                sub_keys = key_part.split('/')
                if len(sub_keys) > 1 and all(sub_keys):
                    for ki, sk in enumerate(sub_keys):
                        if ki > 0:
                            if col < width - 1:
                                stdscr.addstr(row, col, '/')
                                col += 1
                        for tc in sk:
                            if col < width - 1:
                                stdscr.addstr(row, col, tc, key_attr)
                                col += 1
                else:
                    for tc in key_part:
                        if col < width - 1:
                            stdscr.addstr(row, col, tc, key_attr)
                            col += 1
                for tc in desc_part:
                    if col < width - 1:
                        stdscr.addstr(row, col, tc, key_attr if _full_token else 0)
                        col += 1
                if i < len(text):  # closing ']'
                    if col < width - 1:
                        stdscr.addstr(row, col, ']', key_attr if _full_token else 0)
                        col += 1
                    i += 1
            else:
                stdscr.addstr(row, col, ch)
                col += 1
                i += 1
        return col

    def _draw_column_header(self, stdscr, row, col, title, suffix, width):
        """Draw a column header: *title* in white/bold then *suffix* via _draw_hint_text.

        Returns the column position after the last character drawn.
        """
        if col < width - 1:
            stdscr.addstr(row, col, title, curses.color_pair(4) | curses.A_BOLD)
            col += len(title)
        return self._draw_hint_text(stdscr, row, col, suffix, width)

    def _rtt_cell_width(self):
        """Compute the cell width needed for rtt mode based on max RTT across all monitors.

        cell_width = len(str(max_rtt_ms)) + 1  (digits field + 1 trailing space)
        Minimum is 3 (2-digit field covers values up to 99 ms + 1 space).
        Uses monitor.lat_max (never-capped) for a stable maximum.
        """
        max_rtt = 0.0
        for monitor in self.monitors:
            with monitor.lock:
                v = monitor._lat_max
            if v > max_rtt:
                max_rtt = v
        return max(3, len(str(int(max_rtt))) + 1)

    def _mode_banners(self):
        """Yield (label, attr) for each active mode banner row.

        Banners are drawn below the column header, one row each.  Any code that
        needs to know how many banner rows are active can call:
            n = sum(1 for _ in self._mode_banners())
        """
        if self.history_offset > 0:
            n = self.history_offset
            label = (f"  ⏸  HISTORY  ←{n} step{'s' if n != 1 else ''} back"
                     f"  [←] older  [→] newer  [Esc] return to live")
            yield label, curses.A_REVERSE | curses.A_BOLD
        if self._filter_query:
            n_vis = len(self._filter_visible_monitors)
            n_tot = len(self.monitors)
            label = (f"  🔍  FILTER  {self._filter_query}"
                     f"  [{n_vis}/{n_tot}]  [f] edit  [Esc] clear")
            yield label, curses.A_REVERSE | curses.A_BOLD
        if (self.highlighted_index is not None
                and 0 <= self.highlighted_index < len(self.entries)
                and not self.help_open and not self.details_open
                and self.cmd is None and self.prompt is None):
            entry = self.entries[self.highlighted_index]
            if isinstance(entry, SectionLabel):
                locked = self._section_autofold_locked(self.highlighted_index)
                if locked:
                    label = f"  ▶  {entry.title}  (autofold lock)  [p pause]  [ESC clear]"
                else:
                    label = f"  ▶  {entry.title}  [(C-)SPACE fold]  [p pause]  [ESC clear]"
            else:
                name = entry.host if isinstance(entry, Monitor) else str(entry)
                label = f"  ▶  {name}  [Enter details]  [p pause]  [ESC clear]"
                if isinstance(entry, Monitor):
                    disabled, _ = self._match_prog_options(
                        'ssh', entry.host,
                        getattr(entry, 'resolved_hostname', None) or '')
                    if not disabled:
                        label += "  [c connect]"
            yield label, curses.A_REVERSE | curses.A_BOLD

    def draw_hosts(self, stdscr, start_row, max_rows, width, height, show_header=True):
        """Draw host list with ping history.

        Layout per stats mode:
          off         — stat_col: Last latency (colored), history full width
          single mode — stat_col: stat value (replaces Last), history full width
          All         — all stats flush-left after hostname, history fills remaining width
          custom      — dynamic multi-column block after hostname, history fills remaining width
        """
        mode_name = STATS_MODES[self.stats_mode] if self.stats_mode < len(STATS_MODES) else 'custom'
        show_all    = (mode_name == 'All')
        show_custom = (self.stats_custom is not None and self.stats_mode == _CUSTOM_STATS_SENTINEL)
        show_single = (self.stats_mode > 0 and not show_all and not show_custom)

        # Adaptive hostname column: wide enough for all display names (including
        # their per-level indentation), the header label, and section title prefixes.
        dns_mode_str = DNS_MODES[self.dns_mode]
        name_col_width = self._get_name_col_width(dns_mode_str)
        stat_col = name_col_width + 1   # stat value starts 1 col after hostname
        # Badge width: worst case is all monitors in one section → "N↑/N↓/N-"
        n = len(self.monitors)
        has_sections = any(isinstance(e, SectionLabel) for e in self.entries)
        max_badge_w = len(f"{n}↑/{n}↓/{n}-") if has_sections else 0
        stat_field_w = max(6, max_badge_w)
        hist_col = stat_col + stat_field_w + 1  # history starts after stat field + 1 gap

        # In 'All' mode the stats block sits flush-left immediately after the hostname;
        # the ping history bar then fills the remaining screen width to the right.
        # Layout: ms(6) + 2 + Up/Down(var) + 2 + tail(8×6 + 7×2 = 62) = dynamic width.
        updown_col_w = self._updown_col_width()
        ALL_STATS_WIDTH = 8 + updown_col_w + 2 + 62
        all_stats_col = stat_col + (stat_field_w - 6)
        ms_col = all_stats_col
        updown_col = ms_col + 8
        tail_col = updown_col + updown_col_w + 2

        # In custom mode, compute per-column widths with a high-water-mark:
        # expands immediately when a wider value appears, shrinks only after
        # _CUSTOM_COL_SHRINK_SECS seconds of the column not needing more space.
        _CUSTOM_COL_SHRINK_SECS = 60.0
        now = time.monotonic()
        custom_col_widths = []   # list of int, one per column in stats_custom
        custom_start_col = all_stats_col  # same anchor as All mode
        if show_custom and self.stats_custom:
            for cname in self.stats_custom:
                header = _STAT_HEADER.get(cname, cname)
                actual_w = len(header)
                for m in self.monitors:
                    val = self._compute_stat(m, cname)
                    actual_w = max(actual_w, len(val.strip()))
                hwm = self._custom_col_hwm.get(cname, 0)
                if actual_w >= hwm:
                    # Expand (or same width): update immediately, reset shrink timer.
                    self._custom_col_hwm[cname] = actual_w
                    self._custom_col_hwm_ts[cname] = now
                else:
                    # Narrower: only shrink after the column has been stable for a while.
                    last_exp = self._custom_col_hwm_ts.get(cname, now)
                    if now - last_exp >= _CUSTOM_COL_SHRINK_SECS:
                        self._custom_col_hwm[cname] = actual_w
                        self._custom_col_hwm_ts[cname] = now
                custom_col_widths.append(self._custom_col_hwm[cname])
        custom_total_w = (sum(custom_col_widths) + 2 * max(0, len(custom_col_widths) - 1)
                          if custom_col_widths else 0)

        if show_all:
            hist_col_effective = all_stats_col + ALL_STATS_WIDTH + 1
        elif show_custom:
            hist_col_effective = custom_start_col + custom_total_w + 1
        else:
            hist_col_effective = hist_col

        if show_header:
            stdscr.addstr(start_row, 0, "Hostname", curses.A_BOLD)

            if not show_all and not show_custom:
                # stat_col header: mode label when a single stat is active, "ms" otherwise
                col25_label = mode_name if show_single else "ms"
                stdscr.addstr(start_row, stat_col, f"{col25_label:>{stat_field_w}}", curses.A_BOLD)

            # Title includes elapsed time when running; rendered in white/bold.
            if self._start_time is not None:
                elapsed = time.monotonic() - self._start_time
                hist_title = f"Ping history: {_format_updown_time(elapsed)}"
            else:
                hist_title = "Ping history"
            hist_suffix = ""

            if not self.help_open and not self.details_open and self.cmd is None and self.prompt is None:
                if self.highlighted_index is None:
                    hist_suffix += " [↑↓/jk select host]"
                # Selection hints are shown in the banner row (see _mode_banners).
                if any(isinstance(e, SectionLabel) for e in self.entries):
                    # \[ and \] are escaped bracket literals; / splits into two bold keys
                    hist_suffix += r"  [\[/\] (un)fold-all]"

            if self.history_offset > 0:
                hist_suffix += "  [←/→ scroll]"
            if self._filter_query:
                hist_suffix += "  [f edit filter]"

            # Draw title in white/bold, then hints with [key desc] colouring.
            self._draw_column_header(stdscr, start_row, hist_col_effective,
                                     hist_title, hist_suffix, width)

            if show_all and all_stats_col < width:
                all_header = (f"{'ms':>6}  {'Up/Down':>{updown_col_w}}  "
                              f"{'Avg':>6}  {'Min':>6}  {'Max':>6}  "
                              f"{'Loss%':>6}  {'StDev':>6}  {'RX':>6}  {'TX':>6}  {'XX':>6}")
                stdscr.addstr(start_row, all_stats_col, all_header, curses.A_BOLD)

            if show_custom and self.stats_custom and custom_start_col < width:
                parts = []
                for i, cname in enumerate(self.stats_custom):
                    w = custom_col_widths[i]
                    header = _STAT_HEADER.get(cname, cname)
                    parts.append(f"{header:>{w}}")
                custom_header = "  ".join(parts)
                stdscr.addstr(start_row, custom_start_col,
                              custom_header[:max(0, width - 1 - custom_start_col)], curses.A_BOLD)

        data_start = start_row + (1 if show_header else 0)

        # Mode banners: one full-width reverse-video row per active mode
        # (HISTORY, FILTER, …).  Each banner consumes one host row.
        for _blabel, _battr in self._mode_banners():
            self._safe_addstr(stdscr, data_start, 0, _blabel.ljust(width)[:width], _battr)
            data_start += 1
        row = data_start
        sorted_monitors = self.get_sorted_monitors()
        # O(n) reverse-lookup: id(entry) → index in self.entries; avoids O(n²) .index() calls
        _entry_idx_map = {id(e): i for i, e in enumerate(self.entries)}

        # Cap usable column to width-1: curses raises an error when writing to
        # the very last cell (height-1, width-1) because the cursor would advance
        # off-screen. Using safe_width throughout avoids that corner-case.
        safe_width = max(0, width - 1)

        # In rtt/scaled mode use multi-character cells; success mode uses 1 char per ping.
        hist_mode = HISTORY_MODES[self.history_mode]
        if hist_mode == 'rtt':
            cell_width = self._rtt_cell_width()
        else:
            cell_width = 1  # 'success' and 'scaled' both use one column per ping

        # Resize every monitor's history deque to match the current terminal width
        # so that recorded history always fills the full available column.
        # Always size by screen columns (not ping count) so switching modes keeps data.
        normal_history_length = self.history_size
        for m in self.monitors:
            with m.lock:
                if m.history.maxlen != normal_history_length:
                    m.history       = deque(m.history,       maxlen=normal_history_length)
                    m.history_times = deque(m.history_times, maxlen=normal_history_length)

        # Compute layout constants once — they are the same for every monitor row.
        col_length = max(0, width - hist_col_effective)
        ping_length = max(1, col_length // cell_width)
        self._visible_ping_length = ping_length
        half = max(1, ping_length // 2)

        max_ping_count = max((m.ping_count for m in self.monitors), default=0)

        # Wall-clock reference time for sync-history mode; floored to whole second
        # so bucket boundaries are stable — gaps only move once per second.
        render_time = int(time.time())
        sync = self.sync_history
        if sync:
            # Shift t_end back by 1s: position 0 = previous (already-received) second,
            # so the display is stable — no transient empty at position 0 while waiting
            # for the current second's ping to arrive.
            render_time -= 1

        if sync or self.history_offset > 0:
            # Sync mode: always show the full width — new pings land at bucket 0
            # and old ones fall off naturally; sweep animation is irrelevant.
            # Scrolled view: always show the full available width too.
            display_count = ping_length
        else:
            if max_ping_count < ping_length:
                # Initial fill phase: grow from 0 to ping_length
                display_count = max_ping_count
            else:
                # Sweep phase: snap to half, grow back to ping_length-1, repeat.
                # Only animate when all monitors have uniform history (no visible
                # failures) — if any host has X/?  the variation already shows
                # activity, so we keep the full bar to preserve context.
                _all_healthy = not any(
                    any(v is None or v == 'ERR'
                        for v in list(m.history)[-ping_length:])
                    for m in self.monitors
                )
                if _all_healthy:
                    display_count = half + ((max_ping_count - ping_length) % half)
                else:
                    display_count = ping_length

        # Section stack for hierarchical fold tracking (shallowest first)
        section_stack = []
        entry_index = 0  # index in self.entries (not sorted_monitors)
        skipped = 0       # entries skipped due to host_scroll

        for item in sorted_monitors:
            if row >= data_start + max_rows or row >= height:
                break

            # Compute actual_entry_index once, used by both skip paths and draw path
            if self.sort_by == 'none':
                actual_entry_index = entry_index
            else:
                actual_entry_index = _entry_idx_map.get(id(item), -1)

            # Filter mode: skip entries not in the visible set; maintain section_stack
            # but do NOT count them toward host_scroll so navigation still works.
            if self._filter_query and actual_entry_index not in self._filter_visible:
                if isinstance(item, SectionLabel):
                    while section_stack and section_stack[-1].level >= item.level:
                        section_stack.pop()
                    section_stack.append(item)
                entry_index += 1
                continue

            # Skip the first host_scroll visible entries (vertical scroll offset).
            if skipped < self.host_scroll:
                # Still need to track section_stack even for skipped entries so
                # that section indent / fold state is correct for visible rows.
                if isinstance(item, SectionLabel):
                    while section_stack and section_stack[-1].level >= item.level:
                        section_stack.pop()
                    section_stack.append(item)
                entry_index += 1
                skipped += 1
                continue

            # Check if this entry is highlighted or a search match
            is_highlighted = (self.highlighted_index is not None and
                             actual_entry_index == self.highlighted_index)
            is_search_match = (bool(self._search_query) and
                               self._search_mode == 'hosts' and
                               actual_entry_index in self._search_results)

            # Base attribute for the entire row (highlight if selected)
            row_attr = curses.A_REVERSE if is_highlighted else (curses.A_UNDERLINE if is_search_match else 0)

            # Section label — render header row with status badge, and history when folded
            if isinstance(item, SectionLabel):
                # Maintain the section stack: pop same/deeper levels
                while section_stack and section_stack[-1].level >= item.level:
                    section_stack.pop()
                section_stack.append(item)

                # Compute badge parts and (if folded) history for descendant monitors
                sec_monitors = self._get_section_monitors(actual_entry_index)
                hidden_monitors = self._get_hidden_section_monitors(actual_entry_index) if item.folded else None
                badge_parts, sec_history, slot_ok_ratios = self._section_summary(
                    sec_monitors, display_count, self.history_offset,
                    sync=sync, end_time=render_time,
                    history_monitors=hidden_monitors,
                )
                has_error = any(m.error is not None for m in sec_monitors)
                n_hidden = len(hidden_monitors) if hidden_monitors else 0

                # Show fold indicator: [+] if folded, [-] if expanded
                fold_indicator = "[+]" if item.folded else "[-]"
                sec_indent = ' ' * ((item.level - 1) * 2)
                prefix = f"{sec_indent}── {fold_indicator} "
                
                # Compute hidden-host count suffix when folded AND some hosts are visible
                # (when all are hidden, the badge count already tells the story).
                # When autofold is active and the section has a down host, it is
                # "locked open" — show a label so the user knows why Space won't fold it.
                n_total = len(sec_monitors)
                show_count = item.folded and n_hidden > 0 and n_hidden < n_total
                is_locked = self._section_autofold_locked(actual_entry_index)
                if is_locked:
                    count_suffix = " (autofold lock)"
                elif show_count:
                    count_suffix = f" ({n_hidden} folded)"
                else:
                    count_suffix = ""
                
                # Truncate title to fit: reserve space for prefix + title + suffix
                available = stat_col - len(prefix) - len(count_suffix) - 1
                title_text = item.title[:max(0, available)]
                title_part = title_text + count_suffix
                section_text = (prefix + title_part).ljust(stat_col - 1)[:stat_col - 1]

                section_attr = curses.A_BOLD | row_attr
                stdscr.addstr(row, 0, section_text, section_attr)

                # Badge at stat_col — right-aligned in the stat field,
                # each part (N↑, N↓, N-) gets its own colour.
                if stat_col < safe_width:
                    badge_total_len = sum(len(text) for text, _ in badge_parts)
                    col = stat_col + max(0, stat_field_w - badge_total_len)
                    for text, pair_id in badge_parts:
                        if col >= safe_width:
                            break
                        if pair_id == 0:
                            attr = row_attr
                        else:
                            attr = curses.color_pair(pair_id) | row_attr
                            if has_error and pair_id in (2, 3):
                                attr |= curses.A_BOLD
                        try:
                            stdscr.addstr(row, col, text, attr)
                        except curses.error:
                            pass
                        col += len(text)

                # History bar — only when folded
                if item.folded and hist_col_effective < safe_width:
                    col = hist_col_effective
                    for ci, char in enumerate(sec_history):
                        if col >= safe_width:
                            break
                        if char == 'X':
                            # Yellow when majority of hidden hosts are OK for this slot
                            if ci < len(slot_ok_ratios) and slot_ok_ratios[ci] > 0.5:
                                attr = curses.color_pair(3) | row_attr
                            else:
                                attr = curses.color_pair(2) | row_attr
                        elif char == '?':
                            attr = curses.color_pair(2) | curses.A_BOLD | row_attr
                        elif char == '.':
                            attr = curses.color_pair(1) | row_attr
                        else:
                            attr = row_attr
                        try:
                            stdscr.addstr(row, col, char, attr)
                        except curses.error:
                            pass
                        col += 1

                row += 1
                entry_index += 1
                continue

            # Skip this monitor if its immediate parent section is folded.
            # Only the direct parent matters: a folded parent hides its own monitors
            # but nested section headers remain visible (sections are always navigable).
            if section_stack and section_stack[-1].folded:
                entry_index += 1
                continue

            monitor = item

            # Hostname (indented by current section depth)
            host_indent = section_stack[-1].level * 2 if section_stack else 0
            display_name = monitor.get_display_name(DNS_MODES[self.dns_mode])
            display_width = name_col_width - host_indent
            padded_name = (' ' * host_indent + display_name[:display_width]).ljust(name_col_width)
            stdscr.addstr(row, 0, padded_name, row_attr)

            # Stat col: Last latency (off) or single stat value; hidden in All/custom mode
            if not show_all and not show_custom:
                stat_value_col = stat_col + (stat_field_w - 6)
                if monitor.paused:
                    # Paused: show ⏸ in cyan regardless of stats mode
                    # Right-align in the stat field (5 spaces + symbol = 6 display cols)
                    stdscr.addstr(row, stat_value_col, "     ⏸", curses.color_pair(6) | row_attr)
                elif show_single:
                    stat_str = self._compute_stat(monitor, mode_name)
                    # _compute_stat() returns '    ??' when monitor.error is set
                    if monitor.error is not None:
                        stat_color = curses.color_pair(2) | curses.A_BOLD
                    elif mode_name == 'Down':
                        _, is_down = Application._compute_updown(monitor)
                        stat_color = curses.color_pair(2) if is_down else 0
                    else:
                        stat_color = 0
                    stdscr.addstr(row, stat_value_col, stat_str, stat_color | row_attr)
                else:
                    # off mode — show Last latency with color; '    ??' in bright red on error
                    if monitor.error is not None:
                        stdscr.addstr(row, stat_value_col, "    ??", curses.color_pair(2) | curses.A_BOLD | row_attr)
                    elif monitor.latency is not None:
                        color = curses.color_pair(1) if monitor.latency < 50 else curses.color_pair(3)
                        stdscr.addstr(row, stat_value_col, f"{monitor.latency:6.1f}", color | row_attr)
                    else:
                        stdscr.addstr(row, stat_value_col, "     -", curses.color_pair(2) | row_attr)

            history = monitor.get_history_string(
                display_count, self.history_offset, hist_mode, cell_width,
                sync=sync, end_time=render_time
            )

            # Color code the history.
            col = hist_col_effective
            if cell_width > 1:
                # rtt mode: iterate cell_width characters at a time.
                # Each cell is (cell_width-1) digit chars + 1 trailing space.
                for i in range(0, len(history), cell_width):
                    if col >= safe_width:
                        break
                    cell = history[i:i + cell_width]
                    content = cell[:cell_width - 1].lstrip()
                    if not content:
                        # blank padding cell
                        stdscr.addstr(row, col, cell, row_attr)
                    elif content[0] == 'X':
                        stdscr.addstr(row, col, cell, curses.color_pair(2) | row_attr)  # red
                    elif content[0] == '?':
                        stdscr.addstr(row, col, cell, curses.color_pair(2) | curses.A_BOLD | row_attr)  # bright red — process error
                    elif content[0] == '>':
                        stdscr.addstr(row, col, cell, curses.color_pair(3) | row_attr)  # yellow — >100 ms
                    else:
                        val = int(content)
                        if hist_mode == 'scaled':
                            # scaled values are 0-9; threshold at 5 (≈55 ms)
                            color = curses.color_pair(1) if val < 5 else curses.color_pair(3)
                        else:
                            color = curses.color_pair(1) if val < 50 else curses.color_pair(3)
                        stdscr.addstr(row, col, cell, color | row_attr)
                    col += cell_width
            else:
                # success / scaled mode: one character per ping.
                for char in history:
                    if col >= safe_width:
                        break
                    if char == 'X':
                        stdscr.addstr(row, col, char, curses.color_pair(2) | row_attr)  # red
                    elif char == '?':
                        stdscr.addstr(row, col, char, curses.color_pair(2) | curses.A_BOLD | row_attr)  # bright red — process error
                    elif char == '.':
                        stdscr.addstr(row, col, char, curses.color_pair(1) | row_attr)  # green
                    elif char in '01234':
                        stdscr.addstr(row, col, char, curses.color_pair(1) | row_attr)  # green
                    elif char in '56789':
                        stdscr.addstr(row, col, char, curses.color_pair(3) | row_attr)  # yellow
                    elif char == '>':
                        stdscr.addstr(row, col, char, curses.color_pair(5) | row_attr)  # magenta — >100 ms
                    else:
                        stdscr.addstr(row, col, char, row_attr)  # blank padding
                    col += 1

            # Right-edge scroll indicator: overwrite the last rendered history column
            # with '→' when older pings exist beyond the visible window.  This covers
            # two cases:
            #   history_offset > 0        — user has scrolled back; newer pings are off
            #                               to the right of the drawn bar.
            #   max_ping_count > display_count — sweep phase (offset == 0): the bar is
            #                               not yet full-width, so older samples recorded
            #                               before the current sweep window are off-screen.
            if (self.history_offset > 0 or max_ping_count > display_count) and col > hist_col_effective:
                try:
                    stdscr.addstr(row, width - 1, '→', curses.A_BOLD | row_attr)
                except curses.error:
                    pass  # writing to bottom-right corner may fail; ignore

            # All-stats block flush-left after hostname
            if show_all and all_stats_col < width:
                # ms (Last latency)
                if monitor.error is not None:
                    stdscr.addstr(row, ms_col, "    ??", curses.color_pair(2) | curses.A_BOLD | row_attr)
                elif monitor.latency is not None:
                    ms_color = curses.color_pair(1) if monitor.latency < 50 else curses.color_pair(3)
                    stdscr.addstr(row, ms_col, f"{monitor.latency:6.1f}", ms_color | row_attr)
                else:
                    stdscr.addstr(row, ms_col, "     -", curses.color_pair(2) | row_attr)
                # Up/Down
                updown_str, is_down = Application._compute_updown(monitor)
                updown_color = curses.color_pair(2) if is_down else 0
                stdscr.addstr(row, updown_col, f"{updown_str:>{updown_col_w}}", updown_color | row_attr)
                # Avg Min Max Loss% StDev RX TX XX
                all_str = self._compute_all_stats(monitor)
                all_color = (curses.color_pair(2) | curses.A_BOLD) if monitor.error is not None else 0
                stdscr.addstr(row, tail_col, all_str, all_color | row_attr)

            # Custom stats block flush-left after hostname
            if show_custom and self.stats_custom and custom_start_col < width:
                if monitor.paused:
                    stdscr.addstr(row, custom_start_col, "⏸", curses.color_pair(6) | row_attr)
                else:
                    col = custom_start_col
                    for i, cname in enumerate(self.stats_custom):
                        if col >= safe_width:
                            break
                        w = custom_col_widths[i]
                        val = self._compute_stat(monitor, cname)
                        val_stripped = val.strip()
                        val_padded = f"{val_stripped:>{w}}"
                        if monitor.error is not None:
                            attr = curses.color_pair(2) | curses.A_BOLD | row_attr
                        elif cname == 'Down':
                            _, is_down = Application._compute_updown(monitor)
                            attr = (curses.color_pair(2) if is_down else 0) | row_attr
                        elif cname == 'Last':
                            if monitor.latency is not None:
                                attr = (curses.color_pair(1) if monitor.latency < 50
                                        else curses.color_pair(3)) | row_attr
                            else:
                                attr = curses.color_pair(2) | row_attr
                        else:
                            attr = row_attr
                        try:
                            stdscr.addstr(row, col, val_padded, attr)
                        except curses.error:
                            pass
                        col += w + (2 if i < len(self.stats_custom) - 1 else 0)

            entry_index += 1
            row += 1

        return row

    @staticmethod
    def _compute_stat(monitor, mode):
        """Compute a formatted stat string for a given STATS_MODES label.

        Returns '    ??' (6 chars) for all fields when monitor.error is set.
        """
        if monitor.error is not None:
            return "    ??"
        with monitor.lock:
            lat_count = monitor._lat_count
            lat_avg   = monitor._lat_mean if lat_count else None
            lat_min   = monitor._lat_min  if lat_count else None
            lat_max   = monitor._lat_max  if lat_count else None
            lat_stdev = (math.sqrt(monitor._lat_m2 / lat_count)
                         if lat_count >= 2 else None)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count
            last = monitor.latency

        if mode == 'Last':
            return f"{last:6.1f}" if last is not None else "     -"
        elif mode == 'Loss%':
            total = rx + xx
            if total == 0:
                return "     -"
            return f"{xx / total * 100:5.1f}%"
        elif mode == 'Avg':
            return f"{lat_avg:6.1f}" if lat_avg is not None else "     -"
        elif mode == 'Min':
            return f"{lat_min:6.1f}" if lat_min is not None else "     -"
        elif mode == 'Max':
            return f"{lat_max:6.1f}" if lat_max is not None else "     -"
        elif mode == 'StDev':
            return f"{lat_stdev:6.1f}" if lat_stdev is not None else "     -"
        elif mode == 'RX':
            return f"{rx:6d}"
        elif mode == 'TX':
            return f"{tx:6d}"
        elif mode == 'XX':
            return f"{xx:6d}"
        elif mode == 'Down':
            s, _ = Application._compute_updown(monitor)
            compact = s.replace(' ', '')
            return f"{compact:>6}"[:6]
        return "     -"

    @staticmethod
    def _compute_updown(monitor):
        """Return (display_str, is_down) for the Up/Down time column.

        display_str — compact human-readable duration (via _format_updown_time)
                      or '??' on process error, or '-' when timing is unknown.
        is_down     — True when the host is currently down (used to colour the cell).
        """
        if monitor.error is not None:
            return ('??', False)
        if monitor.alive is True and monitor.up_since is not None:
            elapsed = time.monotonic() - monitor.up_since
            return (_format_updown_time(elapsed), False)
        if monitor.alive is False and monitor.down_since is not None:
            elapsed = time.monotonic() - monitor.down_since
            return (_format_updown_time(elapsed), True)
        return ('-', False)

    def _updown_col_width(self):
        """Return the column width needed for the Up/Down cell across all monitors.

        At least len('Up/Down') (7) so the header always fits.
        Scans all monitors and widens the column if any current value is longer.
        """
        max_w = len('Up/Down')
        for monitor in self.monitors:
            s, _ = Application._compute_updown(monitor)
            if len(s) > max_w:
                max_w = len(s)
        return max_w

    @staticmethod
    def _compute_all_stats(monitor):
        """Compute a compact all-stats string for 'All' mode.

        Returns a row of '    ??' placeholders (8 fields, 62 chars total) when
        monitor.error is set.
        Format (aligned to match the tail header in draw_hosts):
          Avg    Min    Max    Loss%  StDev  RX     TX     XX
        """
        if monitor.error is not None:
            placeholder = "    ??"
            sep = "  "
            return sep.join([placeholder] * 8)
        with monitor.lock:
            lat_count = monitor._lat_count
            lat_avg   = monitor._lat_mean if lat_count else None
            lat_min   = monitor._lat_min  if lat_count else None
            lat_max   = monitor._lat_max  if lat_count else None
            lat_stdev = (math.sqrt(monitor._lat_m2 / lat_count)
                         if lat_count >= 2 else None)
            rx = monitor.rx_count
            xx = monitor.xx_count
            tx = monitor.ping_count

        avg_s   = f"{lat_avg:6.1f}"   if lat_avg   is not None else "     -"
        min_s   = f"{lat_min:6.1f}"   if lat_min   is not None else "     -"
        max_s   = f"{lat_max:6.1f}"   if lat_max   is not None else "     -"
        stdev_s = f"{lat_stdev:6.1f}" if lat_stdev is not None else "     -"

        total = rx + xx
        loss_s = f"{xx / total * 100:5.1f}%" if total else "    - "

        return (f"{avg_s}  {min_s}  {max_s}  {loss_s}  "
                f"{stdev_s}  {rx:6d}  {tx:6d}  {xx:6d}")

    def _get_name_col_width(self, dns_mode_str: str) -> int:
        """Return the cached hostname column width for *dns_mode_str*.

        Rebuilds the cache when _name_col_dirty is True or the dns mode
        changes (different dns_mode_str than last time).
        """
        if not self._name_col_dirty and dns_mode_str in self._name_col_cache:
            return self._name_col_cache[dns_mode_str]

        max_name_len = len("Hostname")
        _sec_stack: list = []
        for e in self.entries:
            if isinstance(e, SectionLabel):
                while _sec_stack and _sec_stack[-1].level >= e.level:
                    _sec_stack.pop()
                _sec_stack.append(e)
            elif isinstance(e, Monitor):
                indent = _sec_stack[-1].level * 2 if _sec_stack else 0
                max_name_len = max(max_name_len,
                                   indent + len(e.get_display_name(dns_mode_str)))
        max_section_len = max(
            # Account for prefix "──_[+]_" (7) + title + potential suffix " (NNN folded)" (~13)
            ((e.level - 1) * 2 + 7 + len(e.title) + 13
             for e in self.entries if isinstance(e, SectionLabel)),
            default=0
        )
        result = max(len("Hostname"), max_name_len, max_section_len)
        self._name_col_cache[dns_mode_str] = result
        if len(self._name_col_cache) >= len(DNS_MODES):
            # All modes computed — clear dirty flag so future calls use cache.
            self._name_col_dirty = False
        return result

    def _get_filtered_events(self) -> list:
        """Return (and cache) the event list filtered to the current loglevel.

        The list is rebuilt only when _filtered_events_dirty is True or when
        the incremental appends in add_event() have fallen out of sync (e.g.
        after a log-size change).  All other callers get the cached list at O(1).
        """
        if self._filtered_events_dirty:
            self._filtered_events = [e for e in self.events if e.level <= self.loglevel]
            self._filtered_events_dirty = False
        return self._filtered_events

    def draw_events(self, stdscr, start_row, height, width):
        """Draw event log at bottom with optional scroll support.

        log_offset=0  -> tail mode (newest events always visible)
        log_offset>0  -> scrolled back; header shows position and resume hint
        """
        page_size = max(1, height - start_row - 2)  # rows available for event lines
        # Use cached filtered list (rebuilt only when dirty)
        event_list = self._get_filtered_events()
        total = len(event_list)

        overflows = total > page_size  # True when the log cannot fit on screen

        if self.log_offset == 0:
            # Live tail mode
            visible = event_list[-page_size:]
            visible_start = max(0, total - page_size)
            header_title = 'Events'
            header_suffix = ' [SPACE seen]'
            if overflows:
                header_suffix += " [PgUp/PgDn scroll]"
        else:
            end = total - self.log_offset
            start = max(0, end - page_size)
            visible = event_list[start:end]
            visible_start = start
            line_start = start + 1
            line_end = end
            header_title = 'Events'
            header_suffix = f" lines {line_start}-{line_end}/{total} [PgUp/PgDn scroll] [Esc resume]"

        if self.log_file:
            header_suffix += f" → {self.log_file}"
        header_suffix += " [C|lear]"

        # Render title in white/bold; [key desc] tokens have key in white, desc default.
        self._draw_column_header(stdscr, start_row, 0, header_title, header_suffix, width)

        row = start_row + 1
        search_hit_set = (set(self._search_results)
                          if self._search_query and self._search_mode == 'log' else None)
        for abs_idx, entry in enumerate(visible, start=visible_start):
            if row >= height - 1:
                break
            attr = _event_color_attr(entry)
            if search_hit_set is not None and abs_idx in search_hit_set:
                attr |= curses.A_BOLD
            stdscr.addstr(row, 0, entry.text[:width - 1], attr)
            row += 1

    def _open_prompt_save(self):
        """Open the save-log prompt (non-blocking; state stored in self.prompt)."""
        self.prompt = {
            'type': 'save',
            'chars': list(self.log_file) if self.log_file else [],
        }

    def _open_prompt_clear(self, args=''):
        """Open the clear-log confirmation prompt (non-blocking)."""
        self.prompt = {'type': 'clear', 'chars': []}

    def _draw_prompt(self, stdscr, height, width):
        """Draw the active prompt on the bottom line and position the text cursor.

        Called every frame (after all other drawing) when self.prompt is not None.
        The caller is responsible for calling curses.curs_set(1) before refresh.
        """
        p = self.prompt
        if p['type'] == 'save':
            label = "Write log to: "
            text  = ''.join(p['chars'])
            line  = (label + text).ljust(width - 1)[:width - 1]
            stdscr.addstr(height - 1, 0, line, curses.A_REVERSE)
            cursor_x = min(len(label) + len(text), width - 2)
            stdscr.move(height - 1, cursor_x)
        elif p['type'] == 'save_confirm':
            line = "File exists: [t]runcate  [a]ppend  Esc=cancel"
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'clear':
            line = "Clear event log? [y/N]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'mux_relaunch':
            line = "Not in a multiplexer — relaunch inside tmux? [Y/n]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'mux_new_pane':
            line = f"Open {_PROG_NAME} in new pane? [Y/n]: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'script_changed':
            line = "Script changed — [1] re-exec  [2] reload  [3] ignore: "
            stdscr.addstr(height - 1, 0, line.ljust(width - 1)[:width - 1], curses.A_REVERSE)
            stdscr.move(height - 1, min(len(line), width - 2))
        elif p['type'] == 'search':
            mode_label = 'hosts' if p['mode'] == 'hosts' else 'log'
            label = f"/{mode_label}/ "
            text  = ''.join(p['chars'])
            n_hits = len(self._search_results) if text else 0
            suffix = f"  [{n_hits} match{'es' if n_hits != 1 else ''}]" if text else \
                     "  [Enter=confirm  Tab=filter  Esc=cancel]"
            full_line = (label + text + suffix).ljust(width - 1)[:width - 1]
            stdscr.addstr(height - 1, 0, full_line, curses.A_REVERSE)
            cursor_x = min(len(label) + len(text), width - 2)
            stdscr.move(height - 1, cursor_x)
        elif p['type'] == 'filter':
            label = "/filter/ "
            text  = ''.join(p['chars'])
            if text:
                # Live preview: temporarily apply to get count
                n_vis = len(self._filter_visible_monitors)
                n_tot = len(self.monitors)
                suffix = f"  [{n_vis}/{n_tot} visible]"
            else:
                suffix = "  [Enter=confirm  Tab=search  Esc=cancel]"
            full_line = (label + text + suffix).ljust(width - 1)[:width - 1]
            stdscr.addstr(height - 1, 0, full_line, curses.A_REVERSE)
            cursor_x = min(len(label) + len(text), width - 2)
            stdscr.move(height - 1, cursor_x)

    def _handle_prompt_key(self, key):
        """Process one keypress while a prompt is active.

        Updates self.prompt in place; sets self.prompt = None when the prompt
        is dismissed (confirmed or cancelled).
        Ctrl+C (key == 3) always cancels any prompt immediately.
        """
        # Ctrl+C — cancel any prompt unconditionally
        if key == 3:
            self.prompt = None
            return

        p = self.prompt

        if p['type'] == 'save':
            if key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                filename = ''.join(p['chars']).strip()
                if filename:
                    if os.path.exists(filename):
                        # Advance to the truncate/append confirmation step
                        self.prompt = {'type': 'save_confirm', 'filename': filename, 'chars': []}
                    else:
                        self.save_to_file(filename)
                        self.log_file = filename
                        self.prompt = None
                else:
                    self.prompt = None  # empty filename — cancel
            elif key == 27:  # Escape — cancel
                self.prompt = None
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                if p['chars']:
                    p['chars'].pop()
            elif 32 <= key < 127:
                p['chars'].append(chr(key))

        elif p['type'] == 'save_confirm':
            filename = p['filename']
            if key in (ord('t'), ord('T')):
                self.save_to_file(filename, append=False)
                self.log_file = filename
            elif key in (ord('a'), ord('A')):
                if self.log_file != filename:
                    self.save_to_file(filename, append=True, write_separator=True)
                self.log_file = filename
            # Any other key (Esc, Enter, …) — cancel without saving
            self.prompt = None

        elif p['type'] == 'clear':
            if key in (ord('y'), ord('Y')):
                self.events.clear()
                self._filtered_events.clear()
                self.log_offset = 0  # reset scroll position after clearing
            self.prompt = None  # any key closes the clear prompt

        elif p['type'] == 'mux_relaunch':
            if key not in (ord('n'), ord('N'), 27):
                # Y / Enter / any affirmative key → relaunch in tmux
                backend = _MUX_BACKENDS.get('tmux') or next(
                    (b for b in _MUX_BACKENDS.values() if b.available()), None)
                if backend:
                    extra = []
                    if p.get('pending_host'):
                        extra += ['--select', p['pending_host']]
                    if p.get('pending_cmd'):
                        extra += [':' + p['pending_cmd']]
                    cmd = backend.relaunch_cmd(sys.argv + extra, hosts_file=self.hosts_file)
                    self.prompt = None
                    curses.endwin()
                    self.add_event("exec", shlex.join(cmd), level=LEVEL_TRACE)
                    os.execvp(cmd[0], cmd)
                else:
                    self.add_event("cmd", "relaunch: tmux/screen not found")
            self.prompt = None

        elif p['type'] == 'mux_new_pane':
            self.prompt = None
            if key not in (ord('n'), ord('N'), 27):
                self._mux_open_pane(p['tokens'], p['direction'], p['backend'],
                                    no_focus=p.get('no_focus', False))

        elif p['type'] == 'script_changed':
            file = p.get('file', '')
            if key == ord('1'):
                self.prompt = None
                curses.endwin()
                self.add_event("exec", shlex.join(sys.argv), level=LEVEL_TRACE)
                os.execvp(sys.argv[0], sys.argv)
            elif key == ord('2'):
                self._edit_reload_inplace(file)
                self.prompt = None
            else:  # 3, Esc, or any other key
                self.prompt = None

        elif p['type'] == 'search':
            if key == 27:  # Esc — cancel: restore highlighted_index and fold state
                # Re-fold any sections that were auto-unfolded during this search
                for section in self._search_auto_unfolded:
                    section.folded = self._search_pre_fold.get(section, section.folded)
                self._search_auto_unfolded.clear()
                # Restore position
                self.highlighted_index = self._search_pre_highlighted
                self._search_query = ''
                self._search_results = []
                self._search_idx = 0
                self.prompt = None
            elif key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                self._search_query = ''.join(p['chars'])
                self._search_mode  = p['mode']
                self._update_search_results()
                self._search_idx = 0
                if self._search_results:
                    self._apply_search_result(0)
                elif self._search_query:
                    self.add_event("cmd", f"search: no matches for '{self._search_query}'")
                # Re-fold auto-unfolded sections except those containing the match
                if self._search_mode == 'hosts' and self._search_auto_unfolded:
                    confirmed_sections = set(
                        self._get_ancestor_sections(self.highlighted_index)
                    ) if self.highlighted_index is not None else set()
                    for section in self._search_auto_unfolded:
                        if (self._search_pre_fold.get(section, False)
                                and section not in confirmed_sections):
                            section.folded = True
                    self._search_auto_unfolded.clear()
                self.prompt = None
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                if p['chars']:
                    p['chars'].pop()
                self._search_query = ''.join(p['chars'])
                self._search_mode  = p['mode']
                self._update_search_results()
                self._search_live_update()
            elif key == ord('\t'):  # Tab — switch to filter prompt
                # Cancel search cleanly: restore fold state and position
                for section in self._search_auto_unfolded:
                    section.folded = self._search_pre_fold.get(section, section.folded)
                self._search_auto_unfolded.clear()
                self.highlighted_index = self._search_pre_highlighted
                self._search_query = ''
                self._search_results = []
                self._search_idx = 0
                self.prompt = None
                self._cmd_filter_open()
            elif 32 <= key < 127:
                p['chars'].append(chr(key))
                self._search_query = ''.join(p['chars'])
                self._search_mode  = p['mode']
                self._update_search_results()
                self._search_live_update()

        elif p['type'] == 'filter':
            if key == 27:  # Esc — cancel: restore previous filter
                self._filter_query = p['prev_query']
                self._update_filter_visible()
                self.prompt = None
            elif key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
                self._filter_query = ''.join(p['chars'])
                self._update_filter_visible()
                self.prompt = None
            elif key == ord('\t'):  # Tab — switch to search prompt
                # Discard in-progress filter edits; keep whatever was active before
                self._filter_query = p['prev_query']
                self._update_filter_visible()
                self.prompt = None
                self._cmd_search_open()
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                if p['chars']:
                    p['chars'].pop()
                # Live preview
                self._filter_query = ''.join(p['chars'])
                self._update_filter_visible()
            elif 32 <= key < 127:
                p['chars'].append(chr(key))
                # Live preview
                self._filter_query = ''.join(p['chars'])
                self._update_filter_visible()

    def save_to_file(self, filename, append=False, write_separator=True):
        """Write the current event log to a file.

        Each line is already fully formatted by add_event() with an ISO 8601
        timestamp, so the file is a plain sequence of event lines preceded by
        a one-line header.

        append=False         — overwrite the file with a header + all events.
        append=True          — append events to the existing file.
        write_separator=True — when appending, prepend a separator line with a
                               timestamp; set to False when the file is already
                               the active streaming log (no gap to mark).
        """
        timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
        try:
            if append:
                with open(filename, 'a') as f:
                    if write_separator:
                        f.write(f"\n# ========== appended {timestamp} ==========\n")
                    for event in self.events:
                        f.write(event.text + "\n")
            else:
                with open(filename, 'w') as f:
                    f.write(f"# {_PROG_NAME} event log — saved {timestamp}\n")
                    for event in self.events:
                        f.write(event.text + "\n")
        except OSError as e:
            self.add_event("save", f"error: {e}")

    def _draw_cmd(self, stdscr, height, width):
        """Draw the active command line on the bottom row with a text cursor.

        Renders ':' followed by the typed text, reversed-video style, and
        positions the terminal cursor at the insertion point.

        When completions are available (after the first Tab press) a popup
        menu is drawn immediately above the command line.  The currently
        highlighted candidate (comp_idx) is shown in bold+reverse; all others
        are shown in plain reverse.  The popup scrolls so the highlighted entry
        is always in view.
        """
        c = self.cmd
        completions = c.get('completions', [])
        comp_idx = c.get('comp_idx', -1)

        if completions:
            # How many rows the popup can occupy (leave room for the cmd line itself)
            max_popup_rows = min(len(completions), height - 2)
            # Scroll the popup view so the highlighted entry is always visible.
            if comp_idx < 0:
                view_start = 0
            else:
                view_start = max(0, min(comp_idx, len(completions) - max_popup_rows))
            visible = completions[view_start:view_start + max_popup_rows]

            # Build descriptions for visible items (command names only).
            descs = [(_CMD_MAP[cand].help or '') if cand in _CMD_MAP else ''
                     for cand in visible]
            max_cand_w = max((len(cand) for cand in visible), default=0)
            desc_col = max_cand_w + 2          # two-space separator
            desc_width = width - 1 - desc_col  # remaining room for description

            for i, candidate in enumerate(visible):
                row = height - 1 - max_popup_rows + i
                if row < 0:
                    continue
                actual_idx = view_start + i
                attr = (curses.A_REVERSE | curses.A_BOLD) if actual_idx == comp_idx else curses.A_REVERSE
                desc = descs[i]
                if desc_width > 4 and desc:
                    cell = f"{candidate:<{max_cand_w}}  {desc}"
                else:
                    cell = candidate
                try:
                    stdscr.addstr(row, 0, cell.ljust(width - 1)[:width - 1], attr)
                except curses.error:
                    pass

        text = ''.join(c['chars'])
        line = (':' + text).ljust(width - 1)[:width - 1]
        stdscr.addstr(height - 1, 0, line, curses.A_REVERSE)
        cursor_x = min(1 + c['cursor'], width - 2)
        stdscr.move(height - 1, cursor_x)

    def _handle_cmd_key(self, key):
        """Process one keypress while command mode is active (readline-style editing).

        Supported bindings:
          Tab            — complete to LCP; open popup; then cycle forward through candidates
          Shift+Tab      — cycle backward through completion candidates
          Enter          — dispatch the command (if non-empty) and save to history
          Esc / Ctrl+C   — cancel and close command line
          Backspace/^H   — delete character before cursor
          Delete         — delete character at cursor
          Left / Right   — move cursor one character
          Home / Ctrl+A  — move cursor to start
          End  / Ctrl+E  — move cursor to end
          Ctrl+K         — kill from cursor to end of line
          Ctrl+U         — kill from start of line to cursor
          Ctrl+W         — kill word backward (stop at whitespace boundary)
          Up / Down      — navigate completion popup (when open); else command history
          printable char — insert at cursor position
        """
        c = self.cmd
        chars = c['chars']
        cursor = c['cursor']

        # ── Tab — completion (early return; never resets completion state) ─────
        if key == ord('\t'):
            text = ''.join(chars)

            if not c['completions']:
                # First Tab press: compute candidates from current text.
                c['comp_prefix'] = text
                c['completions'] = self._get_completions(text)
                c['comp_idx'] = -1

                if len(c['completions']) == 1:
                    # Exactly one match — apply it directly and append a trailing
                    # space so the user can immediately type the next argument.
                    # Exception: directory paths (ending with '/') get no space
                    # so the user can keep typing deeper into the path.
                    c['comp_idx'] = 0
                    c['chars'] = list(c['comp_prefix'])
                    c['cursor'] = len(c['comp_prefix'])
                    self._apply_completion(c, c['completions'][0])
                    if not c['completions'][0].endswith('/'):
                        c['chars'].append(' ')
                        c['cursor'] += 1
                    c['completions'] = []  # no popup needed for a unique match
                    return

                if len(c['completions']) > 1:
                    # Multiple candidates — vim wildmode=longest: complete to the
                    # longest common prefix (LCP) first.  If the LCP extends the
                    # current partial token, apply it and leave the popup open so
                    # the user can see the full candidate list.  If the LCP is no
                    # longer than what is already typed, the popup stays as-is.
                    lcp = c['completions'][0]
                    for s in c['completions'][1:]:
                        while not s.startswith(lcp):
                            lcp = lcp[:-1]
                            if not lcp:
                                break

                    # The "current token" is whatever _apply_completion would
                    # replace: everything after the last space (or the whole text).
                    last_space = text.rfind(' ')
                    current_token = text[last_space + 1:] if last_space != -1 else text

                    if len(lcp) > len(current_token):
                        # LCP is longer — fill it in and wait for the next Tab.
                        c['chars'] = list(c['comp_prefix'])
                        c['cursor'] = len(c['comp_prefix'])
                        self._apply_completion(c, lcp)
                        return  # popup stays visible; next Tab will cycle

                if not c['completions']:
                    return  # no matches at all

                # LCP gave no extension — popup is already showing; nothing more to do.
                return  # wildmode=list: no cycling

            # Popup already open — cycle forward through candidates.
            n = len(c['completions'])
            c['comp_idx'] = (c['comp_idx'] + 1) % n
            c['chars'] = list(c['comp_prefix'])
            c['cursor'] = len(c['comp_prefix'])
            self._apply_completion(c, c['completions'][c['comp_idx']])
            return

        # ── Shift+Tab — cycle backward through completion candidates ──────────
        if key == curses.KEY_BTAB:
            if not c['completions']:
                # No popup yet — compute completions from current text.
                text = ''.join(chars)
                c['comp_prefix'] = text
                c['completions'] = self._get_completions(text)
                c['comp_idx'] = -1
                if not c['completions']:
                    return
                if len(c['completions']) == 1:
                    # Unique match — apply immediately (same as Tab unique-match).
                    c['comp_idx'] = 0
                    c['chars'] = list(c['comp_prefix'])
                    c['cursor'] = len(c['comp_prefix'])
                    self._apply_completion(c, c['completions'][0])
                    if not c['completions'][0].endswith('/'):
                        c['chars'].append(' ')
                        c['cursor'] += 1
                    c['completions'] = []
                    return
            # Cycle backward: wrap from 0 (or -1) to the last candidate.
            n = len(c['completions'])
            idx = c['comp_idx']
            c['comp_idx'] = (n - 1) if idx <= 0 else (idx - 1)
            c['chars'] = list(c['comp_prefix'])
            c['cursor'] = len(c['comp_prefix'])
            self._apply_completion(c, c['completions'][c['comp_idx']])
            return

        # ── Up/Down when completion popup is open → navigate popup ───────────
        if c['completions'] and key in (curses.KEY_UP, curses.KEY_DOWN):
            n = len(c['completions'])
            idx = c.get('comp_idx', -1)
            if key == curses.KEY_DOWN:
                c['comp_idx'] = (idx + 1) % n
            else:
                c['comp_idx'] = (n - 1) if idx <= 0 else (idx - 1)
            c['chars'] = list(c['comp_prefix'])
            c['cursor'] = len(c['comp_prefix'])
            self._apply_completion(c, c['completions'][c['comp_idx']])
            return

        # ── All non-Tab keys clear the completion popup ────────────────────────
        c['completions'] = []
        c['comp_idx'] = -1

        if key in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            text = ''.join(chars).strip()
            self.cmd = None
            if text:
                # Deduplicate: remove an earlier identical entry so the most
                # recent invocation always sits at the end of the history list.
                if text in self.cmd_history:
                    self.cmd_history.remove(text)
                self.cmd_history.append(text)
                self._save_cmd_history()
                self._dispatch_cmd(text)

        elif key in (27, 3):  # Escape / Ctrl+C — cancel
            self.cmd = None

        elif key == curses.KEY_UP:
            hist = self.cmd_history
            if hist:
                if c['hist_idx'] == -1:
                    # First Up press: save the current (unsaved) line so it can
                    # be restored when the user presses Down past the end.
                    c['saved_line'] = ''.join(chars)
                    c['hist_idx'] = len(hist) - 1
                elif c['hist_idx'] > 0:
                    c['hist_idx'] -= 1
                entry = hist[c['hist_idx']]
                c['chars'] = list(entry)
                c['cursor'] = len(entry)

        elif key == curses.KEY_DOWN:
            if c['hist_idx'] != -1:
                hist = self.cmd_history
                if c['hist_idx'] < len(hist) - 1:
                    c['hist_idx'] += 1
                    entry = hist[c['hist_idx']]
                    c['chars'] = list(entry)
                    c['cursor'] = len(entry)
                else:
                    # Past the newest history entry — restore the saved line
                    c['hist_idx'] = -1
                    entry = c['saved_line']
                    c['chars'] = list(entry)
                    c['cursor'] = len(entry)

        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if cursor > 0:
                del chars[cursor - 1]
                c['cursor'] -= 1
            c['hist_idx'] = -1  # text edit breaks history navigation

        elif key == curses.KEY_DC:  # Delete key
            if cursor < len(chars):
                del chars[cursor]
            c['hist_idx'] = -1

        elif key == curses.KEY_LEFT:
            if cursor > 0:
                c['cursor'] -= 1
            # Cursor movement does NOT reset hist_idx

        elif key == curses.KEY_RIGHT:
            if cursor < len(chars):
                c['cursor'] += 1

        elif key in (curses.KEY_HOME, 1):  # Home / Ctrl+A
            c['cursor'] = 0

        elif key in (curses.KEY_END, 5):  # End / Ctrl+E
            c['cursor'] = len(chars)

        elif key == 11:  # Ctrl+K — kill to end of line
            del chars[cursor:]
            c['hist_idx'] = -1

        elif key == 21:  # Ctrl+U — kill to start of line
            del chars[:cursor]
            c['cursor'] = 0
            c['hist_idx'] = -1

        elif key == 23:  # Ctrl+W — kill word backward
            end = cursor
            while cursor > 0 and chars[cursor - 1] == ' ':
                cursor -= 1
            while cursor > 0 and chars[cursor - 1] != ' ':
                cursor -= 1
            del chars[cursor:end]
            c['cursor'] = cursor
            c['hist_idx'] = -1

        elif 32 <= key < 127:
            chars.insert(cursor, chr(key))
            c['cursor'] += 1
            c['hist_idx'] = -1

    def _resolve_ssh_host(self, host):
        """Apply :resolv mapping to an SSH host, preserving user@ prefix if present.

        Examples:
          'ps-supervisor'      → '10.10.6.117' (if mapped)
          'user@ps-supervisor' → 'user@10.10.6.117' (if mapped)
          'unmapped-host'      → 'unmapped-host' (unchanged)

        Returns the resolved host string.
        """
        if '@' in host:
            user, hostname = host.rsplit('@', 1)
            if hostname in self.hosts_map:
                resolved_ip = self.hosts_map[hostname][0]
                return f"{user}@{resolved_ip}"
            return host
        else:
            if host in self.hosts_map:
                return self.hosts_map[host][0]
            return host

    def _apply_hosts_entry(self, ip, hostname):
        """Apply a static DNS override pair to any matching monitors.

        Stores the mapping in self.hosts_map (keyed by both ip and hostname so
        either can be used as monitor.host) and sets resolved_ip /
        resolved_hostname directly on any PingMonitor whose host matches either
        the ip or the hostname.  Also sets resolv_static = True so that the
        ping subprocess targets the IP address directly instead of the hostname.

        This is called at startup (via _dispatch_cmd from hosts-file :resolv
        lines) and interactively.  Silent on success; reports a warning to the
        event log only when no monitor matches.
        """
        self.hosts_map[ip] = (ip, hostname)
        self.hosts_map[hostname] = (ip, hostname)

        matched = 0
        for monitor in self.monitors:
            if monitor.host == ip or monitor.host == hostname:
                monitor.resolved_ip = ip
                monitor.resolved_hostname = hostname
                monitor.resolv_static = True
                matched += 1

        if matched == 0 and self._monitoring_started:
            # Only warn when running interactively — during __init__ the host entry
            # may simply appear later in the file and will pick up the mapping then.
            self.add_event("resolv",
                f"no monitor matched '{ip}' / '{hostname}' — mapping stored for future use")

    def _open_cmd_line(self, prefill=''):
        """Open the ':' command line, clearing any pending key sequence.

        If *prefill* is given (e.g. ``'set dns hostname'``), the command buffer
        is pre-populated with that text and the cursor placed at the end.
        """
        self._key_seq = []
        chars = list(prefill)
        self.cmd = {
            'chars': chars, 'cursor': len(chars),
            'hist_idx': -1, 'saved_line': '',
            'completions': [], 'comp_idx': -1, 'comp_prefix': '',
        }

    def _dispatch_cmd(self, text):
        """Dispatch a command string entered via the ':' command line.

        Parses the first word as the command name (stripping any leading ':')
        and passes the remainder as arguments.  Supported commands:

          q / quit               — quit the application
          dns  [off|hostname|ip] — cycle (no arg) or set DNS display mode
          stats [mode]           — cycle (no arg) or set stats column mode
          sort  [mode]           — cycle (no arg) or set sort order
          history/hist [mode]    — cycle (no arg) or set history display mode
          pause                  — toggle pause
          seen                   — insert 'seen' marker in event log
          clear                  — clear event log
          log [file]             — show active log file; or save/stream log to file
          help                   — open the help overlay

        Unknown commands are reported to the event log.
        """
        parts = text.split(None, 1)
        cmd  = parts[0].lstrip(':').lower()
        args = parts[1].strip() if len(parts) > 1 else ''

        if getattr(self, 'kiosk_mode', False):
            self._kiosk_audit('cmd', f'{cmd} {args}'.strip())

        cmd_def = _CMD_MAP.get(cmd)
        if cmd_def:
            self._last_cmd_name = cmd  # let handlers know which alias was used
            getattr(self, cmd_def.action)(args)
        else:
            self.add_event("cmd",
                f"unknown command: {cmd}" + (f" {args}" if args else "")
                + "  (try :help)")

    def _cmd_quit(self, args=''):
        """Quit the application.

        :quit            — quit immediately
        :quit --confirm  — re-press pattern: first press shows a message;
                           a second press within 2 seconds quits.
        """
        if args.strip() == '--confirm':
            now = time.time()
            if now < self._quit_confirm_deadline:
                self.running = False
            else:
                self._quit_confirm_deadline = now + 2.0
                self._status_msg = {
                    'text': "Press Ctrl-C again to quit",
                    'expires': self._quit_confirm_deadline,
                }
        else:
            self.running = False

    def _cmd_ping(self, args=''):
        """Ping a host directly.
        Usage: :ping <host>[:port]
        """
        if not args:
            self.add_event("cmd", "ping: missing host argument")
            return

        target = args.split()[0]
        host, port = parse_target(target)

        if target in [m.host for m in self.monitors]:
            self.add_event("cmd", f"ping: host '{target}' already monitored")
            return

        if port:
            monitor = PortMonitor(host, port, port_map=self.port_map)
        else:
            monitor = PingMonitor(host)

        self.monitors.append(monitor)
        self._add_entry(monitor)

        if self._monitoring_started:
            thread = threading.Thread(target=monitor.ping, daemon=True)
            thread.start()
            self.threads.append(thread)

        self.add_event("cmd", f"ping: added '{target}' to monitor list")


    def _cmd_source(self, args=""):
        """Source a file containing hosts and commands.
        Usage: :source <file>
        """
        if not args:
            self.add_event("cmd", "source: missing file argument")
            return

        filename = args.strip()

        if self.kiosk_mode and not getattr(self, '_loading_file', False):
            if not self._kiosk_allow_path(filename, 'source'):
                return

        if not os.path.exists(filename):
            self.add_event("cmd", f"source: file '{filename}' not found")
            return

        try:
            new_entries = parse_hosts_file(filename, variables=self.variables)
            for kind, *rest in new_entries:
                value = rest[0] if rest else ''
                if kind == 'host':
                    host_str, port_str = parse_target(value)

                    target = f"{host_str}:{port_str}" if port_str else host_str

                    if target not in [m.host for m in self.monitors]:
                        if port_str:
                            m = PortMonitor(host_str, port_str, port_map=self.port_map)
                        else:
                            m = PingMonitor(host_str)
                        # Apply any :resolv static DNS override
                        if host_str in self.hosts_map:
                            ip, hostname = self.hosts_map[host_str]
                            m.resolved_ip = ip
                            m.resolved_hostname = hostname
                            m.resolv_static = True
                        self.monitors.append(m)
                        self._add_entry(m)
                        if self._monitoring_started:
                            thread = threading.Thread(target=m.ping, daemon=True)
                            thread.start()
                            self.threads.append(thread)
                elif kind == 'section':
                    level = rest[1] if len(rest) > 1 else 1
                    folded_default = rest[2] if len(rest) > 2 else False
                    no_autofold = rest[3] if len(rest) > 3 else False
                    self._add_entry(SectionLabel(value, level, folded_default, no_autofold))
                elif kind == 'cmd':
                    self._dispatch_cmd(value)
                elif kind == 'warn':
                    self.add_event("hosts", f"warning: {value}")
                elif kind == 'error':
                    self.add_event("hosts", f"expansion error: {value}")
            self.add_event("cmd", f"source: loaded '{filename}'")
        except Exception as e:
            self.add_event("cmd", f"source error: {e}")

    def _cmd_let(self, args=''):
        """Define or redefine a :let variable.

        Usage: :let <name> [value]

        Sets self.variables[name] = value (empty string when value omitted).
        The name may contain brace expansion; $N in the value is eagerly
        substituted per brace index.  Takes effect immediately for subsequent
        :source or :for loops loaded in the same session.
        """
        if not args:
            self.add_event("cmd", "let: usage: :let <name> [value]")
            return
        parts = args.split(None, 1)
        name_tmpl = parts[0]
        val_tmpl  = parts[1] if len(parts) > 1 else ''
        try:
            name_rows = _expand_host_with_captures(name_tmpl)
        except ValueError as e:
            self.add_event("cmd", f"let: name expansion error: {e}")
            return
        for exp_name, name_caps in name_rows:
            exp_val = _apply_backref(val_tmpl, name_caps, val_tmpl)
            self.variables[exp_name] = exp_val
        if self._monitoring_started:
            preview = ', '.join(
                f'{n}={v!r}' for n, *rest in name_rows[:3]
                for v in [_apply_backref(val_tmpl, rest[0] if rest else [], val_tmpl)]
            )
            self.add_event("cmd", f"let: set {preview}"
                           + (' …' if len(name_rows) > 3 else ''))


    # ── :mux / :tmux / :screen / :term ──────────────────────────────────────

    def _cmd_mux_split(self, args=''):
        """Set or cycle the default mux split direction (:set mux-split v|h|window)."""
        valid = ['v', 'h', 'window']
        if not args:
            idx = valid.index(self.mux_split) if self.mux_split in valid else 0
            self.mux_split = valid[(idx + 1) % len(valid)]
        elif args in valid:
            self.mux_split = args
        else:
            self.add_event("cmd", f"mux-split: invalid value '{args}'; choices: v h window")
            return
        if self._monitoring_started:
            self.add_event("cmd", f"mux-split: {self.mux_split}")

    def _cmd_set_terminal(self, args=''):
        """Set the X/Wayland terminal emulator used by :term (:set terminal <name>|auto)."""
        value = args.strip() or 'auto'
        self.terminal_emulator = value
        _MUX_BACKENDS['terminal'].terminal = value
        if self._monitoring_started:
            self.add_event("cmd", f"terminal: {value}")

    def _mux_relaunch_prompt(self, tokens: list, no_focus: bool = False,
                             direction: str = None) -> dict:
        """Build a mux_relaunch prompt dict, capturing context for post-relaunch restore.

        tokens    — the :mux command tokens (e.g. ['ssh', '10.0.0.1', '-l', 'root'])
        no_focus  — True if --no-focus was given; re-injected into pending_cmd
        direction — explicit split direction if given; re-injected when it differs
                    from the stored mux_split setting so the relaunch uses the same
                    direction the user requested.
        """
        prefix_flags = []
        if direction is not None and direction != self.mux_split:
            prefix_flags.append({'v': '--split-v', 'h': '--split-h',
                                  'window': '--split-window'}.get(direction, ''))
        if no_focus:
            prefix_flags.append('--no-focus')
        prefix_flags = [f for f in prefix_flags if f]  # drop any empty strings

        if tokens or prefix_flags:
            pending_cmd = 'mux ' + shlex.join(prefix_flags + tokens)
        else:
            pending_cmd = None
        pending_host = None
        if (self.highlighted_index is not None
                and 0 <= self.highlighted_index < len(self.entries)):
            entry = self.entries[self.highlighted_index]
            if isinstance(entry, Monitor):
                pending_host = entry.host
        return {
            'type': 'mux_relaunch',
            'chars': [],
            'pending_host': pending_host,
            'pending_cmd': pending_cmd,
        }

    def _cmd_mux(self, args=''):
        """Run a command in a tmux/screen pane, window, or X terminal.

        :mux [-v|-h|-w] <command...>
        :tmux / :screen are aliases; the alias name hints at a preferred backend.
        :term / :terminal / :xterm force the X terminal emulator backend.
        """
        # Determine which alias was used (stored briefly on self._last_cmd_name).
        _alias = getattr(self, '_last_cmd_name', None)
        _alias_map = {'tmux': 'tmux', 'screen': 'screen',
                      'term': 'terminal', 'terminal': 'terminal', 'xterm': 'terminal'}
        preference = _alias_map.get(_alias)

        tokens = args.split() if args else []

        # Parse optional split-direction override
        direction = self.mux_split
        if tokens and tokens[0] in ('-v', '-h', '-w', '--split-v', '--split-h', '--split-window'):
            flag = tokens.pop(0)
            direction = {
                '-v': 'v',      '--split-v': 'v',
                '-h': 'h',      '--split-h': 'h',
                '-w': 'window', '--split-window': 'window',
            }.get(flag, 'v')

        # Parse --no-focus: open pane/window without switching focus to it.
        no_focus = False
        if tokens and tokens[0] == '--no-focus':
            no_focus = True
            tokens.pop(0)

        # Parse --only: kill all panes/regions except the current one.
        if tokens and tokens[0] == '--only':
            tokens.pop(0)
            backend = _resolve_mux_backend(preference)
            if backend is None or isinstance(backend, XTermBackend):
                self.add_event("cmd",
                    "mux: --only requires an active multiplexer (tmux or screen)")
                return
            if not backend.is_inside():
                self.add_event("cmd",
                    "mux: --only requires an active multiplexer session")
                return
            try:
                backend.kill_others()
            except RuntimeError as e:
                self.add_event("cmd", f"mux: {e}")
            return

        if not tokens:
            # No command given: relaunch self.
            # If already inside a multiplexer, ask before opening a duplicate pane.
            # If not inside one, offer to relaunch the whole process inside tmux/screen.
            backend = _resolve_mux_backend(preference)
            is_in_mux = (backend is not None
                         and not isinstance(backend, XTermBackend)
                         and backend.is_inside())
            if not is_in_mux:
                self.prompt = self._mux_relaunch_prompt([])
                return
            if self.kiosk_mode:
                self.add_event("cmd", "mux: self-relaunch not allowed in kiosk mode")
                return
            tokens = list(sys.argv)
            if (self.highlighted_index is not None
                    and 0 <= self.highlighted_index < len(self.entries)):
                entry = self.entries[self.highlighted_index]
                if isinstance(entry, Monitor):
                    tokens += ['--select', entry.host]
            self.prompt = {
                'type': 'mux_new_pane',
                'tokens': tokens,
                'direction': direction,
                'no_focus': no_focus,
                'backend': backend,
            }
            return
        elif self._mux_from_binding:
            # Auto-inject :prog-options when the command came from a key binding.
            prog = tokens[0]
            entry = (self.entries[self.highlighted_index]
                     if self.highlighted_index is not None
                     and 0 <= self.highlighted_index < len(self.entries)
                     else None)
            host = entry.host if isinstance(entry, Monitor) else None
            resolved_hostname = entry.resolved_hostname if isinstance(entry, Monitor) else ''
            disabled, opts = self._match_prog_options(prog, host or '', resolved_hostname or '')
            if disabled:
                return
            if opts:
                tokens = [prog] + shlex.split(opts) + list(tokens[1:])

        # Kiosk whitelist: only ssh and login are permitted; X terminal not allowed
        if self.kiosk_mode:
            cmd_name = tokens[0].lower()
            if cmd_name not in ('ssh', 'login'):
                self.add_event("cmd",
                    f"mux: '{cmd_name}' not allowed in kiosk mode (only ssh/login)")
                return
            # Inject key-isolation flags immediately after 'ssh' so the user
            # cannot see or modify them in the pre-filled command line.
            if cmd_name == 'ssh':
                tokens = ['ssh'] + _kiosk_ssh_flags() + tokens[1:]
            # Kiosk only supports tmux
            backend = _MUX_BACKENDS.get('tmux')
            if backend is None or not backend.available():
                self.add_event("cmd", "mux: kiosk mode requires tmux (not found)")
                return
        else:
            # When the user explicitly names a multiplexer (e.g. :tmux or :screen),
            # verify we are actually inside that session before trying — otherwise
            # the backend binary exists but the session socket does not and the
            # subprocess prints its error directly to the terminal.
            if preference in ('tmux', 'screen'):
                named = _MUX_BACKENDS[preference]
                if not named.is_inside():
                    if not named.available():
                        self.add_event("cmd",
                            f"mux: {preference} is not installed")
                    else:
                        self.prompt = self._mux_relaunch_prompt(
                            tokens, no_focus=no_focus, direction=direction)
                    return
            backend = _resolve_mux_backend(preference)
            if backend is None:
                self.add_event("cmd",
                    "mux: no terminal multiplexer or X terminal available "
                    "(install tmux, screen, or an X terminal emulator)")
                return
            # For real mux backends (tmux/screen): if we're not currently inside
            # a session, the backend binary exists but has no session socket —
            # offer to relaunch inside one instead of hitting a cryptic error.
            if backend is not _MUX_BACKENDS.get('terminal') and not backend.is_inside():
                self.prompt = self._mux_relaunch_prompt(
                    tokens, no_focus=no_focus, direction=direction)
                return

        self.add_event("cmd",
            f"mux: {shlex.join(tokens)}", level=LEVEL_DEBUG)
        try:
            # Wrap the command so the pane stays open after the process exits,
            # letting the user see any error output before the pane closes.
            hold_script = (
                shlex.join(tokens)
                + '; _rc=$?;'
                  ' if [ "$_rc" -ne 0 ]; then'
                  ' printf "\\n[process exited (code %s) — press Enter to close]\\n" "$_rc";'
                  ' read _ignored; fi'
            )
            held_tokens = ['sh', '-c', hold_script]
            if direction == 'window':
                backend.new_window(held_tokens, focus=not no_focus)
            else:
                backend.split(direction, held_tokens, focus=not no_focus)
        except RuntimeError as e:
            self.add_event("cmd", f"mux: {e}")

    def _mux_open_pane(self, tokens, direction, backend, no_focus=False):
        """Open a mux split/window with pre-built command tokens (called after confirmation)."""
        try:
            hold_script = (
                shlex.join(tokens)
                + '; _rc=$?;'
                  ' if [ "$_rc" -ne 0 ]; then'
                  ' printf "\\n[process exited (code %s) — press Enter to close]\\n" "$_rc";'
                  ' read _ignored; fi'
            )
            held_tokens = ['sh', '-c', hold_script]
            if direction == 'window':
                backend.new_window(held_tokens, focus=not no_focus)
            else:
                backend.split(direction, held_tokens, focus=not no_focus)
        except RuntimeError as e:
            self.add_event("cmd", f"mux: {e}")

    def _open_cmd_prefill(self, text: str):
        """Open command mode with the given text pre-filled and cursor at the end."""
        self.cmd = {
            'chars': list(text),
            'cursor': len(text),
            'hist_idx': -1,
            'saved_line': '',
            'completions': [], 'comp_idx': -1, 'comp_prefix': '',
        }

    # ── :prog-options ────────────────────────────────────────────────────────

    def _cmd_prog_options(self, args=''):
        """Manage per-program glob-based option rules for :mux auto-injection.

        :prog-options                          — list all rules
        :prog-options <prog>                   — list rules for <prog>
        :prog-options <prog> <glob>            — remove rule for (prog, glob)
        :prog-options <prog> <glob> <options>  — add/replace rule
        :prog-options <prog> <glob> --disable  — disable prog for matching hosts
        """
        parts = args.split(None, 2)
        if not parts:
            # List all rules
            if not self.prog_options:
                if self._monitoring_started:
                    self.add_event("cmd", "prog-options: no rules defined")
            else:
                for prog, rules in self.prog_options.items():
                    for pattern, opts in rules:
                        status = '--disable' if opts is None else opts
                        if self._monitoring_started:
                            self.add_event("cmd",
                                f"prog-options: {prog} {pattern!r} → {status}")
            return

        prog = parts[0]
        if len(parts) == 1:
            # List rules for this program
            rules = self.prog_options.get(prog, [])
            if not rules:
                if self._monitoring_started:
                    self.add_event("cmd", f"prog-options: no rules for '{prog}'")
            else:
                for pattern, opts in rules:
                    status = '--disable' if opts is None else opts
                    if self._monitoring_started:
                        self.add_event("cmd",
                            f"prog-options: {prog} {pattern!r} → {status}")
            return

        pattern = parts[1]
        if len(parts) == 2:
            # Remove rule for (prog, glob)
            rules = self.prog_options.get(prog, [])
            before = len(rules)
            rules = [(p, o) for p, o in rules if p != pattern]
            if rules:
                self.prog_options[prog] = rules
            elif prog in self.prog_options:
                del self.prog_options[prog]
            if self._monitoring_started:
                removed = before - len(rules)
                self.add_event("cmd",
                    f"prog-options: removed {removed} rule(s) for '{prog}' '{pattern}'")
            return

        opts_str = parts[2].strip()
        opts = None if opts_str == '--disable' else opts_str
        rules = self.prog_options.get(prog, [])
        rules = [(p, o) for p, o in rules if p != pattern]
        rules.append((pattern, opts))
        self.prog_options[prog] = rules
        if self._monitoring_started:
            status = '--disable' if opts is None else f'opts={opts_str!r}'
            self.add_event("cmd", f"prog-options: '{prog}' '{pattern}' → {status}")

    def _cmd_with(self, args=''):
        """:with is a hosts-file-only directive; cannot be used interactively."""
        self.add_event("cmd",
            "with: this directive is only valid in a hosts file, not interactively")

    def _match_prog_options(self, prog, host, resolved_hostname=''):
        """Return (disabled, opts_str) for prog + host by matching prog_options rules.

        Last matching rule wins. Returns (True, '') if disabled, (False, opts) otherwise.
        """
        rules = self.prog_options.get(prog, [])
        matched_opts = ''
        matched_disabled = False
        for pattern, opts in rules:
            if fnmatch.fnmatch(host, pattern) or fnmatch.fnmatch(resolved_hostname, pattern):
                if opts is None:
                    matched_disabled = True
                else:
                    matched_disabled = False
                    matched_opts = opts
        return matched_disabled, matched_opts

