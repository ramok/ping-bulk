def _strip_hint_markup(text):
    """Strip _draw_hint_text markup for plain-text output (used by --help-full).

    Converts: \\[ → [    [key:color desc] → [key desc]   [key|rest] → [keyrest]
    """
    result = []
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == '\\' and i + 1 < len(text) and text[i + 1] == '[':
            result.append('[')
            i += 2
        elif ch == '[':
            result.append('[')
            i += 1
            token = []
            while i < len(text) and text[i] != ']':
                if text[i] == '\\' and i + 1 < len(text) and text[i + 1] in '[]':
                    token.append(text[i + 1])
                    i += 2
                else:
                    token.append(text[i])
                    i += 1
            content = ''.join(token)
            pipe_pos = content.find('|')
            space_pos = content.find(' ')
            if pipe_pos != -1 and (space_pos == -1 or pipe_pos < space_pos):
                key_part = content[:pipe_pos]
                rest = content[pipe_pos + 1:]
            elif space_pos == -1:
                key_part = content
                rest = ''
            else:
                key_part = content[:space_pos]
                rest = content[space_pos:]
            colon = key_part.rfind(':')
            if colon > 0 and key_part[colon + 1:] in _HINT_KEY_COLORS:
                key_part = key_part[:colon]
            result.append(key_part + rest)
            if i < len(text):
                result.append(']')
                i += 1
        else:
            result.append(ch)
            i += 1
    return ''.join(result)


