    def _cmd_set(self, args=''):
        """Set a display mode by name: :set <setting> [value].

        With no arguments or a single param name: opens the settings overlay.
        With param + value: delegates to the corresponding _cmd_* handler.

        Supported settings are defined in SET_PARAMS (dns, stats, sort,
        ping-view, log-level, autofold, …).
        """
        parts = args.split(None, 1)
        if not parts:
            # :set with no args — open settings overlay showing all settings
            self._open_settings_overlay()
            return
        subcmd = parts[0].lower()
        param = _SET_PARAM_MAP.get(subcmd)
        if param is None:
            choices = '  '.join(p.name for p in SET_PARAMS)
            self.add_event("cmd",
                f"set: unknown setting '{subcmd}' — choices: {choices}")
            return
        if len(parts) == 1:
            # :set <param> with no value — open settings overlay focused on that param
            self._open_settings_overlay(param_name=subcmd)
        else:
            getattr(self, param.action)(parts[1].strip())

    def _open_settings_overlay(self, param_name=''):
        """Open the help overlay in settings tab, optionally focused on a param."""
        self.help_open = True
        self.help_tab = 5
        self.help_search_active = False
        self.help_scroll = 0
        self.help_h_scroll = 0
        self._current_mode = 'help'
        if param_name:
            # Find the param index and set cursor to it; also pre-search
            for i, p in enumerate(SET_PARAMS):
                if p.name == param_name:
                    self.settings_cursor = i
                    break
            # Pre-populate search so the param is highlighted
            self.help_search = param_name
            self._update_help_search()
            # Scroll to cursor after line map is built (on next draw)
            # We defer by setting a flag — handled in _draw_help_overlay
            self._settings_scroll_to_cursor = True
        else:
            self.settings_cursor = 0
            self.help_search = ''
            self.help_search_matches = []
            self._settings_scroll_to_cursor = False

    def _cmd_pause(self, args=''):
        """Toggle or set global pause (all monitors). Args: on | off | (empty = toggle)."""
        val = args.strip().lower()
        all_paused = all(m.paused for m in self.monitors)
        if val == 'on':
            want_pause = True
        elif val == 'off':
            want_pause = False
        else:
            want_pause = not all_paused
        for m in self.monitors:
            m.pause() if want_pause else m.unpause()

