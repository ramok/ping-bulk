    def _cmd_resolv(self, args=''):
        """Apply a static DNS override: :resolv <ip-pattern> <hostname-template>."""
        parts = args.split(None, 1)
        if len(parts) != 2:
            self.add_event("cmd", "resolv: usage: :resolv <ip> <hostname>")
        else:
            ip_pattern, hostname_tmpl = parts[0], parts[1].strip()
            try:
                rows = _expand_host_with_captures(ip_pattern)
            except ValueError as e:
                self.add_event("cmd", f"resolv: brace expansion error: {e}")
            else:
                for expanded_ip, captures in rows:
                    if not _is_ip(expanded_ip):
                        self.add_event("cmd",
                            f"resolv: '{expanded_ip}' is not a valid IP address — skipped")
                        continue
                    hostname = _apply_backref(hostname_tmpl, captures)
                    self._apply_hosts_entry(expanded_ip, hostname)

    def _cmd_resolv_port(self, args=''):
        """Apply a static port→service mapping: :resolv-port <port-pattern> <service-template>."""
        parts = args.split(None, 1)
        if len(parts) != 2:
            self.add_event("cmd", "resolv-port: usage: :resolv-port <port> <service>")
        else:
            port_pattern, service_tmpl = parts[0], parts[1].strip()
            try:
                rows = _expand_host_with_captures(port_pattern)
            except ValueError as e:
                self.add_event("cmd", f"resolv-port: brace expansion error: {e}")
            else:
                for expanded_port, captures in rows:
                    try:
                        port_num = int(expanded_port)
                    except ValueError:
                        self.add_event("cmd",
                            f"resolv-port: '{expanded_port}' is not a valid port number — skipped")
                        continue
                    service = _apply_backref(service_tmpl, captures)
                    # Store bidirectional mapping
                    self.port_map[port_num] = service
                    self.port_map[service] = port_num

    def _cmd_ssh(self, args=''):
        """Add a remote-ping monitor: :ssh [opts] <dest> <ping-host>."""
        if not args:
            self.add_event("cmd",
                "ssh: usage: :ssh [opts] <dest> <ping-host>")
        else:
            try:
                tokens = shlex.split(args)
            except ValueError as e:
                self.add_event("cmd", f"ssh: parse error: {e}")
            else:
                if len(tokens) < 2:
                    self.add_event("cmd",
                        "ssh: usage: :ssh [opts] <dest> <ping-host>")
                else:
                    ping_host_pattern = tokens[-1]
                    ssh_args = tokens[:-1]
                    ssh_dest = ssh_args[-1]

                    # In kiosk mode, prepend isolation flags to block ~/.ssh/ access
                    if self.kiosk_mode:
                        ssh_args = _kiosk_ssh_flags() + ssh_args

                    # Preserve original SSH args before applying :resolv mappings
                    original_ssh_args = ssh_args.copy()

                    # Apply :resolv mapping to SSH destination
                    ssh_args[-1] = self._resolve_ssh_host(ssh_dest)

                    # Apply :resolv mapping to ProxyJump/jump hosts (-J and -o ProxyJump=)
                    i = 0
                    while i < len(ssh_args):
                        arg = ssh_args[i]

                        # Handle -J option (ProxyJump shorthand)
                        if arg == '-J' and i + 1 < len(ssh_args):
                            # Collect all tokens that belong to this -J argument.
                            # When user types "-J bastion1, bastion2", shlex.split() produces
                            # ['-J', 'bastion1,', 'bastion2'], so we need to collect tokens
                            # while the previous token ends with a comma.
                            jump_tokens = []
                            j = i + 1
                            while j < len(ssh_args):
                                jump_tokens.append(ssh_args[j])
                                # Stop if this token doesn't end with comma (it's the last one)
                                if not ssh_args[j].endswith(','):
                                    break
                                j += 1

                            # Join collected tokens with space, then split on comma
                            jump_hosts_str = ' '.join(jump_tokens)

                            # Handle comma-separated multi-hop: host1,host2,host3
                            if ',' in jump_hosts_str:
                                resolved_hops = []
                                for hop in jump_hosts_str.split(','):
                                    hop = hop.strip()  # Strip whitespace
                                    if hop:  # Skip empty strings from trailing commas
                                        resolved_hops.append(self._resolve_ssh_host(hop))
                                resolved_str = ','.join(resolved_hops)
                            else:
                                resolved_str = self._resolve_ssh_host(jump_hosts_str)

                            # Replace the collected tokens with the single resolved string
                            ssh_args[i + 1] = resolved_str
                            # Remove any extra tokens that were part of the jump host list
                            for _ in range(len(jump_tokens) - 1):
                                ssh_args.pop(i + 2)

                            i += 2
                            continue

                        # Handle -o ProxyJump=host (with or without space after -o)
                        if arg.startswith('-oProxyJump='):
                            # Format: -oProxyJump=host (no space)
                            jump_hosts = arg.split('=', 1)[1]
                            if ',' in jump_hosts:
                                resolved_hops = []
                                for hop in jump_hosts.split(','):
                                    resolved_hops.append(self._resolve_ssh_host(hop.strip()))
                                ssh_args[i] = '-oProxyJump=' + ','.join(resolved_hops)
                            else:
                                ssh_args[i] = '-oProxyJump=' + self._resolve_ssh_host(jump_hosts)
                        elif arg == '-o' and i + 1 < len(ssh_args):
                            # Format: -o ProxyJump=host (with space)
                            next_arg = ssh_args[i + 1]
                            if next_arg.startswith('ProxyJump='):
                                jump_hosts = next_arg.split('=', 1)[1]
                                if ',' in jump_hosts:
                                    resolved_hops = []
                                    for hop in jump_hosts.split(','):
                                        resolved_hops.append(self._resolve_ssh_host(hop.strip()))
                                    ssh_args[i + 1] = 'ProxyJump=' + ','.join(resolved_hops)
                                else:
                                    ssh_args[i + 1] = 'ProxyJump=' + self._resolve_ssh_host(jump_hosts)
                                i += 2
                                continue

                        i += 1
                    try:
                        expanded_hosts = _expand_host(ping_host_pattern)
                    except ValueError as e:
                        self.add_event("cmd", f"ssh: brace expansion error: {e}")
                    else:
                        for ping_host in expanded_hosts:
                            actual_ping_host = (self.hosts_map[ping_host][0]
                                                if ping_host in self.hosts_map
                                                else ping_host)
                            monitor = SshPingMonitor(ssh_args, actual_ping_host,
                                                     ping_host_label=ping_host,
                                                     original_ssh_args=original_ssh_args,
                                                     hosts_map=self.hosts_map)
                            self.monitors.append(monitor)
                            self.entries.append(monitor)
                            if self._monitoring_started:
                                thread = threading.Thread(
                                    target=monitor.ping, daemon=True
                                )
                                thread.start()
                                self.threads.append(thread)

