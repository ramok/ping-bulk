    def _snapshot_monitor(self, m):
        """Return a dict of per-monitor stats for history preservation across reload."""
        with m.lock:
            return {
                'history':       list(m.history),
                'history_times': list(m.history_times),
                'lat_count':     m._lat_count,
                'lat_mean':      m._lat_mean,
                'lat_m2':        m._lat_m2,
                'lat_min':       m._lat_min,
                'lat_max':       m._lat_max,
                'rx_count':      m.rx_count,
                'xx_count':      m.xx_count,
                'ping_count':    m.ping_count,
                'alive':         m.alive,
                'down_since':    m.down_since,
                'up_since':      m.up_since,
            }

    def _restore_monitor(self, m, snap):
        """Restore stats captured by _snapshot_monitor into a freshly created monitor."""
        with m.lock:
            m.history.extend(snap['history'])
            m.history_times.extend(snap['history_times'])
            m._lat_count  = snap['lat_count']
            m._lat_mean   = snap['lat_mean']
            m._lat_m2     = snap['lat_m2']
            m._lat_min    = snap['lat_min']
            m._lat_max    = snap['lat_max']
            m.rx_count    = snap['rx_count']
            m.xx_count    = snap['xx_count']
            m.ping_count  = snap['ping_count']
            m.alive       = snap['alive']
            m.down_since  = snap['down_since']
            m.up_since    = snap['up_since']

    def _edit_reload_inplace(self, hosts_file):
        """In-process reload: snapshot history, clear monitors, re-source, restore."""
        snapshot = {m.host: self._snapshot_monitor(m) for m in self.monitors}

        for m in self.monitors:
            m.stop()
        for t in self.threads:
            t.join(timeout=0)

        self.highlighted_index = None
        self.host_scroll = 0
        self.monitors.clear()
        self.entries.clear()
        self._name_col_dirty = True
        self._name_col_cache.clear()
        self.threads.clear()
        self.hosts_map.clear()

        # Source the file with _monitoring_started temporarily False so that
        # _apply_hosts_entry does not log spurious "no monitor matched" warnings
        # when :resolv entries are processed before their host entries (the usual
        # order in hosts files).  Thread creation is deferred to the loop below.
        self._monitoring_started = False
        try:
            self._cmd_source(hosts_file)
        finally:
            self._monitoring_started = True

        for m in self.monitors:
            thread = threading.Thread(target=m.ping, daemon=True)
            thread.start()
            self.threads.append(thread)

        for m in self.monitors:
            if m.host in snapshot:
                self._restore_monitor(m, snapshot[m.host])

        self.add_event("cmd", f"edit: reloaded {hosts_file}")

    def _kiosk_audit(self, action: str, detail: str = '') -> None:
        """Write one audit record to syslog when kiosk mode is active.

        Records the executing user, action name, and optional detail string.
        Uses LOG_NOTICE priority so the record lands in most syslog targets
        (e.g. ``/var/log/syslog``) without flooding ``/var/log/auth.log``.

        Safe to call on non-Linux platforms — if syslog is unavailable the
        call is silently ignored.
        """
        try:
            user = os.environ.get('USER') or os.environ.get('LOGNAME') or str(os.getuid())
            msg = f"kiosk_audit: user={user} action={action}"
            if detail:
                msg += f" detail={detail!r}"
            _syslog.openlog(_PROG_NAME, _syslog.LOG_PID, _syslog.LOG_DAEMON)
            _syslog.syslog(_syslog.LOG_NOTICE, msg)
        except Exception:
            pass  # syslog not available (non-Linux, permission denied, …)

    def _kiosk_allow_path(self, path: str, context: str = '') -> bool:
        """Check whether *path* is allowed for file operations in kiosk mode.

        Returns True when the canonical (realpath) form of *path* falls under
        an allowed prefix.  Allowed prefixes are:

          /tmp/                           — world-writable scratch space
          ~/.local/state/{_PROG_NAME}/   — conventional state directory
          /etc/{_PROG_NAME}/             — admin-controlled config directory
          directory of self.hosts_file   — same place the hosts file lives
                                           (so operators can keep extra sources
                                           alongside the main file)

        If *path* does not exist yet, the directory part is checked instead.
        When the check fails, an event is logged (using *context* as the
        category prefix) and False is returned.
        """
        allowed_prefixes = [
            '/tmp/',
            os.path.expanduser(f'~/.local/state/{_PROG_NAME}/'),
            f'/etc/{_PROG_NAME}/',
        ]
        if self.hosts_file:
            hosts_dir = os.path.dirname(os.path.realpath(self.hosts_file))
            allowed_prefixes.append(hosts_dir + '/')

        check = os.path.realpath(path)
        # If the path doesn't exist yet, check its parent directory.
        if not os.path.exists(check):
            check = os.path.realpath(os.path.dirname(path)) + '/'

        for prefix in allowed_prefixes:
            real_prefix = os.path.realpath(prefix.rstrip('/')) + '/'
            if check == real_prefix or check.startswith(real_prefix):
                return True

        tag = f"{context}: " if context else ""
        self.add_event("cmd",
            f"{tag}kiosk mode: path not in allowed directories — {path}")
        return False

    def _resolve_editor(self) -> list:
        """Return [editor_binary] or [editor_binary, flags] to open a file.

        Kiosk mode uses rnano (restricted nano, no shell escape), then rvim.
        All environment variables ($VISUAL/$EDITOR) are ignored in kiosk mode.
        Normal mode respects $VISUAL, $EDITOR, then Debian's 'editor' alternative.
        """
        if self.kiosk_mode:
            for candidate in ('rnano', 'rvim'):
                if shutil.which(candidate):
                    return [candidate]
            if shutil.which('vim'):
                return ['vim', '-Z']
            return []
        for candidate in [
            os.environ.get('VISUAL'),
            os.environ.get('EDITOR'),
            'editor', 'vim', 'vi',
        ]:
            if candidate and shutil.which(candidate):
                return [candidate]
        return []

    def _cmd_edit(self, args=''):
        """Open the active hosts file in an external editor, then offer reload options."""
        if not self.hosts_file:
            self.add_event("cmd", "edit: no hosts file loaded (use -f <file>)")
            return

        editor_cmd = self._resolve_editor()
        if not editor_cmd:
            if self.kiosk_mode:
                self.add_event("cmd",
                    "edit: no restricted editor found (install rnano or rvim)")
            else:
                self.add_event("cmd", "edit: no editor found "
                               "(set $VISUAL or $EDITOR, or install vim)")
            return

        try:
            mtime_before = os.stat(self.hosts_file).st_mtime
        except OSError:
            mtime_before = None

        import curses as _curses
        _curses.endwin()
        try:
            subprocess.call(editor_cmd + [self.hosts_file])
        finally:
            _curses.doupdate()

        try:
            mtime_after = os.stat(self.hosts_file).st_mtime
        except OSError:
            mtime_after = None

        if mtime_before is None or mtime_after is None or mtime_after == mtime_before:
            return  # nothing changed (or read-only file that couldn't be written)

        self.prompt = {'type': 'script_changed', 'file': self.hosts_file}

    def _cmd_dns(self, args=''):
        """Cycle (no arg) or set DNS display mode."""
        if args:
            modes_lower = [m.lower() for m in DNS_MODES]
            if args.lower() in modes_lower:
                self.dns_mode = modes_lower.index(args.lower())
                self._name_col_dirty = True
                self._name_col_cache.clear()
                if DNS_MODES[self.dns_mode] in ('hostname', 'ip'):
                    for monitor in self.monitors:
                        if monitor.resolved_ip is None:
                            threading.Thread(
                                target=monitor.resolve_dns, daemon=True
                            ).start()
                if self._filter_query:
                    self._update_filter_visible()
            else:
                self.add_event("cmd",
                    f"dns: unknown mode '{args}' — choices: {' '.join(DNS_MODES)}")
        else:
            self.cycle_dns(1)

    def _cmd_stats(self, args=''):
        """Cycle (no arg), set single-mode, or set custom comma-separated column list.

        Examples:
          :set stats avg          — single mode
          :set stats last,avg,stdev — custom multi-column
          :set stats ,            — clear custom, back to off
        """
        if not args:
            self.cycle_stats(1)
            return

        args = args.strip()

        # Bare comma or empty list → clear custom, reset to off
        if args in (',', ''):
            self._set_stats_custom(None)
            self.stats_mode = 0
            return

        # Comma list → custom multi-column mode
        if ',' in args:
            tokens = [t.strip().lower() for t in args.split(',') if t.strip()]
            if not tokens:
                self._set_stats_custom(None)
                self.stats_mode = 0
                return
            unknown = [t for t in tokens if t not in STAT_NAMES]
            if unknown:
                valid = sorted(STAT_NAMES.keys())
                self.add_event("cmd",
                    f"stats: unknown column(s): {', '.join(unknown)} — "
                    f"valid: {', '.join(valid)}")
                return
            self._set_stats_custom([STAT_NAMES[t] for t in tokens])
            self.stats_mode = _CUSTOM_STATS_SENTINEL
            return

        # Single name — could be standard STATS_MODES or a STAT_NAMES alias
        arg_lower = args.lower()
        modes_lower = [m.lower() for m in STATS_MODES]
        if arg_lower in modes_lower:
            self.stats_mode = modes_lower.index(arg_lower)
            self._set_stats_custom(None)
        elif arg_lower in STAT_NAMES:
            # e.g. ':set stats last' → treat as custom single-column
            self._set_stats_custom([STAT_NAMES[arg_lower]])
            self.stats_mode = _CUSTOM_STATS_SENTINEL
        else:
            valid = sorted(set(modes_lower) | set(STAT_NAMES.keys()))
            self.add_event("cmd",
                f"stats: unknown mode '{args}' — "
                f"choices: {', '.join(v for v in valid if v != 'last')}"
                f" (or comma list e.g. last,avg,stdev)")


    def _cmd_sort(self, args=''):
        """Cycle (no arg) or set sort order.  'reverse' cycles backward."""
        sorts = ['none', 'name', 'status', 'latency']
        if args:
            a = args.strip().lower()
            if a == 'reverse':
                self.cycle_sort(-1)
            elif a in sorts:
                self.sort_by = a
            else:
