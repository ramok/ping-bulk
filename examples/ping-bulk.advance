#!/bin/sh
# polyglot: sh executes the lines below
# ping-bulk joins them as one comment via '\' continuation \
    command -v ping-bulk >/dev/null 2>&1 && exec ping-bulk -f "$0" "$@"; \
    exec "$(dirname "$0")/ping-bulk" -f "$0" "$@"

# Full-featured example showing sections, brace expansion, static DNS
# overrides, :for loops, and SSH-based remote monitoring.
#
# Run directly:  chmod +x network.hosts && ./network.hosts
# Or:            ping-bulk -f network.hosts

# ── Static DNS overrides ───────────────────────────────────────────────────
# Map IP ranges to meaningful names.
# Back-references (all equivalent): $N  ${N}  (N = 1 for first brace group)
# $0 expands to the full expanded host string for each iteration.
:resolv 10.0.0.1      gw-core
:resolv 10.0.1.{1..3} leaf-sw$1
:resolv 10.0.2.{1..4} server${1}

# ── Display preferences (optional) ────────────────────────────────────────
:set stats down; :set ping-view scaled; :set dns hostname

# ── Hierarchical sections ──────────────────────────────────────────────────
# ## (or :title) creates a level-1 section header.
# ### (or :title2) creates a level-2 section, indented 2 spaces.
# #### (or :title3) creates level-3, and so on.
#
# Each section header shows a status badge: N↑/N↓/N-
#   N↑  green  — hosts with a successful reply
#   N↓  red    — hosts that last timed out
#   N-  yellow — hosts not yet reached (starting up / in backoff)
# When any host has a fatal error (e.g. SSH auth failure, bad hostname)
# the ↓ and - counters are shown in bold, distinguishing an unrecoverable
# error from a transient "still connecting" state.
#
# Sections are collapsible: press [ to fold all, ] to unfold all,
# or navigate to a section header and press Space / zc / zo.
#
# Append '-' right after the hashes to start a section folded by default:
#   ##- Title        starts collapsed (also :title- / :title2-)
#   ## Title         starts expanded (normal)

## Infrastructure
### Core
10.0.0.1

### Distribution switches
10.0.1.{1..3}

### Servers
10.0.2.{1..4}

# ── Optional hosts with '?' prefix ────────────────────────────────────────
# A '?' prefix on a host line makes it conditional on a :resolv mapping.
# The host is added only if its expanded name has a :resolv entry; otherwise
# it is silently skipped.  This is most useful inside :for loops where some
# iterations lack a particular device.
#
# Here hubs 1,2,4 have a camera but hub 3 does not:
:resolv 10.0.{1,2,4}.50  sw$1-cam

## Sensor hubs
:for hub-{1..4}
    ### $0
    10.0.$1.1  ## sw$1-router
    10.0.$1.2  ## sw$1-uplink
    ?sw$1-cam
:end

## TCP Port Monitoring
# TCP connection check instead of ICMP ping.
# Optionally override the resolved port name via :resolv-port.
:resolv-port 8443 alt-https
example.com:443
1.1.1.1:53
1.1.1.1:8443
google.com:https

## Public connectivity
8.8.8.8
1.1.1.1

# ── Semicolon separator ────────────────────────────────────────────────────
# A semicolon (;) is a line separator — equivalent to a newline.
# Useful for compact one-liners, keeping related entries together, or
# defining a :let variable and using it on the same physical line.

:let ns1 9.9.9.9; :let ns2 149.112.112.112

## DNS resolvers
# Two resolvers per physical line:
8.8.4.4; 1.0.0.1
$ns1; $ns2

# ── :let variables ────────────────────────────────────────────────────────
# :let defines reusable variables.  $name and ${name} are equivalent:
# both substitute the value when defined, and are left unchanged when not.
# ${name} is mainly useful to delimit the variable name from adjacent text.
#
# :let name{range} value  — indexed variables via brace expansion.
# $1 in the value refers to the brace group of the name expansion.
:let domain .example.com
:let gw{1..3} 10.10.$1.1

## DC gateways
$gw1$domain
$gw2$domain
${gw3}$domain   # ${gw3} same as $gw3; braces just for clarity

# ── :if conditionals ──────────────────────────────────────────────────────
# :if VALUE in val1,val2,...   — include block when VALUE matches any token
# :if VALUE not in val1,...    — include block when VALUE matches none
# :elif / :else / :end work as expected.  Blocks can be nested and work both
# at the top level (with :let variables) and inside :for loops.

:let env production

:if $env in staging,production
    10.0.0.100          ## staging-monitor
:end

## :if also works inside :for loops
:for hub in region-{1..3}
    10.0.$1.1           ## region$1-router
    :if $1 in 1,2
        10.0.$1.10      ## region$1-primary
    :else
        10.0.$1.11      ## region$1-backup
    :end
:end

# ── :let with per-loop folding ──────────────────────────────────────────────
# ${name_$N} two-level expansion: $N is resolved first (from loop back-ref),
# then the resulting string is used as the variable name.
# Undefined variables expand to "" — so only exceptions need a :let entry.
:let fold3 -        # hub-3 starts folded; all others (undefined) → "" → expanded

## Sensor hubs (conditional fold)
:for sensor-hub-{1..5}
    :title${fold$1} sensor-hub-$1
    sensor-hub-$1-router
    sensor-hub-$1-uplink
:end

# ── Use :for loop with backreferences to assign names ──────────────────────
# $0 expands to the full expanded host string for each iteration.
# Numbered ($1) or named variables ($x) refer to brace groups.
## Workstations
:for x in 192.168.1.{2..4}
    :resolv $0 workstation$x
    $0
:end

# ── Sections that start folded (##-) ───────────────────────────────────────
# Append '-' directly after the hashes (or after :title/:title2) to start
# the section collapsed.  The user can unfold it with Space / zo / ].
##- Historical / decommissioned
192.0.2.1
192.0.2.2

# ── for-loop: two brace groups → two back-references ───────────────────────
# $r = rack number (first group),  $n = node number (second group)
# Generates 6 entries: 10.3.1.1, 10.3.1.2, 10.3.2.1, 10.3.2.2, 10.3.3.1, 10.3.3.2
## Pod servers
:for r,n in 10.3.{1..3}.{1..2}
    :resolv $0 rack$r-node$n
    $0
:end

# ── Remote monitoring over SSH ─────────────────────────────────────────────
# Ping hosts on a remote network segment as seen from a remote server.
# Requires passwordless SSH access (key or agent).
# Nested sections work inside :with remote-ping blocks too.

## Remote sites
### Remote site A (via ssh jump)
:with remote-ping -J bastion.example.com ops@remote-a
    10.10.0.{1..3}
:end

### Remote site B
:remote-ping ops@remote-b 10.20.0.1
:remote-ping ops@remote-b 10.20.0.{2..3}

# ── :prog-options ─────────────────────────────────────────────────────────
# Map hostname globs to SSH flags injected automatically by :mux.
# Rules are evaluated in order; last match wins.
#
# Inline syntax:
#   :prog-options <prog> <glob> <opts>    — add/replace rule
#   :prog-options <prog> <glob> --disable — disable prog for matching hosts
#   :prog-options <prog> <glob>           — remove rule for that pattern
#   :prog-options <prog>                  — list rules for that program
#   :prog-options                         — list all rules
#
# Block syntax (handy when many rules share one program):
#   :with prog-options <prog>
#     <glob> <opts>
#     ...
#   :end
#
# Options are auto-injected when :mux <prog> is run from a key binding.

:prog-options ssh *-router     -l admin    # Mikrotik routers
:prog-options ssh *-comm-mod   -l root     # comm modules
:prog-options ssh *-jetson     -l jetson   # Jetson boards
:prog-options ssh *-nuc        -l dev      # NUC devices
:prog-options ssh *-ps*        -l dev      # power supplies
:prog-options ssh *.internal.example.com -o ProxyJump=bastion

# Disable SSH connect for public services — no SSH makes sense here
:prog-options ssh 1.1.1.1      --disable
:prog-options ssh 8.8.8.8      --disable
:prog-options ssh 1.0.0.1      --disable

# Disable connect entirely for a specific restricted host
:prog-options ssh restricted.example.com --disable

# ── Key bindings ──────────────────────────────────────────────────────────
# :bind-key assigns a command (or chain of commands) to a key sequence.
# Vim-like notation: <C-x> = Ctrl+x, <CR> = Enter, <Space>, <Up>, etc.
# Multi-key sequences work naturally: za, gg, gt, etc.
#
# Variable expansion at keypress time:
#   %h  — selected host display name  %i  — selected host IP (resolved)
#   %r  — connectable target: static :resolv IP if set, else hostname
#   %d  — SSH destination (SshPingMonitor only, e.g. user@gateway)
#   %j  — jump host(s) (SshPingMonitor only, from -J flags)
#   %H  — all hosts in section        %R  — section hosts (%r logic)
#   %p  — port (TCP monitors only)    %s  — section title
#   %%  — literal %
#
# Custom separator: %{H:,} = comma-separated,  %{H:\n} = newline-separated.
# Same syntax for lists: %{j: -J } joins jump hosts with ' -J ' between items.
#
# Conditional expansion: %{var?template}
#   Expands 'template' when var is set, otherwise empty string.
#   Inner % vars are also expanded.  Useful for optional SSH flags:
#     %{j?-J %{j: -J }}  →  "-J host1 -J host2" when jump hosts exist, "" otherwise
#
# Append '...' to pre-fill the command line without executing (edit mode):
#   :bind-key t :mux mtr %i...     — lets user review before Enter
#
# --desc TEXT    description shown in the ? help overlay "Custom bindings" section
# --hint TEXT    short label shown in the bottom bar (use [x] notation for hotkey)
# --mode MODE    bind key in a specific UI layer: normal (default), help, details
#
# Default 'c' binding (built-in, shown here for reference / override):
#   SSH-proxied hosts (have %d):  :mux ssh%{j? -J %{j: -J }} %d
#   Plain hosts:                  :mux ssh %r
# Override example:
#   :bind-key c :mux ssh -l admin %r

:bind-key --desc "MTR trace" --hint "[t]race" t :mux mtr %i
:bind-key x :set stats down \; :set dns hostname
:bind-key <C-p> :pause

# Overlay-mode bindings — bind h to show help even while in the help overlay:
# :bind-key --mode help h :close

# ── Dynamic Additions ──────────────────────────────────────────────────────
# You can also dynamically source other config files or add specific hosts
# directly from within this script or interactively at runtime.
#
:source ./examples/ping-bulk.simple

