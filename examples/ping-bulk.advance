#!/bin/sh
# \
    exec ping-bulk -f "$0" "$@"

# Full-featured example showing sections, brace expansion, static DNS
# overrides, :for loops, and SSH-based remote monitoring.
#
# Run directly:  chmod +x network.hosts && ./network.hosts
# Or:            ping-bulk -f network.hosts

# ── Static DNS overrides ───────────────────────────────────────────────────
# Map IP ranges to meaningful names.
# Back-references (all equivalent): $N  ${N}  (N = 1 for first brace group)
# $0 expands to the full expanded host string for each iteration.
:resolv 10.0.0.1      gw-core
:resolv 10.0.1.{1..4} leaf-sw$1
:resolv 10.0.2.{1..8} server${1}

# ── Display preferences (optional) ────────────────────────────────────────
:set stats down
:set ping-view scaled
:set dns hostname

# ── Hierarchical sections ──────────────────────────────────────────────────
# ## (or :title) creates a level-1 section header.
# ### (or :title2) creates a level-2 section, indented 2 spaces.
# #### (or :title3) creates level-3, and so on.
#
# Each section header shows a status badge: N↑/N↓/N-
#   N↑  green  — hosts with a successful reply
#   N↓  red    — hosts that last timed out
#   N-  yellow — hosts not yet reached (starting up / in backoff)
# When any host has a fatal error (e.g. SSH auth failure, bad hostname)
# the ↓ and - counters are shown in bold, distinguishing an unrecoverable
# error from a transient "still connecting" state.
#
# Sections are collapsible: press [ to fold all, ] to unfold all,
# or navigate to a section header and press Space / zc / zo.

## Infrastructure
### Core
10.0.0.1

### Distribution switches
10.0.1.{1..4}

### Servers
10.0.2.{1..8}

# ── Optional hosts with '?' prefix ────────────────────────────────────────
# A '?' prefix on a host line makes it conditional on a :resolv mapping.
# The host is added only if its expanded name has a :resolv entry; otherwise
# it is silently skipped.  This is most useful inside :for loops where some
# iterations lack a particular device.
#
# Here hubs 1,2,4 have a camera but hub 3 does not:
:resolv 10.0.{1,2,4}.50  sw$1-cam

## Sensor hubs
:for hub-{1..4}
    ### $0
    10.0.$1.1  ## sw$1-router
    10.0.$1.2  ## sw$1-uplink
    ?sw$1-cam
:done

## TCP Port Monitoring
# TCP connection check instead of ICMP ping.
# Optionally override the resolved port name via :resolv-port.
:resolv-port 8443 alt-https
example.com:443
1.1.1.1:53
1.1.1.1:8443
google.com:https

## Public connectivity
8.8.8.8
1.1.1.1

# ── Use :for loop with backreferences to assign names ──────────────────────
# $0 expands to the full expanded host string for each iteration.
# Numbered ($1) or named variables ($x) refer to brace groups.
## Workstations
:for x in 192.168.1.{2..5}
    :resolv $0 workstation$x
    $0
:done

# ── for-loop: two brace groups → two back-references ───────────────────────
# $r = rack number (first group),  $n = node number (second group)
# Generates 6 entries: 10.3.1.1, 10.3.1.2, 10.3.2.1, 10.3.2.2, 10.3.3.1, 10.3.3.2
## Pod servers
:for r,n in 10.3.{1..3}.{1..2}
    :resolv $0 rack$r-node$n
    $0
:done

# ── Remote monitoring over SSH ─────────────────────────────────────────────
# Ping hosts on a remote network segment as seen from a remote server.
# Requires passwordless SSH access (key or agent).
# Nested sections work inside :ssh-begin blocks too.

## Remote sites
### Remote site A (via ssh jump)
:ssh-begin -J bastion.example.com ops@remote-a
    10.10.0.{1..4}
:ssh-end

### Remote site B
:ssh ops@remote-b 10.20.0.1
:ssh ops@remote-b 10.20.0.{2..5}

# ── Dynamic Additions ──────────────────────────────────────────────────────
# You can also dynamically source other config files or add specific hosts
# directly from within this script or interactively at runtime.
#
:ping 1.0.0.1
:source ./examples/ping-bulk.simple

