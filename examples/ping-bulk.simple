#!/usr/bin/env -S ping-bulk -f
# Simple example — public DNS resolvers and a local gateway.
# Run directly:  chmod +x simple.hosts && ./simple.hosts
# Or:            ping-bulk -f simple.hosts

## Public DNS
8.8.8.8   ## Google DNS primary
8.8.4.4   ## Google DNS secondary
1.1.1.1   ## Cloudflare DNS primary
1.0.0.1   ## Cloudflare DNS secondary
9.9.9.9   ## Quad9 DNS

## Local network
192.168.1.1   ## gateway
# $1 expands to the value of the first brace group (the last octet here)
192.168.1.{2..5} ## workstation$1

